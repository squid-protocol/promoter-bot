[Unit]
Description=promoter-bot gate (churn tick): cheap checks; a model session only when something needs judgment

[Service]
Type=oneshot
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 %h/.local/bin/churn tick
# a model tick is capped at 90 min inside churn; leave room for the gate
TimeoutStartSec=6000
Nice=5
