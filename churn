IDLE_TICK_CAP_S = 30 * 60  # an idle tick stands for the time to the next logged event, at most one timer period
FACTORY = H / "factory-metrics.json"
DASH_REPO, DASH_BRANCH, DASH_FILE = _CFG.get("dashboard_repo", f"{ORG}/squid-bot"), "dashboard", "factory.json"
FACTORY_PACE_S, FACTORY_RETRY_S = 60, 90  # `churn factory --days N`: GitHub search allows 30 calls a minute
FACTORY_DAYS = 120  # 2026-10-26: weekly quality lines (quality.svg) want months, not one


def record_factory(c: dict, push: bool = True) -> bool:
    """Keep the day's factory numbers (last FACTORY_DAYS days) and publish them to squid-bot's dashboard branch, where
    the Fleet CI report renders an "Agent factory" row from them. Never raises: the gate must not stop over it."""
    try:
        data = json.loads(FACTORY.read_text()) if FACTORY.exists() else {}
    except ValueError:
        data = {}
    days = data.get("days", {})
    days[c["day"]] = {**c["factory"], "churn_merged": len(c["churn_merged"]), "usd": c["total_usd"],
                      "usd_per_merged_churn_pr": c["usd_per_merged_churn_pr"],
                      "slices_merged": c.get("slices_merged", 0), "items_done": c.get("items_done", 0)}
    keep = sorted(days)[-FACTORY_DAYS:]
    data = {"repo": REPO, "updated": iso(now()), "days": {d: days[d] for d in keep}}
    FACTORY.write_text(json.dumps(data, indent=1, sort_keys=True))
    return push_factory(data) if push else True


# Fields of a factory day that add up across hosts (counts, hours, dollars, worker slots); the ratios are recomputed
# from these sums, so a combined day is exact. ci_busy_hours is each host's view of the same CI queue: the max.
FACTORY_SUM = ("churn_merged", "slices_merged", "items_done", "usd", "loop_runs", "idle_ticks", "idle_hours", "paused_hours", "max_workers",
               "worker_hours", "precheck", "holds", "idle_causes", "idle_blockers", "first_pass", "quality")


def _add(a, b):
    if isinstance(a, dict) or isinstance(b, dict):
        a, b = a or {}, b or {}
        return {k: _add(a.get(k), b.get(k)) for k in {*a, *b}}
    return round((a or 0) + (b or 0), 3)


def combine_factory_days(hosts: dict[str, dict]) -> dict[str, dict]:
    """Owner 2026-10-18: two hosts published factory.json in turn and each push replaced the other's numbers. Each host
    now owns hosts[<host_id>]; the top-level `days` the Fleet CI report reads is their sum. A day only one host has is
    that host's day unchanged. The two medians become a churn_merged-weighted mean of the hosts' medians (approximate)."""
    out = {}
    for day in sorted({d for days in hosts.values() for d in days}):
        rows = [days[day] for days in hosts.values() if day in days]
        if len(rows) == 1:
            out[day] = dict(rows[0])
            continue
        c: dict = {}
        for k in FACTORY_SUM:
            for r in rows:
                if k in r:
                    c[k] = _add(c.get(k), r[k])
        c["idle_blockers"] = dict(sorted((c.get("idle_blockers") or {}).items(), key=lambda kv: -kv[1])[:5])
        merged, worked = c.get("churn_merged") or 0, sum((c.get("worker_hours") or {}).values())
        c["usd_per_merged_churn_pr"] = round(c.get("usd", 0) / merged, 2) if merged else None
        c["loops_per_merged_pr"] = round(c.get("loop_runs", 0) / merged, 2) if merged else None
        c["new_work_share"] = round((c.get("worker_hours") or {}).get("new_work", 0) / worked, 3) if worked else None
        slots = sum(r.get("max_workers") or 0 for r in rows)
        c["slot_use"] = (round(sum((r.get("slot_use") or 0) * (r.get("max_workers") or 0) for r in rows) / slots, 3)
                         if slots else None)
        c["ci_busy_hours"] = max((r.get("ci_busy_hours") or 0) for r in rows)
        for k in ("review_wait_min_median", "pr_open_to_merge_h_median"):
            w = [(r[k], r.get("churn_merged") or 1) for r in rows if r.get(k) is not None]
            c[k] = round(sum(v * n for v, n in w) / sum(n for _, n in w), 2) if w else None
        c["hosts"] = len(rows)
        out[day] = c
    return out


def push_factory(data: dict, tries: int = 3) -> bool:
    """Commit this host's factory days to the dashboard branch through the contents API (gh's auth; no clone, no ssh):
    read the published file, replace only hosts[HOST_ID], recompute the combined `days`, write with the read sha. A
    write that lost the race (the other host committed in between) is retried on the new file."""
    path = f"repos/{DASH_REPO}/contents/{DASH_FILE}"
    err = ""
    for _ in range(tries):
        try:
            cur = gh_json(f"{path}?ref={DASH_BRANCH}")
            sha, remote = cur.get("sha"), json.loads(base64.b64decode(cur.get("content") or "e30=") or b"{}")
        except RuntimeError:
            sha, remote = None, {}  # not there yet
        except ValueError:
            sha, remote = cur.get("sha"), {}
        hosts = remote.get("hosts") or ({"_legacy": remote["days"]} if remote.get("days") else {})  # pre-2026-10-18 file
        hosts[HOST_ID] = data["days"]
        out = {"repo": data.get("repo", REPO), "updated": data["updated"], "hosts": hosts,
               "days": combine_factory_days(hosts)}
        content = base64.b64encode(json.dumps(out, indent=1, sort_keys=True).encode()).decode()
        r = run(["gh", "api", "-X", "PUT", path, "-f", f"message=churn: agent factory metrics {data['updated']} ({HOST_ID})",
                 "-f", f"content={content}", "-f", f"branch={DASH_BRANCH}", *(["-f", f"sha={sha}"] if sha else [])])
        if not r.returncode:
            return True
        err = r.stderr.strip()
        if not re.search(r"\b409\b|does not match|sha", err):
            break
    log(f"factory metrics not published: {err[:200]}")
    return False


def write_scorecard_if_due(force_day: dt.date | None = None) -> bool:
    today = now().date()
    state = load_state()
    if force_day is None and state.get("last_daily_summary") == today.isoformat():
        return False
    day = force_day or today - dt.timedelta(days=1)
    try:
        c = scorecard(day, state)
        md = scorecard_md(c)
    except Exception as e:  # noqa: BLE001 -- a scorecard failure must never stop the gate
        log(f"scorecard for {day} failed: {str(e)[:200]}")
        return False
    LOG.write_text(md + (LOG.read_text() if LOG.exists() else ""))
    try:
        if c.get("factory"):
            record_factory(c)
    except Exception as e:  # noqa: BLE001 -- publishing must never stop the gate
        log(f"factory metrics for {day} failed: {str(e)[:200]}")
    if force_day is None:
        with edit_state() as st:
            st["last_daily_summary"] = today.isoformat()
    return True


