PLAN_HEADER = """PHASE 1 of 2: PLAN ONLY (you are in plan mode: read, search and query; change nothing).
Read the brief below and the issue, find the code, and write a concrete implementation plan: the class and its
same-mechanism siblings in scope, the files you will change or add, the tests (whole input class), the gates.
Orientation for free: churn generated the self-scan DB of THIS worktree at docs/self_scan/gitgalaxy_master.db
(commit = HEAD; see .claude/skills/self-scan-query). `sqlite3` it for size/complexity/importers instead of broad
greps: file_data (file_path, pagerank_score, normalized_blast_radius), function_data (func_name, calls_out_to),
edge_data (src_file_id imports dst_file_id). If a command is refused in plan mode, skip it.
END your reply with one fenced ```json block:
{"files": ["repo-relative paths you expect to modify or add"], "class": "...", "siblings_in_scope": ["..."],
 "tests": ["..."], "gates": ["..."], "risks": "...", "needs_owner": false}
churn then checks the files against the other in-flight branches and resumes you to implement.

"""


def plan_files(text: str) -> list[str]:
    blocks = re.findall(r"```json\s*(\{.*?\})\s*```", text, re.S)
    for b in reversed(blocks):
        with contextlib.suppress(Exception):
            return [str(f).strip().lstrip("./") for f in json.loads(b).get("files", []) if str(f).strip()]
    return []


def branch_files(wt: str) -> set[str]:
    """Files a churn worktree has changed vs origin/main (committed + uncommitted)."""
    out = set(run(["git", "-C", wt, "diff", "--name-only", "origin/main...HEAD"]).stdout.split())
    for line in run(["git", "-C", wt, "status", "--porcelain"]).stdout.splitlines():
        out.add(line[3:].split(" -> ")[-1].strip())
    return {f for f in out if f}


def inflight_files(me: str) -> dict[str, set[str]]:
    """{who: files} for live churn/agy workers (changed + planned files) and watched open PRs."""
    state = load_state()
    res: dict[str, set[str]] = {}
    for r in state.get("running", []):
        rid = r.get("run_id")
        if not rid or rid == me or not pid_alive(r.get("pid")):
            continue
        with contextlib.suppress(Exception):
            m = json.loads((RUNS / rid / "meta.json").read_text())
            files = branch_files(m["worktree"])
            with contextlib.suppress(Exception):
                files |= set(json.loads((RUNS / rid / "plan.json").read_text()).get("files", []))
            res[f"worker {rid}"] = files
    snap = json.loads(SNAP.read_text()) if SNAP.exists() else {}
    # #64 (2026-10-24): one files call per watched PR, every tick and every plan check, was the biggest single churn
    # consumer of the API quota; a PR's files only change with its head, so they are kept per (PR, head)
    try:
        cache = json.loads(PR_FILES_CACHE.read_text())
    except (OSError, ValueError):
        cache = {}
    keep = {}
    for n in map(pr_num, state.get("prs", [])):
        v = snap.get(str(n), {})
        if v.get("state") != "open":
            continue
        hit = cache.get(str(n)) or {}
        if v.get("head") and hit.get("head") == v["head"]:
            files = set(hit.get("files") or [])
        else:
            try:
                files = {f["filename"] for f in gh_json(f"repos/{REPO}/pulls/{n}/files?per_page=100")}
            except RuntimeError:
                continue
        res[f"PR #{n}"] = files
        keep[str(n)] = {"head": v.get("head"), "files": sorted(files)}
    with contextlib.suppress(OSError):
        PR_FILES_CACHE.write_text(json.dumps(keep))
    return res


def db_neighbours(db: Path, files: list[str]) -> dict:
    """1-hop import neighbourhood + blast stats of `files` from the worktree's self-scan DB."""
    import sqlite3
    out = {"neighbours": [], "stats": {}}
    if not db.exists() or not files:
        return out
    con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
    try:
        ids = {}
        for f in files:
            row = con.execute("SELECT id, pagerank_score, normalized_blast_radius, total_loc FROM file_data WHERE file_path = ?",
                              (f,)).fetchone()
            if row:
                ids[row[0]] = f
                out["stats"][f] = {"pagerank": row[1], "blast_radius": row[2], "loc": row[3]}
        if ids:
            q = ",".join("?" * len(ids))
            rows = con.execute(f"SELECT DISTINCT fd.file_path FROM edge_data e JOIN file_data fd ON fd.id = "
                               f"CASE WHEN e.src_file_id IN ({q}) THEN e.dst_file_id ELSE e.src_file_id END "
                               f"WHERE e.src_file_id IN ({q}) OR e.dst_file_id IN ({q})", [*ids] * 3).fetchall()
            out["neighbours"] = sorted({r[0] for r in rows} - set(files))
    finally:
        con.close()
    return out


def plan_impact(meta: dict, plan_text: str) -> dict:
    files = plan_files(plan_text)
    db = Path(meta["worktree"]) / "docs/self_scan/gitgalaxy_master.db"
    nb = db_neighbours(db, files)
    near_set = set(nb["neighbours"])
    direct, near = {}, {}
    for who, fs in inflight_files(meta["run_id"]).items():
        if d := sorted(set(files) & fs):
            direct[who] = d
        if n := sorted(near_set & fs):
            near[who] = n
    hold = {w: f for w, f in direct.items() if w.startswith("worker ")}  # two live edits of one file: the tick decides
    return {"files": files, "stats": nb["stats"], "neighbours": nb["neighbours"][:60], "direct_overlap": direct,
            "near_overlap": near, "hold": hold, "db": str(db) if db.exists() else None}


def self_scan(wt: str, rd: Path) -> bool:
    if not Path(SELFSCAN_PY).exists():
        return False
    with open(rd / "selfscan.log", "w") as fh:
        rc = subprocess.call([SELFSCAN_PY, "tests/tools/self_scan.py"], cwd=wt, stdout=fh, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, env={**os.environ, "PYTHONPATH": wt}, timeout=600)
    return rc == 0


def plan_env(**extra) -> dict:
    """Environment for a Claude run billed to the plan: any API key in the caller's environment is dropped, so a stray
    `export ANTHROPIC_API_KEY` can never move the fleet onto paid API usage."""
    return {**{k: v for k, v in os.environ.items() if k not in API_KEY_VARS}, **WORKER_ENV, **extra}


def _claude(cmd: list[str], cwd: str, env: dict, out_path: Path, err_path: Path) -> tuple[int, dict]:
    with open(out_path, "w") as out, open(err_path, "w") as err:
        rc = subprocess.call(cmd, cwd=cwd, env=env, stdin=subprocess.DEVNULL, stdout=out, stderr=err)
    try:
        return rc, json.loads(out_path.read_text())
    except Exception:
        return rc, {}


def cmd_run(a) -> int:
    """Detached body of one worker: (plan, impact check,) run claude, save its JSON, then nudge a tick."""
    rd = RUNS / a.run_id
    meta = json.loads((rd / "meta.json").read_text())
    env = plan_env(PYTHONPATH=meta["worktree"])
    # --max-budget-usd is checked against the session's total, which on a resume includes the earlier runs
    budget = float(meta.get("budget_usd") or WORKER_BUDGET[meta["model"]]) + float(meta.get("resume_base_usd") or 0)
    if meta.get("lane") == "credit":
        if not (key := credit_key(credit_cfg(load_state()))):  # removed since launch: fail as a credit-auth, requeued
            (rd / "out.json").write_text(json.dumps({"is_error": True, "result": "credit lane: invalid api key (key file missing)"}))
            (rd / "err.txt").write_text("")
            (rd / "exit").write_text(f"1\n{iso(now())}\n")
            DIRTY.touch()
            nudge_tick()
            return 0
        env["ANTHROPIC_API_KEY"] = key
    prompt = (rd / "prompt.md").read_text()
    resume = meta.get("resume_session")
    rc = 0
    try:
        if meta.get("plan"):
            meta["self_scan"] = self_scan(meta["worktree"], rd)
            pcmd = claude_cmd(PLAN_HEADER + prompt, meta["model"], round(budget * PLAN_SHARE, 2))
            pcmd[pcmd.index("auto")] = "plan"
            rc, pout = _claude(pcmd, meta["worktree"], env, rd / "plan_out.json", rd / "plan_err.txt")
            pcost, _ = run_cost(pout)
            meta["plan_cost_usd"] = round(pcost, 2)
            text = str(pout.get("result") or "")
            (rd / "plan.md").write_text(text)
            if not pout or pout.get("is_error") or not pout.get("session_id"):
                shutil.copy(rd / "plan_out.json", rd / "out.json")
                shutil.copy(rd / "plan_err.txt", rd / "err.txt")
                return 0
            impact = plan_impact(meta, text)
            (rd / "plan.json").write_text(json.dumps(impact, indent=1))
            meta["session_id"] = pout["session_id"]
            if impact["hold"]:
                (rd / "plan_held").write_text(json.dumps(impact["hold"]))
                shutil.copy(rd / "plan_out.json", rd / "out.json")
                (rd / "err.txt").write_text("")
                return 0
            resume = pout["session_id"]
            budget = max(round(pcost + 1.0, 2), budget)  # phase 2 resumes the plan session: its total includes pcost
            prompt = ("PHASE 2: churn's gate accepted your plan. Impact check from the self-scan DB and the in-flight "
                      f"branches:\n```json\n{json.dumps({k: impact[k] for k in ('stats', 'direct_overlap', 'near_overlap')}, indent=1)[:3000]}\n```\n"
                      "Overlap with an open PR means that PR will likely merge first: merge origin/main before you push "
                      "and keep your change in those files small. Now implement the plan in full, following the brief "
                      "(gates, WIP pushes, handoff note, draft PR, final report). If the plan turned out wrong, say what "
                      "changed in your report.")
        rc, _ = _claude(claude_cmd(prompt, meta["model"], budget, resume=resume), meta["worktree"], env,
                        rd / "out.json", rd / "err.txt")
    finally:
        (rd / "meta.json").write_text(json.dumps(meta, indent=2))
        (rd / "exit").write_text(f"{rc}\n{iso(now())}\n")
        DIRTY.touch()
        nudge_tick()
    return 0


# ---------------------------------------------------------------- credit lane
def credit_cfg(state: dict) -> dict:
    return {**CREDIT_DEFAULT, **{k: v for k, v in (state.get("credit") or {}).items() if k in CREDIT_DEFAULT}}


def credit_key(cfg: dict) -> str | None:
    with contextlib.suppress(OSError):
        return Path(cfg["key_file"]).expanduser().read_text().strip() or None
    return None


def credit_balance(state: dict, at: dt.datetime | None = None) -> dict:
    """The lane's own ledger: grants (`churn credit add`) minus the list-price cost of credit runs, which is what the API
    bills. Spend draws on the grants live at that moment, earliest expiry first; what a grant has left when it expires
    is lost. `churn credit sync` corrects drift against the Console's balance with an adjustment grant."""
    at = at or now()
    c = state.get("credit") or {}
    grants = sorted(({"usd": float(g.get("usd") or 0), "left": float(g.get("usd") or 0),
                      "expires": parse_iso(g.get("expires"))} for g in c.get("grants", [])),
                    key=lambda g: g["expires"] or dt.datetime.max.replace(tzinfo=dt.timezone.utc))
    spent = over = 0.0
    for e in sorted(c.get("log", []), key=lambda e: e.get("t", "")):
        cost, t = float(e.get("cost_usd") or 0), parse_iso(e.get("t")) or at
        spent += cost
        for g in grants:
            if cost <= 0:
                break
            if g["left"] > 0 and not (g["expires"] and g["expires"] <= t):
                take = min(g["left"], cost)
                g["left"] -= take
                cost -= take
        over += cost
    live = [g for g in grants if not (g["expires"] and g["expires"] <= at)]
    soon = [g for g in live if g["expires"] and g["left"] > 0]
    return {"granted": round(sum(g["usd"] for g in grants), 2), "spent": round(spent, 2),
            "expired": round(sum(g["left"] for g in grants if g not in live), 2), "over": round(over, 2),
            "balance": round(max(0.0, sum(g["left"] for g in live) - over), 2),
            "next_expiry": iso(min(g["expires"] for g in soon)) if soon else None}


def credit_ready(state: dict, plan_paused: bool) -> tuple[bool, str]:
    """Whether the credit lane may launch now, and why not (for `churn credit status`)."""
    cfg, c = credit_cfg(state), state.get("credit") or {}
    if not cfg["enabled"]:
        return False, "off (`churn credit on`)"
    if not c.get("grants"):
        return False, "no credit recorded (`churn credit add USD`)"
    if c.get("blocked"):
        return False, f"blocked: {c['blocked']} (`churn credit add` or `churn credit on` clears it)"
    if (p := parse_iso(c.get("paused_until"))) and now() < p:
        return False, f"API rate limit, paused until {iso(p)}"
    if not credit_key(cfg):
        return False, f"no API key in {cfg['key_file']}"
    bal = credit_balance(state)
    if bal["balance"] - credit_committed(state) - float(cfg["floor_usd"]) < float(cfg["min_run_usd"]):
        return False, f"balance ${bal['balance']:.2f} is below floor ${cfg['floor_usd']} + one run ${cfg['min_run_usd']}"
    live = [r for r in state.get("running", []) if r.get("lane") == "credit" and pid_alive(r.get("pid"))]
    if len(live) >= int(cfg["max_running"]):
        return False, f"{len(live)} credit worker(s) running (max_running {cfg['max_running']})"
    rush = (e := parse_iso(bal["next_expiry"])) and e - now() <= dt.timedelta(days=float(cfg["expiry_rush_days"]))
    if cfg["when"] == "paused" and not plan_paused and not rush:
        return False, "waiting for a plan limit pause (when=paused)"
    return True, "expiring credit" if rush and not plan_paused else "ready"


def credit_committed(state: dict) -> float:
    """Budget caps of the credit runs still going: not in the ledger yet, but already promised."""
    out = 0.0
    for r in state.get("running", []):
        if r.get("lane") == "credit" and r.get("run_id") and pid_alive(r.get("pid")):
            out += float(_run_meta(r["run_id"]).get("budget_usd") or 0)
    return out


def credit_pick(state: dict, snap: dict, cfg: dict) -> tuple[dict, dict] | tuple[None, None]:
    """The first queue item the credit lane can run with no model tick (direct_spec): PR fixes first, then normal and
    ci items by position. Items queued for Opus stay with the plan unless the lane itself runs Opus."""
    q = [(i, x) for i, x in enumerate(state.get("queue", [])) if not x.get("needs_owner") and x.get("backend") != "agy"
         and x.get("lane", "normal") in ("normal", "ci") and not blocked_by(x, snap, state) and not waiting(x)
         and not plan_overlap(state, x) and in_focus(state, x)
         and (x.get("model", "sonnet") != "opus" or cfg["model"] == "opus")]
    q.sort(key=lambda ix: (not ix[1].get("pr"), ix[0]))
    for _, x in q:
        if (spec := direct_spec(state, snap, x)) is not None:
            return x, spec
    return None, None


def credit_lane(b: dict, snap: dict, plan_paused: bool, dry_run: bool = False) -> list[str]:
    """Launch credit workers while credit_ready says so (one per call): same box rule as the agy lane."""
    state = load_state()
    ok, _ = credit_ready(state, plan_paused)
    if not ok or state.get("workers_paused") or b.get("verdict") != "GREEN" or b.get("free_slots", 0) < 1:
        return []
    cfg = credit_cfg(state)
    x, spec = credit_pick(state, snap, cfg)
    if x is None:
        return []
    if not x.get("pr") and len(prs_needing_work(snap, claude_slot_holders(state), state)) >= 3:
        return []  # the gate's "finish those first" hold
    budget = round(min(WORKER_BUDGET[cfg["model"]],
                       credit_balance(state)["balance"] - credit_committed(state) - float(cfg["floor_usd"])), 2)
    did = [f"credit worker for #{x['issue']} ({cfg['model']}, cap ${budget:.2f})"]
    if dry_run:
        return did
    try:
        with contextlib.redirect_stdout(open(os.devnull, "w")):
            cmd_worker(argparse.Namespace(resume_run=None, issue=x["issue"], model=cfg["model"], task=x.get("task"),
                                          brief=spec["brief"], brief_file=None, force=False, plan=spec["plan"],
                                          worktree=spec["worktree"], branch=spec.get("branch"), check_of=None,
                                          repo=spec.get("repo"), lane="credit", budget_usd=budget, queue_item=x))
    except (SystemExit, OSError, RuntimeError) as e:
        log(f"credit launch of #{x['issue']} refused, left queued: {str(e)[:200]}")
        return []
    with edit_state() as st:
        with contextlib.suppress(ValueError):
            st.get("queue", []).remove(x)
        if spec.get("held_plan"):
            st.get("held_plans", {}).pop(spec["held_plan"], None)
    return did


def credit_failure(out: dict, text: str) -> str | None:
    """A credit run that failed on billing, not on the work: the credit ran out, the key was refused, or the API's own
    rate limit. None for any other outcome (those take the normal statuses)."""
    if not out.get("is_error") and out.get("api_error_status") != 429:
        return None
    if CREDIT_OUT_RE.search(text):
        return "credit-out"
    if AUTH_RE.search(text):
        return "credit-auth"
    if out.get("api_error_status") == 429 or limit_reset(text) or re.search(r"rate.?limit|\b429\b|overloaded", text, re.I):
        return "credit-limit"
    return None


def credit_hold(state: dict, status: str, rid: str, text: str) -> None:
    """Hold only the credit lane: a billing failure never pauses the plan's workers or pages a Claude login failure."""
    c = state.setdefault("credit", {})
    if status == "credit-limit":
        reset = limit_reset(text)
        c["paused_until"] = iso(reset if reset and reset > now() else now() + dt.timedelta(hours=1))
        log(f"credit lane: API rate limit on {rid}; paused until {c['paused_until']}")
        return
    c["blocked"] = ("API credit ran out" if status == "credit-out" else "API key refused") + f" ({rid}, {iso(now())})"
    log(f"credit lane blocked: {c['blocked']}; plan workers are unaffected")
    notify("credit-lane", "churn: credit lane stopped", f"{c['blocked']}. Plan workers keep going. "
           "`churn credit add USD` after a new grant (or a new key) starts it again.", priority="low", cooldown_h=24)


# ---------------------------------------------------------------- weekly retro
def retro_cfg(state: dict) -> dict:
    return {**RETRO_DEFAULT, **{k: v for k, v in (state.get("retro") or {}).items() if k in RETRO_DEFAULT}}


def retro_due(state: dict) -> tuple[bool, str]:
    cfg, r = retro_cfg(state), state.get("retro") or {}
    if not cfg["enabled"]:
        return False, "off (`churn retro on`)"
    if not cfg["issue"]:
        return False, "no standing issue (`churn retro set issue N`)"
    if any(x.get("lane") == "retro" and pid_alive(x.get("pid")) for x in state.get("running", [])):
        return False, "a retro is running"
    if (last := parse_iso(r.get("last"))) and now() - last < dt.timedelta(days=float(cfg["every_days"])):
        return False, f"next after {iso(last + dt.timedelta(days=float(cfg['every_days'])))}"
    return True, "due"


SCORECARD_HEAD = re.compile(r"^# Scorecard (\d{4}-\d\d-\d\d)")


def retro_data(state: dict, since: dt.datetime, runs_dir: Path | None = None, log_text: str | None = None,
               inbox: Path | None = None) -> dict:
    """The week's facts for the retro worker, from churn's own files (no model, no GitHub)."""
    statuses: dict[str, int] = {}
    kinds: dict[str, int] = {}
    denied: dict[str, dict] = {}
    send_backs, budget_hits = [], []
    cost = 0.0
    for m in sorted((runs_dir or RUNS).glob("*/meta.json")):
        try:
            meta = json.loads(m.read_text())
        except (OSError, ValueError):
            continue
        if not (t := parse_iso(meta.get("started"))) or t < since or meta.get("lane") == "retro":
            continue
        st = "agy-" + str(meta.get("status", "?")) if meta.get("backend") == "agy" else str(meta.get("status", "running"))
        statuses[st] = statuses.get(st, 0) + 1
        kind = run_kind(meta, runs_dir)
        kinds[kind] = kinds.get(kind, 0) + 1
        cost += float(meta.get("cost_usd") or 0)
        if st == "budget":
            budget_hits.append({"run": meta.get("run_id"), "issue": meta.get("issue"), "usd": meta.get("cost_usd"),
                                "task": str(meta.get("task") or "")[:160]})
        if kind == "send_back" and (m.parent / "prompt.md").exists():
            send_backs.append({"run": meta.get("run_id"), "issue": meta.get("issue"),
                               "message": (m.parent / "prompt.md").read_text()[:400]})
        with contextlib.suppress(OSError, ValueError):
            for d in json.loads((m.parent / "out.json").read_text()).get("permission_denials") or []:
                e = denied.setdefault(str(d.get("tool_name")), {"n": 0, "examples": []})
                e["n"] += 1
                if len(e["examples"]) < 3:
                    e["examples"].append(json.dumps(d.get("tool_input"))[:200])
    text = log_text if log_text is not None else (LOG.read_text() if LOG.exists() else "")
    cards: dict[str, list[str]] = {}
    day = None
    for line in text.splitlines():
        if mh := SCORECARD_HEAD.match(line):
            day = mh.group(1) if mh.group(1) >= str((since - dt.timedelta(days=7)).date()) and mh.group(1) not in cards else None
            if day:
                cards[day] = []
        elif day and line.startswith("- "):
            cards[day].append(line[2:])
        else:
            day = None
    inbox = inbox or H / "lessons-inbox.md"
    lessons = [x for x in (inbox.read_text().splitlines() if inbox.exists() else []) if x.startswith("- [ ]")]
    return {"since": iso(since), "until": iso(now()), "runs": sum(statuses.values()), "cost_usd": round(cost, 2),
            "statuses": statuses, "kinds": kinds, "budget_hits": budget_hits, "send_backs": send_backs[-25:],
            "denials": dict(sorted(denied.items(), key=lambda kv: -kv[1]["n"])), "scorecards": dict(sorted(cards.items())),
            "unticked_lessons": lessons}


def retro_lane(b: dict, snap: dict, dry_run: bool = False) -> list[str]:
    """Launch the weekly retro as a normal plan worker (it takes a slot) when it is due and a slot is free."""
    if not host_role("retro"):
        return []
    state = load_state()
    ok, _ = retro_due(state)
    if not ok or state.get("workers_paused") or b.get("verdict") != "GREEN":
        return []
    if worker_slots(b, len(claude_slot_holders(state)), slot_ceiling(state, rate_plan(state))) <= 0:
        return []
    cfg, r = retro_cfg(state), state.get("retro") or {}
    n = int(r.get("count", 0)) + 1
    deep = n % int(cfg["deep_every"]) == 0
    did = [f"weekly retro #{n} ({cfg['model']}, cap ${cfg['budget_usd']}{', deep audit' if deep else ''})"]
    if dry_run:
        return did
    day = now().strftime("%Y-%m-%d")
    data = H / "retro" / f"retro-{day}.json"
    data.parent.mkdir(parents=True, exist_ok=True)
    data.write_text(json.dumps(retro_data(state, now() - dt.timedelta(days=float(cfg["every_days"]))), indent=1))
    brief = RETRO_BRIEF.format(day=day, issue=cfg["issue"], deep_tag=", deep audit" if deep else "", data=data,
                               inbox=H / "lessons-inbox.md", proposals=EXP_PROPOSALS,
                               sizes=", ".join(f"{k}: {v}" for k, v in cfg["size_budget_kb"].items()) or "none set",
                               deep=RETRO_DEEP.format(n=cfg["deep_every"]) if deep else "",
                               template=worker_brief_template() or "")
    try:
        with contextlib.redirect_stdout(open(os.devnull, "w")):
            cmd_worker(argparse.Namespace(resume_run=None, issue=int(cfg["issue"]), model=cfg["model"],
                                          task=f"weekly retro {day}", brief=brief, brief_file=None, force=False,
                                          plan=False, worktree=None, branch=None, check_of=None, repo=None,
                                          lane="retro", budget_usd=float(cfg["budget_usd"])))
    except (SystemExit, OSError, RuntimeError) as e:
        log(f"weekly retro launch refused: {str(e)[:200]}")
        return []
    with edit_state() as st:
        st.setdefault("retro", {}).update(last=iso(now()), count=n)
    return did


