def cmd_followup(a) -> int:
    with edit_state() as st:
        f = next((f for f in st.get("followups", []) if f["pr"] == a.number), None)
        if f is None:
            raise SystemExit(f"no followup for #{a.number}")
        st["followups"] = [g for g in st["followups"] if g is not f]
