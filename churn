    sub.add_parser("skills", help="pull the private repo and link its skills into ~/.claude/skills (missing/identical only)")
    r = sub.add_parser("_run")
    r.add_argument("run_id")
    pc = sub.add_parser("_precheck")
    pc.add_argument("run_id")
    ra = sub.add_parser("_agyrun")
    ra.add_argument("run_id")
    argv = sys.argv[1:]
    if argv[:2] == ["agy", "result"]:  # `churn agy result ...` (agy alone starts a worker)
        argv = ["agy-result", *argv[2:]]
    a = ap.parse_args(argv)
    if a.cmd == "tick":
        if a.reason and not a.force:
            a.reason = []
        return cmd_tick(a) if a.dry_run else guarded_tick(lambda: cmd_tick(a))
    if a.cmd == "worker":
        if a.issue is None:
            ap.error("worker needs --issue")
        a.resume_run = None
        return cmd_worker(a)
    if a.cmd == "send-back":
        prev = json.loads((RUNS / a.run_id / "meta.json").read_text())
        if not prev.get("session_id"):
            raise SystemExit(f"{a.run_id} has no session id (not reaped yet, or it crashed)")
        fin = parse_iso(prev.get("finished"))
        if fin and now() - fin > dt.timedelta(hours=1) and not a.force:
            raise SystemExit(f"{a.run_id} finished {iso(fin)}, over 1 h ago: its prompt cache is gone and a resume re-bills "
                             "the whole context (#4767). Start a fresh `churn worker` from its handoff note instead "
                             "(--force to resume anyway).")
        ns = argparse.Namespace(resume_run=a.run_id, message=a.message, force=False, plan=False)
        return cmd_worker(ns)
    if a.cmd == "status":
        return cmd_status(a)
    if a.cmd == "goal":
        return cmd_goal(a)
    if a.cmd == "queue":
        return cmd_queue(a)
    if a.cmd == "_run":
        return cmd_run(a)
    if a.cmd == "_precheck":
        return cmd_precheck(a)
    if a.cmd == "_agyrun":
        return cmd_agyrun(a)
    if a.cmd == "agy":
        return cmd_agy(a)
    if a.cmd == "pr":
        return cmd_pr(a)
    if a.cmd == "followup":
        return cmd_followup(a)
    if a.cmd == "review":
        return cmd_review(a)
    if a.cmd == "agy-result":
        return cmd_agy_result(a)
    if a.cmd == "state":
        return cmd_state(a)
    if a.cmd == "config":
        return cmd_config(a)
    if a.cmd == "worktrees":
        return cmd_worktrees(a)
    if a.cmd == "notify":
        return cmd_notify(a)
    if a.cmd == "credit":
        return cmd_credit(a)
    if a.cmd == "retro":
        return cmd_retro(a)
    if a.cmd == "poll":
        return cmd_poll(a)
    if a.cmd == "sync":
        note = run_sync_pulse(force=True)
        print(note or f"promoter-bot is on origin/main ({(load_state().get('sync') or {}).get('head', '?')})")
        if note:
            log(note)
        return 0
    if a.cmd == "skills":
        note = skills_note()
        print(note or "skills: all linked to the private repo (or no private checkout; see `churn status`)")
        if note:
            log(note)
        return 0
    if a.cmd == "watchdog":
        return cmd_watchdog(a)
    if a.cmd == "factory":
        return cmd_factory(a)
    if a.cmd == "refill":
        return cmd_refill(a)
    if a.cmd == "claims":
        return cmd_claims(a)
    if a.cmd == "scorecard":
        return cmd_scorecard(a)
    if a.cmd == "checklist":
        return cmd_checklist(a)
    return 2


if __name__ == "__main__":
    sys.exit(main())
