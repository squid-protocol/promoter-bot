AGY_CONV = Path.home() / ".gemini/antigravity-cli/conversations"


def agy_denied_call(rd: Path) -> str:
    """The tool + last command agy tried before a headless soft-denial (its log names only the tool; the command is
    in the conversation DB). Best effort: '' when it can't be found."""
    import sqlite3
    log_text = (rd / "agy.log").read_text(errors="ignore") if (rd / "agy.log").exists() else ""
    tool = (re.findall(r'soft-denying tool confirmation "(\w+)"', log_text) or [""])[-1]
    conv = (re.findall(r"conversation ([0-9a-f-]{36}) step", log_text) or [""])[-1]
    db = AGY_CONV / f"{conv}.db"
    if not tool or not conv or not db.exists():
        return tool
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        blob = []
        for (t,) in con.execute("SELECT name FROM sqlite_master WHERE type='table'"):
            for row in con.execute(f'SELECT * FROM "{t}"'):
                blob += [v.decode("utf-8", "ignore") if isinstance(v, bytes) else v for v in row if isinstance(v, (bytes, str))]
        con.close()
    except sqlite3.Error:
        return tool
    text = "\n".join(blob)
    pat = (r'"Url"\s*:\s*"(https?://[^"]{4,300})"' if tool == "ReadUrlContent" else
           r'(?:CommandLine|commandLine|command_line)"?\s*[:=]\s*"((?:[^"\\]|\\.){1,300})"')
    hits = re.findall(pat, text)
    return f"{tool}: {hits[-1][:300]}" if hits else tool


def reap_agy(state: dict, r: dict) -> dict:
    rid = r["run_id"]
    rd = RUNS / rid
    meta = json.loads((rd / "meta.json").read_text())
