def gh_is_write(cmd: list[str]) -> bool:
    """A content-creating (or changing) GitHub call: what the secondary limits count (#64, owner 2026-10-24)."""
    if len(cmd) < 2:
        return False
    if cmd[1] == "api":
        if "graphql" in cmd[:3]:
            return any("mutation" in c for c in cmd)
        for i, c in enumerate(cmd):
            if c in ("-X", "--method") and i + 1 < len(cmd):
                return cmd[i + 1].upper() != "GET"
        return any(c in ("-f", "-F", "--field", "--raw-field", "--input") for c in cmd)
    return (cmd[1], cmd[2] if len(cmd) > 2 else "") in GH_WRITE_SUBCOMMANDS


def gh_quota() -> dict | None:
    """The core and GraphQL quota now (one free call), or None when unreadable."""
    try:
        r = subprocess.run(["gh", "api", "rate_limit"], capture_output=True, text=True, timeout=30)
        res = json.loads(r.stdout).get("resources") or {}
    except (OSError, ValueError, subprocess.TimeoutExpired):
        return None
    core, gq = res.get("core") or {}, res.get("graphql") or {}
    if "remaining" not in core:
        return None
    return {"remaining": int(core["remaining"]), "limit": int(core.get("limit", 5000)), "used": int(core.get("used", 0)),
            "reset": int(core.get("reset", 0)), "graphql_remaining": gq.get("remaining")}


def quota_cfg(state: dict) -> dict:
    return {**QUOTA_DEFAULT, **{k: v for k, v in (state.get("quota") or {}).items() if k in QUOTA_DEFAULT}}


def quota_mode(q: dict | None, burn_h: float | None, cfg: dict, at: float | None = None) -> str:
    """ok / lean / hold for a quota reading (see QUOTA_DEFAULT)."""
    if not q:
        return "ok"  # unreadable: never stop on a missing reading
    if q["remaining"] < cfg["reserve"]:
        return "hold"
    left_min = max(0.0, (q["reset"] - (at if at is not None else time.time())) / 60)
    projected = q["remaining"] - (burn_h or 0) * left_min / 60
    if q["remaining"] < cfg["optional_reserve"] or projected < cfg["reserve"]:
        return "lean"
    return "ok"


def quota_tick(state: dict) -> dict | None:
    """Read the quota, work out the burn since the last reading (same reset window), log it, set QUOTA_MODE, and page
    the owner once when it is exhausted. Returns the reading (with burn_h and mode)."""
    global QUOTA_MODE
    q = gh_quota()
    if q is None:
        QUOTA_MODE = "ok"
        return None
    prev = state.get("gh_quota") or {}
    t = time.time()
    burn = None
    if prev.get("reset") == q["reset"] and prev.get("ts") and t - prev["ts"] > 30:
        burn = round(max(0, q["used"] - prev["used"]) / (t - prev["ts"]) * 3600)
    mine = 0
    with contextlib.suppress(OSError):
        since = iso(dt.datetime.fromtimestamp(prev.get("ts") or t - 600, dt.timezone.utc))
        mine = sum(1 for line in GH_CALLS.read_text().splitlines() if line[:17] >= since)
    QUOTA_MODE = quota_mode(q, burn, quota_cfg(state), t)
    reading = {**q, "ts": t, "t": iso(now()), "burn_h": burn, "churn_calls": mine, "mode": QUOTA_MODE}
    with contextlib.suppress(OSError):
        with open(GH_QUOTA_LOG, "a") as fh:
            fh.write(json.dumps(reading, sort_keys=True) + "\n")
    if q["remaining"] == 0:
        notify("gh-quota-out", "churn: GitHub API quota exhausted",
               f"0 of {q['limit']} left until {iso(dt.datetime.fromtimestamp(q['reset'], dt.timezone.utc))}; the shepherd "
               "(merge bot) shares it and cannot merge until then.", priority="high", cooldown_h=3, tags="no_entry")
    return reading


def gh_json_etag(path: str) -> object:
    """gh_json with a conditional request: the cached ETag goes out as If-None-Match, and an unchanged resource answers
    304, which does not count against the quota (#64). Falls back to a plain read when the cache is unusable."""
    import hashlib
    ETAG_CACHE.mkdir(parents=True, exist_ok=True)
    f = ETAG_CACHE / (hashlib.sha1(path.encode()).hexdigest()[:20] + ".json")
    try:
        cached = json.loads(f.read_text())
    except (OSError, ValueError):
        cached = {}
    cmd = ["gh", "api", "-i", *(["-H", f"If-None-Match: {cached['etag']}"] if cached.get("etag") else []), path]
    r = run(cmd, timeout=60)
    head, _, body = r.stdout.replace("\r\n", "\n").partition("\n\n")
    status = head.split("\n", 1)[0]
    if " 304" in status and "body" in cached:
        return cached["body"]
    if r.returncode or " 200" not in status:
        return gh_json(path)
    data = json.loads(body)
    etag = next((ln.split(":", 1)[1].strip() for ln in head.split("\n") if ln.lower().startswith("etag:")), None)
    with contextlib.suppress(OSError):
        f.write_text(json.dumps({"etag": etag, "body": data}))
    return data


def run(cmd: list[str], **kw) -> subprocess.CompletedProcess:
    if cmd and cmd[0] == "gh" and "rate_limit" not in cmd:  # #64: attribute the shared 5,000/h quota (free reads left out)
        with contextlib.suppress(Exception):
            frame, callers = sys._getframe(1), []
            while frame and len(callers) < 3:
                if frame.f_code.co_name not in ("run", "gh_json", "gh_label", "<lambda>"):
                    callers.append(frame.f_code.co_name)
                frame = frame.f_back
            kind = "graphql" if "graphql" in cmd[:3] else cmd[1] if len(cmd) > 1 else "?"
            ep = next((c for c in cmd[2:] if c.startswith(("repos/", "orgs/", "search/", "/"))), "")
            with open(GH_CALLS, "a") as fh:
                fh.write(f"{iso(now())}\t{'>'.join(callers)}\t{kind}\t{re.sub(r'[0-9]+', 'N', ep.split('?')[0])[:70]}"
                         f"\t{'w' if gh_is_write(cmd) else 'r'}\n")
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def pr_num(p) -> int:
    """state["prs"] holds ints or dicts ({"number": n, ...}, written by ticks since 2026-10-12;
    a tick on 2026-10-13 wrote {"pr": n, ...}, which crashed every gate run for 6 h)."""
    if isinstance(p, dict):
        return int(p["number"] if "number" in p else p["pr"])
    return int(p)


def gh_json(path: str):
    r = run(["gh", "api", path])
    if r.returncode != 0:
        raise RuntimeError(f"gh api {path}: {r.stderr.strip()[:200]}")
    return json.loads(r.stdout)


def worktree_pr(wt: str, issue: int | None = None) -> tuple[str, int | None]:
    """(the worktree's current branch, the open PR that already holds its work, or None). #5237/#5251: a worker cut
    off by a limit had pushed and opened a draft on a renamed branch; the resumed worker was told "nothing pushed yet",
    rebased, could not force-push, and opened a second PR. A PR matches when its head IS this branch, or when it is
    a churn/<issue>- branch whose head commit is already in this worktree's history (it was pushed from here)."""
    branch = run(["git", "-C", wt, "branch", "--show-current"]).stdout.strip()
    try:
        prs = gh_json(f"repos/{REPO}/pulls?state=open&per_page=100")
    except (RuntimeError, ValueError):
        return branch, None
    for p in prs:
        if branch and p["head"]["ref"] == branch:
            return branch, p["number"]
    for p in prs:
        if issue is not None and p["head"]["ref"].startswith(f"churn/{issue}-") and run(
                ["git", "-C", wt, "merge-base", "--is-ancestor", p["head"]["sha"], "HEAD"]).returncode == 0:
            return branch, p["number"]
    return branch, None


SMALL_CODE_LINES = 30  # own non-test lines since the reviewed head that a Sonnet re-review may judge
TEST_OR_DATA = re.compile(r"(^|/)(test_[^/]*\.py|conftest\.py)$|^\.test_durations$|baseline[^/]*\.json$|^docs/")


def own_commits(wt: str, start: str | None) -> bool | None:
    """Did the run commit anything of its own since `start` (non-merge commits not on origin/main)? None = unknown.
    #20: fix runs that only merged origin/main counted toward the Opus rescue like real fixes."""
    if not start or run(["git", "-C", wt, "cat-file", "-e", f"{start}^{{commit}}"]).returncode:
        return None
    r = run(["git", "-C", wt, "log", "--no-merges", "--format=%H", "HEAD", f"^{start}", "^origin/main"])
    return None if r.returncode else bool(r.stdout.strip())


def small_delta(wt: str, reviewed_head: str) -> str | None:
    """Why the PR's own change since `reviewed_head` is small enough for a Sonnet re-review, or None (Opus). Own change =
    non-merge commits since that head that are not on origin/main, so a merge of main counts for nothing. 2026-10-16:
    297 of 333 Opus ticks were reviews, many of them a re-approval after a merge of main or a one-line test fix."""
    if not reviewed_head or run(["git", "-C", wt, "cat-file", "-e", f"{reviewed_head}^{{commit}}"]).returncode:
        return None
    r = run(["git", "-C", wt, "log", "--no-merges", "--numstat", "--format=", "HEAD", f"^{reviewed_head}", "^origin/main"])
    if r.returncode:
        return None
    code = other = 0
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 3:
            continue
        n = sum(int(x) for x in parts[:2] if x.isdigit())
        if TEST_OR_DATA.search(parts[2]):
            other += n
        else:
            code += n
    if code <= SMALL_CODE_LINES:
        return f"small delta since reviewed head {reviewed_head[:8]}: {code} code + {other} test/data lines"
    return None


PRECHECK_FUSE_MIN = 45  # a check still pending after this no longer holds the review


def precheck_holds(e: dict) -> bool:
    t = parse_iso(e.get("precheck_at"))
    return e.get("precheck") == "pending" and bool(t) and now() - t < dt.timedelta(minutes=PRECHECK_FUSE_MIN)


def start_precheck(rid: str) -> None:
    """Spawn the model-free pre-review check of a finished run (`churn _precheck`)."""
    spawn_detached(f"churn-precheck-{rid}", [sys.executable, SELF, "_precheck", rid], TICK_CWD, RUNS / rid / "precheck.log")


# promoter-bot-private#2 (owner ruling 2026-10-19, GitGalaxy is an LLC): projects with an unclear license or provenance
# are internal only, never named in committed files or public PRs. A hand-made grep list missed prose mentions and five
# lines survived a cleanup PR (2026-10-20). The list lives in the private repo, since it names them; a hit is reported
# by file:line only, and the matched name goes to the run's local precheck.log, never to GitHub-visible text.
def internal_names(path: Path | None = None) -> list[str]:
    p = path or Path(_CFG.get("internal_names", str(PRIVATE_DIR / "policy" / "internal-only-names.txt")))
    try:
        lines = p.read_text().splitlines()
    except OSError:
        return []
    return [s for x in lines if (s := x.strip()) and not s.startswith("#")]


def internal_name_re(names: list[str]) -> re.Pattern | None:
    """Case-insensitive; `-`, `_` and word characters on either side make it another name: listing `foo-doom` leaves
    a public `foo-doom-cc` alone."""
    if not names:
        return None
    alt = "|".join(re.escape(n) for n in sorted(set(names), key=len, reverse=True))
    return re.compile(rf"(?<![\w-])(?:{alt})(?![\w-])", re.IGNORECASE)


def added_lines(diff: str) -> list[tuple[str, int, str]]:
    """(file, new line number, text) of each added line in a `git diff -U0` output."""
    out, f, n = [], None, 0
    for ln in diff.splitlines():
        if ln.startswith("+++ "):
            f = ln[6:] if ln.startswith("+++ b/") else None
        elif ln.startswith("@@") and (m := re.match(r"@@ -\S+ \+(\d+)", ln)):
            n = int(m.group(1))
        elif ln.startswith("+") and f:
            out.append((f, n, ln[1:]))
            n += 1
    return out


def internal_name_problems(diff: str, body: str, names: list[str]) -> tuple[list[str], list[str]]:
    """(problems without the names, local-only detail lines with them) for a PR's added lines and its body."""
    rx = internal_name_re(names)
    if not rx:
        return [], []
    hits = [(f"{f}:{n}", m.group(0)) for f, n, t in added_lines(diff) for m in [rx.search(t)] if m]
    in_body = [(f"PR body line {k}", m.group(0)) for k, t in enumerate(body.splitlines(), 1) for m in [rx.search(t)] if m]
    out = []
    if hits:
        out.append(f"adds an internal-only project name (promoter-bot-private policy list) at "
                   f"{', '.join(w for w, _ in hits[:10])}{f' and {len(hits) - 10} more' if len(hits) > 10 else ''}: "
                   "describe the shape generically (own fixtures for engine bugs); never quote the name in the PR body, "
                   "comments, commit messages or the report")
    if in_body:
        out.append(f"the PR body names an internal-only project ({', '.join(w for w, _ in in_body[:5])}): edit it to "
                   "describe the shape generically")
    return out, [f"{w}: {name}" for w, name in hits + in_body]


NO_CLASS_TABLE = "the PR body is missing or has no class table / Sibling gaps (gitgalaxy-pr-worker.md): write it"
# The night-shift 5-file rule (owner 2026-10-17; re-measured 2026-10-26: send-backs 24% at 3-4 hand-written files, 50% at
# 5, 62% at 6-7, and 52 of 64 PRs over 5 stated no exception). Regenerated files don't count: goldens, baselines,
# ledgers, evidence / coverage records, generated docs, lock / pin files, data. 0 turns the check off.
FILE_CAP = int(_CFG.get("file_cap", 5))
REGENERATED_RE = re.compile(r"golden_master|refraction_snapshot|scan_output|/evidence/|evidence_report|det_sweep_coverage"
                            r"|provenance|ledger|baseline|_scores|survivors|infeasible_outcomes|register/|\.lock$"
                            r"|(^|/)pins?\.|\.test_durations$|\.(json|jsonl|txt|csv|dat|snap|svg)(\.gz)?$")
# (\.gz)? (2026-10-27): DOOM-rosetta re-blesses write tests/golden_doom_rosetta/<port>.json.gz; read as hand-written,
# they sent pure re-bless PRs back over the 5-file rule (#6751 with 7, #6799 with 6: ~1.5 h of worker re-runs)
FILE_CAP_EXCEPTION = re.compile(r"(?im)^[*_ ]*File-cap exception[*_ ]*:\s*\S")


def hand_written(files: list[str]) -> list[str]:
    """The files a PR's 5-file rule counts: everything but the regenerated ones."""
    return [f for f in files if not REGENERATED_RE.search(f)]


def body_has_class_section(body: str) -> bool:
    return len(body.strip()) >= 150 and bool(re.search(r"(?i)\bclass\b|sibling", body))


_SECTION_HEAD = re.compile(r"(?i)^\s*(?:\*\*|#+\s+)(?:the\s+)?(?:class|sibling gaps)\b")


def report_class_sections(report: str) -> str:
    """The worker's own **Class** / **Sibling gaps** paragraphs from its report.md, as written. A header with text
    after it ("**Sibling gaps:** none beyond ...") is one paragraph; a bare header, or one ending in ":", heads the
    list or paragraph that follows. Each block ends at the next blank line after its content."""
    lines, out, i = report.splitlines(), [], 0
    while i < len(lines):
        if not _SECTION_HEAD.match(lines[i]):
            i += 1
            continue
        head = lines[i]
        tail = re.sub(r"^\s*(?:\*\*|#+\s+)[^*:.]*(?:\*\*)?[:.]?", "", head).strip().strip("*").strip()
        block, i = [head], i + 1
        if not tail or head.rstrip().endswith(":"):
            while i < len(lines) and not lines[i].strip():
                i += 1
            while i < len(lines) and lines[i].strip() and not _SECTION_HEAD.match(lines[i]):
                block.append(lines[i])
                i += 1
        else:
            while i < len(lines) and lines[i].strip() and not _SECTION_HEAD.match(lines[i]):
                block.append(lines[i])
                i += 1
        out.append("\n".join(block))
    return "\n\n".join(out)


def body_with_report_sections(body: str, report: str) -> str | None:
    """2026-10-23: 25 of a day's 41 precheck send-backs were only the PR body's missing class / Sibling gaps, which
    the worker had already written in its report. The body with those paragraphs appended (labelled as copied), or
    None when the report has none or the result still fails the check."""
    sec = report_class_sections(report)
    if not sec:
        return None
    new = (body.rstrip() + "\n\n" if body.strip() else "") + ("## Class / Sibling gaps\n\n_Copied from the worker's "
                                                               "report by promoter-bot's precheck._\n\n" + sec + "\n")
    return new if body_has_class_section(new) else None


def fill_class_section(meta: dict, body: str, report: str, names: list[str] | None = None) -> bool:
    """Write body_with_report_sections() to the PR; False (the send-back stands) when there is nothing to copy, the
    copy names an internal-only project, or the edit fails."""
    new = body_with_report_sections(body, report)
    if not new or not meta.get("pr"):
        return False
    if internal_name_problems("", new, internal_names() if names is None else names)[0]:
        return False
    r = run(["gh", "api", "-X", "PATCH", f"repos/{REPO}/pulls/{meta['pr']}", "--input", "-"], input=json.dumps({"body": new}))
    return r.returncode == 0


def precheck_problems(meta: dict, body: str, gates=None) -> list[str]:
    """The mechanical problems a reviewer would otherwise send back (2026-10-16: about half of 22 send-backs were
    these): conflicts with main, a workflow edited without an allow_workflows item, a PR body without its class table,
    more hand-written files than FILE_CAP with no stated exception (2026-10-26), red fast gates. Each is checked in the run's worktree with git and pr_gates; no model."""
    wt, out = meta["worktree"], []
    run(["git", "-C", wt, "fetch", "-q", "origin", "main"], timeout=300)
    mt = run(["git", "-C", wt, "merge-tree", "--write-tree", "--name-only", "origin/main", "HEAD"], timeout=300)
    if mt.returncode == 1:
        files = [x for x in mt.stdout.splitlines()[1:] if x.strip() and not x.startswith(("Auto-merging", "CONFLICT"))]
        out.append("conflicts with main in " + ", ".join(files[:8]) + ": `git merge origin/main` (never rebase), resolve, "
                   "regenerate generated files with their tools")
    aw = meta.get("allow_workflows")
    if aw is False or aw == "standing":
        wf = run(["git", "-C", wt, "diff", "--name-only", "origin/main...HEAD", "--", ".github/workflows"]).stdout.split()
        if aw == "standing":  # the standing grant stops short of the shepherd's own workflows
            wf = [f for f in wf if SHEPHERD_WORKFLOWS.match(f)]
        if wf:
            out.append(f"edits {', '.join(wf)} but the queue item has no allow_workflows: drop the workflow change "
                       "(night-shift Never rule) or say in the report that it needs the owner")
    if not body_has_class_section(body):
        out.append(NO_CLASS_TABLE)
    if FILE_CAP and not FILE_CAP_EXCEPTION.search(body):
        changed = run(["git", "-C", wt, "diff", "--name-only", "origin/main...HEAD"], timeout=300).stdout.split()
        if len(hand := hand_written(changed)) > FILE_CAP:
            out.append(f"touches {len(hand)} hand-written files, over the {FILE_CAP}-file rule ({', '.join(hand[:10])}"
                       f"{', ...' if len(hand) > 10 else ''}): keep the first self-contained slice of {FILE_CAP} or fewer "
                       "and list the rest under Remaining slices, or, for an atomic rename or a mechanical one-line "
                       "change, add a line `File-cap exception: <why>` to the PR body")
    if names := internal_names():
        diff = run(["git", "-C", wt, "diff", "-U0", "--no-color", "--no-ext-diff", "origin/main...HEAD"], timeout=300).stdout
        probs, detail = internal_name_problems(diff, body, names)
        out += probs
        for x in detail:  # precheck.log on this host only; the problems above stay name-free
            print(f"internal-only name: {x}")
    g = (gates or (lambda: run([str(Path(wt) / "tests/tools/box/heavy-run.sh"), sys.executable, "tests/tools/pr_gates.py",
                                "--fast"], cwd=wt, timeout=1800)))()
    if g.returncode:
        fails = [x for x in (g.stdout + g.stderr).splitlines() if x.startswith("FAIL")]
        out.append("pr_gates --fast is red: " + ("; ".join(fails[:6]) or (g.stdout + g.stderr)[-400:].strip()))
    return out


def pr_allows_workflows(state: dict, pr) -> bool:
    """2026-10-16: the owner approved #5228's workflow edit, a worker then pushed one more line, and the precheck --
    which read allow_workflows only from the run -- sent it back and the tick re-held it for the owner. The owner's OK
    is now recorded on the PR (`churn pr allow-workflows N`) and holds for every later head and run."""
    return bool(pr) and any(isinstance(p, dict) and pr_num(p) == int(pr) and p.get("allow_workflows")
                            for p in state.get("prs", []))


def precheck_grants(st: dict, meta: dict) -> dict:
    """The run's meta with the workflow grants the precheck honours: the PR's OK, else the standing policy."""
    if pr_allows_workflows(st, meta.get("pr")):
        return {**meta, "allow_workflows": True}
    if not meta.get("allow_workflows") and standing_workflows(st):
        return {**meta, "allow_workflows": "standing"}
    return meta


# 2026-10-28: 46 precheck send-back runs on nyx over 10-26..28 (~$1.36 each), about 3 a day for the 5-file rule alone:
# the worker opened the PR, the gate's precheck found it over the cap, and a second run split it. The worker now runs
# the same check before `gh pr create`.
SELFCHECK_NOTE = ("\n\nBefore `gh pr create`: write the PR body to a file and run `churn selfcheck --body <file>` in your "
                  "worktree. It is the gate's pre-review check (conflicts with main, workflow grant, class section, the "
                  "5-file rule) without the slow gates. Fix everything it lists first (over the cap: keep the first "
                  "slice of 5 or fewer hand-written files and list the rest under Remaining slices), then open the PR "
                  "with `--body-file <file>`. A PR it would fail costs a send-back run.\n")


def run_for_worktree(wt: str) -> dict:
    """The newest churn run whose worktree is wt (a worker's own run, for its grants), or {}."""
    want = os.path.realpath(wt)
    metas = [m for d in RUNS.glob("*-*") if (m := _run_meta(d.name))
             and m.get("worktree") and os.path.realpath(m["worktree"]) == want]
    return max(metas, key=lambda m: str(m.get("started") or ""), default={})


def cmd_selfcheck(a) -> int:
    """`churn selfcheck [--body FILE] [--gates]`: the precheck's problems for the worktree in the current directory,
    before a PR exists. Read-only: no state, no send-back. Exit 1 when it finds any."""
    top = run(["git", "rev-parse", "--show-toplevel"], cwd=os.getcwd()).stdout.strip() or os.getcwd()
    meta = precheck_grants(load_state(), {"allow_workflows": False, **run_for_worktree(top), "worktree": top})
    body = Path(a.body).read_text(errors="replace") if a.body else ""
    ok = subprocess.CompletedProcess([], 0, "", "")
    problems = precheck_problems(meta, body, gates=None if a.gates else (lambda: ok))
    if not a.body:
        problems = [p for p in problems if p != NO_CLASS_TABLE]
    for p in problems:
        print(f"- {p}")
    print(f"selfcheck: {len(problems)} problem(s)" + ("" if a.gates else " (pr_gates not run: --gates to include)"))
    return 1 if problems else 0


def cmd_precheck(a) -> int:
    rd = RUNS / a.run_id
    meta = json.loads((rd / "meta.json").read_text())
    try:
        body = str(gh_json(f"repos/{REPO}/pulls/{meta['pr']}").get("body") or "")
        meta = precheck_grants(load_state(), meta)
        problems = precheck_problems(meta, body)
    except (RuntimeError, subprocess.TimeoutExpired, OSError, KeyError) as e:
        problems, err = [], f"precheck could not run: {e}"[:300]
    else:
        err = ""
    filled = False
    if NO_CLASS_TABLE in problems:  # the worker wrote it in its report: copy it over instead of a send-back run
        try:
            filled = fill_class_section(meta, body, (rd / "report.md").read_text(errors="replace"))
        except OSError:
            filled = False
        if filled:
            problems = [x for x in problems if x != NO_CLASS_TABLE]
            log(f"precheck {a.run_id} (PR #{meta['pr']}): PR body's class / Sibling gaps copied from the worker's report")
    (rd / "precheck.json").write_text(json.dumps({"at": iso(now()), "problems": problems, "error": err,
                                                  **({"filled": "class / Sibling gaps from report.md"} if filled else {})},
                                                 indent=1))
    retry = bool(problems) and not meta.get("precheck_of")  # one automatic send-back per run chain, never a loop
    with edit_state() as state:
        for e in state.get("reports_pending", []):
            if e.get("run_id") == a.run_id:
                e["precheck"] = "sent-back" if retry else ("fail" if problems else "pass")
                if problems:
                    e["precheck_problems"] = " | ".join(problems)[:900]
    if retry:
        msg = ("The gate's automatic pre-review check (no reviewer has looked yet) found:\n- " + "\n- ".join(problems)
               + "\nFix exactly these, rerun `tests/tools/box/heavy-run.sh python tests/tools/pr_gates.py --fast`, push to "
               "the PR's branch (merge, never rebase), update the PR body if flagged, and give your final report again.")
        try:  # 2026-10-16 audit: the report used to be dropped BEFORE this launch, so a refused launch lost the run
            cmd_worker(argparse.Namespace(resume_run=a.run_id, message=msg, force=True, plan=False, precheck_of=a.run_id))
        except (SystemExit, OSError, RuntimeError, ValueError) as ex:
            with edit_state() as state:
                for e in state.get("reports_pending", []):
                    if e.get("run_id") == a.run_id:
                        e["precheck"] = "fail"
                        e["precheck_problems"] = (f"auto send-back could not launch ({str(ex)[:120]}); "
                                                  + " | ".join(problems))[:900]
            log(f"precheck {a.run_id} (PR #{meta['pr']}): send-back launch failed ({str(ex)[:120]}); left for the review")
            nudge_tick()
            return 0
        with edit_state() as state:
            state["reports_pending"] = [e for e in state.get("reports_pending", []) if e.get("run_id") != a.run_id]
        log(f"precheck sent back {a.run_id} (PR #{meta['pr']}): " + " | ".join(problems)[:300])
    else:
        log(f"precheck {a.run_id} (PR #{meta.get('pr')}): " + ("pass" if not problems else "FAILED again: "
                                                                + " | ".join(problems)[:300]) + (f" ({err})" if err else ""))
        nudge_tick()
    return 0


def existing_pr_note(n: int, branch: str) -> str:
    return (f"THIS WORK IS ALREADY OPEN AS PR #{n} (head branch `{branch}`). Push your commits to that branch so #{n} "
            f"updates (`git push origin HEAD:{branch}`). Need main? `git merge origin/main`, never rebase: a rebase needs a "
            f"force-push, which is forbidden. Never open a second PR or push the work to a new branch; report #{n}.\n\n")


# ---------------------------------------------------------------- usage / pace
def run_cost(out: dict) -> tuple[float, int]:
    """List-price USD and fresh tokens (input + output + cache writes; cache reads excluded). The USD is the SESSION's
    total: `claude -p --resume` reports the cost since the session began, not since the resume (see session_cost_at)."""
    u = out.get("usage") or {}
    tokens = sum(int(u.get(k) or 0) for k in ("input_tokens", "output_tokens", "cache_creation_input_tokens"))
    return float(out.get("total_cost_usd") or 0.0), tokens


def session_cost_at(prev: dict) -> float:
    """The session's total cost when run `prev` ended: what a run resuming it already carries. 2026-10-18 audit: each
    send-back logged its whole session again (one $0.95 session logged as $3.29), so the ledger ran ~1.9x high and
    --max-budget-usd on a resume was checked against the earlier runs' spend too. Runs from before the fix have no
    session_cost_usd: read their out.json."""
    if "session_cost_usd" in prev:
        return float(prev["session_cost_usd"])
    with contextlib.suppress(OSError, ValueError):
        return run_cost(json.loads((RUNS / prev["run_id"] / "out.json").read_text()))[0]
    return 0.0


def window_usd(state: dict, at: dt.datetime | None = None) -> float:
    at = at or now()
    lo = at - dt.timedelta(hours=state.get("usage", {}).get("window_hours", WINDOW_H))
    total = 0.0
    for e in state.get("usage", {}).get("log", []):
        t = parse_iso(e.get("t"))
        if t and t >= lo and "cost_usd" in e:
            total += float(e["cost_usd"])
    return total


def typical_usd(state: dict, model: str) -> float:
    costs = [e["cost_usd"] for e in state.get("usage", {}).get("log", []) if e.get("model") == model and "cost_usd" in e]
    return statistics.median(costs[-9:]) if costs else TYPICAL_USD.get(model, 6.0)


def pace_allows(state: dict, model: str) -> tuple[bool, str]:
    usage = state.setdefault("usage", {})
    budget = usage.get("learned_budget_usd")
    win = window_usd(state)
    if usage.get("pace") == "off":  # owner: no spend pacing; a limit hit still pauses until its reset
        return True, f"window ${win:.0f}, pace off"
    if budget:
        need = typical_usd(state, model)
        ok = win + need <= 0.8 * budget
        return ok, f"window ${win:.0f} + {model} ${need:.0f} vs 80% of ${budget:.0f}"
    recent = [r for r in usage.get("launches", []) if (t := parse_iso(r)) and t > now() - dt.timedelta(hours=1)]
    ok = len(recent) < SOFT_LAUNCHES_PER_HOUR
    return ok, f"window ${win:.0f}, no learned budget: {len(recent)}/{SOFT_LAUNCHES_PER_HOUR} launches this hour"


# ---------------------------------------------------------------- rate pace (usage.pace = "rate", owner 2026-10-16)
# The 3-worker trial (2026-10-16) spent the ~$130 session budget in 2 h, then idled 3 h until the reset: same PRs per
# block as 2 workers, at a higher $/PR. The rate pace sizes launches to the money left in the CURRENT session block
# (blocks run WINDOW_H hours from a reset), counting what live workers will still bill, so the block lasts until its
# reset. It also shifts priority: an item that doesn't fit steps aside for the next one that does (lane and tier
# order otherwise kept), and late in a block with budget to spare, Opus items go first and up to max_opus_burst run.
DEFAULT_RATE_USD_H = {"haiku": 3.0, "sonnet": 10.0, "opus": 30.0}  # until the log has timed runs
RATE_DEFAULT = {"headroom": 0.9, "max_opus_burst": 2, "surplus_hours": 2.0, "surplus_share": 0.3, "max_workers_burst": 3}
MODEL_RANK = {"haiku": 0, "sonnet": 1, "opus": 2}


def rate_cfg(state: dict) -> dict:
    return {**RATE_DEFAULT, **(state.get("usage", {}).get("rate") or {})}


def run_span(e: dict) -> tuple[dt.datetime, dt.datetime] | None:
    """(started, finished) of a ledger entry: `started` on entries since 2026-10-16, else the run's meta.json."""
    end = parse_iso(e.get("t"))
    start = parse_iso(e.get("started"))
    if not start and e.get("run_id"):
        with contextlib.suppress(Exception):
            start = parse_iso(json.loads((RUNS / e["run_id"] / "meta.json").read_text()).get("started"))
    return (start, end) if start and end and end > start else None


def model_rate(state: dict, model: str) -> float:
    """Median $/h of the model's last 9 timed runs (5 min or longer, cost > 0)."""
    rates = []
    for e in reversed(state.get("usage", {}).get("log", [])):
        if e.get("model") != model or not e.get("cost_usd") or not (span := run_span(e)):
            continue
        h = (span[1] - span[0]).total_seconds() / 3600
        if h >= 5 / 60:
            rates.append(float(e["cost_usd"]) / h)
        if len(rates) == 9:
            break
    return statistics.median(rates) if rates else DEFAULT_RATE_USD_H.get(model, 10.0)


def expected_usd(state: dict, model: str) -> float:
    """Mean cost of the model's last 9 runs that billed anything: the budget feels the heavy tail (an Opus epic slice
    is $20+) that a median hides, and $0 plan-held runs say nothing about what a launch costs."""
    costs = [float(e["cost_usd"]) for e in state.get("usage", {}).get("log", []) if e.get("model") == model and e.get("cost_usd")]
    return statistics.mean(costs[-9:]) if costs else TYPICAL_USD.get(model, 6.0)


def block_bounds(state: dict, at: dt.datetime | None = None) -> tuple[dt.datetime, dt.datetime] | None:
    """The current session block. A block lasts WINDOW_H hours from its first use, and the next one starts at the
    first use after it ends (not on a fixed grid: 2026-10-16's block began 07:15Z, when churn woke after a quiet
    night). Anchored on the latest known reset (a limit hit's resets_at, or usage.block_start set with `churn
    config`), then chained through churn's own activity (launches, ledger entries). None while no anchor is known."""
    at = at or now()
    usage = state.get("usage", {})
    anchors = [parse_iso(h.get("resets_at")) for h in usage.get("limit_hits", [])] + [parse_iso(usage.get("block_start"))]
    anchors = [t for t in anchors if t and t <= at]
    if not anchors:
        return None
    step = dt.timedelta(hours=usage.get("window_hours", WINDOW_H))
    start = max(anchors)
    uses = sorted(t for t in [*(parse_iso(x) for x in usage.get("launches", [])),
                              *(parse_iso(e.get("t")) for e in usage.get("log", []))] if t and start <= t <= at)
    while start + step <= at:
        start = next((t for t in uses if t >= start + step), at)  # nothing since the block ended: the next use is now
    return start, start + step


def _hours_between(a: dt.datetime, b: dt.datetime) -> float:
    return max(0.0, (b - a).total_seconds() / 3600)


def block_spend(state: dict, start: dt.datetime, at: dt.datetime) -> float:
    """Ledger spend inside [start, at]; a run that began before the block counts pro rata (the ledger logs at reap)."""
    total = 0.0
    for e in state.get("usage", {}).get("log", []):
        t = parse_iso(e.get("t"))
        if not t or t < start or t > at or "cost_usd" not in e:
            continue
        cost = float(e["cost_usd"])
        if (span := run_span(e)) and span[0] < start:
            cost *= _hours_between(start, span[1]) / _hours_between(*span)
        total += cost
    return total


def rate_plan(state: dict, at: dt.datetime | None = None) -> dict | None:
    """Money left in this block after what is spent and committed. None unless usage.pace is "rate" and a budget is
    known (then pace_allows' older rules apply)."""
    usage = state.get("usage", {})
    budget = usage.get("learned_budget_usd")
    if usage.get("pace") != "rate" or not budget:
        return None
    at = at or now()
    cfg = rate_cfg(state)
    bounds = block_bounds(state, at)
    if bounds:
        start, end = bounds
        spent, left_h = block_spend(state, start, at), _hours_between(at, end)
    else:  # no reset seen yet: the rolling window, and assume a whole block is still ahead
        start, end, spent, left_h = at - dt.timedelta(hours=WINDOW_H), None, window_usd(state, at), float(WINDOW_H)
    rate = {m: model_rate(state, m) for m in MODELS}
    cost = {m: min(expected_usd(state, m), rate[m] * left_h) for m in MODELS}  # what one more run bills in THIS block
    live = [r for r in state.get("running", []) if r.get("run_id") and r.get("backend") != "agy" and r.get("lane") != "credit"
            and pid_alive(r.get("pid"))]
    committed = 0.0
    for r in live:
        m = r.get("model", "sonnet")
        began = parse_iso(r.get("started")) or at
        so_far = rate.get(m, 10.0) * _hours_between(began, at)
        rest = max(0.0, max(expected_usd(state, m), so_far) - so_far)
        committed += rate.get(m, 10.0) * _hours_between(max(began, start), at) + min(rest, rate.get(m, 10.0) * left_h)
    ticks = sum(float(e.get("cost_usd") or 0) for e in usage.get("log", [])
                if str(e.get("model", "")).startswith("orchestrator-") and (t := parse_iso(e.get("t")))
                and dt.timedelta(0) <= at - t <= dt.timedelta(hours=2))
    committed += ticks / 2 * left_h
    room = float(cfg["headroom"]) * float(budget) - spent - committed
    # the $/h the rest of the block can carry: what a set of workers may burn, together, until the reset
    sustain = (float(cfg["headroom"]) * float(budget) - spent - ticks / 2 * left_h) / left_h if left_h > 0 else 0.0
    if left_h <= float(cfg["surplus_hours"]) and room >= float(cfg["surplus_share"]) * float(budget):
        mode = "surplus"  # budget that would go unused at the reset: let the expensive work have it
    elif room < cost["sonnet"]:
        mode = "tight"
    else:
        mode = "steady"
    opus_cap = int(cfg["max_opus_burst"]) if mode == "surplus" else int(state.get("max_opus", 1))
    live_opus = sum(1 for r in live if r.get("model") == "opus")
    why = (f"pace rate {mode}: block ends {iso(end) if end else '?'} ({left_h:.1f} h left), spent ${spent:.0f} + "
           f"committed ${committed:.0f} vs {float(cfg['headroom']):.0%} of ${float(budget):.0f} -> room ${room:.0f}; "
           f"$/run in block " + " ".join(f"{m} {cost[m]:.0f}" for m in MODELS) + f"; opus {live_opus}/{opus_cap}; "
           f"sustains ${sustain:.0f}/h")
    return {"mode": mode, "room": room, "cost": cost, "rate": rate, "spent": spent, "committed": committed, "sustain": sustain,
            "left_h": left_h, "end": end, "opus_cap": opus_cap, "live_opus": live_opus, "why": why}


def worker_cap(state: dict, plan: dict | None, models: list[str]) -> int:
    """Claude workers allowed for this set of models (the live ones + the one about to start). Owner 2026-10-16: 2
    Sonnet or 1 Sonnet + 1 Opus (state.max_workers); a third (rate.max_workers_burst) only with no Opus in the set and
    only while the block can carry the set's measured burn until the reset, or in a surplus block."""
    base = int(state.get("max_workers", 2))
    if not plan or "opus" in models:
        return base
    if plan["mode"] == "surplus" or sum(plan["rate"].get(m, 10.0) for m in models) <= plan["sustain"]:
        return max(base, int(rate_cfg(state)["max_workers_burst"]))
    return base


def slot_ceiling(state: dict, plan: dict | None) -> int:
    """The most Claude workers any mix may reach (the box and worker_cap decide the rest)."""
    base = int(state.get("max_workers", 2))
    return max(base, int(rate_cfg(state)["max_workers_burst"])) if plan else base


def live_opus_count(state: dict) -> int:
    return sum(1 for r in state.get("running", []) if r.get("run_id") and r.get("backend") != "agy"
               and r.get("lane") != "credit" and r.get("model") == "opus" and pid_alive(r.get("pid")))


def ci_priced(state: dict, x: dict) -> bool:
    """A new normal-lane item whose PR runs on this repo's CI: what CI admission meters (#38)."""
    return x.get("lane") in (None, "normal") and not x.get("pr") and not x.get("repo") and x.get("backend") != "agy"


def budget_picks(state: dict, snap: dict | None, mode: str, n: int, plan: dict | None) -> list[tuple[int, dict]]:
    """Up to n queue items in pick_item order, taking only what fits: the opus cap always (state.max_opus, or the
    plan's burst cap), and with a rate plan the block's room, spent down pick by pick. An item that doesn't fit steps
    aside for the next one that does; in a surplus block Opus items go first within their lane and tier."""
    room = plan["room"] if plan else float("inf")
    opus = plan["live_opus"] if plan else live_opus_count(state)
    cap = plan["opus_cap"] if plan else int(state.get("max_opus", 1))
    queue = state.get("queue", [])
    slot_models = [r.get("model", "sonnet") for r in claude_slot_holders(state)]
    out, taken = [], set()
    running = list(state.get("running", []))
    # #38 step 3: CI admission's launch count caps the CI-priced picks in one tick (the next tick's admission counts
    # them as committed). PR fixes, the ci lane, the core reserve and crucible-repo work stay outside it, as under busy.
    adm = state.get("ci_admission") or {}
    ci_left = int(adm["admit"]) if "admit" in adm else n
    for _ in range(max(0, n)):
        def fits(x, room=room, opus=opus, models=tuple(slot_models), ci_left=ci_left):
            m = x.get("model", "sonnet")
            if x.get("lane") != "backfill" and len(models) + 1 > worker_cap(state, plan, [*models, m]):
                return False  # backfill takes no Claude slot
            if ci_left < 1 and ci_priced(state, x):
                return False
            return (m != "opus" or opus < cap) and (not plan or plan["cost"].get(m, 0.0) <= room)
        q = [(k, x) for k, x in enumerate(queue) if k not in taken and fits(x)]
        if plan and plan["mode"] == "surplus":
            q.sort(key=lambda kx: -MODEL_RANK.get(kx[1].get("model", "sonnet"), 1))  # stable: lane/tier order stays
        _, x = pick_item({**state, "queue": [x for _, x in q], "running": running}, snap, mode)
        if x is None:
            break
        running.append({"scope": x.get("scope"), "lane": x.get("lane"), "picked": True})
        k = next(k for k, y in q if y is x)
        taken.add(k)
        out.append((k, x))
        m = x.get("model", "sonnet")
        room -= plan["cost"].get(m, 0.0) if plan else 0.0
        ci_left -= ci_priced(state, x)
        opus += m == "opus"
        if x.get("lane") != "backfill":
            slot_models.append(m)
        if x.get("lane") == "backfill":
            break  # backfill_max is 1
    return out


_RESET_RE = re.compile(r"resets?\s+(?:at\s+)?(\d{1,2})(?::(\d\d))?\s*(am|pm)?", re.I)


# Owner 2026-10-17: a weekly limit says "resets Oct 21, 9pm" or "resets Monday 9am"; _RESET_RE wants a digit right after
# "resets", missed it, and fell back to 1 h -- churn would have relaunched into the limit every hour for days.
_DATED_RE = re.compile(r"resets?\s+(?:on\s+)?(?:(?P<mon>jan|feb|mar|apr|may|jun|jul|aug|sep|oct|nov|dec)[a-z]*\.?\s+(?P<day>\d{1,2})"
                       r"|(?P<wd>mon|tue|wed|thu|fri|sat|sun)[a-z]*)\s*,?\s*(?:at\s+)?(?P<h>\d{1,2})(?::(?P<m>\d\d))?\s*(?P<ap>am|pm)?",
                       re.I)
_MONTHS = ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"]
_WEEKDAYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]


def _hour24(h: str, ap: str | None) -> int:
    hour, ap = int(h), (ap or "").lower()
    if ap == "pm" and hour < 12:
        hour += 12
    if ap == "am" and hour == 12:
        hour = 0
    return hour % 24


def limit_reset(text: str) -> dt.datetime | None:
    """A 'session limit ... resets 9pm' message -> the next such local time, as UTC + 5 min. A dated reset ("resets
    Oct 21, 9pm", "resets Monday 9am": the weekly limit) -> that day."""
    if not re.search(r"limit", text, re.I):
        return None
    # Wall-clock arithmetic stays naive and takes its UTC offset last, from the target day: a reset across a DST change
    # ("resets Nov 1, 9pm" read on Oct 28) stays 9pm instead of keeping today's offset and landing an hour off.
    local = dt.datetime.now()

    def utc(wall: dt.datetime) -> dt.datetime:
        return wall.astimezone().astimezone(dt.timezone.utc) + dt.timedelta(minutes=5)

    if d := _DATED_RE.search(text):
        at = local.replace(hour=_hour24(d["h"], d["ap"]), minute=int(d["m"] or 0), second=0, microsecond=0)
        if d["mon"]:
            with contextlib.suppress(ValueError):
                cand = at.replace(month=_MONTHS.index(d["mon"].lower()[:3]) + 1, day=int(d["day"]))
                if cand < local - dt.timedelta(days=1):  # December's "resets Jan 2"
                    cand = cand.replace(year=cand.year + 1)
                return utc(cand)
        else:
            cand = at + dt.timedelta(days=(_WEEKDAYS.index(d["wd"].lower()[:3]) - local.weekday()) % 7)
            if cand <= local:
                cand += dt.timedelta(days=7)
            return utc(cand)
    m = _RESET_RE.search(text)
    if not m:
        return now() + dt.timedelta(hours=1)
    hour, minute, ampm = int(m.group(1)), int(m.group(2) or 0), (m.group(3) or "").lower()
    if ampm == "pm" and hour < 12:
        hour += 12
    if ampm == "am" and hour == 12:
        hour = 0
    cand = local.replace(hour=hour % 24, minute=minute, second=0, microsecond=0)
    if cand <= local:
        cand += dt.timedelta(days=1)
    return utc(cand)


LONG_PAUSE_H = 6  # a limit pause longer than a 5-hour window is the weekly limit (or a misread reset): page
LIMIT_LOOP_HITS = 4  # this many separate limit hits within LONG_PAUSE_H: each pause ended into the limit again


def record_limit(state: dict, reset: dt.datetime, source: str, text: str = "") -> None:
    usage = state.setdefault("usage", {})
    win = window_usd(state)
    usage.setdefault("limit_hits", []).append({"t": iso(now()), "resets_at": iso(reset), "window_usd": round(win, 2), "source": source})
    said = " ".join(text.split())[:240]
    if reset - now() > dt.timedelta(hours=LONG_PAUSE_H):
        notify(f"long-limit-{iso(reset)}", "churn: paused for a long usage limit",
               f"Paused until {reset.astimezone().strftime('%a %b %d %H:%M')} ({(reset - now()).total_seconds() / 3600:.0f} h)."
               + (f" Message: {said}" if said else ""), priority="high", cooldown_h=24 * 7, tags="hourglass")
    recent = {h["t"] for h in usage["limit_hits"] if (ht := parse_iso(h.get("t"))) and now() - ht < dt.timedelta(hours=LONG_PAUSE_H)}
    if len(recent) >= LIMIT_LOOP_HITS:
        notify("limit-loop", f"churn: hit the usage limit {len(recent)} times in {LONG_PAUSE_H} h",
               "Each pause ended straight into the limit again: the reset time is probably misread (a weekly limit?). "
               f"Check /usage; `touch {STOP}` stops churn." + (f" Last message: {said}" if said else ""),
               priority="high", cooldown_h=12, tags="repeat")
    if win > 0:
        # The ledger counts churn's own runs only; other sessions share the limit, so `win` is churn's share at the
        # hit, a LOWER bound. Keep the latest owner reading (/usage %) if it is higher (owner 2026-10-12: 14% used
        # while the ledger implied ~63%).
        floor = max([r.get("learned_budget_usd") or 0 for r in usage.get("owner_readings", [])
                     if (t := parse_iso(r.get("t"))) and now() - t < dt.timedelta(days=7)] or [0])
        usage["learned_budget_usd"] = round(max(win, floor), 2)
    prev = parse_iso(state.get("paused_until"))
    if not prev or reset > prev:
        state["paused_until"] = iso(reset)


# ---------------------------------------------------------------- box
def refresh_tools() -> None:
    run(["git", "-C", str(V6), "fetch", "-q", "origin"], timeout=120)
    if not TOOLS.exists():
        run(["git", "-C", str(V6), "worktree", "add", "-q", "--detach", str(TOOLS), "origin/main"])
    else:
        run(["git", "-C", str(TOOLS), "checkout", "-q", "--detach", "origin/main"])


# Sync pulse (owner 2026-10-19): the install itself drifted off main (nyx ran 5 merged commits behind, its new timer
# never installed). Hourly the gate checks the install's own checkout against origin/main and fast-forwards it once
# origin/main's tests pass, installing new or changed systemd units; it never touches a dirty or diverged checkout.
SYNC_EVERY_MIN, SYNC_MAX_DEFER_H, SYNC_TEST_TIMEOUT_S = 60, 3, 600
UNIT_DIR = Path.home() / ".config" / "systemd" / "user"


def install_units(src: Path, dest: Path | None = None) -> tuple[list[str], list[str]]:
    """Copy the repo's systemd/*.service|*.timer that are new or changed into dest: (copied, new timers). The repo's
    units must be host-neutral (%h, no host paths): the pulse overwrites an installed unit of the same name."""
    dest = dest or UNIT_DIR
    copied, new_timers = [], []
    for f in sorted(src.glob("*.service")) + sorted(src.glob("*.timer")):
        d = dest / f.name
        if d.exists() and d.read_bytes() == f.read_bytes():
            continue
        if not d.exists() and f.suffix == ".timer":
            new_timers.append(f.name)
        dest.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(f, d)
        copied.append(f.name)
    return copied, new_timers


def sync_units(src: Path) -> str:
    """Install the checkout's new or changed units under systemd (enabling new timers): what changed, or ""."""
    if not use_systemd() or not (src / "systemd").is_dir():
        return ""
    copied, timers = install_units(src / "systemd")
    if copied:
        run(["systemctl", "--user", "daemon-reload"])
        for t in timers:
            run(["systemctl", "--user", "enable", "--now", t])
    return ", ".join(copied) + (f" (enabled {', '.join(timers)})" if timers else "")


def self_sync(sync: dict, live: int, src: Path | None = None, force: bool = False,
              test_cmd: list[str] | None = None, units: bool = True) -> str | None:
    """One sync pulse: update `sync` (the state's record) in place and return a note when something happened."""
    src = src or Path(SELF).parent
    if not force and (t := parse_iso(sync.get("checked"))) and now() - t < dt.timedelta(minutes=SYNC_EVERY_MIN):
        return None
    sync["checked"] = iso(now())

    def git(*a, **kw):
        return run(["git", "-C", str(src), *a], **kw)
    if git("fetch", "-q", "origin", timeout=120).returncode:
        return None  # offline or no remote: the next pulse tries again
    head, target = git("rev-parse", "HEAD").stdout.strip(), git("rev-parse", "origin/main").stdout.strip()
    behind = int(git("rev-list", "--count", "HEAD..origin/main").stdout.strip() or 0)
    ahead = int(git("rev-list", "--count", "origin/main..HEAD").stdout.strip() or 0)
    sync.update(head=head[:12], behind=behind, ahead=ahead)
    if not behind:
        sync.pop("behind_since", None)  # on main: still make the installed units match it (a host pulled by hand)
        clean = not git("status", "--porcelain", "--untracked-files=no").stdout.strip()
        return (f"sync: units {installed}" if clean and units and (installed := sync_units(src)) else None)
    sync.setdefault("behind_since", iso(now()))
    dirty = git("status", "--porcelain", "--untracked-files=no").stdout.strip()
    if ahead or dirty:
        why = f"{ahead} local commit(s) not on main" if ahead else "uncommitted edits"
        notify(f"sync-blocked-{target[:8]}", "promoter-bot is behind main",
               f"{behind} commit(s) behind origin/main and not updated: {why} in {src}. Update it by hand.", cooldown_h=24)
        return f"sync: {behind} behind main, not updated ({why})"
    if sync.get("failed") == target:
        return None  # this main already failed its tests here; the alert went out
    since = parse_iso(sync.get("behind_since"))
    if live and since and now() - since < dt.timedelta(hours=SYNC_MAX_DEFER_H):
        return f"sync: {behind} behind main, waiting for {live} worker(s) to finish"
    tmp = Path(tempfile.mkdtemp(prefix="promoter-sync-", dir=str(H)))
    try:
        if git("worktree", "add", "-q", "--detach", str(tmp / "t"), target).returncode:
            return None
        # A second run before pinning main as failed (nyx 2026-10-22: one flaky test at 10:31Z held the host 4
        # commits behind all day, since a failed target is never retested).
        for _ in range(2):
            try:
                r = run(test_cmd or [SELFSCAN_PY, "-m", "pytest", "-q", "-x", "tests"], cwd=str(tmp / "t"),
                        timeout=SYNC_TEST_TIMEOUT_S)
            except subprocess.TimeoutExpired:
                r = subprocess.CompletedProcess([], 1, "", "tests timed out")
            if not r.returncode:
                break
    finally:
        git("worktree", "remove", "--force", str(tmp / "t"))
        shutil.rmtree(tmp, ignore_errors=True)
    if r.returncode:
        sync["failed"] = target
        tail = " ".join((r.stdout + r.stderr).split())[-300:]
        notify(f"sync-tests-{target[:8]}", "promoter-bot: main fails its tests here",
               f"Not updating {head[:8]} -> {target[:8]}: {tail}", priority="high", cooldown_h=24)
        return f"sync: origin/main {target[:8]} fails its tests here (twice); staying on {head[:8]}: {tail}"
    if git("merge", "-q", "--ff-only", target).returncode:
        return f"sync: fast-forward to {target[:8]} failed; staying on {head[:8]}"
    note = f"sync: promoter-bot {head[:8]} -> {target[:8]} ({behind} commit(s))"
    if units and (installed := sync_units(src)):
        note += f"; units {installed}"
    sync.update(head=target[:12], behind=0, ahead=0, applied=iso(now()))
    sync.pop("behind_since", None)
    sync.pop("failed", None)
    notify(f"sync-applied-{target[:8]}", "promoter-bot updated", note[6:], priority="low")
    return note


SKILLS_DIR = Path.home() / ".claude" / "skills"
# Host-private files (the night-shift skill) live in the private repo, not in this public one (owner 2026-10-19).
PRIVATE_DIR = Path(_CFG.get("private_dir", str(Path.home() / ".local" / "src" / "promoter-bot-private")))


def pull_private(src: Path | None = None) -> str | None:
    """Fast-forward the private checkout to its upstream (text only: no tests). None = nothing to do or no checkout."""
    src = src or PRIVATE_DIR
    if not (src / ".git").exists():
        return None

    def git(*a, **kw):
        return run(["git", "-C", str(src), *a], **kw)
    if git("fetch", "-q", "origin", timeout=120).returncode:
        return None
    behind = int(git("rev-list", "--count", "HEAD..@{u}").stdout.strip() or 0)
    if not behind:
        return None
    if git("status", "--porcelain", "--untracked-files=no").stdout.strip() or git("merge", "-q", "--ff-only", "@{u}").returncode:
        notify(f"private-blocked-{git('rev-parse', '@{u}').stdout.strip()[:8]}", "promoter-bot-private is behind",
               f"{src} is {behind} commit(s) behind its upstream and has local edits or commits: update it by hand.",
               cooldown_h=24)
        return f"private checkout {behind} behind, not updated (local edits or commits)"
    return f"private checkout updated ({behind} commit(s))"


def link_skills(src: Path | None = None, dest: Path | None = None) -> tuple[list[str], list[str]]:
    """Point each installed skill file at the private repo's copy (skills/<name>/<file>), so the sync pulse keeps the
    skill current on every host (owner 2026-10-19: night-shift was hand-copied from melek). Only a missing file or a
    byte-identical copy is replaced by a symlink; a copy that differs is left alone and reported, so a host's own
    edits are never lost. Returns (linked now, differing)."""
    src, dest = src or PRIVATE_DIR / "skills", dest or SKILLS_DIR
    linked, differ = [], []
    for f in sorted(p for p in src.glob("*/*") if p.is_file()):
        d = dest / f.parent.name / f.name
        if d.is_symlink() and d.resolve() == f.resolve():
            continue
        if d.exists() and (d.is_symlink() or d.read_bytes() != f.read_bytes()):
            differ.append(f"{f.parent.name}/{f.name}")
            continue
        d.parent.mkdir(parents=True, exist_ok=True)
        tmp = d.with_name(f".{d.name}.promoter-link")
        tmp.unlink(missing_ok=True)
        tmp.symlink_to(f.resolve())
        os.replace(tmp, d)  # atomic: a reader sees the old file or the link, never neither
        linked.append(f"{f.parent.name}/{f.name}")
    return linked, differ


def skills_note() -> str | None:
    pulled = pull_private()
    linked, differ = link_skills()
    if differ:
        notify("skills-differ-" + hashlib.sha1(",".join(differ).encode()).hexdigest()[:8],
               "promoter-bot: a skill here differs from the repo",
               f"{', '.join(differ)} under {SKILLS_DIR} is not the repo's copy, so it is not kept current. Put its edits "
               f"in a promoter-bot PR, then delete the local file (the next pulse links it).", cooldown_h=24)
    return "; ".join(x for x in ([pulled] if pulled else []) + ([f"skills linked to the repo: {', '.join(linked)}"] if linked else [])
                     + ([f"skills that differ from the repo (left alone): {', '.join(differ)}"] if differ else [])) or None


def run_sync_pulse(force: bool = False) -> str | None:
    """The gate's call: the pulse runs outside the state lock (tests may take minutes), then records its result."""
    state = load_state()
    sync = dict(state.get("sync") or {})
    if (note := self_sync(sync, len(claude_slot_holders(state)), force=force)) is not None or force or \
            sync.get("checked") == iso(now()):  # skills follow on every real pulse, not on the throttled no-op
        with contextlib.suppress(OSError):
            note = "; ".join(x for x in (note, skills_note()) if x) or None
    with edit_state() as st:
        st["sync"] = sync
    return note


CGROUP_APP = Path(f"/sys/fs/cgroup/user.slice/user-{os.getuid()}.slice/user@{os.getuid()}.service/app.slice")
_BOX_ADJ = """import json, sys
