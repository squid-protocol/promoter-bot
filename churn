def cmd_config(a) -> int:
    """`churn config` lists the knobs; `churn config KEY VALUE` sets one (validated, logged)."""
    if not a.key:
        state = load_state()
        for k, (path, _) in CONFIG_KEYS.items():
            v = state
            for p in path:
                v = v.get(p) if isinstance(v, dict) else None
            dflt = RATE_DEFAULT.get(k[5:]) if k.startswith("rate.") else CI_ADMISSION_DEFAULT.get(k[3:]) \
                if k.startswith("ci.") else {"max_workers": 2, "max_opus": 1, "pace": "ledger",
                                                                                          "core_reserve": CORE_RESERVE}.get(k)
            print(f"{k} = {v if v is not None else dflt}" + (" (default)" if v is None else ""))
        return 0
    if a.key not in CONFIG_KEYS or a.value is None:
        raise SystemExit(f"usage: churn config KEY VALUE; keys: {', '.join(CONFIG_KEYS)}")
    path, parse = CONFIG_KEYS[a.key]
    try:
        val = parse(a.value)
    except (ValueError, TypeError) as e:
        raise SystemExit(f"{a.key}: bad value {a.value!r} ({e})") from None
    if a.key in ("max_workers", "max_opus", "core_reserve", "rate.max_opus_burst", "rate.max_workers_burst") and not 0 <= val <= 4:
        raise SystemExit(f"{a.key} must be 0..4")
    if a.key in ("rate.headroom", "rate.surplus_share") and not 0 < val <= 1:
        raise SystemExit(f"{a.key} must be in (0, 1]")
    with edit_state() as state:
        holder = state
        for p in path[:-1]:
            holder = holder.setdefault(p, {})
        old = holder.get(path[-1])
        holder[path[-1]] = val
    log(f"[owner] config {a.key} {old} -> {val}" + (f" ({a.note})" if a.note else ""))
    print(f"{a.key}: {old} -> {val}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog=Path(sys.argv[0]).name or "churn", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd", required=True)
    t = sub.add_parser("tick", help="gate, reap, and run a model tick only when needed")
    t.add_argument("--dry-run", action="store_true", help="print what the gate decided; launch no model")
    t.add_argument("--force", action="store_true", help="run a model tick even if the gate is quiet")
    t.add_argument("--reason", action="append", help="why (logged; with --force it is the tick's reason)")
    w = sub.add_parser("worker", help="start one detached headless worker")
    w.add_argument("--issue", type=int)
    w.add_argument("--model", default="sonnet")
    w.add_argument("--task", help="one-line task (recorded in state)")
    w.add_argument("--brief-file")
    w.add_argument("--brief")
    w.add_argument("--force", action="store_true", help="ignore the two-worker cap")
    w.add_argument("--off-focus", action="store_true", help="owner only: launch an issue outside this host's focus")
