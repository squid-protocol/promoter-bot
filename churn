        return 0 if ok else 1
    print(json.dumps({k: v for k, v in cfg.items() if k != "owner_seen"}, indent=1))
    return 0


STALE_QUEUED_H = 3
CI_QUEUE_PAGES = 3  # #35: the median came from the newest 100 only (biased low in a long queue); read up to 300


def ci_queue(gh=None, ignore=()) -> dict:
    """GitHub Actions runs waiting for a runner: count and median wait (minutes), leaving out runs of the `ignore`
    workflow files. One API call, up to CI_QUEUE_PAGES when more than 100 runs are queued."""
    gh = gh or gh_json
    runs: list = []
    total = 0
    try:
        for page in range(1, CI_QUEUE_PAGES + 1):
            d = gh(f"repos/{REPO}/actions/runs?status=queued&per_page=100" + (f"&page={page}" if page > 1 else ""))
            got = d.get("workflow_runs", [])
            total, runs = max(total, int(d.get("total_count", 0))), runs + got
            if len(got) < 100 or len(runs) >= total:
                break
    except RuntimeError as e:
        if not runs:
            return {"error": str(e)[:120]}  # a later page failing keeps what the earlier pages saw
    total = max(total, len(runs))
    is_light = [os.path.basename(str(r.get("path", ""))) in set(ignore) for r in runs]
    counted = [r for r, lt in zip(runs, is_light) if not lt]
    light = len(runs) - len(counted)
    every = sorted((now() - t).total_seconds() / 60 for r in counted if (t := parse_iso(r.get("created_at"))))
    # 2026-10-16 audit: one run queued for hours (no runner will ever take it) kept the median >= busy_wait_min, so busy
    # mode -- and the hold on normal work -- could never end. Runs queued longer than STALE_QUEUED_H don't count.
    waits = [w for w in every if w < STALE_QUEUED_H * 60]
    stale = len(every) - len(waits)
    # Runs beyond the pages read are unseen: count them at the share of counted runs among those seen.
    unseen = total - len(runs)
    queued = len(counted) - stale + (round(unseen * len(counted) / len(runs)) if runs else unseen)
    by_wf = collections.Counter(os.path.basename(str(r.get("path", ""))) for r in counted
                                if (t := parse_iso(r.get("created_at"))) and now() - t < dt.timedelta(hours=STALE_QUEUED_H))
    return {"queued": max(0, queued), "median_wait_min": round(waits[len(waits) // 2], 1) if waits else 0.0,
            **({"stale": stale} if stale else {}), **({"ignored": light} if light else {}),
            **({"unseen": unseen} if unseen > 0 else {}), "by_workflow": dict(by_wf)}


def ci_mode(state: dict, q: dict, adm: dict | None = None) -> tuple[str, str]:
    """busy when CI admission has no room for one normal launch (`adm`, else state's ci_admission), calm otherwise.
    An unreadable queue, or no admission reading yet, keeps the previous mode."""
    prev = state.get("ci_mode", "calm")
    if "error" in q:
        return prev, f"CI queue unknown ({q['error']}); stays {prev}"
    adm = adm if adm is not None else state.get("ci_admission")
    if not adm or "admit" not in adm:
        return prev, f"no CI admission reading yet; stays {prev}"
    mode = "busy" if int(adm["admit"]) < 1 else "calm"
    extra = ", ".join(f"{q[k]} {label}" for k, label in (("ignored", "lightweight ignored"), ("unseen", "past the pages read"))
                      if q.get(k))
    return mode, (f"CI {mode}: admission room {adm.get('room_rm')} runner-min, {adm['admit']} launch(es) at "
                  f"{adm.get('per_launch_rm')} each, target_util {adm.get('target_util')}; {q.get('queued')} runs queued"
                  + (f" ({extra})" if extra else ""))


def retire_ci_pressure(state: dict) -> list[str]:
    """#38 step 3: drop busy/calm threshold overrides from state.ci_pressure (they decide nothing now), loudly."""
    cp = state.get("ci_pressure") or {}
    gone = {k: cp.pop(k) for k in CI_PRESSURE_RETIRED if k in cp}
    return ["ci_pressure: retired busy/calm override(s) removed, admission decides now (#38): "
            + ", ".join(f"{k}={v}" for k, v in gone.items())] if gone else []


# #38 step 1 (shadow): measure CI load in runner-minutes against the pool instead of counting runs. The busy/calm counts
# were set 2026-10-14; by 10-20 jobs ran 4.9 -> 3.1 min on the same 20-job pool, so "20 queued" meant half the wait, and
# busy hours tripled while runner-hours stayed flat (#34). A learned per-workflow cost tracks such changes by itself.
# Logged next to busy/calm, deciding nothing yet; the admission controller (#38 step 2) reads these numbers.
CI_PROFILE_DEFAULT = {"every_h": 1, "sample_runs": 12, "alpha": 0.3, "pool": 20, "wait_window_h": 2,
                      "default_runner_min": 5.0}


def ci_profile_cfg(state: dict) -> dict:
    return {**CI_PROFILE_DEFAULT, **(state.get("ci_profile_cfg") or {})}


def ci_run_cost(jobs: list[dict]) -> dict | None:
    """Runner-minutes, wall minutes, job count and per-job queue waits of one completed run; None if no job ran."""
    ran = [(c, s, e) for j in jobs if j.get("conclusion") != "skipped"
           and (c := parse_iso(j.get("created_at"))) and (s := parse_iso(j.get("started_at")))
           and (e := parse_iso(j.get("completed_at")))]
    if not ran:
        return None
    return {"runner_min": sum((e - s).total_seconds() for _, s, e in ran) / 60,
            "wall_min": (max(e for *_, e in ran) - min(c for c, *_ in ran)).total_seconds() / 60,
            "jobs": len(ran), "waits": [max(0.0, (s - c).total_seconds() / 60) for c, s, _ in ran]}


def ci_profile_sample(state: dict, gh=None, ignore=(), want=()) -> list[str]:
    """Every every_h: read the jobs of up to sample_runs completed runs (about 1 + 1.5 x sample_runs API calls) and
    fold each workflow file's runner-minutes, wall minutes and job count into an EWMA; keep pull_request job queue
    waits (the outcome the admission controller holds to a target). `want`: workflow files queued now -- the
    least-profiled of them get their latest completed run first. Returns log notes; mutates state."""
    cfg = ci_profile_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    last = parse_iso(prof.get("sampled_at"))
    if last and now() - last < dt.timedelta(hours=float(cfg["every_h"])):
        return []
    gh = gh or gh_json
    prof["sampled_at"] = iso(now())
    seen = set(prof.get("seen_runs", []))
    try:
        runs = gh(f"repos/{REPO}/actions/runs?status=completed&per_page=100").get("workflow_runs", [])
    except RuntimeError as e:
        return [f"ci profile: runs unreadable ({str(e)[:80]})"]
    fresh = [r for r in runs if r.get("id") not in seen and r.get("conclusion") not in ("cancelled", "skipped")
             and os.path.basename(str(r.get("path", ""))) not in set(ignore)]
    # Short runs finish most often (and shepherd runs fill the newest 100), so the newest runs are mostly docs, audits
    # and post-merge. The least-profiled workflows queued now come first, then one run per workflow, least-sampled first,
    # so the heavy PR workflows (smoke, det sweep) don't go unmeasured.
    def n_of(wf):
        return int((prof["workflows"].get(wf) or {}).get("n", 0))
    picked: list[dict] = []
    wanted = collections.Counter(w for w in want if w.endswith((".yml", ".yaml")) and w not in set(ignore))
    for wf in sorted(wanted, key=lambda w: (n_of(w), -wanted[w], w)):  # least profiled, then most queued
        if len(picked) >= int(cfg["sample_runs"]) // 2 or n_of(wf) >= 3:
            break
        try:  # 20: superseded PR runs are cancelled (cancel-in-progress), so the last few can all be cancelled
            got = gh(f"repos/{REPO}/actions/workflows/{wf}/runs?status=completed&per_page=20").get("workflow_runs", [])
        except RuntimeError:
            continue
        picked += [r for r in got if r.get("id") not in seen
                   and r.get("conclusion") not in ("cancelled", "skipped")][:1]
    first: dict[str, dict] = {}
    for r in fresh:
        first.setdefault(os.path.basename(str(r.get("path", ""))), r)
    have = {r.get("id") for r in picked}
    picked += sorted((r for r in first.values() if r.get("id") not in have),
                     key=lambda r: n_of(os.path.basename(str(r.get("path", "")))))
    picked = picked[:int(cfg["sample_runs"])]
    a, n = float(cfg["alpha"]), 0
    for r in picked:
        try:
            jobs = gh(f"repos/{REPO}/actions/runs/{r['id']}/jobs?per_page=100").get("jobs", [])
        except RuntimeError:
            continue
        seen.add(r["id"])
        if not (c := ci_run_cost(jobs)):
            continue
        n += 1
        w = prof["workflows"].setdefault(os.path.basename(str(r.get("path", ""))), {"n": 0})
        for k in ("runner_min", "wall_min", "jobs"):
            w[k] = round(c[k] if not w["n"] else (1 - a) * float(w.get(k, c[k])) + a * c[k], 2)
        w["n"], w["t"] = w["n"] + 1, iso(now())
        if r.get("event") == "pull_request":
            prof["waits"] += [[iso(t), round(x, 2)] for x in c["waits"] if (t := parse_iso(r.get("updated_at")))]
    keep = now() - dt.timedelta(hours=max(6.0, float(cfg["wait_window_h"])))
    prof["waits"] = [x for x in prof["waits"] if (t := parse_iso(x[0])) and t >= keep][-500:]
    prof["seen_runs"] = sorted(seen)[-300:]
    notes = [f"ci profile: sampled {n} of {len(picked)} runs, {len(prof['workflows'])} workflows known"] if picked else []
    # Per-push cost from pushes whose runs have all finished: the newest completed runs hold a recent push's quick
    # workflows but not its heavy ones (still running), which read 9 runner-min a push against ~65 measured (#34).
    lo, hi = now() - dt.timedelta(minutes=90), now() - dt.timedelta(minutes=60)
    try:
        window = gh(f"repos/{REPO}/actions/runs?event=pull_request&per_page=100&created="
                    f"{lo.strftime('%Y-%m-%dT%H:%M:%SZ')}..{hi.strftime('%Y-%m-%dT%H:%M:%SZ')}").get("workflow_runs", [])
    except RuntimeError:
        window = []
    if (pp := per_push_cost(window, prof, cfg)) is not None:
        prof["per_push_rm"] = round(pp if prof.get("per_push_rm") is None else (1 - a) * float(prof["per_push_rm"]) + a * pp, 1)
    if note := adjust_target_util(state):
        notes.append(note)
    return notes


def per_push_cost(runs: list[dict], prof: dict, cfg: dict) -> float | None:
    """Runner-minutes one PR push costs: for the pull_request runs in `runs` (all runs created in a closed window),
    each workflow's runs per pushed head SHA times its learned cost. Cancelled (superseded) and skipped (draft) runs
    don't count, nor runs still going. None with fewer than 3 pushes in view."""
    pr = [r for r in runs if r.get("event") == "pull_request" and r.get("status") in (None, "completed")
          and r.get("conclusion") not in ("cancelled", "skipped")]
    shas = {r.get("head_sha") for r in pr if r.get("head_sha")}
    if len(shas) < 3:
        return None
    per_wf = collections.Counter(os.path.basename(str(r.get("path", ""))) for r in pr)
    return sum(k / len(shas) * float(workflow_cost(prof, wf, cfg)["runner_min"]) for wf, k in per_wf.items())


# #38 step 2 (shadow): admission instead of a busy/calm switch. Each launch is priced at its expected CI cost and
# admitted while the pool has room under target_util; target_util follows the outcome (PR job queue wait) by AIMD, so
# nothing here is a hand-set congestion threshold. pushes_per_pr is a setting until PR history is measured (step 3).
# #38 step 3: the hourly AIMD alone let a 22:20Z-23:20Z overrun (p50 5.28 min) stand for an hour while admission still
# admitted 2-5. Every tick now reads the job waits of the newest live PR runs (live_runs API calls); their p50 over
# fast_factor x target cuts target_util at once, at most every fast_every_min.
CI_ADMISSION_DEFAULT = {"target_wait_min": 5.0, "util_init": 0.8, "util_min": 0.3, "util_max": 1.0, "util_step": 0.05,
                        "util_cut": 0.8, "pushes_per_pr": 2.0, "horizon_min": 60, "min_waits": 5,
                        "live_runs": 2, "fast_factor": 1.5, "fast_window_min": 30, "fast_every_min": 20}


def ci_admission_cfg(state: dict) -> dict:
    return {**CI_ADMISSION_DEFAULT, **(state.get("ci_admission_cfg") or {})}


def recent_job_waits(state: dict) -> list[float]:
    cfg = ci_profile_cfg(state)
    cut = now() - dt.timedelta(hours=float(cfg["wait_window_h"]))
    return sorted(x[1] for x in (state.get("ci_profile") or {}).get("waits", []) if (t := parse_iso(x[0])) and t >= cut)


def adjust_target_util(state: dict) -> str | None:
    """AIMD on the pool share admission may fill, once per profile sample: PR job wait p50 over target_wait_min cuts it
    (x util_cut), under 60% of the target raises it (+ util_step); in between, or with too few waits, it holds."""
    cfg = ci_admission_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    u = float(prof.get("target_util", cfg["util_init"]))
    waits = recent_job_waits(state)
    if len(waits) < int(cfg["min_waits"]):
        prof["target_util"] = u
        return None
    p50, target = waits[len(waits) // 2], float(cfg["target_wait_min"])
    if p50 > target:
        new = max(float(cfg["util_min"]), u * float(cfg["util_cut"]))
    elif p50 < 0.6 * target:
        new = min(float(cfg["util_max"]), u + float(cfg["util_step"]))
    else:
        new = u
    prof["target_util"] = round(new, 3)
    return f"ci admission: PR job wait p50 {p50} min vs target {target}: target_util {u:.2f} -> {new:.2f}" \
        if round(new, 3) != round(u, 3) else None


def live_pr_job_waits(state: dict, in_progress: list[dict] | None, gh=None) -> list[list]:
    """[job id, wait min] for the jobs of the newest live_runs pull_request runs in progress: a started job's queue
    wait, or a queued job's wait so far (a lower bound). One API call per run read."""
    n = int(ci_admission_cfg(state)["live_runs"])
    runs = sorted((r for r in in_progress or [] if r.get("event") == "pull_request" and r.get("id")),
                  key=lambda r: str(r.get("created_at") or ""), reverse=True)[:n]
    out = []
    for r in runs:
        try:
            jobs = (gh or gh_json)(f"repos/{REPO}/actions/runs/{r['id']}/jobs?per_page=100").get("jobs", [])
        except RuntimeError:
            continue
        for j in jobs:
            if j.get("conclusion") == "skipped" or not (c := parse_iso(j.get("created_at"))):
                continue
            s = None if j.get("status") == "queued" else parse_iso(j.get("started_at"))
            out.append([j.get("id"), round(max(0.0, ((s or now()) - c).total_seconds() / 60), 2)])
    return out


def fast_cut(state: dict, live: list[list]) -> str | None:
    """Fold this tick's live job waits into ci_profile.live_waits (by job id, fast_window_min kept) and cut target_util
    (x util_cut) when their p50 is over fast_factor x target_wait_min; at most every fast_every_min."""
    cfg = ci_admission_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    keep = now() - dt.timedelta(minutes=float(cfg["fast_window_min"]))
    seen = {str(x[0]): x for x in prof.get("live_waits", []) if (t := parse_iso(x[1])) and t >= keep}
    for jid, w in live:
        seen[str(jid)] = [jid, iso(now()), w]
    prof["live_waits"] = list(seen.values())[-300:]
    waits = sorted(x[2] for x in prof["live_waits"])
    if len(waits) < int(cfg["min_waits"]):
        return None
    p50, limit = waits[len(waits) // 2], float(cfg["fast_factor"]) * float(cfg["target_wait_min"])
    last = parse_iso(prof.get("fast_cut_at"))
    if p50 <= limit or (last and now() - last < dt.timedelta(minutes=float(cfg["fast_every_min"]))):
        return None
    u = float(prof.get("target_util", cfg["util_init"]))
    new = max(float(cfg["util_min"]), u * float(cfg["util_cut"]))
    prof["target_util"], prof["fast_cut_at"] = round(new, 3), iso(now())
    return f"ci admission: live PR job wait p50 {p50} min over {limit:g}: target_util {u:.2f} -> {new:.2f} (fast cut)"


def ci_admission(state: dict, backlog: dict) -> dict:
    """What admission would allow now: room = target_util x pool x horizon minus the work in hand (backlog) minus what
    live Claude workers will push (one PR's cost each), in runner-minutes; admit = launches that fit at one PR each.
    Crucible-repo work runs on its own repo's CI and is not priced here."""
    cfg, pcfg = ci_admission_cfg(state), ci_profile_cfg(state)
    prof = state.get("ci_profile") or {}
    u = float(prof.get("target_util", cfg["util_init"]))
    per_push = float(prof.get("per_push_rm") or 2 * float(pcfg["default_runner_min"]))
    per_launch = per_push * float(cfg["pushes_per_pr"])
    live = [r for r in claude_slot_holders(state) if not r.get("repo")]
    committed = len(live) * per_launch
    in_hand = float(backlog.get("queued_rm") or 0) + float(backlog.get("active_rm") or 0)
    room = u * int(backlog.get("pool") or pcfg["pool"]) * float(cfg["horizon_min"]) - in_hand - committed
    return {"target_util": round(u, 3), "per_launch_rm": round(per_launch), "committed_rm": round(committed),
            "room_rm": round(room), "admit": max(0, int(room // per_launch)) if per_launch > 0 else 0}


def workflow_cost(prof: dict, wf: str, cfg: dict) -> dict:
    """The learned cost of workflow file `wf`, else the median of known workflows, else default_runner_min."""
    known = prof.get("workflows") or {}
    if wf in known:
        return known[wf]
    rms = sorted(float(w.get("runner_min", 0)) for w in known.values()) or [float(cfg["default_runner_min"])]
    return {"runner_min": rms[len(rms) // 2], "wall_min": None, "jobs": None}


def ci_backlog(state: dict, q: dict, in_progress: list[dict] | None) -> dict:
    """Minutes the pool needs to drain the work in hand: queued runs at their learned runner-minutes plus what is left
    of runs in progress (shards queue AFTER a run's plan job starts, so queued runs alone miss most of the backlog),
    over `pool` runners. Plus the outcome: median pull_request job queue wait over wait_window_h."""
    cfg = ci_profile_cfg(state)
    prof = state.get("ci_profile") or {}
    pool = max(1, int(cfg["pool"]))
    by_wf = q.get("by_workflow") or {}
    queued_rm = sum(n * float(workflow_cost(prof, wf, cfg)["runner_min"]) for wf, n in by_wf.items())
    if q.get("unseen") and by_wf:
        queued_rm *= (sum(by_wf.values()) + q["unseen"]) / sum(by_wf.values())
    active_rm = 0.0
    for r in in_progress or []:
        c = workflow_cost(prof, os.path.basename(str(r.get("path", ""))), cfg)
        if (t := parse_iso(r.get("run_started_at") or r.get("created_at"))) and c.get("wall_min"):
            done = min(1.0, (now() - t).total_seconds() / 60 / max(1.0, float(c["wall_min"])))
            active_rm += float(c["runner_min"]) * (1 - done)
        else:
            active_rm += float(c["runner_min"]) / 2  # no wall time learned yet: assume half done
    waits = recent_job_waits(state)
    return {"backlog_min": round((queued_rm + active_rm) / pool, 1), "queued_rm": round(queued_rm),
            "active_rm": round(active_rm), "in_progress": None if in_progress is None else len(in_progress),
            "pool": pool, "job_wait_p50": waits[len(waits) // 2] if waits else None, "job_wait_n": len(waits)}


def ci_in_progress(gh=None, ignore=()) -> list[dict] | None:
    """Runs in progress (one API call, newest 100), minus the `ignore` workflows; None when unreadable."""
    try:
        runs = (gh or gh_json)(f"repos/{REPO}/actions/runs?status=in_progress&per_page=100").get("workflow_runs", [])
    except RuntimeError:
        return None
    return [r for r in runs if os.path.basename(str(r.get("path", ""))) not in set(ignore)]


def _json_or_empty(line: str) -> dict:
    try:
        r = json.loads(line)
    except ValueError:
        return {}
    return r if isinstance(r, dict) else {}


CI_SNAPSHOTS_KEEP_D = 30
CI_SNAPSHOTS_MAX_BYTES = 4_000_000  # ~300 B a tick, 144 ticks a day: trimming runs about once a month


def log_ci_snapshot(state: dict, q: dict, path: Path | None = None) -> None:
    """#36: append this tick's CI reading and the decision it fed. Only mode switches were logged before, so busy time
    and the queued/wait distribution had to be rebuilt from switch lines (the #34 analysis)."""
    path = path or CI_SNAPSHOTS
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    row = {"t": iso(now()), "host": HOST_ID, **{k: v for k, v in q.items() if k not in ("t", "by_workflow")},
           **{k: v for k, v in (state.get("ci_backlog") or {}).items() if k != "t"},
           **{k: v for k, v in (state.get("ci_admission") or {}).items() if k != "t"},
           "mode": state.get("ci_mode", "calm"), "mode_since": state.get("ci_mode_since"),
           "running": len(live), "running_backfill": sum(r.get("lane") == "backfill" for r in live),
           "queue_len": len(state.get("queue", []))}
    try:
        with open(path, "a") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
        if path.stat().st_size > CI_SNAPSHOTS_MAX_BYTES:
            cut = now() - dt.timedelta(days=CI_SNAPSHOTS_KEEP_D)
            path.write_text("".join(ln + "\n" for ln in path.read_text().splitlines()
                                    if (t := parse_iso(_json_or_empty(ln).get("t"))) and t >= cut))
    except OSError as e:
        log(f"ci snapshot not written: {e}", quiet=True)


def ci_snapshot_summary(hours: float = 24, path: Path | None = None) -> str:
    """Busy share and the queued / median-wait spread over the last `hours` of snapshots, for `churn status`."""
    path = path or CI_SNAPSHOTS
    if not path.exists():
        return "no CI snapshots yet"
    cut = now() - dt.timedelta(hours=hours)
    rows = [r for ln in path.read_text().splitlines()
            if (t := parse_iso((r := _json_or_empty(ln)).get("t"))) and t >= cut and "error" not in r]
    if not rows:
        return f"no CI snapshots in the last {hours:g} h"
    def mid(k):
        vs = sorted(r.get(k, 0) for r in rows)
        return vs[len(vs) // 2]
    busy = sum(r.get("mode") == "busy" for r in rows)
    idle_busy = sum(r.get("mode") == "busy" and not r.get("running") for r in rows)
    out = (f"CI last {hours:g} h: busy {100 * busy // len(rows)}% of {len(rows)} ticks ({idle_busy} with 0 running); "
           f"median queued {mid('queued')}, median wait {mid('median_wait_min')} min")
    # #38 step 3: admission decides; a hold is earned when PR jobs really waited over the target at the time
    if held := [r for r in rows if "admit" in r and r["admit"] < 1]:
        tw = float(CI_ADMISSION_DEFAULT["target_wait_min"])
        over = sum((r.get("job_wait_p50") or 0) > tw for r in held)
        out += f"; admission held {len(held)} ticks, {over} of them with PR job wait p50 over {tw:g} min"
    return out


HELD_PLAN_MAX_H = 48
OVERLAP_IGNORE = re.compile(r"(^docs/|\.md$|baseline|ledger|_report\b|CHANGELOG)")  # shared ledgers: the tick calls these harmless
_INFLIGHT: dict[str, set[str]] | None = None  # inflight_files() once per tick (git + one gh call per watched PR)


def held_plan(state: dict, x: dict) -> tuple[str, dict] | tuple[None, None]:
    """The newest held plan for a normal gitgalaxy item's issue (2026-10-16: 42 plan-held runs since 10-13, $22.50;
    10 issues planned 2-3 times because a requeued item planned again from scratch)."""
    if x.get("pr") or x.get("repo") or x.get("lane") in ("backfill", "ci") or x.get("backend") == "agy":
        return None, None
    cut = now() - dt.timedelta(hours=HELD_PLAN_MAX_H)
    task = str(x.get("task") or "")  # same issue is not enough: a later slice must not re-run an old slice's plan
    hits = [(rid, h) for rid, h in (state.get("held_plans") or {}).items()
            if h.get("issue") == x.get("issue") and (t := parse_iso(h.get("t"))) and t > cut
            and (rid in task or (h.get("task") and h["task"] == task))]
    return max(hits, key=lambda rh: rh[1]["t"], default=(None, None))


def plan_overlap(state: dict, x: dict) -> list[str]:
    """`who: file` overlaps that still hold item x's saved plan; checked by the gate, no plan run spent."""
    rid, h = held_plan(state, x)
    if not rid:
        return []
    global _INFLIGHT
    if _INFLIGHT is None:
        _INFLIGHT = inflight_files(rid)
    files = {f for f in h.get("files", []) if not OVERLAP_IGNORE.search(f)}
    return [f"{who}: {f}" for who, fs in _INFLIGHT.items() if who != f"worker {rid}" for f in sorted(files & fs)]


def backfill_rank(x: dict) -> int:
    """Backfill order (owner 2026-10-14): crucible-repo steps first (no CI cost, small Sonnet steps), then other
    backfill, L5 mutation last (long Opus runs with a real start-up cost)."""
    if x.get("repo") in CRUCIBLE_REPOS:
        return 0
    return 2 if "mutation" in str(x.get("task", "")).lower() else 1


def in_flight(x: dict) -> bool:
    """A PR fix, a ci-lane item or a RESUME of a preempted run: work already under way, never held by scope."""
    return bool(x.get("pr")) or x.get("lane") == "ci" or str(x.get("task", "")).startswith("RESUME")


def scope_held(x: dict) -> bool:
    return x.get("scope") == "frontier" and not x.get("promoted") and not in_flight(x)


def scope_rank(x: dict) -> int:
    return 0 if x.get("promoted") else SCOPE_RANK.get(x.get("scope"), 1)


def item_tier(x: dict) -> str | None:
    """The item's tier; an untiered "Siblings of #X" item is a follow-up (its task names the class it widens)."""
    if x.get("tier"):
        return x["tier"]
    return "followup" if re.search(r"\bsiblings of\b", str(x.get("task", "")), re.I) else None


def issue_meta(n: int) -> dict | None:
    """Issue #n's title + labels (one gh call), or None if unreadable."""
    r = run(["gh", "issue", "view", str(n), "--repo", REPO, "--json", "title,labels"])
    if r.returncode:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def issue_scope(n: int, meta: dict | None = None) -> str | None:
    """Scope from issue #n's `scope:<name>` label; None if unlabelled or unreadable."""
    d = meta if meta is not None else issue_meta(n)
    names = [str(lab.get("name", "")) for lab in (d or {}).get("labels") or []]
    return next((x[6:] for x in names if x.startswith("scope:") and x[6:] in SCOPES), None)


def issue_tier(n: int, meta: dict | None = None) -> str | None:
    """Tier from issue #n's `tier:<name>` label; else "followup" for a "Siblings of" issue; None if unknown."""
    d = meta if meta is not None else issue_meta(n)
    if d is None:
        return None
    for lab in d.get("labels") or []:
        name = str(lab.get("name", ""))
        if name.startswith("tier:") and name[5:] in TIERS:
            return name[5:]
    return "followup" if str(d.get("title", "")).lower().startswith("siblings of") else None


# Owner 2026-10-18: 20 of 70 merged PRs were core (33 infra). With 2 workers, ci-lane, infra and backfill items could
# hold both slots while a core item waited (in busy mode normal items never launched at all). `core_reserve` (default
# 1) Claude workers stay on scope:core whenever a core item can launch; PR fixes still go first (finishing beats starting).
CORE_RESERVE = 1


def core_short(state: dict) -> bool:
    """Fewer live (or just-picked) Claude workers on scope:core than state.core_reserve."""
    held = sum(1 for r in state.get("running", []) if r.get("scope") == "core" and r.get("backend") != "agy"
               and r.get("lane") not in ("backfill", "credit") and (r.get("picked") or pid_alive(r.get("pid"))))
    return held < int(state.get("core_reserve", CORE_RESERVE))


# Owner 2026-10-21: the factory had throughput but no goal. Work entered from labels, checklist lines and refills, so the
# queue drifted to wherever reviews had last filed siblings: 6 of 10 burned programs that did not translate whole had
# no issue at all, and the core slot took core items by position alone. The goal is an ordered list of stages, each an
# issue set (`churn goal add STAGE N`); the active stage's issues launch first in every pick (PR fixes, the core slot,
# normal work) and in the rule refill, later stages next, everything else after. With `goal_reports` in the host
# config, `churn goal measure` (the gate every measure_every_h) reads the repo's evidence reports, counts programs per
# level and names the programs with holes that no open issue mentions; the tick is asked to file and add those.
GOAL_DEFAULT = {"order": ["translate", "l5", "breadth"], "stage": "translate", "measure_every_h": 6,
                "line_partials_max": 3}
GOAL_REPORTS = _CFG.get("goal_reports") or {}  # {"fetch": "branch", "ref": "origin/branch", "path": "dir/of/reports"}


def goal_cfg(state: dict) -> dict:
    return {**GOAL_DEFAULT, **(state.get("goal") or {})}


def goal_rank(state: dict, x: dict) -> int:
    """0 = the active stage's issue, 1.. = later stages, len(order) = not goal work (earlier, finished stages too)."""
    g = goal_cfg(state)
    order = list(g["order"])
    stages = order[order.index(g["stage"]):] if g["stage"] in order else order
    issues = g.get("issues") or {}
    return next((k for k, s in enumerate(stages) if x.get("issue") in set(issues.get(s) or [])), len(order))


def stamp_scopes(state: dict, limit: int = 6) -> list[str]:
    """Give queue items without a scope their issue's scope (and tier) label, at most `limit` gh reads a tick; an
    item is read once (`scope_checked`). Before this, PR-fix and hand-queued items ranked level with sweep."""
    out, metas = [], {}
    for x in state.get("queue", []):
        if x.get("scope") or x.get("scope_checked") or not x.get("issue") or x.get("backend") == "agy":
            continue
        if x["issue"] not in metas:
            if len(metas) >= limit:
                break
            metas[x["issue"]] = issue_meta(x["issue"])
        if (meta := metas[x["issue"]]) is None:
            continue  # unreadable: try again next tick
        x["scope_checked"] = True
        if sc := issue_scope(x["issue"], meta):
            x["scope"] = sc
            out.append(f"#{x['issue']} {sc}")
        if not x.get("tier") and (tier := issue_tier(x["issue"], meta)):
            x["tier"] = tier
    return out


def pick_item(state: dict, snap: dict | None, mode: str) -> tuple[int, dict] | tuple[None, None]:
    """The next Claude queue item for this CI mode: PR fixes (core first), then a core item while core_short, then the
    `ci` lane (all always), then `normal` items
    when CI is calm (by tier, then position), or `backfill` items when it is busy (at most backfill_max running).
    2026-10-16: calm mode offers backfill too once the slots have sat idle (nothing else launchable) for
    backfill_idle_ticks ticks in a row; the streak keeps a just-unblocked normal item from losing its box to it."""
    q = [(i, x) for i, x in enumerate(state.get("queue", [])) if not x.get("needs_owner") and x.get("backend") != "agy"
         and not blocked_by(x, snap, state) and not waiting(x) and not plan_overlap(state, x) and not scope_held(x)]
    fix = min(((i, x) for i, x in q if x.get("pr")), key=lambda ix: (scope_rank(ix[1]), goal_rank(state, ix[1]), ix[0]),
              default=None)
    if fix:
        return fix
    for i, x in q:
        if x.get("auto") == "main-red":
            return i, x  # a red main blocks every PR, core ones too
    if core_short(state) and (core := min(((i, x) for i, x in q if x.get("scope") == "core"
                                           and x.get("lane") in (None, "normal", "ci")),
                                          key=lambda ix: (goal_rank(state, ix[1]), TIER_RANK[item_tier(ix[1])], ix[0]),
                                          default=None)):
        return core  # the core slot: at least core_reserve workers on scope:core, in busy mode too
    for i, x in q:
        if x.get("lane") == "ci":
            return i, x
    cfg = ci_cfg(state)
    live = [r for r in state.get("running", []) if r.get("lane") == "backfill" and pid_alive(r.get("pid"))]
    if mode == "busy":
        since = parse_iso(state.get("ci_mode_since"))
        if since and (now() - since).total_seconds() / 60 < float(cfg["backfill_min_busy_min"]):
            return None, None  # a short busy spell: a backfill launched now would be preempted again within minutes
        if len(live) < int(cfg["backfill_max"]):
            return min(((i, x) for i, x in q if x.get("lane") == "backfill"),
                       key=lambda ix: (scope_rank(ix[1]), backfill_rank(ix[1]), ix[0]), default=(None, None))
        return None, None
    normal = min(((i, x) for i, x in q if x.get("lane") in (None, "normal")),
                 key=lambda ix: (scope_rank(ix[1]), goal_rank(state, ix[1]), TIER_RANK[item_tier(ix[1])], ix[0]),
                 default=(None, None))
    if normal[1] is not None or len(live) >= int(cfg["backfill_max"]) \
            or int(state.get("idle_streak", 0)) < int(cfg["backfill_idle_ticks"]):
        return normal
    return min(((i, x) for i, x in q if x.get("lane") == "backfill"),
               key=lambda ix: (scope_rank(ix[1]), backfill_rank(ix[1]), ix[0]), default=(None, None))


def idle_causes(state: dict, snap: dict | None, mode: str) -> str:
    """Why no Claude queue item could launch, for the quiet line (owner 2026-10-16: 39 idle ticks a day said only
    "nothing launchable"). Counts items per cause; blocked items also name their blockers, which `factory` totals."""
    c: collections.Counter = collections.Counter()
    blockers: collections.Counter = collections.Counter()
    for x in state.get("queue", []):
        if x.get("backend") == "agy":
            c["agy"] += 1
        elif x.get("needs_owner"):
            c["owner"] += 1
        elif scope_held(x):
            c["frontier"] += 1
        elif bl := blocked_by(x, snap, state):
            c["blocked"] += 1
            blockers.update(bl)
        elif waiting(x):
            c["wait"] += 1
        elif plan_overlap(state, x):
            c["plan-overlap"] += 1
        elif x.get("lane") == "backfill" and mode != "busy":
            c["backfill-calm"] += 1
        elif x.get("lane") in (None, "normal") and not x.get("pr") and mode == "busy":
            c["ci-admission"] += 1
        else:
            c["other"] += 1  # launchable by its own rule (a pace or plan hold, or a backfill already running)
    if not c:
        return "idle: empty"
    room = (state.get("ci_admission") or {}).get("room_rm")
    return "idle: " + ", ".join(f"{k} {v}" + (" (" + " ".join(f"#{n}x{m}" for n, m in blockers.most_common(3)) + ")"
                                               if k == "blocked" else f" (room {room} runner-min)"
                                               if k == "ci-admission" and room is not None else "")
                                for k, v in c.most_common())


def unapplied_owner_answers() -> list[dict]:
    """Owner replies in owner-answers.jsonl the tick has not applied yet. One the tick looked at and could not map stays
    `applied: false` with an `applied_note` saying why; that one waits for the owner, so it does not wake the model."""
    try:
        lines = (H / "owner-answers.jsonl").read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict) and not e.get("applied") and not e.get("applied_note"):
            out.append(e)
    return out


def gate(state: dict, b: dict, force: list[str], needs: dict[str, str] | None = None,
         snap: dict | None = None) -> tuple[list[str], str]:
    """needs: {key: reason} from reconcile (review #n@head, followup #n), already filtered by the stall rule."""
    reasons = list(force)
    if needs:
        reasons += list(needs.values())
    # 2026-10-22: the gate never looked at owner answers, so seven 10-21 rulings sat unapplied for a day while the
    # ticks it did wake (refill, launch) stayed on their own reason. Step 0b applies them.
    if answers := unapplied_owner_answers():
        reasons.append("owner answers to apply (step 0b, owner-answers.jsonl): " + ", ".join(
            f"{e.get('id', '?')} ({str(e.get('question') or e.get('item') or '')[:60]})" for e in answers))
    pending = [e for e in state.get("reports_pending", []) if not auto_checkable(e)  # agy `done`: the lane launches a checker
               and not precheck_holds(e)]
    if pending:
        reasons.append("review: " + ", ".join(
            f"{e['run_id']} ({e['status']}" + (f"; {e['review_why']}" if e.get("review_why") else "")
            + (f"; PRECHECK FAILED again after its automatic send-back: {e['precheck_problems']}" if e.get("precheck") == "fail"
               else "") + ")" for e in pending))
    live = claude_slot_holders(state)
    agy = [r for r in state.get("running", []) if not r.get("run_id")]  # hand-tracked / legacy entries
    if not state.get("workers_paused"):
        plan = rate_plan(state)
        free = worker_slots(b, len(live), slot_ceiling(state, plan))
        if state.get("ci_mode") == "busy" and not free and b.get("verdict") == "GREEN" and b.get("free_slots", 0) >= 1:
            free = 1  # backfill takes no Claude slot; pick_item only offers backfill if no PR fix / ci item is waiting

        mode = state.get("ci_mode", "calm")
        cand = budget_picks(state, snap, mode, max(free, 1), plan)
        idx, item = cand[0] if cand else (None, None)
        if free and not item and (x := pick_item(state, snap, mode)[1]):
            m = x.get("model", "sonnet")
            log(f"launch held by pace: next #{x['issue']} ({m}"
                + (f", ~${plan['cost'][m]:.0f} in this block" if plan else "") + "): "
                + (plan["why"] if plan else f"opus {live_opus_count(state)}/{state.get('max_opus', 1)}"), quiet=True)
        if item and item.get("lane") != "backfill" and not worker_slots(b, len(live), slot_ceiling(state, plan)):
            item = None  # the extra slot above is for backfill only
        open_prs = [n for n in prs_needing_work(snap or {}, live, state) if not (item and item.get("pr") == int(n))]
        if free and item and not item.get("pr") and item.get("lane") != "backfill" and len(open_prs) >= 3:
            log(f"launch held: {len(open_prs)} churn PRs need work ({', '.join('#' + n for n in open_prs)}); "
                "finish those first", quiet=True)
            item = None
        if free and item:
            ok, why = (True, plan["why"]) if plan else pace_allows(state, item.get("model", "sonnet"))
            if ok:
                n = min(free, int(b.get("free_slots", free) or free))
                picks = [(idx, item)] + [(k, x) for k, x in cand[1:]
                                         if (x.get("lane") == "backfill") == (item.get("lane") == "backfill")][:n - 1]

                def desc(k, x):
                    what = (f"PR fix for #{x['pr']}: work on that PR's own branch (send-back or `churn worker --worktree "
                            f"--branch`), the PR exists already" if x.get("pr") else x.get("model", "sonnet"))
                    return (f"queue[{k}] #{x['issue']} ({what}, lane {x.get('lane', 'normal')}"
                            + (f", repo {x['repo']}: `churn worker --repo {x['repo']}`" if x.get("repo") else "") + ")")
                reasons.append(f"launch slot{'s' if len(picks) > 1 else ''}: box {b.get('verdict')} free_slots "
                               f"{b.get('free_slots')}, launch {len(picks)}: next " + "; ".join(desc(k, x) for k, x in picks)
                               + f" (rm the highest index first); {why}; {state.get('ci_mode', 'calm')} CI")
    if agy:
        stale = [r for r in agy if (t := parse_iso(r.get("started"))) and now() - t > dt.timedelta(hours=3)]
        last = parse_iso(state.get("last_model_tick"))
        if stale and (not last or now() - last > dt.timedelta(hours=3)):
            reasons.append("non-churn entries in running for 3h+: " + ", ".join(r.get("agent", "?") for r in stale))
    # Owner 2026-10-16: ticks run on Sonnet; Opus only to review an Opus worker's PR (the big changes). 61% of ticks
    # were Opus, mostly for launches, followups and small re-reviews.
    model = "opus" if any(e.get("review_model") == "opus" or (not e.get("review_model") and e.get("model") == "opus"
                                                             and e.get("pr")) for e in pending) else "sonnet"
    return reasons, model


def pr_in_hand(n: str, v: dict, live: list[dict]) -> bool:
    """A live worker is already on PR n: its task names it (#n), or the PR's churn/<issue>- branch is its issue."""
    tasks = " ".join(r.get("task") or "" for r in live)
    m = re.match(r"churn/(\d+)-", v.get("branch", ""))
    return bool(re.search(rf"#{n}\b", tasks) or (m and m.group(1) in {str(r.get("issue")) for r in live}))


FLAKE_HOURS = 2


def flaked(state: dict, n: str, v: dict) -> bool:
    """The tick declared PR n's red at this head a CI flake and reran it (`churn pr flake`): no fix item for it until
    the head changes or FLAKE_HOURS pass (2026-10-14: #5105's Db2 pull flake was re-queued and dropped every tick)."""
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None) or {}
    fh, at = str(p.get("flake_head") or ""), parse_iso(p.get("flake_at"))
    return bool(fh and "head" in v and (fh.startswith(v["head"]) or v["head"].startswith(fh[:12]))
                and at and now() - at < dt.timedelta(hours=FLAKE_HOURS))


def queue_main_red(state: dict, issues: list[dict], snap: dict | None = None) -> list[str]:
    """Owner 2026-10-14: main sat red for hours (#5091 Full Suite since 05:36Z, #5094 Evidence Refresh) while churn only
    watched PRs. Each open `ci-red-main` issue with no live worker and no queue item becomes a `ci`-lane item."""
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    have = {q["issue"] for q in state.get("queue", [])} | {r.get("issue") for r in live}
    # 2026-10-14: the issue stays open until its fix merges AND the workflow passes on main; a watched PR or a report
    # waiting for review for it means the work is done or in flight -- don't queue it again.
    have |= {p.get("issue") for p in state.get("prs", []) if isinstance(p, dict) and p.get("issue")}
    have |= {e.get("issue") for e in state.get("reports_pending", [])}
    have |= {int(m.group(1)) for v in (snap or {}).values() if v.get("state") == "open"
             if (m := re.match(r"churn/(\d+)-", v.get("branch", "")))}
    added = []
    for i in issues:
        n = int(i["number"])
        if n in have:
            continue
        state.setdefault("queue", []).insert(0, {
            "issue": n, "model": "sonnet", "needs_owner": False, "lane": "ci", "allow_workflows": True, "auto": "main-red",
            "task": (f"Main is red: {i.get('title', '')} (#{n}). Read the failing runs named in the issue (latest first, "
                     "tests/tools/ci_digest.py), separate infrastructure flakes (rerun them) from real failures, and fix "
                     "the real ones in one PR with tests (class sweep: siblings of each failure). The issue closes itself "
                     "when the workflow next succeeds on main.")})
        added.append(f"#{n}")
    return added


def red_main_issues() -> list[dict]:
    try:
        return [i for i in gh_json(f"repos/{REPO}/issues?labels=ci-red-main&state=open&per_page=50") if "pull_request" not in i]
    except RuntimeError:
        return []


NOISE = {"infra", "flake", "main"}  # ci_digest triage the shepherd handles by rerunning (or main's own fix)
CI_RED: dict[int, str] = {}  # PR -> its failing checks at the last triage, for the fix brief (#19: no tick to read CI)


def ci_triage(n: int) -> list[str] | None:
    """ci_digest's triage of PR n's failed checks at its current head (origin/main's ci_digest in TOOLS), or None when
    it cannot be read. [] = nothing failing right now (CI still running, or the label is stale)."""
    try:  # ci_digest exits 1 whenever something failed; its JSON is the answer either way
        r = run([sys.executable, str(TOOLS / "tests" / "tools" / "ci_digest.py"), str(n), "--json"], timeout=300)
        failed = json.loads(r.stdout)["failed"]
        CI_RED[n] = "; ".join(f"{f.get('check')} ({f.get('triage')})"
                              + (f": {' '.join((f.get('tests') or [])[:3])}" if f.get("tests") else "")
                              + (f", repro `{f['repro']}`" if f.get("repro") else "") for f in failed)[:600]
        return [f.get("triage") for f in failed]
    except (ValueError, KeyError, TypeError, AttributeError, subprocess.TimeoutExpired):
        return None


def mark_flake(state: dict, n: str, head: str, note: str) -> None:
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
    if p is None:
        p = {"number": int(n)}
        state.setdefault("prs", []).append(p)
    p.update(flake_head=head, flake_at=iso(now()), flake_note=note[:200])


def prune_pr_fixes(state: dict, snap: dict) -> list[str]:
    """Drop auto PR-fix items whose PR moved on: closed, or its head changed since the item was queued (a worker or
    send-back already pushed; the next pass judges the new head). 2026-10-16: ticks spent ~48 turns in 4 days dropping
    such items by hand."""
    out, keep = [], []
    for q in state.get("queue", []):
        v = snap.get(str(q.get("pr"))) if q.get("auto") == "pr-fix" else None
        if v is not None and (v.get("state") != "open" or (q.get("head") and v.get("head") and q["head"] != v["head"])):
            out.append(f"#{q['pr']}")
            continue
        keep.append(q)
    state["queue"] = keep
    return out


FIX_LOOP_CAP, FIX_LOOP_WINDOW_H = 3, 24


def recent_fix_runs(pr: int, issue: int) -> int:
    """Fix-loop runs (PR fixes naming #pr, send-backs and precheck retries of the issue's runs) started in the window.
    A run known to have committed nothing of its own (merge-only or no-op, #20) is not a fix round."""
    cut = now() - dt.timedelta(hours=FIX_LOOP_WINDOW_H)
    n = 0
    for d in RUNS.glob(f"{issue}-*"):
        m = _run_meta(d.name)
        t = parse_iso(m.get("started"))
        if not t or t < cut or m.get("check_of") or m.get("code_changed") is False:
            continue
        kind = run_kind(m)
        if (kind == "pr_fix" and re.search(rf"#{pr}\b", m.get("task") or "")) or kind in ("send_back", "precheck_retry"):
            n += 1
    return n


RESCUE_AT = 2  # Sonnet fix runs in the window before the one Opus rescue run (owner 2026-10-17)
RESCUE_TAG = "RESCUE"


def was_rescued(pr: int, issue: int) -> bool:
    """An Opus rescue run for this PR has started (ever: one rescue per PR)."""
    return any(re.match(rf"{RESCUE_TAG} \(Fix PR #{pr}\b", _run_meta(d.name).get("task") or "") for d in RUNS.glob(f"{issue}-*"))


def rescue_task(n, branch: str | None, issue: int, loops: int, why: list[str]) -> str:
    """The Opus rescue brief: judge the PR before touching it, then one verdict (owner 2026-10-17)."""
    return (f"{RESCUE_TAG} (Fix PR #{n}, Opus) ({branch}): {loops} fix runs in {FIX_LOOP_WINDOW_H} h and it is back"
            f"{' (' + ' + '.join(why) + ')' if why else ''}. Owner OK (2026-10-17): a rescue run may close this PR and "
            f"edit issue #{issue}. FIRST judge, before changing anything: read issue #{issue}, the PR's diff and size, "
            f"every review note and send-back reason, its CI failures and the earlier runs' reports "
            f"({RUNS}/{issue}-*/report.md). Then end your report with `## Rescue verdict: SAVE|SLICE|RESTART|OWNER` and "
            f"why. SAVE: the fix is tractable; do it now on the PR's branch (merge origin/main, never rebase; gates; "
            f"push). SLICE: sound but too big (5-file rule); cut this PR to a first self-contained slice of <= 5 "
            f"hand-written files, push, and list the rest under **Remaining slices**. RESTART: the approach is wrong; "
            f"close the PR with a comment saying why, then edit issue #{issue}: append `## Plan (Opus rescue of PR "
            f"#{n})` with ordered steps, each one Sonnet-sized PR of <= 5 hand-written files with its own acceptance "
            f"check, the pitfalls the failed attempts hit, and what to reuse from the closed branch; list the same "
            f"steps under **Remaining slices**. OWNER: only for a ruling only the owner can make; ask one plain question. "
            f"There is no second rescue: if this fails again the PR goes to the owner.")


FIX_SETTLE_MIN = 15  # a run on the PR finished this recently: CI on its push has not reported yet (#20)


def update_branch(n: int) -> bool:
    """Merge origin/main into PR n's branch on GitHub (the update-branch API): True when GitHub took it, False on a real
    conflict (422) or any other failure. #20: ~8 Claude fix runs a night only merged main and pushed."""
    return not run(["gh", "api", "-X", "PUT", f"repos/{REPO}/pulls/{n}/update-branch"]).returncode


def recently_settling(state: dict, n: str, v: dict, issue: int) -> bool:
    """A run on PR n is not judged yet (its report waits for review) or finished under FIX_SETTLE_MIN ago (#20: four
    resume/fix runs found their work already done, one fix overlapped an Opus rescue)."""
    if any(e.get("issue") == issue for e in state.get("reports_pending", [])):
        return True
    cut = now() - dt.timedelta(minutes=FIX_SETTLE_MIN)
    return any(m.get("branch") == v.get("branch") and (t := parse_iso(m.get("finished"))) and t > cut
               for d in RUNS.glob(f"{issue}-*") if (m := _run_meta(d.name)))


def carry_reviews(state: dict, snap: dict, compare=None) -> list[str]:
    """A PR the gate updated with main (update_branch) keeps its review: when its head moved from `updated_from` by
    exactly GitHub's one merge commit, the verdict given at the old head is re-stamped at the new one, so the update
    costs no re-review model tick."""
    out = []
    for p in state.get("prs", []):
        if not isinstance(p, dict) or not (old := str(p.get("updated_from") or "")):
            continue
        v = snap.get(str(pr_num(p)), {})
        if v.get("state") != "open" or not v.get("head") or old.startswith(v["head"]) or v["head"].startswith(old[:12]):
            continue
        p.pop("updated_from")
        rh = str(p.get("reviewed_head") or "")
        if not (rh and p.get("verdict") and (rh.startswith(old) or old.startswith(rh[:12]))):
            continue
        try:
            c = (compare or gh_json)(f"repos/{REPO}/compare/{old}...{v['head']}")
            commits = c.get("commits") or []
        except (RuntimeError, ValueError, AttributeError):
            continue
        if len(commits) == 1 and len(commits[0].get("parents") or []) == 2:
            p["reviewed_head"] = v["head"]
            out.append(f"#{pr_num(p)} {p['verdict']} -> {v['head']}")
    return out


def queue_pr_fixes(state: dict, snap: dict, triage=None, update=None) -> list[str]:
    """Owner 2026-10-13: #5038/#5041 sat conflicting for hours because a tick with no free slot only logged them and
    stuck_seen then hid them. Any watched open PR that is conflicting (dirty) or shepherd:needs-fix, with no live worker
    on it and no queue item for it, gets a fix item at the FRONT of the queue (key "pr").
    2026-10-16: so does a PR reviewed send-back at its current head. #5204's send-back waited for #5201; when #5201
    merged a tick dropped the fix item ("clean, nothing to fix"), the head never moved, and 5 items blocked on it idled
    the slots ~20 h. A send-back stays a need until the head changes."""
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    queued = {int(q["pr"]) for q in state.get("queue", []) if q.get("pr")}
    issue_of = {pr_num(p): p.get("issue") for p in state.get("prs", []) if isinstance(p, dict)}
    added = []
    for n, v in snap.items():
        if v.get("state") != "open" or int(n) in queued or pr_in_hand(n, v, live) or flaked(state, n, v):
            continue
        sent_back = verdict_at_head(state, n, v) == "send-back"
        why = [w for w, hit in (("conflicts with main", v.get("mergeable_state") == "dirty"),
                                ("shepherd:needs-fix", "shepherd:needs-fix" in v.get("labels", [])),
                                ("review sent it back", sent_back)) if hit]
        if not why:
            continue
        m = re.match(r"churn/(\d+)-", v.get("branch", ""))
        issue = issue_of.get(int(n)) or (int(m.group(1)) if m else int(n))
        if recently_settling(state, n, v, issue):
            continue
        entry = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
        if why == ["conflicts with main"] and entry is not None and entry.get("update_tried") != v.get("head"):
            # #20: a branch that only needs main merged is GitHub's job, not a model's; a real conflict fails (422)
            entry["update_tried"] = v.get("head")
            if (update or update_branch)(int(n)):
                entry["updated_from"] = v.get("head")
                added.append(f"updated:#{n}")
                continue
        if why == ["shepherd:needs-fix"]:  # a red, not a conflict: only a REAL failure is a worker's job
            kinds = (triage or ci_triage)(int(n))
            if kinds is not None and not [k for k in kinds if k not in NOISE]:
                if "main" in kinds and entry is not None and entry.get("update_tried") != v.get("head"):
                    entry["update_tried"] = v.get("head")  # main's own red: take main's fix, no worker
                    if (update or update_branch)(int(n)):
                        entry["updated_from"] = v.get("head")
                        added.append(f"updated:#{n}")
                        continue
                if kinds:  # infra / flake / main only: the shepherd reruns it; look again in FLAKE_HOURS or on a new head
                    mark_flake(state, n, v.get("head", ""), "gate: CI noise only (" + ", ".join(sorted(set(kinds))) + ")")
                    added.append(f"noise:#{n} ({', '.join(sorted(set(kinds)))})")
                if not kinds:  # nothing failing at this head yet: not churn work until triage finds a failure
                    for p in state.get("prs", []):
                        if isinstance(p, dict) and pr_num(p) == int(n):
                            p["clean_head"] = v.get("head")
                continue
        loops = recent_fix_runs(int(n), issue)
        # Owner 2026-10-17: two Sonnet fix runs, then ONE Opus rescue that judges the PR (save / slice / restart /
        # owner); a PR that fails again after its rescue goes to the owner. Before: the owner at 3 runs, no rescue.
        rescued = loops >= RESCUE_AT and was_rescued(int(n), issue)
        rescue = loops >= RESCUE_AT and not rescued
        if rescued:  # 2026-10-16: chains of 3+ workers chased one PR's CI timings; the owner decides
            why.append(f"{loops} fix runs in {FIX_LOOP_WINDOW_H} h and an Opus rescue already ran, owner decides")
        note = next((str(p.get("note") or "") for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), "")
        review = (f" The review at this head asked for: {note[:400]} (This item comes back every tick until the head "
                  f"changes: to defer it use `churn queue wait`, never `churn queue rm`.)" if sent_back and note else "")
        if "shepherd:needs-fix" in why and CI_RED.get(int(n)):
            review += f" Red at this head (ci_digest): {CI_RED[int(n)]}."
        task = (rescue_task(n, v.get("branch"), issue, loops, why) + review if rescue else
                f"Fix PR #{n} ({v.get('branch')}): {' + '.join(why)}. Work on the PR's own branch: merge origin/main "
                f"(never rebase), resolve (regenerate generated docs, never hand-merge them), read any red check and fix "
                f"what is real, gates, push; report the PR's CI." + review)
        state.setdefault("queue", []).insert(0, {"issue": issue, "pr": int(n), "model": "opus" if rescue else "sonnet",
                                                 "task": task, "needs_owner": rescued, "auto": "pr-fix",
                                                 **({"rescue": True} if rescue else {}),
                                                 **({"head": v["head"]} if v.get("head") else {})})
        added.append(f"#{n}")
    return added


def verdict_at_head(state: dict, n: str, v: dict) -> str | None:
    """The tick's recorded verdict for PR n if it was given at the PR's CURRENT head (else None)."""
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
    rh = str((p or {}).get("reviewed_head") or "")
    if rh and "head" in v and (rh.startswith(v["head"]) or v["head"].startswith(rh[:12])):
        return p.get("verdict")
    return None


def owner_holds(state: dict, snap: dict) -> list[str]:
    """Open PRs the tick put on hold at their current head: they wait on the owner, not on churn."""
    return [n for n, v in snap.items() if v.get("state") == "open" and verdict_at_head(state, n, v) == "hold"]


def fix_merge_labels(state: dict, snap: dict, dry_run: bool = False) -> list[str]:
    """Owner 2026-10-14: #5080 was reviewed `merge` at its head but lost shepherd:merge (shepherd:reapprove instead), so
    nothing would ever merge it. A PR reviewed `merge` at its CURRENT head gets its labels put back (the skill's rule:
    re-add shepherd:merge only if that head was reviewed)."""
    out = []
    for n, v in snap.items():
        labels = set(v.get("labels", []))
        if (v.get("state") == "open" and verdict_at_head(state, n, v) == "merge"
                and ("shepherd:merge" not in labels or "shepherd:reapprove" in labels)
                and not labels & {"shepherd:needs-fix"} and v.get("mergeable_state") != "dirty"):
            if not dry_run:
                gh_label(int(n), add="shepherd:merge", remove="shepherd:reapprove")
            out.append(f"#{n}")
    return out


def owner_parked(state: dict, n: str) -> bool:
    """PR n waits on the owner: its fix item is needs_owner (fix-loop cap), or one of its needs stalled."""
    return any(q.get("pr") == int(n) and q.get("needs_owner") for q in state.get("queue", [])) or \
        any(re.match(rf"(review|followup|orphan PR) #{n}\b", k) for k in state.get("stalled", []))


def clean_at_head(state: dict, n: str, v: dict) -> bool:
    """The gate's triage found nothing failing at this head (a stale shepherd:needs-fix label); re-triaged every tick."""
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None) or {}
    return bool(v.get("head")) and p.get("clean_head") == v["head"]


def prs_needing_work(snap: dict, live: list[dict] | None = None, state: dict | None = None) -> list[str]:
    """Open watched PRs that need churn work (fix rule 3). A PR with shepherd:merge that is only waiting for CI or the
    shepherd doesn't count: holding launches for those would stall churn behind CI. With `live` (running Claude
    workers), a PR a live worker is already fixing doesn't count either (owner 2026-10-13, for the agy lane): its task
    names the PR (#n), or the PR's churn/<issue>- branch is that worker's issue."""
    out = []
    for n, v in snap.items():
        if v.get("state") != "open":
            continue
        if live and pr_in_hand(n, v, live):
            continue
        if state is not None and verdict_at_head(state, n, v) in ("hold", "merge"):
            continue  # hold: waits on the owner; merge at this head: fix_merge_labels puts the labels back
        if state is not None and (owner_parked(state, n) or flaked(state, n, v) or clean_at_head(state, n, v)):
            continue  # 2026-10-16 audit: three such PRs held all normal churn with nothing scheduled to clear them
        labels = set(v.get("labels", []))
        if ("shepherd:merge" not in labels or labels & {"shepherd:reapprove", "shepherd:needs-fix"}
                or v.get("mergeable_state") == "dirty"):
            out.append(n)
    return out


def auto_checkable(e: dict) -> bool:
    return e.get("backend") == "agy" and e.get("status") == "done"


def lanes(b: dict, snap: dict, claude_paused: bool, dry_run: bool = False) -> list[str]:
    """Deterministic launches that need no model tick: a Sonnet checker for each finished agy run (Claude slot
    needed), and agy workers from `backend: agy` queue items (agy's own quota: runs during a Claude pause too)."""
    did = []
    state = load_state()
    if state.get("workers_paused"):
        return did
    live_claude = claude_slot_holders(state)
    cfg = agy_cfg(state)
    if not claude_paused:
        for e in [e for e in state.get("reports_pending", []) if auto_checkable(e)]:
            if worker_slots(b, len(live_claude), int(state.get("max_workers", 2))) <= 0:
                break
            meta = json.loads((RUNS / e["run_id"] / "meta.json").read_text())
            did.append(f"checker for {e['run_id']}")
            if dry_run:
                live_claude.append(e)
                continue
            brief = CHECK_BRIEF.format(issue=e["issue"], wt=meta["worktree"], branch=meta["branch"], agy_dir=RUNS / e["run_id"],
                                       repo_dir=V6, python=SELFSCAN_PY)
            with contextlib.redirect_stdout(open(os.devnull, "w")):
                cmd_worker(argparse.Namespace(resume_run=None, issue=e["issue"], model=cfg["checker_model"],
                                              task=f"check agy run {e['run_id']}", brief=brief, brief_file=None, force=False,
                                              plan=False, worktree=meta["worktree"], branch=meta["branch"], check_of=e["run_id"]))
            with edit_state() as st:
                st["reports_pending"] = [x for x in st.get("reports_pending", []) if x["run_id"] != e["run_id"]]
            live_claude.append(e)
    paused = parse_iso(cfg.get("paused_until"))
    live_agy = [r for r in state.get("running", []) if r.get("backend") == "agy" and pid_alive(r.get("pid"))]
    item = next((q for q in state.get("queue", []) if q.get("backend") == "agy" and not q.get("needs_owner")
                 and not blocked_by(q, snap) and not waiting(q)), None)
    if (item and cfg["enabled"] and not (paused and now() < paused) and len(live_agy) < cfg["max_running"]
            and b.get("verdict") == "GREEN" and b.get("free_slots", 0) >= 1 and len(prs_needing_work(snap, live_claude, state)) < 3):
        did.append(f"agy worker for #{item['issue']}")
        if not dry_run:
            with contextlib.redirect_stdout(open(os.devnull, "w")):
                cmd_agy(argparse.Namespace(issue=item["issue"], task=item.get("task"), model=item.get("agy_model"),
                                           brief_file=None, force=False))
            with edit_state() as st:
                q = st.get("queue", [])
                with contextlib.suppress(ValueError):
                    q.remove(item)
    return did


def _run_meta(rid: str) -> dict:
    with contextlib.suppress(OSError, ValueError):
        return json.loads((RUNS / rid / "meta.json").read_text())
    return {}


WARM_RESUME_MIN = 55  # a run finished this recently resumes inside the 1 h prompt cache (send-back's limit is 60)


def direct_spec(state: dict, snap: dict, x: dict) -> dict | None:
    """How the gate can launch item x itself, or None if a model tick must write its brief (owner 2026-10-16: ~330 of
    ~440 model ticks since 10-14 carried a launch; for these items the brief already exists):
    - a PR fix, when a churn worktree of its issue is on the PR's branch;
    - a backfill RESUME item (the preempted run's worktree);
    - an item whose plan was held, once the overlap cleared: it implements the saved plan, no new plan run."""
    def tree(meta):
        return meta if meta.get("worktree") and Path(meta["worktree"]).is_dir() else None
    if x.get("pr"):
        branch = (snap.get(str(x["pr"])) or {}).get("branch")
        metas = sorted((m for d in RUNS.glob(f"{x['issue']}-*") if (m := _run_meta(d.name))), key=lambda m: m.get("started", ""))
        m = next((m for m in reversed(metas) if branch and m.get("branch") == branch and tree(m)), None)
        if m and m.get("session_id") and m.get("status") == "done" and not m.get("repo") and not x.get("rescue") and (
                m.get("model") == x.get("model", "sonnet")) and (
                t := parse_iso(m.get("finished"))) and now() - t < dt.timedelta(minutes=WARM_RESUME_MIN):
            # #19: the run that wrote this PR is still in the 1 h prompt cache: the fix goes back into its session
            return {"worktree": m["worktree"], "branch": branch, "brief": x["task"], "plan": False, "resume_run": m["run_id"]}
        return m and {"worktree": m["worktree"], "branch": branch, "brief": x["task"], "plan": False, "repo": m.get("repo")}
    if x.get("lane") == "backfill" and (r := re.match(r"RESUME backfill run (\S+)", str(x.get("task", "")))):
        m = tree(_run_meta(r.group(1)))
        return m and {"worktree": m["worktree"], "branch": m.get("branch"), "brief": x["task"], "plan": False,
                      "repo": m.get("repo"), "lane": "backfill"}
    rid, _ = held_plan(state, x)
    if not rid and (spec := fresh_spec(state, snap, x)):
        return spec
    if rid and (m := tree(_run_meta(rid))):
        prompt = (RUNS / rid / "prompt.md").read_text() if (RUNS / rid / "prompt.md").exists() else x.get("task", "")
        return {"worktree": m["worktree"], "branch": m.get("branch"), "plan": False, "held_plan": rid,
                "brief": (f"PHASE 2 (the gate checked your saved plan's files against the in-flight work: the overlap "
                          f"that held it has cleared). Implement the plan in {RUNS / rid / 'plan.md'}; first `git merge "
                          f"origin/main` (never rebase), since this worktree may be behind. Queue task: {x.get('task', '')}"
                          f"\n\n{prompt}")}
    return None


SKILL_MD = Path.home() / ".claude/skills/night-shift/SKILL.md"


def worker_brief_template() -> str | None:
    """The skill's "## Worker brief" section, read live so the gate's brief and a tick's brief stay one text."""
    with contextlib.suppress(OSError):
        m = re.search(r"^## Worker brief[^\n]*\n(.*?)(?=^## )", SKILL_MD.read_text(), re.S | re.M)
        return m.group(1).strip() if m else None
    return None


def fresh_spec(state: dict, snap: dict, x: dict) -> dict | None:
    """A new normal/ci-lane item the gate launches itself (owner 2026-10-16: a launch-only model tick just filled the
    skill's brief template). Only with plan_first on, since the plan's impact check is what catches file overlap with
    in-flight work; never a crucible step, an owner item, or an issue with a live run or an open churn PR."""
    if (x.get("pr") or x.get("repo") or x.get("needs_owner") or x.get("backend") == "agy"
            or x.get("lane", "normal") not in ("normal", "ci") or not state.get("features", {}).get("plan_first")):
        return None
    issue = x.get("issue")
    if crucible_repo_of(issue) or any(r.get("issue") == issue for r in state.get("running", []) if pid_alive(r.get("pid"))):
        return None
    if any(str(v.get("branch") or "").startswith(f"churn/{issue}-") and v.get("state") == "open" for v in snap.values()
           if isinstance(v, dict)):
        return None
    if not (tpl := worker_brief_template()):
        return None
    task = str(x.get("task") or "")
    owner = re.search(r"Owner OK \([^)]*\):[^\n]*", task)
    brief = (f"# Issue #{issue}\n\nTask: {task}\n\nRead the issue (`gh issue view {issue} -R {REPO}`) for the acceptance "
             f"criteria first.\n"
             + (f"\nCopy this line into the PR body under `## Owner decisions`: {owner.group(0)}\n" if owner else "")
             + ("\nThe owner queued this workflow change (allow_workflows): editing .github/workflows is in scope.\n"
                if x.get("allow_workflows") else "")
             + f"\n{tpl}\n")
    return {"worktree": None, "branch": None, "plan": None, "brief": brief}


def direct_launches(b: dict, snap: dict, dry_run: bool = False) -> list[str]:
    """Launch, with no model tick, the gate's launch picks that need no brief written (direct_spec), in pick order;
    stop at the first pick that needs the model so priority is kept. Same slot, pace and PR-hold rules as gate()."""
    state = load_state()
    if state.get("workers_paused"):
        return []
    if not dry_run:
        with edit_state() as st:  # held plans age out; the first run seeds them from the runs dir
            cut = now() - dt.timedelta(hours=HELD_PLAN_MAX_H)
            if "held_plans" not in st:
                st["held_plans"] = {}
                for d in RUNS.glob("*/plan_held"):
                    m = _run_meta(d.parent.name)
                    if m.get("status") == "plan-held" and not m.get("repo") and (d.parent / "plan.md").exists():
                        st["held_plans"][d.parent.name] = {"issue": m.get("issue"), "t": m.get("finished") or iso(now()),
                                                           "task": m.get("task"),
                                                           "files": plan_files((d.parent / "plan.md").read_text())}
            st["held_plans"] = {k: v for k, v in st["held_plans"].items() if (t := parse_iso(v.get("t"))) and t > cut}
        state = load_state()
    plan = rate_plan(state)
    live = claude_slot_holders(state)
    free = worker_slots(b, len(live), slot_ceiling(state, plan))
    mode = state.get("ci_mode", "calm")
    if mode == "busy" and not free and b.get("verdict") == "GREEN" and b.get("free_slots", 0) >= 1:
        free = 1  # backfill takes no Claude slot
    did: list[str] = []
    for _, x in budget_picks(state, snap, mode, max(free, 0), plan):
        spec = direct_spec(state, snap, x)
        if spec is None:
            break
        if spec.get("worktree") and held_by_live(state, Path(spec["worktree"]), x.get("task") or ""):
            continue  # a live run already has this PR (#20): the next pick may still go
        if x.get("lane") != "backfill" and not worker_slots(b, len(live) + len(did), slot_ceiling(state, plan)):
            break
        if not x.get("pr") and x.get("lane") != "backfill" and len(prs_needing_work(snap, live, state)) >= 3:
            break  # gate's "finish those first" hold
        ok, _ = (True, "") if plan else pace_allows(state, x.get("model", "sonnet"))
        if not ok:
            break
        what = (f"PR fix #{x['pr']}" + (" (warm resume)" if spec.get("resume_run") else "") if x.get("pr") else "backfill resume" if spec.get("lane") else
                f"held plan {spec['held_plan']}" if spec.get("held_plan") else "new issue, gate brief")
        did.append(f"#{x['issue']} ({what})")
        if dry_run:
            continue
        try:
            with contextlib.redirect_stdout(open(os.devnull, "w")):
                if spec.get("resume_run"):
                    cmd_worker(argparse.Namespace(resume_run=spec["resume_run"], message=spec["brief"], force=False,
                                                  plan=False))
                else:
                    cmd_worker(argparse.Namespace(resume_run=None, issue=x["issue"], model=x.get("model", "sonnet"),
                                                  task=x.get("task"), brief=spec["brief"], brief_file=None, force=False,
                                                  plan=spec["plan"], worktree=spec["worktree"], branch=spec.get("branch"),
                                                  check_of=None, repo=spec.get("repo"), lane=spec.get("lane")))
        except (SystemExit, OSError, RuntimeError) as e:  # a cap / missing tree: leave the item to the model tick
            did.pop()
            log(f"direct launch of #{x['issue']} refused, left queued for the tick: {str(e)[:200]}")
            break
        with edit_state() as st:
            q = st.get("queue", [])
            with contextlib.suppress(ValueError):
                q.remove(x)
            if spec.get("held_plan"):
                st.get("held_plans", {}).pop(spec["held_plan"], None)
        state = load_state()
    return did


def note_box(state: dict, b: dict) -> None:
    """A box that stays non-GREEN blocks every launch: say why in churn-log (not just the quiet log) after two ticks in a
    row, and at once when box_status names a probable stray (#4930: a stray `find /` held it YELLOW for 40 min)."""
    verdict = b.get("verdict")
    with edit_state() as st:
        streak = st.get("box_streak", {})
        streak = {"verdict": verdict, "ticks": streak.get("ticks", 0) + 1 if streak.get("verdict") == verdict else 1,
                  "logged": streak.get("logged") if streak.get("verdict") == verdict else False}
        strays = b.get("strays") or []
        if verdict != "GREEN" and not streak["logged"] and (streak["ticks"] >= 2 or strays):
            why = "; ".join(b.get("reasons", []))[:300]
            log(f"box {verdict} for {streak['ticks']} tick(s), launches held: {why}"
                + (f" | culprit: {b['culprit']}" if b.get("culprit") else "")
                + ("" if not strays else " | probable strays: " + ", ".join(f"pid {x['pid']} ({x['age_min']} min) {x['cmd'][:60]}" for x in strays)))
            streak["logged"] = True
        if verdict == "GREEN" and st.get("box_streak", {}).get("logged"):
            log(f"box GREEN again after {st['box_streak'].get('ticks')} {st['box_streak'].get('verdict')} tick(s)")
        st["box_streak"] = streak
        state["box_streak"] = streak


TICK_CLI = """NEVER edit churn-state.json yourself (not with Edit/Write, python or jq): change state ONLY with these
(each validates and logs; the gate quarantines anything malformed):
- `churn review done <run_id> [--note ...]`             a reviewed report leaves reports_pending (no PR: note goes on the issue)
- `churn pr watch <n> --issue <i> [--head <sha>]`       watch a PR (a worker's new draft PR)
- `churn pr reviewed <n> --head <sha> --verdict merge|send-back|hold [--note]`  records the review at that head;
                                                         `merge` also adds shepherd:merge and drops shepherd:reapprove
- `churn pr unwatch <n>`;  `churn followup done <n> [--note] [--closed | --next "<next slice>"]`  (after the
   issue-closure decision: --closed when it closed; when it stays open, --next queues that slice at the front, and
   without it an open core issue gets a generic next slice)
- `churn pr flake <n> --head <sha> --note ...`  after you rerun a red that is a CI flake: the gate queues no fix for
   that PR until its head changes or 2 h pass (then drop the PR-fix item with `churn queue rm`)
- `churn queue wait --index <k> --run <actions run id> | --minutes <m> --note ...`  when the gate names a launch you
   decline because it waits on something (a CI run, a time): record it ONCE; the gate skips the item until then (max 6 h)
- `churn queue add --issue <i> --task ... [--front] [--model m] [--backend agy] [--pr <n>] [--after-pr <n> ...]
   [--allow-workflows] [--agy-step <s>] [--needs-owner]`;  `churn queue park --index <k> --note ...`;  `churn queue rm --index <k>`
- `churn agy result --issue <i> --step <s> --verdict PASS|FIXED|REJECT [--pr <n>] [--denials k] [--notes ...]`
   after every agy checker review (two REJECTs at a step route that step's agy items back to Claude by themselves)
The daily scorecard is written by the gate itself; don't write a daily summary.
"""


def model_tick(reasons: list[str], model: str, state: dict, b: dict) -> dict:
    td = RUNS / "ticks"
    td.mkdir(parents=True, exist_ok=True)
    stamp = now().strftime("%Y%m%dT%H%M%SZ")
    status = (
        f"Headless tick started by `churn tick` at {iso(now())}. The gate already reaped finished workers, "
        "refreshed the PR snapshot and checked the box; don't redo those. Why this tick runs:\n"
        + "\n".join(f"- {r}" for r in reasons)
        + f"\nBox: {b.get('verdict')} free_slots {b.get('free_slots')} ({'; '.join(b.get('reasons', [])[:3])}).\n"
        f"Spend: window ${window_usd(state):.0f} over {WINDOW_H}h; learned budget "
        f"{state.get('usage', {}).get('learned_budget_usd') or 'unknown'}"
        + (" -- pace is OFF (owner): ignore spend, fill free slots; a limit hit pauses churn until the reset by itself.\n"
           if state.get("usage", {}).get("pace") == "off" else
           f" -- {plan['why']}. The gate already sized the launches to this block: launch exactly what it named.\n"
           if (plan := rate_plan(state)) else ".\n")
        + f"Claude workers running: {sum(1 for r in state.get('running', []) if r.get('run_id') and r.get('backend') != 'agy' and r.get('lane') != 'credit')} "
        f"of {state.get('max_workers', 2)} (agy-lane runs: {sum(1 for r in state.get('running', []) if r.get('backend') == 'agy')}, "
        "they do NOT count toward the cap).\n"
    )
    # 2026-10-18 cost audit: the skill's ~37 KB body lands AFTER the command args, so a per-tick status in the args made
    # every tick re-write ~22k cache tokens (~79% of a tick's cost). The prompt is now byte-identical across ticks (the
    # skill body stays cached for the hour) and this tick's status is a file the tick reads first.
    (td / f"{stamp}-{model}-status.md").write_text(status)
    TICK_STATUS.write_text(status)
    prompt = (
        "/night-shift tick\n\n"
        f"Start by reading {TICK_STATUS}: when this headless tick started and why it runs, the box, spend and "
        "running workers.\n"
        "Launch workers ONLY with `churn worker` (never the Agent tool); send one back with `churn send-back`.\n"
        + TICK_CLI
        + "Reply in 2-4 lines."
    )
    cmd = claude_cmd(prompt, model, TICK_BUDGET[model], allowed=TICK_ALLOWED)
    cmd += ["--disallowedTools", f"Edit({STATE})", f"Write({STATE})", f"Edit({SNAP})", f"Write({SNAP})"]
    out_path = td / f"{stamp}-{model}.json"
    try:
        with open(out_path, "w") as out, open(td / f"{stamp}-{model}.err", "w") as err:
            subprocess.run(cmd, cwd=TICK_CWD, stdin=subprocess.DEVNULL, stdout=out, stderr=err, timeout=TICK_TIMEOUT_S,
                           env=plan_env())
    except subprocess.TimeoutExpired:
        log(f"model tick ({model}) timed out after {TICK_TIMEOUT_S // 60} min; see {out_path}")
    try:
        return json.loads(out_path.read_text())
    except Exception:
        return {}


# ---------------------------------------------------------------- refill
# Owner 2026-10-17: the queue ran dry overnight (idle 02:21-04:21Z with budget left) until the owner topped it up.
# Below a low-water mark the gate refills it in three stages:
#  1. rules, no model: open burned-estate issues (scope core > sweep > infra; bugs, then priority), skipping epics,
#     frontier, unlabelled (stage 2 labels them), call-graph issues (stage 3), queued/running/open-PR issues and any
#     issue worked in the last cooldown_h;
#  2. nothing found: the next Sonnet tick gets a "refill" need (label, split epics, file sibling gaps, queue them),
#     at most every agent_every_h;
#  3. still dry an hour after that ask: call-graph work (epic #3772, effectively endless): its open child issues,
#     else one standing item on the epic.
# Owner 2026-10-17: with NOTHING launchable (slots idle) stage 2 asks every agent_empty_min with an agent_empty_grace_min
# grace, so stage 3 still gets its turn (2026-10-17 02:30-04:20Z the slots sat idle ~2 h waiting on the 6 h ask).
REFILL_DEFAULT = {"enabled": True, "batch": 8, "cooldown_h": 12, "agent_every_h": 6, "agent_grace_h": 1,
                  "agent_empty_min": 30, "agent_empty_grace_min": 15}
CALLGRAPH_EPIC = 3772
CALLGRAPH_TASK = (f"#{CALLGRAPH_EPIC} call-graph function work: pick the language whose call graph agrees least with its "
                  "compiler reference (callgraph-* skills, .claude/agents/callgraph-triage-scout.md), fix one class of "
                  "unresolved or wrong calls, and report the agreement before/after; list other classes as sibling gaps")
SKIP_LABELS = {"epic", "roadmap"}
PRIO_RANK = {"priority: high": 0, "priority: medium": 1, "priority: low": 3}


def refill_cfg(state: dict) -> dict:
    return {**REFILL_DEFAULT, **{k: v for k, v in (state.get("refill") or {}).items() if k in REFILL_DEFAULT}}


def low_water(state: dict) -> int:
    return 2 * int(state.get("max_workers", 2))


def launchable(state: dict, snap: dict | None) -> int:
    """Queue items a slot could take now or soon: not the owner's, not agy, not held frontier, not blocked or waiting."""
    return sum(1 for x in state.get("queue", []) if not x.get("needs_owner") and x.get("backend") != "agy"
               and not scope_held(x) and not blocked_by(x, snap, state) and not waiting(x))


def is_callgraph(i: dict) -> bool:
    text = " ".join([str(i.get("title", "")), *(str(lab.get("name", "")) for lab in i.get("labels") or []),
                     str((i.get("milestone") or {}).get("title", ""))]).lower()
    return "call-graph" in text or "call graph" in text


def open_issues() -> list[dict]:
    r = run(["gh", "issue", "list", "--repo", REPO, "--state", "open", "--limit", "500",
             "--json", "number,title,labels,milestone,assignees,body"], timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh issue list: {r.stderr.strip()[:160]}")
    return json.loads(r.stdout)


def issues_with_open_prs() -> set[int]:
    r = run(["gh", "pr", "list", "--repo", REPO, "--state", "open", "--limit", "300", "--json", "headRefName,body"],
            timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh pr list: {r.stderr.strip()[:160]}")
    out: set[int] = set()
    for p in json.loads(r.stdout):
        out.update(int(m) for m in re.findall(r"^(?:churn|agy|claude)/(\d+)-", p.get("headRefName") or ""))
        out.update(int(m) for m in re.findall(r"(?:Fixes|Closes|Part of)\s+#(\d+)", p.get("body") or "", re.I))
    return out


def recently_worked(issue: int, hours: float) -> bool:
    """A churn run on this issue started within `hours`, or it ever ran in a crucible repo (the tick passes --repo)."""
    cut = now() - dt.timedelta(hours=hours)
    for d in RUNS.glob(f"{issue}-*"):
        m = _run_meta(d.name)
        if m.get("repo"):
            return True
        if (t := parse_iso(m.get("started"))) and t > cut:
            return True
    return False


# Owner 2026-10-18: an issue's checklist is its parts list, and the boxes were never ticked (156 merged PRs against the
# open core issues, 0 of 138 lines checked). A refill item now names ONE unchecked line by a key, the worker writes
# `Checklist: done|partial [c:<key>]` in the PR body, and on merge the gate ticks that line itself: the boxes count
# what is left (scorecard), and a core issue's next line is queued at once instead of after the 12 h cooldown.
CHECK_RE = re.compile(r"^(\s*[-*]\s+)\[([ xX])\]\s+(.*?)\s*$", re.M)
CHECK_KEY_RE = re.compile(r"\[c:([0-9a-f]{8})\]")
PR_CHECK_RE = re.compile(r"\bChecklist:?\W*(done|partial)\b[^\n]*?\[c:([0-9a-f]{8})\]([^\n]*)", re.I)


def check_key(text: str) -> str:
    return hashlib.sha1(" ".join(text.split()).lower().encode()).hexdigest()[:8]


def checklist(body: str | None) -> list[dict]:
    """[{done, text, key}] for each `- [ ]` / `- [x]` line of an issue body."""
    return [{"done": m.group(2) != " ", "text": m.group(3), "key": check_key(m.group(3))}
            for m in CHECK_RE.finditer(body or "")]


def tick_line(body: str, key: str, pr: int) -> str | None:
    """body with the unchecked line `key` ticked and its PR appended; None if no unchecked line has that key."""
    for m in CHECK_RE.finditer(body):
        if m.group(2) == " " and check_key(m.group(3)) == key:
            return body[:m.start()] + f"{m.group(1)}[x] {m.group(3)} (#{pr})" + body[m.end():]
    return None


def claimed_checks(state: dict, issue: int) -> set[str]:
    """Checklist keys of issue #issue that a queued or running item already holds."""
    return {k for s in ("queue", "running") for x in state.get(s, []) if x.get("issue") == issue
            for k in CHECK_KEY_RE.findall(str(x.get("task", "")))}


def next_check(i: dict, state: dict) -> dict | None:
    taken = claimed_checks(state, i["number"])
    return next((c for c in checklist(i.get("body")) if not c["done"] and c["key"] not in taken), None)


def check_task(i: dict, c: dict) -> str:
    k = c["key"]
    return (f"#{i['number']} {i.get('title', '')[:120]} -- checklist item [c:{k}]: \"{c['text'][:300]}\". Do this item "
            "(or its next PR-sized slice); burned estates only, list the rest as sibling gaps. Put one line in the PR "
            f"body: `Checklist: done [c:{k}]` if this PR completes the item, else `Checklist: partial [c:{k}] -- <what "
            "is left>`. Never edit the issue: the gate ticks the box when the PR merges.")


def refill_item(i: dict, task: str | None = None, check: dict | None = None) -> dict:
    meta = {"title": i.get("title", ""), "labels": i.get("labels") or []}
    item = {"issue": i["number"], "model": "sonnet", "needs_owner": False, "auto": "refill",
            "task": task or (check_task(i, check) if check else
                             f"#{i['number']} {i.get('title', '')[:120]} -- take the next unchecked item on the issue; "
                             "burned estates only, list the rest as sibling gaps")}
    if sc := issue_scope(i["number"], meta):
        item["scope"] = sc
    if tier := issue_tier(i["number"], meta):
        item["tier"] = tier
    return item


def refill_candidates(state: dict, issues: list[dict], in_pr: set[int], callgraph: bool = False) -> list[dict]:
    cfg = refill_cfg(state)
    taken = {x.get("issue") for x in state.get("queue", [])} | {r.get("issue") for r in state.get("running", [])}
    recent = {int(k) for k, t in ((state.get("refill") or {}).get("issued") or {}).items()
              if (ts := parse_iso(t)) and now() - ts < dt.timedelta(hours=float(cfg["cooldown_h"]))}
    out = []
    for i in issues:
        names = {str(lab.get("name", "")) for lab in i.get("labels") or []}
        sc = next((x[6:] for x in names if x.startswith("scope:")), None)
        if is_callgraph(i) != callgraph or names & SKIP_LABELS or i["number"] in taken | in_pr | recent:
            continue
        if not callgraph and sc not in ("core", "sweep", "infra"):
            continue  # frontier waits for the owner; unlabelled goes to stage 2
        if recently_worked(i["number"], float(cfg["cooldown_h"])):
            continue
        if foreign_claim(i) or host_skips(i):
            continue  # a person or another host has it, or it is not this host's kind of work
        if (items := checklist(i.get("body"))) and all(c["done"] for c in items):
            continue  # every line ticked: closing it is the tick's followup, not more work
        out.append(i)

    def rank(i):
        names = {str(lab.get("name", "")) for lab in i.get("labels") or []}
        sc = next((x[6:] for x in names if x.startswith("scope:")), None)
        return (goal_rank(state, {"issue": i["number"]}), SCOPE_RANK.get(sc, 1), "bug" not in names,
                min((PRIO_RANK[n] for n in names if n in PRIO_RANK), default=2), i["number"])
    return sorted(out, key=rank)[:int(cfg["batch"])]


def refill(state: dict, snap: dict | None, dry_run: bool = False, force: bool = False) -> tuple[str, list[dict]]:
    """("off" | "full" | "rules" | "callgraph" | "ask" | "wait", items queued). "ask" = give the tick a refill need."""
    cfg = refill_cfg(state)
    if not cfg["enabled"] or state.get("workers_paused"):
        return "off", []
    if not force and launchable(state, snap) >= low_water(state):
        return "full", []
    issues, in_pr = open_issues(), issues_with_open_prs()
    if not dry_run:
        expire_claims(state, issues)
    stage, items = "rules", [refill_item(i, check=next_check(i, state)) for i in refill_candidates(state, issues, in_pr)]
    if not items:
        asked = parse_iso((state.get("refill") or {}).get("agent_t"))
        if launchable(state, snap) == 0:
            every = dt.timedelta(minutes=float(cfg["agent_empty_min"]))
            grace = dt.timedelta(minutes=float(cfg["agent_empty_grace_min"]))
        else:
            every = dt.timedelta(hours=float(cfg["agent_every_h"]))
            grace = dt.timedelta(hours=float(cfg["agent_grace_h"]))
        if not asked or now() - asked >= every:
            return "ask", []
        if now() - asked < grace:
            return "wait", []  # the tick that was asked may still be filing issues
        stage = "callgraph"
        items = [refill_item(i) for i in refill_candidates(state, issues, in_pr, callgraph=True)]
        if not items and not any(x.get("issue") == CALLGRAPH_EPIC for x in state.get("queue", [])) \
                and not recently_worked(CALLGRAPH_EPIC, 1) and not HOST.get("milestones") and not HOST.get("labels"):
            items = [refill_item({"number": CALLGRAPH_EPIC, "title": "", "labels": [{"name": "scope:infra"}]},
                                 CALLGRAPH_TASK)]
    if items and not dry_run:
        with edit_state() as st:
            st.setdefault("queue", []).extend(items)
            rf = st.setdefault("refill", {})
            rf["t"] = iso(now())
            rf["issued"] = {**{k: t for k, t in (rf.get("issued") or {}).items()
                               if (ts := parse_iso(t)) and now() - ts < dt.timedelta(days=3)},
                            **{str(x["issue"]): iso(now()) for x in items if x["issue"] != CALLGRAPH_EPIC}}
        log(f"refill ({stage}): queued " + ", ".join(f"#{x['issue']} [{x.get('scope', '-')}]" for x in items))
    return stage, items


def refill_need(state: dict) -> str:
    return (f"refill: the queue is below its low-water mark ({low_water(state)} launchable) and the rule-based refill "
            "found no open core/sweep/infra issue to queue. Refill it, burned estates only, about 8 items at most: "
            "(1) label unlabelled open issues (type, area, priority, scope:core|sweep|frontier|infra) with "
            f"`gh api repos/{REPO}/issues/<n>/labels`; (2) for each core/sweep `epic`, file its next concrete step as a "
            "new issue if none is open; (3) file the 'Sibling gaps' from recent churn-runs/*/report.md that have no "
            "issue; (4) queue what you labelled or filed with `churn queue add --issue <n> --model sonnet --task ...`. "
            "Never queue frontier work. If nothing qualifies, say so: the gate falls back to call-graph work "
            f"(#{CALLGRAPH_EPIC}) in an hour.")


def goal_reports() -> list[dict]:
    """The evidence reports at goal_reports.ref (fetched first): one dict per `report.json` under goal_reports.path,
    with `file` added. A report lists programs[] with `program`, `level` (L0..L5, `*` = carried while stale) and
    `translation` {hole_count, gap_classes, refused}. No goal_reports in the host config: nothing to measure."""
    ref, path = GOAL_REPORTS.get("ref"), GOAL_REPORTS.get("path")
    if not ref or not path:
        return []
    if GOAL_REPORTS.get("fetch"):
        run(["git", "-C", str(V6), "fetch", "-q", "origin", GOAL_REPORTS["fetch"]], timeout=120)
    r = run(["git", "-C", str(V6), "ls-tree", "-r", "--name-only", ref, "--", path])
    if r.returncode:
        raise RuntimeError(f"goal reports at {ref}:{path}: {r.stderr.strip()[:160]}")
    out = []
    for f in r.stdout.split():
        if f.endswith("report.json") and not (s := run(["git", "-C", str(V6), "show", f"{ref}:{f}"])).returncode:
            with contextlib.suppress(ValueError):
                out.append({**json.loads(s.stdout), "file": f})
    return out


def goal_measure(reports: list[dict], issues: list[dict]) -> dict:
    """Programs per level, and every program that does not translate whole (L0) with the open issues that name it.
    `untracked` = L0 programs no open issue mentions: nobody is working on them."""
    levels: collections.Counter = collections.Counter()
    texts = [(i["number"], f"{i.get('title', '')}\n{i.get('body') or ''}".lower()) for i in issues]
    untranslated = []
    for rep in reports:
        for p in rep.get("programs") or []:
            lv = str(p.get("level") or "?").rstrip("*")
            levels[lv] += 1
            if lv != "L0":
                continue
            t = p.get("translation") or {}
            stem = Path(str(p.get("program", ""))).stem.lower()
            hits = sorted(n for n, txt in texts if stem and re.search(rf"\b{re.escape(stem)}\b", txt))
            untranslated.append({"estate": Path(rep["file"]).parent.name, "program": p.get("program"),
                                 "holes": t.get("hole_count"), "refused": t.get("refused"),
                                 "classes": [str(c)[:120] for c in (t.get("gap_classes") or [])[:4]], "issues": hits})
    return {"t": iso(now()), "programs": sum(levels.values()), "levels": dict(sorted(levels.items())),
            "untranslated": untranslated, "untracked": [u["program"] for u in untranslated if not u["issues"]]}


def goal_summary(m: dict) -> str:
    lv = " ".join(f"{k} {v}" for k, v in (m.get("levels") or {}).items())
    holes = sum(int(u.get("holes") or 0) for u in m.get("untranslated", []))
    return (f"{m.get('programs', 0)} programs: {lv}; {len(m.get('untranslated', []))} not translated whole "
            f"({holes} holes), {len(m.get('untracked', []))} with no open issue")


def goal_tick(state: dict, force: bool = False) -> list[str]:
    """Measure when due (goal.measure_every_h), keep the result and a dated snapshot, and set goal.ask to the untracked
    programs not asked about in the last day. Returns log notes."""
    g = goal_cfg(state)
    last = parse_iso((g.get("measure") or {}).get("t"))
    if not GOAL_REPORTS or (not force and last and now() - last < dt.timedelta(hours=float(g["measure_every_h"]))):
        return []
    m = goal_measure(goal_reports(), open_issues())
    snaps = H / "progress-snapshots"
    snaps.mkdir(exist_ok=True)
    (snaps / f"goal-{now().strftime('%Y-%m-%dT%H%MZ')}.json").write_text(json.dumps(m, indent=1))
    with edit_state() as st:
        gs = st.setdefault("goal", {})
        gs["measure"] = m
        asked = {k: t for k, t in (gs.get("asked") or {}).items()
                 if (ts := parse_iso(t)) and now() - ts < dt.timedelta(days=1)}
        gs["asked"] = asked
        gs["ask"] = [p for p in m["untracked"] if p not in asked]
    return [f"goal measured: {goal_summary(m)}"]


def goal_need(state: dict) -> str:
    g = goal_cfg(state)
    rows = {u["program"]: u for u in (g.get("measure") or {}).get("untranslated", [])}
    lines = "; ".join(f"{p} ({rows.get(p, {}).get('estate', '?')}: {rows.get(p, {}).get('holes')} holes"
                      + (f", refused: {rows[p]['refused']}" if rows.get(p, {}).get("refused") else "")
                      + f", classes: {' | '.join(rows.get(p, {}).get('classes') or [])[:240]})" for p in g.get("ask", []))
    return (f"goal ({g['stage']}): these programs do not translate whole and no open issue names them: {lines}. "
            "For each hole class (one issue per class, several programs may share it): check closed issues for an owner "
            "decision first; if the program cannot be done here (source the vendor compiler rejects, needs a real "
            "mainframe, a language we do not translate) file it scope:frontier and say why; otherwise file a scope:core "
            "issue with the holes and source lines, a checklist, and the labels the repo uses, then "
            f"`churn goal add {g['stage']} <n>` and `churn queue add --issue <n> --tier era-core --front`.")


def cmd_goal(a) -> int:
    """`churn goal` (status), `stage NAME`, `add STAGE N..`, `rm N..`, `order A,B,..`, `measure`."""
    args = list(a.args or [])
    if a.action == "measure":
        state = load_state()
        if not GOAL_REPORTS:
            raise SystemExit("no goal_reports in the host config: nothing to measure")
        for note in goal_tick(state, force=True):
            log(note)
            print(note)
    elif a.action in ("stage", "add", "rm", "order"):
        with edit_state() as st:
            gs = st.setdefault("goal", {})
            g = goal_cfg(st)
            if a.action == "order":
                if len(args) != 1 or not all(args[0].split(",")):
                    raise SystemExit("goal order A,B,C")
                gs["order"] = args[0].split(",")
                msg = f"goal order {gs['order']}"
            elif a.action == "stage":
                if len(args) != 1 or args[0] not in g["order"]:
                    raise SystemExit(f"goal stage NAME, one of {g['order']}")
                gs["stage"] = args[0]
                msg = f"goal stage -> {args[0]}"
            elif a.action == "add":
                if len(args) < 2 or args[0] not in g["order"]:
                    raise SystemExit(f"goal add STAGE N.., STAGE one of {g['order']}")
                nums = [_int(x) for x in args[1:]]
                iss = gs.setdefault("issues", {})
                for s in iss:
                    iss[s] = [n for n in iss[s] if n not in nums]  # an issue belongs to one stage
                iss[args[0]] = sorted(set(iss.get(args[0], [])) | set(nums))
                msg = f"goal: {args[0]} += {', '.join(f'#{n}' for n in nums)}"
            else:
                nums = {_int(x) for x in args}
                gs["issues"] = {s: [n for n in v if n not in nums] for s, v in (gs.get("issues") or {}).items()}
                msg = f"goal: removed {', '.join(f'#{n}' for n in sorted(nums))}"
        log(f"{msg} (owner)")
        print(msg)
    else:
        state = load_state()
        g = goal_cfg(state)
        print(f"goal stage: {g['stage']} (order {' > '.join(g['order'])})")
        for s in g["order"]:
            print(f"  {s}: " + (", ".join(f"#{n}" for n in (g.get("issues") or {}).get(s, [])) or "-"))
        if m := g.get("measure"):
            print(f"measured {m['t']}: {goal_summary(m)}")
            for u in m.get("untranslated", []):
                print(f"  {u['estate']} {u['program']}: {u.get('holes')} holes"
                      + (f" ({u['refused']})" if u.get("refused") else "") + " -> "
                      + (", ".join(f"#{n}" for n in u["issues"]) or "NO ISSUE"))
        elif not GOAL_REPORTS:
            print("not measured: no goal_reports in the host config")
        queued = [x for x in state.get("queue", []) if goal_rank(state, x) == 0]
        print(f"queued for the active stage: {', '.join(f'#{x['issue']}' for x in queued) or 'none'}")
    return 0


def cmd_refill(a) -> int:
    """Run the refill now (owner or debugging); --dry-run lists what it would queue; --on/--off toggles it."""
    if a.on or a.off:
        with edit_state() as st:
            st.setdefault("refill", {})["enabled"] = bool(a.on)
        log(f"refill {'on' if a.on else 'off'} (owner)")
        return 0
    state = load_state()
    snap = json.loads(SNAP.read_text()) if SNAP.exists() else {}
    stage, items = refill(state, snap, dry_run=a.dry_run, force=a.force)
    print(f"{stage}: launchable {launchable(state, snap)} / low-water {low_water(state)}")
    for x in items:
        print(f"  #{x['issue']} [{x.get('scope', '-')}{', ' + x['tier'] if x.get('tier') else ''}] {x['task'][:110]}")
    return 0


# Owner 2026-10-18: more than one host (and later people) work the same repo. GitHub is the only state they share, so
# an issue's owner is recorded there: a person by assigning themselves, a host by a `claim:<host_id>` label plus one
# lease comment it edits on every refresh. Every host skips issues that are assigned or claimed by someone else; a
# claim nobody refreshed for ttl_h hours expires and may be taken over. Two hosts claiming in the same minute: the
# earliest `labeled` event of a claim still on the issue wins, the other host takes its label back off.
CLAIMS_DEFAULT = {"enabled": True, "ttl_h": 6, "refresh_h": 2, "expire_checks": 10, "per_tick": 10}
CLAIM_PREFIX = "claim:"
CLAIM_MARK = "<!-- promoter-bot claim host={} -->"


def claims_cfg(state: dict) -> dict:
    return {**CLAIMS_DEFAULT, **{k: v for k, v in (state.get("claims") or {}).items() if k in CLAIMS_DEFAULT}}


def claim_label(host: str = HOST_ID) -> str:
    return CLAIM_PREFIX + host


def claim_exempt(state: dict, issue) -> bool:
    """Standing issues every host may work at once: the call-graph epic and the weekly retro's issue."""
    return not issue or int(issue) in {CALLGRAPH_EPIC, retro_cfg(state).get("issue")}


def foreign_claim(i: dict) -> str | None:
    """Who else holds issue `i` (a gh issue dict with labels + assignees): a person or another host; None if free."""
    if who := [str(x.get("login", "")) for x in i.get("assignees") or []]:
        return "assigned to " + ", ".join(who)
    hosts = [n[len(CLAIM_PREFIX):] for n in (str(lab.get("name", "")) for lab in i.get("labels") or [])
             if n.startswith(CLAIM_PREFIX) and n != claim_label()]
    return f"claimed by {', '.join(hosts)}" if hosts else None


def gh_pages(path: str) -> list[dict]:
    """Every element of a paginated GitHub list endpoint."""
    r = run(["gh", "api", "--paginate", path, "--jq", ".[]"], timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh api {path}: {r.stderr.strip()[:200]}")
    return [json.loads(line) for line in r.stdout.splitlines() if line.strip()]


def gh_comment(n: int, body: str, cid: int | None = None) -> int:
    """Post a comment on #n (or edit comment `cid`); returns its id."""
    path = f"repos/{REPO}/issues/comments/{cid}" if cid else f"repos/{REPO}/issues/{n}/comments"
    r = run(["gh", "api", *(["-X", "PATCH"] if cid else []), path, "-f", f"body={body}"])
    if r.returncode:
        raise RuntimeError(f"gh api {path}: {r.stderr.strip()[:200]}")
    return int(json.loads(r.stdout)["id"])


def gh_uncomment(cid: int) -> None:
    run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/issues/comments/{cid}"])  # already gone: fine


def claim_body(state: dict) -> str:
    return (CLAIM_MARK.format(HOST_ID) + f"\nClaimed by promoter-bot host `{HOST_ID}`, lease renewed {iso(now())}. "
            f"It lapses after {claims_cfg(state)['ttl_h']} h without a renewal. To take it back, assign someone or "
            f"remove the `{claim_label()}` label.")


def claim_comments(n: int, host: str) -> list[dict]:
    mark = CLAIM_MARK.format(host)
    return [c for c in gh_pages(f"repos/{REPO}/issues/{n}/comments") if mark in str(c.get("body", ""))]


def claim_winner(n: int, labels: list[str]) -> str | None:
    """The host whose claim label (of those still on #n) was added first; ties go to the smaller name."""
    added: dict[str, str] = {}
    for e in gh_pages(f"repos/{REPO}/issues/{n}/events"):
        name = str((e.get("label") or {}).get("name", ""))
        if e.get("event") == "labeled" and name in labels:
            added[name] = str(e.get("created_at", ""))  # events run oldest first: keep the latest add
    if not added:
        return None
    return min(added, key=lambda k: (added[k], k))[len(CLAIM_PREFIX):]


def claim_age_h(n: int, host: str) -> float | None:
    """Hours since `host` last renewed its claim on #n (its lease comment), or since the label went on if it has none
    (a person tagged it by hand); None if neither is readable."""
    stamps = [parse_iso(c.get("updated_at")) for c in claim_comments(n, host)]
    if not any(stamps):
        stamps = [parse_iso(e.get("created_at")) for e in gh_pages(f"repos/{REPO}/issues/{n}/events")
                  if e.get("event") == "labeled" and (e.get("label") or {}).get("name") == claim_label(host)]
    stamps = [t for t in stamps if t]
    return (now() - max(stamps)).total_seconds() / 3600 if stamps else None


def host_role(name: str) -> bool:
    """Whether this host does a job that only one host should do (HOST_ROLES); every role when host.roles is unset."""
    return HOST.get("roles") is None or name in HOST["roles"]


def host_skips(i: dict) -> str | None:
    """Why issue `i` (a gh issue dict with labels + milestone) is not this host's work; None if it is.
    A `lane:<host_id>` label routes an issue to that host whatever its milestone. Otherwise an issue must be in one of
    host.milestones or carry one of host.labels (both empty: anything), must not be in host.exclude_milestones, and
    every `needs:<x>` label it carries must be in host.capabilities (unset: this host can do anything)."""
    names = {str(lab.get("name", "")) for lab in i.get("labels") or []}
    ms = str((i.get("milestone") or {}).get("title", ""))
    lanes = {n[5:] for n in names if n.startswith("lane:")}
    if lanes and HOST_ID not in lanes:
        return "routed to " + ", ".join(sorted(lanes))
    caps = HOST.get("capabilities")
    if caps is not None and (missing := sorted(n[6:] for n in names if n.startswith("needs:") and n[6:] not in caps)):
        return "needs " + ", ".join(missing)
    if lanes:
        return None
    if ms and ms in (HOST.get("exclude_milestones") or []):
        return f"milestone {ms} is another host's"
    want_ms, want_labels = HOST.get("milestones") or [], HOST.get("labels") or []
    if (want_ms or want_labels) and ms not in want_ms and not names & set(want_labels):
        return "outside this host's lanes"
    return None


def claim(state: dict, n: int, dry_run: bool = False) -> tuple[bool, str, dict | None]:
    """Take issue #n for this host: (True, note, new lease or None) when it is ours, (False, why, None) when it is closed
    or a person or another host has it. Reads GitHub, so call it OUTSIDE the state lock; store the lease after."""
    if not claims_cfg(state)["enabled"] or claim_exempt(state, n) or str(n) in (state.get("claims") or {}).get("held", {}):
        return True, "", None
    i = gh_json(f"repos/{REPO}/issues/{n}")
    if i.get("state") == "closed":
        return False, "closed", None
    if who := foreign_claim(i):
        return False, who, None
    if dry_run:
        return True, "would claim", None
    gh_label(n, add=claim_label())
    labels = [str(lab.get("name", "")) for lab in gh_json(f"repos/{REPO}/issues/{n}").get("labels") or []]
    rivals = [x for x in labels if x.startswith(CLAIM_PREFIX)]
    if len(rivals) > 1 and (win := claim_winner(n, rivals)) and win != HOST_ID:
        gh_label(n, remove=claim_label())
        return False, f"lost the claim race to {win}", None
    mine = claim_comments(n, HOST_ID)
    return True, "claimed", {"comment": gh_comment(n, claim_body(state), mine[0]["id"] if mine else None), "t": iso(now())}


def release(n: int, lease: dict | None = None) -> None:
    """Give issue #n back on GitHub: label and lease comment off (the caller drops state["claims"]["held"][n])."""
    gh_label(n, remove=claim_label())
    for cid in {(lease or {}).get("comment")} | {c["id"] for c in claim_comments(n, HOST_ID)}:
        if cid:
            gh_uncomment(int(cid))


def wanted_claims(state: dict) -> set[int]:
    """Issues this host is working: queued, running, waiting for review, with a watched PR or a followup."""
    out = {x.get("issue") for k in ("queue", "running", "reports_pending", "followups") for x in state.get(k, [])
           if isinstance(x, dict)}
    out |= {p.get("issue") for p in state.get("prs", []) if isinstance(p, dict)}
    return {int(n) for n in out if n and not claim_exempt(state, n)}


def claimed_here() -> set[int]:
    """Open issues that carry this host's claim label on GitHub."""
    r = run(["gh", "issue", "list", "--repo", REPO, "--state", "open", "--label", claim_label(), "--limit", "500",
             "--json", "number"], timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh issue list: {r.stderr.strip()[:160]}")
    return {int(i["number"]) for i in json.loads(r.stdout)}


def sync_claims(dry_run: bool = False) -> list[str]:
    """Level-triggered, once per tick: claim what this host works on (per_tick at most), renew leases older than
    refresh_h, release what it dropped. A queued item someone else holds leaves the queue; a running one only gets a
    CLAIM line for the owner. GitHub is read and written outside the state lock; the results are merged in after.
    An issue that could not be claimed (closed, someone else's) is asked about again only after refresh_h."""
    st = load_state()
    cfg = claims_cfg(st)
    if not cfg["enabled"]:
        return []
    cl = st.get("claims") or {}
    held, skip = dict(cl.get("held") or {}), dict(cl.get("skip") or {})
    fresh = lambda t: (ts := parse_iso(t)) and now() - ts < dt.timedelta(hours=float(cfg["refresh_h"]))
    want, have = wanted_claims(st), claimed_here()
    gone = [k for k in held if int(k) not in have]  # a person took the label off: claim it again if still ours
    for k in gone:
        held.pop(k)
    running = {r.get("issue") for r in st.get("running", [])}
    notes, got, lost, renewed = [], {}, {}, {}
    todo = [n for n in sorted(want - set(map(int, held))) if not fresh(skip.get(str(n)))][:int(cfg["per_tick"])]
    for n in todo:
        ok, why, lease = claim({**st, "claims": {**cl, "held": held}}, n, dry_run)
        if ok:
            if lease:
                got[str(n)] = lease
            if why:
                notes.append(f"#{n} {why}")
        else:
            lost[n] = why
            if why != "closed" and n in running:
                notes.append(f"CLAIM #{n}: {why}, but a worker of ours is on it -- owner: settle who keeps it")
    for k, lease in held.items():
        if int(k) in want and not fresh(lease.get("t")) and not dry_run:
            renewed[k] = {"comment": gh_comment(int(k), claim_body(st), lease.get("comment")), "t": iso(now())}
    released = sorted(have - want)
    for n in released:
        if not dry_run:
            release(n, held.get(str(n)))
        notes.append(f"released #{n}")
    if dry_run:
        return notes
    with edit_state() as cur:
        c = cur.setdefault("claims", {})
        h = c.setdefault("held", {})
        for k in gone + [str(n) for n in released]:
            h.pop(k, None)
        h.update(got)
        h.update(renewed)
        c["skip"] = {k: t for k, t in (c.get("skip") or {}).items() if fresh(t)} | {str(n): iso(now()) for n in lost}
        for n, why in lost.items():
            before = len(cur.get("queue", []))
            cur["queue"] = [x for x in cur.get("queue", []) if x.get("issue") != n]
            if len(cur["queue"]) < before:
                notes.append(f"dropped #{n} from the queue: {why}")
    return notes


def expire_claims(state: dict, issues: list[dict]) -> list[str]:
    """Take the label off claims another host stopped renewing (ttl_h), so refill sees those issues as free. At most
    expire_checks issues per call (each costs a GitHub read). `issues` (from open_issues) is updated in place."""
    cfg, notes = claims_cfg(state), []
    claimed = [(i, n[len(CLAIM_PREFIX):]) for i in issues if not i.get("assignees")
               for n in (str(lab.get("name", "")) for lab in i.get("labels") or [])
               if n.startswith(CLAIM_PREFIX) and n != claim_label()]
    for i, host in claimed[:int(cfg["expire_checks"])]:
        age = claim_age_h(i["number"], host)
        if age is not None and age >= float(cfg["ttl_h"]):
            gh_label(i["number"], remove=claim_label(host))
            i["labels"] = [lab for lab in i.get("labels") or [] if lab.get("name") != claim_label(host)]
            notes.append(f"expired {claim_label(host)} on #{i['number']} (not renewed for {age:.0f} h)")
    for line in notes:
        log(line)
    return notes


def cmd_claims(a) -> int:
    """status (default): this host's id and leases; sync [--dry-run]; on / off; release N."""
    if a.action in ("on", "off"):
        with edit_state() as st:
            st.setdefault("claims", {})["enabled"] = a.action == "on"
        log(f"claims {a.action} (owner)")
        return 0
    if a.action == "release":
        if not a.issue:
            raise SystemExit("claims release needs an issue number")
        release(a.issue, (load_state().get("claims") or {}).get("held", {}).get(str(a.issue)))
        with edit_state() as st:
            st.setdefault("claims", {}).setdefault("held", {}).pop(str(a.issue), None)
        log(f"released #{a.issue} (owner)")
        return 0
    if a.action == "sync":
        for line in sync_claims(dry_run=a.dry_run):
            print(line)
        return 0
    state = load_state()
    cfg = claims_cfg(state)
    print(f"host {HOST_ID} (label {claim_label()}), claims {'on' if cfg['enabled'] else 'off'}, "
          f"ttl {cfg['ttl_h']} h, renew every {cfg['refresh_h']} h")
    print("lanes: " + (", ".join(f"{k}={HOST[k]}" for k in ("milestones", "labels", "exclude_milestones") if HOST.get(k))
                       or "everything") + f"; capabilities: {HOST.get('capabilities', 'all')}; roles: "
          + ", ".join(r for r in HOST_ROLES if host_role(r)))
    for k, lease in sorted((state.get("claims") or {}).get("held", {}).items(), key=lambda kv: int(kv[0])):
        print(f"  #{k} renewed {lease.get('t')}")
    return 0


def cmd_tick(a) -> int:
    H.mkdir(parents=True, exist_ok=True)
    TICK_LOCK.touch(exist_ok=True)
    fh = open(TICK_LOCK)
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        DIRTY.touch()  # the running tick loops once more when it sees this
        return 0
    if STOP.exists() and not a.dry_run:  # a dry run only reports, so it may preview a stopped churn
        log("stopped (churn.stop present)", quiet=True)
        return 0
    for _ in range(2):
        started = time.time()
        DIRTY.unlink(missing_ok=True)
        with edit_state() as state:
            reaped = reap(state)
        for e in reaped:
            log(f"reaped {e['run_id']} (#{e['issue']} {e['model']}): {e['status']}")
        state = load_state()
        if not a.dry_run:
            if down := unreachable():
                offline_tick(state, down)
                return 0
            if state.get("offline"):
                back_online()
                state = load_state()
            with contextlib.suppress(Exception):
                flush_outbox()
            with contextlib.suppress(Exception):  # the install follows origin/main (sync pulse, hourly)
                if note := run_sync_pulse():
                    log(note)
        paused = parse_iso(state.get("paused_until"))
        if paused and now() < paused:  # Claude's limit; agy has its own quota and API credit its own bill: both go on
            did = []
            agy_items = any(q.get("backend") == "agy" for q in state.get("queue", []))
            if agy_items or credit_ready(state, True)[0]:
                refresh_tools()
                b, snap = box(), (json.loads(SNAP.read_text()) if SNAP.exists() else {})
                did = (lanes(b, snap, True, a.dry_run) if agy_items else []) + credit_lane(b, snap, True, a.dry_run)
            log(f"paused until {iso(paused)}" + (f"; lanes: {', '.join(did)}" if did else ""), quiet=not did)
            if a.dry_run:
                print(json.dumps({"paused_until": iso(paused), "lanes": did}, indent=1))
            return 0
        refresh_tools()
        b = box()
        old = json.loads(SNAP.read_text()) if SNAP.exists() else {}
        _OPEN_CACHE.clear()
        global _INFLIGHT
        _INFLIGHT = None
        _RUN_DONE.clear()
        _CI_IN_FLIGHT.clear()
        snap = pr_snapshot(state.get("prs", []), old)
        if not a.dry_run:
            with contextlib.suppress(Exception):  # an alert bug must never stop the gate
                gate_alerts(state, b, snap)
            with contextlib.suppress(Exception):
                for line in end_dead_wait_loops(state):
                    log(line)
            with contextlib.suppress(Exception):
                for line in (tend_bot_prs() if host_role("bot_prs") else []):
                    log(line)
            SNAP.write_text(json.dumps(snap, indent=1))  # a cache for other commands; nothing diffs it any more
            with edit_state() as st:
                for note in settle_closed(st, snap):
                    log(note)
                with contextlib.suppress(Exception):
                    if carried := carry_reviews(st, snap):
                        log("review kept across the gate's update-branch: " + ", ".join(carried))
                pruned = prune_pr_fixes(st, snap)
                fixes = queue_pr_fixes(st, snap)
                with contextlib.suppress(Exception):
                    if stamped := stamp_scopes(st):
                        log("scope from labels: " + ", ".join(stamped), quiet=True)
                reds = queue_main_red(st, red_main_issues(), snap) if host_role("main_red") else []
                relabelled = fix_merge_labels(st, snap)
            if reds:
                log("queued main-red fixes (ci lane): " + ", ".join(reds))
            if relabelled:
                log("re-applied shepherd:merge (reviewed `merge` at the current head): " + ", ".join(relabelled))
            if pruned:
                log("dropped PR-fix items whose PR moved on (new head or closed): " + ", ".join(pruned))
            noise = [x[6:] for x in fixes if x.startswith("noise:")]
            updated = [x[8:] for x in fixes if x.startswith("updated:")]
            fixes = [x for x in fixes if not x.startswith(("noise:", "updated:"))]
            if updated:
                log("updated with main by the gate (update-branch, no worker): " + ", ".join(updated))
            if noise:
                log("not queued, CI noise only (the shepherd reruns it; no worker): " + ", ".join(noise))
            if fixes:
                log("queued PR fixes (front): " + ", ".join(fixes))
            write_scorecard_if_due()
            for note in reap_containers(float(state.get("container_max_age_h", CONTAINER_MAX_AGE_H))):
                log(note)
            for note in gc_worktrees_if_due(b):
                log(note)
            ign = ci_cfg(state)["ignore_workflows"]
            cq, inprog = ci_queue(ignore=ign), ci_in_progress(ignore=ign)
            want = [*collections.Counter(cq.get("by_workflow") or {}).elements(),
                    *(os.path.basename(str(r.get("path", ""))) for r in inprog or [])]
            for note in ci_profile_sample(state, ignore=ign, want=want):  # GitHub calls outside the state lock
                log(note, quiet=True)
            live_waits = live_pr_job_waits(state, inprog)
            with edit_state() as st:
                for note in retire_ci_pressure(st):
                    log(note)
                st["ci_profile"] = state.get("ci_profile") or st.get("ci_profile")
                if note := fast_cut(st, live_waits):
                    log(note)
                st["ci_backlog"] = {**ci_backlog(st, cq, inprog), "t": iso(now())}
                st["ci_admission"] = {**ci_admission(st, st["ci_backlog"]), "t": iso(now())}  # #38: decides the mode
                mode, why = ci_mode(st, cq)
                if mode != st.get("ci_mode", "calm"):
                    log(f"CI mode {st.get('ci_mode', 'calm')} -> {mode} ({why}); "
                        + ("no admission room: normal work holds, backfill may run" if mode == "busy"
                           else "normal churn resumes"))
                    st["ci_mode_since"] = iso(now())
                st["ci_mode"], st["ci_queue"] = mode, {**cq, "t": iso(now())}
                throttled = yield_backfill(st, snap, b, mode=mode)  # backfill stops only for waiting work, not on calm
                log_ci_snapshot(st, cq)
            for note in throttled:
                log(note)
            state = load_state()
        refill_stage = "off"
        if not a.dry_run:
            try:
                refill_stage, _ = refill(state, snap)
            except (RuntimeError, OSError, ValueError) as e:  # GitHub unreadable: try again next tick
                log(f"refill skipped: {str(e)[:160]}", quiet=True)
            try:
                for note in goal_tick(state):
                    log(note)
            except (RuntimeError, OSError, ValueError) as e:
                log(f"goal measure skipped: {str(e)[:160]}", quiet=True)
            try:
                for note in sync_claims():
                    log(note, quiet=not note.startswith(("CLAIM", "dropped")))
            except (RuntimeError, OSError, ValueError, SystemExit) as e:
                log(f"claims sync skipped: {str(e)[:160]}", quiet=True)
            state = load_state()
        did = lanes(b, snap, False, a.dry_run)
        if direct := direct_launches(b, snap, a.dry_run):
            did += [f"direct launch {d}" for d in direct]
        did += credit_lane(b, snap, False, a.dry_run)  # when=always, or credit about to expire
        did += retro_lane(b, snap, a.dry_run)
        if did:
            if not a.dry_run:
                log("lanes: " + ", ".join(did))
            state = load_state()
        live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
        wants = {f"review #{n}@{w.split()[0]}": f"PR needs review: #{n} {w} -> review it, then `churn pr reviewed {n} "
                 f"--head <sha> --verdict merge|send-back|hold`" for n, w in reviews_needed(state, snap, live).items()}
        found = orphans(state, snap, live)
        if not a.dry_run:
            with edit_state() as st:
                new = sorted(set(found) - set(st.get("orphans", [])))
                st["orphans"] = sorted(found)
            for k in new:
                log(f"LIVENESS {k}: {found[k]}")
        for k, why in found.items():
            wants[k] = (f"liveness: {why} -> give it a next step (review it, queue a fix, `churn queue wait`, hold it "
                        f"for the owner, `churn pr watch` / `unwatch`, `churn review done`, `churn followup done`)")
        for f in state.get("followups", []):
            wants[f"followup #{f['pr']}"] = (
                f"followup: PR #{f['pr']} {f['kind']}" + (f" (issue #{f['issue']})" if f.get("issue") else "")
                + ": decide whether the issue's acceptance is now met (close it with a comment if so, then "
                f"`churn followup done {f['pr']} --closed`); if it stays open, `churn followup done {f['pr']} "
                "--next \"<the next PR-sized slice>\"` queues that slice")
        if refill_stage == "ask":
            wants["refill"] = refill_need(state)
            with edit_state() as st:
                st.setdefault("refill", {})["agent_t"] = iso(now())
            log("refill: no rule-based candidates; asking the tick to label, split epics and file sibling gaps")
        if goal_cfg(state).get("ask"):
            wants["goal"] = goal_need(state)
            if not a.dry_run:
                with edit_state() as st:
                    gs = st.setdefault("goal", {})
                    gs["asked"] = {**(gs.get("asked") or {}), **{p: iso(now()) for p in gs.pop("ask", [])}}
                log(f"goal: asking the tick to file issues for {len(goal_cfg(state)['ask'])} untracked programs")
        if a.dry_run:
            active, stalled = list(wants), []
        else:
            with edit_state() as st:
                active, stalled = count_attempts(st, list(wants))
            for k in stalled:
                log(f"STALLED after {STALL_AFTER} model ticks, needs the owner: {wants[k][:200]}")
        needs = {k: wants[k] for k in active}
        force = ([f"forced: {r}" for r in a.reason or []] or ["forced"]) if a.force else []
        reasons, model = gate(state, b, force, needs, snap)
        if not a.dry_run:
            note_box(state, b)
            idle_now = (b.get("verdict") == "GREEN" and not state.get("workers_paused")
                        and len(claude_slot_holders(state)) < int(state.get("max_workers", 2))
                        and not any(r.startswith("launch slot") for r in reasons))
            with edit_state() as st:  # consecutive ticks with a free slot and nothing launchable (calm backfill waits on it)
                st["idle_streak"] = int(st.get("idle_streak", 0)) + 1 if idle_now else 0
            state["idle_streak"] = int(state.get("idle_streak", 0)) + 1 if idle_now else 0
        if not reasons:
            if a.dry_run:
                print(json.dumps({"quiet": True, "lanes": did}, indent=1))
            free = b.get("verdict") == "GREEN" and len(claude_slot_holders(state)) < int(state.get("max_workers", 2))
            log(f"quiet (box {b.get('verdict')}: {'; '.join(b.get('reasons', []))[:200]}; "
                f"{len(state.get('running', []))} running, window ${window_usd(state):.0f})"
                + (f" {idle_causes(state, snap, state.get('ci_mode', 'calm'))}" if free else ""), quiet=True)
        else:
            if a.dry_run:
                print(json.dumps({"model": model, "reasons": reasons, "lanes": did}, indent=1))
                return 0
            log(f"model tick ({model}): " + " | ".join(reasons)[:600])
            with edit_state() as st:
                bump_attempts(st, list(needs))
            out = model_tick(reasons, model, state, b)
            cost, tokens = run_cost(out)
            result = str(out.get("result") or "")
            with edit_state() as state:
                state.setdefault("usage", {}).setdefault("log", []).append(
                    {"t": iso(now()), "model": f"orchestrator-{model}", "tokens": tokens, "cost_usd": round(cost, 2), "issue": 0})
                state["last_model_tick"] = iso(now())
                if out.get("is_error") and (reset := limit_reset(result)):
                    record_limit(state, reset, "tick", result)
            if out.get("is_error"):
                auth_alert(result, "the model tick")
            if out.get("is_error") and OFFLINE_RE.search(result):
                with edit_state() as st:  # not a real attempt: it must not count toward STALL_AFTER
                    st["attempts"] = {k: max(0, v - (k in needs)) for k, v in st.get("attempts", {}).items()}
                    st.setdefault("offline", {}).setdefault("since", iso(now()))
            denials = out.get("permission_denials") or []
            log(f"model tick done ${cost:.2f}{f', {len(denials)} permission denials' if denials else ''}: "
                + " ".join(result.split())[:400])
            if not out or out.get("is_error"):
                log("model tick failed or hit a limit: its needs stay open for the next tick")
        if not (DIRTY.exists() and DIRTY.stat().st_mtime >= started):
            break
    return 0


# ---------------------------------------------------------------- scorecard
# Owner 2026-10-13: a daily scorecard from data, not a model's summary: is the factory burning issues down, at what
# cost, and how long was main red? The gate writes the previous UTC day's card at the top of churn-log.md once a day.
REAP_RE = re.compile(r"^- (\S+) \[churn\] reaped (\S+) \(#(\d+) (\S+)\): (\S+)")


def _hours(lo: dt.datetime, hi: dt.datetime, a: dt.datetime | None, b: dt.datetime | None) -> float:
    if not a:
        return 0.0
    a, b = max(a, lo), min(b or now(), hi)
    return max(0.0, (b - a).total_seconds() / 3600)


LOG_LINE = re.compile(r"^- (\d{4}-\d\d-\d\dT\d\d:\d\dZ) \[churn\] (.*)")
PR_FIX_TASK = re.compile(r"(?i)pr fix|fix pr|needs-fix|conflict|dirty")
HOLDS = (("pace", "launch held by pace"), ("prs-need-work", "launch held:"), ("paused", "paused until"))


def run_kind(meta: dict, runs_dir: Path | None = None) -> str:
    if meta.get("precheck_of"):
        return "precheck_retry"
    if meta.get("resume_of"):
        parent = {}
        with contextlib.suppress(OSError, ValueError):
            parent = json.loads(((runs_dir or RUNS) / meta["resume_of"] / "meta.json").read_text())
        # approving a held plan continues new work, not a fix loop (2026-10-16: 10 such runs, $46, read as loops)
        return "new_work" if parent.get("status") == "plan-held" else "send_back"
    return "pr_fix" if PR_FIX_TASK.search(meta.get("task") or "") else "new_work"


def _median(xs: list[float]) -> float | None:
    xs = sorted(xs)
    return round((xs[len(xs) // 2] + xs[(len(xs) - 1) // 2]) / 2, 2) if xs else None


def factory(day: dt.date, state: dict, log_text: str, quiet_text: str, merged_prs: list[dict],
            runs_dir: Path | None = None) -> dict:
    """The agent factory's own numbers for one UTC day (owner 2026-10-16: the bottleneck moved from CI to worker
    slots; 25-42% of worker-hours went to fix loops). All from churn's run metadata and logs; no model, no GitHub
    except the merged PRs the scorecard already fetched. Worker-hours are Claude runs only (agy has its own quota)."""
    lo = dt.datetime(day.year, day.month, day.day, tzinfo=dt.timezone.utc)
    hi = min(lo + dt.timedelta(days=1), now())
    hours = {"new_work": 0.0, "pr_fix": 0.0, "send_back": 0.0, "precheck_retry": 0.0}
    starts = {k: 0 for k in hours}
    for m in sorted((runs_dir or RUNS).glob("*/meta.json")):
        try:
            meta = json.loads(m.read_text())
        except (OSError, ValueError):
            continue
        if meta.get("backend") == "agy" or str(meta.get("run_id", "")).endswith("-agy"):
            continue
        a, b = parse_iso(meta.get("started")), parse_iso(meta.get("finished"))
        if not a or a >= hi or (b and b < lo):
            continue
        k = run_kind(meta, runs_dir)
        hours[k] += _hours(lo, hi, a, b)
        if lo <= a < hi:
            starts[k] += 1
    worked = sum(hours.values())
    slot_h = int(state.get("max_workers", 2)) * (hi - lo).total_seconds() / 3600
    events = [(parse_iso(m.group(1)), m.group(2)) for t in (log_text, quiet_text) for line in t.splitlines()
              if (m := LOG_LINE.match(line))]
    events = [(t, x) for t, x in events if t and lo <= t < hi]
    holds = {k: sum(1 for _, x in events if x.startswith(p)) for k, p in HOLDS}
    paused, last = 0.0, lo  # union of [line, paused_until] intervals
    for t, x in sorted(events):
        if x.startswith("paused until ") and (until := parse_iso(x.split()[2])):
            a, b = max(t, last), min(until, hi)
            if b > a:
                paused += (b - a).total_seconds() / 3600
                last = b
    busy_h, since = 0.0, None  # CI-busy mode (normal work held): from the mode switches
    for t, x in sorted(events):
        if x.startswith("CI mode "):
            if x.split()[4].startswith("busy"):
                since = t
            else:
                busy_h += ((t - (since or lo)).total_seconds() / 3600) if since or x.split()[2] == "busy" else 0.0
                since = None
    if since:
        busy_h += (hi - since).total_seconds() / 3600
    idle = [(t, x) for t, x in events if (m := re.match(r"quiet \(box GREEN.*?; (\d+) running", x))
            and int(m.group(1)) < int(state.get("max_workers", 2))]
    times = sorted(t for t, _ in events)
    idle_h = sum(min((next((u for u in times if u > t), hi) - t).total_seconds(), IDLE_TICK_CAP_S) for t, _ in idle) / 3600
    causes: collections.Counter = collections.Counter()  # ticks each cause was present (2026-10-16 on)
    blockers: collections.Counter = collections.Counter()  # ticks each PR blocked queue items
    for _, x in idle:
        if (m := re.search(r"\bidle: (.*)$", x)):
            causes.update({c.split(" (")[0].rsplit(" ", 1)[0] for c in re.split(r", (?![^()]*\))", m.group(1))})
            for b in re.findall(r"\((#\d+x\d+(?: #\d+x\d+)*)\)", m.group(1)):
                blockers.update(f"#{n}" for n in re.findall(r"#(\d+)x", b))
    reaped = {x.split()[1]: t for t, x in events if x.startswith("reaped ")}
    waits = [(t - reaped[x.split()[2].rstrip(":")]).total_seconds() / 60 for t, x in events
             if x.startswith("review done ") and x.split()[2].rstrip(":") in reaped]
    ages = [(parse_iso(p["merged_at"]) - parse_iso(p["created_at"])).total_seconds() / 3600 for p in merged_prs
            if parse_iso(p.get("merged_at")) and parse_iso(p.get("created_at"))]
    loops = starts["pr_fix"] + starts["send_back"] + starts["precheck_retry"]
    return {
        "worker_hours": {k: round(v, 2) for k, v in hours.items()},
        "new_work_share": round(hours["new_work"] / worked, 3) if worked else None,
        "slot_use": round(worked / slot_h, 3) if slot_h else None, "max_workers": int(state.get("max_workers", 2)),
        "loops_per_merged_pr": round(loops / len(merged_prs), 2) if merged_prs else None, "loop_runs": loops,
        "precheck": {"sent_back": sum(1 for _, x in events if x.startswith("precheck sent back")),
                     "passed": sum(1 for _, x in events if x.startswith("precheck ") and x.endswith(": pass")),
                     "failed_again": sum(1 for _, x in events if x.startswith("precheck ") and ": FAILED again" in x)},
        "paused_hours": round(paused, 2), "holds": holds, "ci_busy_hours": round(busy_h, 2),
        "idle_ticks": len(idle),  # GREEN box, a slot free, nothing launchable (queue empty, blocked, held or waiting)
        "idle_hours": round(idle_h, 2), "idle_causes": dict(causes.most_common()),
        "idle_blockers": dict(blockers.most_common(5)),
        "review_wait_min_median": _median(waits), "pr_open_to_merge_h_median": _median(ages),
    }


def own_branches(runs_dir: Path | None = None) -> set[str]:
    """The churn/* branches this host's runs worked on (meta.json `branch`, else churn/<run_id>)."""
    out = set()
    for m in (runs_dir or RUNS).glob("*/meta.json"):
        try:
            meta = json.loads(m.read_text())
        except (OSError, ValueError):
            continue
        out.add(meta.get("branch") or f"churn/{m.parent.name}")
    return out


def host_search() -> str:
    """Issue-search qualifiers for this host's lane: its excluded milestones, or its one milestone. Label and
    `lane:` routing can't be said in a search, so counts made this way only follow milestones."""
    q = "".join(f' -milestone:"{m}"' for m in HOST.get("exclude_milestones") or [])
    if len(ms := HOST.get("milestones") or []) == 1:
        q += f' milestone:"{ms[0]}"'
    return q


def core_parts(gh, merged: list[dict], lo: dt.datetime, hi: dt.datetime) -> dict:
    """The core finish line in parts (owner 2026-10-18): checklist lines of this host's open scope:core issues (an issue with no
    checklist counts as one part), and the merged PRs that name a core issue (branch churn/<n>- or Part of/Closes #n)
    per hour of the window, so parts_left / per_hour is the time to the finish line at this pace."""
    issues = []
    for page in range(1, 6):
        batch = [i for i in gh(f"repos/{REPO}/issues?labels=scope:core&state=open&per_page=100&page={page}") or []
                 if isinstance(i, dict) and "pull_request" not in i]
        issues += [i for i in batch if not host_skips(i)]
        if len(batch) < 100:
            break
    lines = [checklist(i.get("body")) for i in issues]
    total = sum(len(x) or 1 for x in lines)
    done = sum(sum(c["done"] for c in x) for x in lines)
    closed = gh("search/issues?per_page=100&q=" + urllib.parse.quote(
        f"repo:{REPO} is:issue label:scope:core closed:>={lo.date()}")).get("items") or []
    closed = [i for i in closed if not host_skips(i)]
    nums = {i.get("number") for i in issues} | {i.get("number") for i in closed}
    refs = lambda p: {int(x) for x in re.findall(r"^(?:churn|agy|claude)/(\d+)-", str(p.get("head", {}).get("ref", "")))} | {
        int(x) for x in re.findall(r"(?:Part of|Fixes|Closes|Resolves)\s+#(\d+)", f"{p.get('title', '')} {p.get('body') or ''}", re.I)}
    linked = [p["number"] for p in merged if refs(p) & nums]
    hours = max((hi - lo).total_seconds() / 3600, 0.0)
    rate = len(linked) / hours if hours >= 1 else None
    left = total - done
    return {"parts": total, "parts_done": done, "parts_left": left, "merged_core": len(linked),
            "core_per_hour": round(rate, 2) if rate else None, "eta_hours": round(left / rate) if rate else None}


def scorecard(day: dt.date, state: dict, gh=None, log_text: str | None = None, quiet_text: str | None = None) -> dict:
    gh = gh or gh_json
    lo = dt.datetime(day.year, day.month, day.day, tzinfo=dt.timezone.utc)
    hi = lo + dt.timedelta(days=1)

    def within(t) -> bool:
        x = parse_iso(t) if isinstance(t, str) else t
        return bool(x and lo <= x < hi)

    prs = []
    for page in range(1, 6):
        batch = gh(f"repos/{REPO}/pulls?state=all&sort=updated&direction=desc&per_page=100&page={page}")
        prs += batch
        if not batch or not (u := parse_iso(batch[-1].get("updated_at"))) or u < lo:
            break
    own = own_branches() if _CFG.get("host_id") else None  # several hosts: each counts only its own churn PRs

    def is_churn(p):
        ref = str(p.get("head", {}).get("ref", ""))
        return ref.startswith("churn/") and (own is None or ref in own)
    merged = [p for p in prs if p.get("merged_at") and within(p["merged_at"])]
    opened = [p for p in prs if within(p.get("created_at"))]

    def count(q: str) -> int:
        return int(gh("search/issues?per_page=1&q=" + urllib.parse.quote(q)).get("total_count", 0))

    created = count(f"repo:{REPO} is:issue created:{day}")
    closed = count(f"repo:{REPO} is:issue closed:{day}")
    # owner 2026-10-16: lead with the fixed finish line, the scope:core burn-down (frontier growth is discovery, not debt)
    lane = host_search()  # owner 2026-10-18: core here = this host's lane (the DOOM box counts its own)
    core = {"open": count(f"repo:{REPO} is:issue is:open label:scope:core{lane}"),
            "opened": count(f"repo:{REPO} is:issue label:scope:core created:{day}{lane}"),
            "closed": count(f"repo:{REPO} is:issue label:scope:core closed:{day}{lane}"),
            "frontier_opened": count(f"repo:{REPO} is:issue label:scope:frontier created:{day}")}
    core.update(core_parts(gh, merged, lo, min(hi, now())))
    reds = [i for i in gh(f"repos/{REPO}/issues?labels=ci-red-main&state=all&per_page=100&since={iso(lo - dt.timedelta(days=7))}")
            if "pull_request" not in i]
    red = sorted(((round(_hours(lo, hi, parse_iso(i.get("created_at")), parse_iso(i.get("closed_at"))), 1), i["number"],
                   i.get("title", "")) for i in reds), reverse=True)
    red = [r for r in red if r[0] > 0]
    spend = {"workers": 0.0, "ticks": 0.0}
    runs_n = {"workers": 0, "ticks": 0, "agy": 0}
    for e in state.get("usage", {}).get("log", []):
        if not within(e.get("t")):
            continue
        m = str(e.get("model", ""))
        lane = "ticks" if m.startswith("orchestrator") else "agy" if m.startswith("agy-") else "workers"
        runs_n[lane] += 1
        if lane != "agy":
            spend[lane] += float(e.get("cost_usd") or 0)
    credit_runs = [e for e in (state.get("credit") or {}).get("log", []) if within(e.get("t"))]
    statuses: dict[str, int] = {}
    text = log_text if log_text is not None else (LOG.read_text() if LOG.exists() else "")
    for line in text.splitlines():
        if (m := REAP_RE.match(line)) and within(m.group(1)):
            statuses[m.group(5)] = statuses.get(m.group(5), 0) + 1
    trial = [r for r in state.get("agy", {}).get("trial", {}).get("results", []) if within(r.get("t"))]
    total = spend["workers"] + spend["ticks"]
    churn_merged = [p for p in merged if is_churn(p)]
    # #20: epics advance by slices long before an issue closes; count the merged PRs that reported checklist lines
    slices = [pr_checks(p.get("body") or "").get("checks", []) for p in churn_merged]
    quiet = quiet_text if quiet_text is not None else (QUIET_LOG.read_text() if QUIET_LOG.exists() else "")
    return {
        "factory": factory(day, state, text, quiet, churn_merged),
        "day": str(day), "merged": [p["number"] for p in merged], "churn_merged": [p["number"] for p in churn_merged],
        "opened": len(opened), "churn_opened": sum(1 for p in opened if is_churn(p)),
        "spend": {k: round(v, 2) for k, v in spend.items()}, "runs": runs_n, "total_usd": round(total, 2),
        "usd_per_merged_churn_pr": round(total / len(churn_merged), 2) if churn_merged else None,
        "credit": {"usd": round(sum(float(e.get("cost_usd") or 0) for e in credit_runs), 2), "runs": len(credit_runs),
                   "balance": credit_balance(state)["balance"]},
        "issues_created": created, "issues_closed": closed, "issues_net": created - closed, "core": core,
        "slices_merged": sum(1 for s in slices if s), "items_done": sum(c[0] == "done" for s in slices for c in s),
        "red_main_hours": round(sum(r[0] for r in red), 1), "red_main": red[:3], "statuses": statuses,
        "agy_trial": {v: sum(1 for r in trial if r.get("verdict") == v) for v in ("PASS", "FIXED", "REJECT")},
        "queue": len(state.get("queue", [])), "queue_owner": sum(1 for q in state.get("queue", []) if q.get("needs_owner")),
        "stalled": list(state.get("stalled", [])), "quarantined": len(state.get("quarantine", [])),
        "owner_holds": owner_holds(state, json.loads(SNAP.read_text()) if SNAP.exists() else {}),
    }


def scorecard_md(c: dict) -> str:
    fail = {k: v for k, v in c["statuses"].items() if k != "done"}
    lines = [
        f"# Scorecard {c['day']} (UTC day; written by the gate)",
        *([f"- Core (burned-estate finish line): {c['core']['open']} open; today {c['core']['closed']} closed, "
           f"{c['core']['opened']} opened, net {c['core']['opened'] - c['core']['closed']:+d}; "
           f"{c['core']['frontier_opened']} frontier gaps mapped (Gap Atlas)."] if c.get("core") else []),
        *([f"- Core parts (checklist lines; an issue with none counts 1): {c['core']['parts_left']} left of "
           f"{c['core']['parts']}; {c['core']['merged_core']} core-linked PRs merged"
           + (f" ({c['core']['core_per_hour']}/h, about {c['core']['eta_hours']} h to the finish line at this pace)"
              if c['core'].get('core_per_hour') else "") + "."] if (c.get("core") or {}).get("parts") is not None else []),
        f"- Merged: {len(c['merged'])} PRs, {len(c['churn_merged'])} from churn"
        + (f" ({', '.join('#' + str(n) for n in c['churn_merged'][:15])})" if c["churn_merged"] else "")
        + f"; opened {c['opened']} ({c['churn_opened']} churn)"
        + (f"; {c['slices_merged']} reported checklist slices, {c.get('items_done', 0)} lines done"
           if c.get("slices_merged") else "") + ".",
        f"- Spend: ${c['total_usd']:.2f} = workers ${c['spend']['workers']:.2f} ({c['runs']['workers']} runs) + ticks "
        f"${c['spend']['ticks']:.2f} ({c['runs']['ticks']}); agy {c['runs']['agy']} runs (Google quota)"
        + (f"; ${c['usd_per_merged_churn_pr']:.2f} per merged churn PR" if c["usd_per_merged_churn_pr"] is not None else "")
        + (f"; API credit ${c['credit']['usd']:.2f} ({c['credit']['runs']} runs, ${c['credit']['balance']:.2f} left)"
           if (c.get("credit") or {}).get("runs") else "") + ".",
        f"- Issues: {c['issues_created']} opened, {c['issues_closed']} closed, net {c['issues_net']:+d}"
        + (" (backlog growing)" if c["issues_net"] > 0 else " (burning down)" if c["issues_net"] < 0 else "") + ".",
        f"- Main red: {c['red_main_hours']}h" + (": " + "; ".join(f"#{n} {h}h ({t.replace('main is red: ', '')[:40]})"
                                                          for h, n, t in c["red_main"]) if c["red_main"] else "") + ".",
        f"- Runs: {c['statuses'].get('done', 0)} done" + ("".join(f", {v} {k}" for k, v in sorted(fail.items())) if fail else "")
        + f"; agy trial PASS {c['agy_trial']['PASS']} / FIXED {c['agy_trial']['FIXED']} / REJECT {c['agy_trial']['REJECT']}.",
        f"- Now: queue {c['queue']} ({c['queue_owner']} wait on the owner)"
        + (f"; STALLED (owner): {', '.join(c['stalled'])}" if c["stalled"] else "")
        + (f"; PRs on hold for the owner: {', '.join('#' + n for n in c.get('owner_holds', []))}" if c.get("owner_holds") else "")
        + (f"; {c['quarantined']} quarantined state entries" if c["quarantined"] else "") + ".",
    ]
    if fa := c.get("factory"):
        wh = fa["worker_hours"]
        pct = lambda v: f"{100 * v:.0f}%" if v is not None else "-"
        lines.append(
            f"- Factory: {sum(wh.values()):.1f} worker-hours, {pct(fa['new_work_share'])} new work (PR fixes {wh['pr_fix']:.1f}h, "
            f"send-backs {wh['send_back'] + wh['precheck_retry']:.1f}h); slots {pct(fa['slot_use'])} used of "
            f"{fa['max_workers']}; {fa['loops_per_merged_pr'] if fa['loops_per_merged_pr'] is not None else '-'} fix loops per "
            f"merged churn PR; precheck sent back {fa['precheck']['sent_back']}, passed {fa['precheck']['passed']}, failed "
            f"again {fa['precheck']['failed_again']}; paused {fa['paused_hours']:.1f}h, CI-busy {fa['ci_busy_hours']:.1f}h, "
            f"{fa['idle_ticks']} idle ticks (slot free, nothing launchable"
            + (f", ~{fa['idle_hours']:.1f}h" if fa.get("idle_hours") is not None else "")
            + ("; " + ", ".join(f"{k} {v}" for k, v in fa["idle_causes"].items()) if fa.get("idle_causes") else "")
            + ("; blocked behind " + ", ".join(f"{k} {v}" for k, v in fa["idle_blockers"].items()) if fa.get("idle_blockers") else "")
            + f"); holds pace {fa['holds']['pace']} / "
            f"PRs-need-work {fa['holds']['prs-need-work']}; review wait median {fa['review_wait_min_median'] or '-'} min, "
            f"PR open->merge median {fa['pr_open_to_merge_h_median'] or '-'} h.")
    return "\n".join(lines) + "\n\n"


IDLE_TICK_CAP_S = 30 * 60  # an idle tick stands for the time to the next logged event, at most one timer period
FACTORY = H / "factory-metrics.json"
DASH_REPO, DASH_BRANCH, DASH_FILE = _CFG.get("dashboard_repo", f"{ORG}/squid-bot"), "dashboard", "factory.json"
FACTORY_DAYS = 30


def record_factory(c: dict, push: bool = True) -> bool:
    """Keep the day's factory numbers (last FACTORY_DAYS days) and publish them to squid-bot's dashboard branch, where
    the Fleet CI report renders an "Agent factory" row from them. Never raises: the gate must not stop over it."""
    try:
        data = json.loads(FACTORY.read_text()) if FACTORY.exists() else {}
    except ValueError:
        data = {}
    days = data.get("days", {})
    days[c["day"]] = {**c["factory"], "churn_merged": len(c["churn_merged"]), "usd": c["total_usd"],
                      "usd_per_merged_churn_pr": c["usd_per_merged_churn_pr"],
                      "slices_merged": c.get("slices_merged", 0), "items_done": c.get("items_done", 0)}
    keep = sorted(days)[-FACTORY_DAYS:]
    data = {"repo": REPO, "updated": iso(now()), "days": {d: days[d] for d in keep}}
    FACTORY.write_text(json.dumps(data, indent=1, sort_keys=True))
    return push_factory(data) if push else True


# Fields of a factory day that add up across hosts (counts, hours, dollars, worker slots); the ratios are recomputed
# from these sums, so a combined day is exact. ci_busy_hours is each host's view of the same CI queue: the max.
FACTORY_SUM = ("churn_merged", "slices_merged", "items_done", "usd", "loop_runs", "idle_ticks", "idle_hours", "paused_hours", "max_workers",
               "worker_hours", "precheck", "holds", "idle_causes", "idle_blockers")


def _add(a, b):
    if isinstance(a, dict) or isinstance(b, dict):
        a, b = a or {}, b or {}
        return {k: _add(a.get(k), b.get(k)) for k in {*a, *b}}
    return round((a or 0) + (b or 0), 3)


def combine_factory_days(hosts: dict[str, dict]) -> dict[str, dict]:
    """Owner 2026-10-18: two hosts published factory.json in turn and each push replaced the other's numbers. Each host
    now owns hosts[<host_id>]; the top-level `days` the Fleet CI report reads is their sum. A day only one host has is
    that host's day unchanged. The two medians become a churn_merged-weighted mean of the hosts' medians (approximate)."""
    out = {}
    for day in sorted({d for days in hosts.values() for d in days}):
        rows = [days[day] for days in hosts.values() if day in days]
        if len(rows) == 1:
            out[day] = dict(rows[0])
            continue
        c: dict = {}
        for k in FACTORY_SUM:
            for r in rows:
                if k in r:
                    c[k] = _add(c.get(k), r[k])
        c["idle_blockers"] = dict(sorted((c.get("idle_blockers") or {}).items(), key=lambda kv: -kv[1])[:5])
        merged, worked = c.get("churn_merged") or 0, sum((c.get("worker_hours") or {}).values())
        c["usd_per_merged_churn_pr"] = round(c.get("usd", 0) / merged, 2) if merged else None
        c["loops_per_merged_pr"] = round(c.get("loop_runs", 0) / merged, 2) if merged else None
        c["new_work_share"] = round((c.get("worker_hours") or {}).get("new_work", 0) / worked, 3) if worked else None
        slots = sum(r.get("max_workers") or 0 for r in rows)
        c["slot_use"] = (round(sum((r.get("slot_use") or 0) * (r.get("max_workers") or 0) for r in rows) / slots, 3)
                         if slots else None)
        c["ci_busy_hours"] = max((r.get("ci_busy_hours") or 0) for r in rows)
        for k in ("review_wait_min_median", "pr_open_to_merge_h_median"):
            w = [(r[k], r.get("churn_merged") or 1) for r in rows if r.get(k) is not None]
            c[k] = round(sum(v * n for v, n in w) / sum(n for _, n in w), 2) if w else None
        c["hosts"] = len(rows)
        out[day] = c
    return out


def push_factory(data: dict, tries: int = 3) -> bool:
    """Commit this host's factory days to the dashboard branch through the contents API (gh's auth; no clone, no ssh):
    read the published file, replace only hosts[HOST_ID], recompute the combined `days`, write with the read sha. A
    write that lost the race (the other host committed in between) is retried on the new file."""
    path = f"repos/{DASH_REPO}/contents/{DASH_FILE}"
    err = ""
    for _ in range(tries):
        try:
            cur = gh_json(f"{path}?ref={DASH_BRANCH}")
            sha, remote = cur.get("sha"), json.loads(base64.b64decode(cur.get("content") or "e30=") or b"{}")
        except RuntimeError:
            sha, remote = None, {}  # not there yet
        except ValueError:
            sha, remote = cur.get("sha"), {}
        hosts = remote.get("hosts") or ({"_legacy": remote["days"]} if remote.get("days") else {})  # pre-2026-10-18 file
        hosts[HOST_ID] = data["days"]
        out = {"repo": data.get("repo", REPO), "updated": data["updated"], "hosts": hosts,
               "days": combine_factory_days(hosts)}
        content = base64.b64encode(json.dumps(out, indent=1, sort_keys=True).encode()).decode()
        r = run(["gh", "api", "-X", "PUT", path, "-f", f"message=churn: agent factory metrics {data['updated']} ({HOST_ID})",
                 "-f", f"content={content}", "-f", f"branch={DASH_BRANCH}", *(["-f", f"sha={sha}"] if sha else [])])
        if not r.returncode:
            return True
        err = r.stderr.strip()
        if not re.search(r"\b409\b|does not match|sha", err):
            break
    log(f"factory metrics not published: {err[:200]}")
    return False


def write_scorecard_if_due(force_day: dt.date | None = None) -> bool:
    today = now().date()
    state = load_state()
    if force_day is None and state.get("last_daily_summary") == today.isoformat():
        return False
    day = force_day or today - dt.timedelta(days=1)
    try:
        c = scorecard(day, state)
        md = scorecard_md(c)
    except Exception as e:  # noqa: BLE001 -- a scorecard failure must never stop the gate
        log(f"scorecard for {day} failed: {str(e)[:200]}")
        return False
    LOG.write_text(md + (LOG.read_text() if LOG.exists() else ""))
    try:
        if c.get("factory"):
            record_factory(c)
    except Exception as e:  # noqa: BLE001 -- publishing must never stop the gate
        log(f"factory metrics for {day} failed: {str(e)[:200]}")
    if force_day is None:
        with edit_state() as st:
            st["last_daily_summary"] = today.isoformat()
    return True


def cmd_scorecard(a) -> int:
    day = dt.date.fromisoformat(a.day) if a.day else now().date()
    c = scorecard(day, load_state())
    if a.json:
        print(json.dumps(c, indent=1))
    else:
        print(scorecard_md(c), end="")
    if a.write:
        write_scorecard_if_due(day)
    return 0


def cmd_checklist(a) -> int:
    """Checklist parts per open issue of a scope (default core): ticked / total, and the next unclaimed line."""
    state = load_state()
    every = [i for i in gh_pages(f"repos/{REPO}/issues?labels=scope:{a.scope}&state=open&per_page=100")
             if "pull_request" not in i]
    issues = [i for i in every if not host_skips(i)]  # this host's lane only; the other host counts its own
    total = done = 0
    for i in sorted(issues, key=lambda i: -sum(not c["done"] for c in checklist(i.get("body")))):
        items = checklist(i.get("body"))
        n, d = len(items) or 1, sum(c["done"] for c in items)
        total, done = total + n, done + d
        nxt = next_check(i, state)
        print(f"#{i['number']:<5} {d}/{n:<3} {i.get('title', '')[:70]}"
              + (f"\n        next [c:{nxt['key']}] {nxt['text'][:90]}" if nxt and a.next else ""))
    print(f"{len(issues)} open scope:{a.scope} issues: {done}/{total} parts ticked, {total - done} left"
          + (f" ({len(every) - len(issues)} in another host's lane not counted)" if len(every) > len(issues) else ""))
    return 0


def cmd_factory(a) -> int:
    """Record (and publish) the factory numbers for --days past days, e.g. a backfill; today's partial day with --today."""
    state, today = load_state(), now().date()
    days = [today - dt.timedelta(days=i) for i in range(a.days, 0, -1)] + ([today] if a.today else [])
    for i, day in enumerate(days):
        c = scorecard(day, state)
        record_factory(c, push=a.push and i == len(days) - 1)
        print(f"{day}: " + next((x[2:] for x in scorecard_md(c).splitlines() if x.startswith("- Factory:")), "no data"))
    return 0


