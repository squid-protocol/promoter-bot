def _int(x) -> int:
    if isinstance(x, bool):
        raise ValueError(f"not an int: {x!r}")
    if isinstance(x, int):
        return x
    if isinstance(x, float) and x.is_integer():
        return int(x)
    if isinstance(x, str) and x.strip().lstrip("#").isdigit():
        return int(x.strip().lstrip("#"))
    raise ValueError(f"not an int: {x!r}")


def _norm_pr(p):
    if not isinstance(p, dict):
        return _int(p)
    p = dict(p)
    if "number" not in p:
        key = next((k for k in ("pr", "pr_number", "n", "num") if k in p), None)
        if key is None:
            raise ValueError("PR entry has no number")
        p["number"] = p.pop(key)
    p["number"] = _int(p["number"])
    if p.get("issue") is not None:
        p["issue"] = _int(p["issue"])
    return p


def _norm_queue(q):
    if not isinstance(q, dict):
        raise ValueError("queue item is not an object")
    q = dict(q)
    q["issue"] = _int(q.get("issue"))
    if not isinstance(q.get("task"), str) or not q["task"].strip():
        raise ValueError("queue item has no task")
    q["model"] = q.get("model") or "sonnet"
    if q["model"] not in MODELS:
        raise ValueError(f"queue item model {q['model']!r} not in {MODELS}")
    q["needs_owner"] = bool(q.get("needs_owner", False))
    if q.get("backend") in (None, "claude"):
        q.pop("backend", None)
    elif q["backend"] != "agy":
        raise ValueError(f"queue item backend {q['backend']!r}")
    if q.get("pr") is not None:
        q["pr"] = _int(q["pr"])
    if q.get("wait_run") is not None:
        q["wait_run"] = _int(q["wait_run"])
    if "also_prs" in q:
        q["also_prs"] = [_int(x) for x in (q["also_prs"] if isinstance(q["also_prs"], list) else [q["also_prs"]])]
    if "after_prs" in q:
        ap = q["after_prs"] if isinstance(q["after_prs"], list) else [q["after_prs"]]
        q["after_prs"] = [_int(x) for x in ap]
    if q.get("lane") in (None, "normal"):
        q.pop("lane", None)
    elif q["lane"] not in LANES:
        raise ValueError(f"queue item lane {q['lane']!r} not in {LANES}")
    if q.get("scope") is None:
        q.pop("scope", None)
    elif q["scope"] not in SCOPES:
        raise ValueError(f"queue item scope {q['scope']!r} not in {SCOPES}")
    q.pop("promoted", None)  # promotion retired 2026-10-25
    q.pop("tier", None)  # tiers retired 2026-10-25
    if q.get("repo") is not None and q["repo"] not in CRUCIBLE_REPOS:
        raise ValueError(f"queue item repo {q['repo']!r} not in {sorted(CRUCIBLE_REPOS)}")
    # Unknown keys pass through untouched (2026-10-16: a churn process still running the previous code quarantined every
    # item carrying the new `scope` key and emptied the queue). Code that doesn't know a key ignores it; newer code keeps it.
    return q


def _norm_running(r):
    if not isinstance(r, dict):
        raise ValueError("running entry is not an object")
    r = dict(r)
    if r.get("run_id") is not None and not isinstance(r["run_id"], str):
        raise ValueError("running run_id is not a string")
    if r.get("pid") is not None:
        r["pid"] = _int(r["pid"])
    if r.get("issue") is not None:
        r["issue"] = _int(r["issue"])
    return r


def _norm_report(e):
    if not isinstance(e, dict):
        raise ValueError("report entry is not an object")
    e = dict(e)
    for k in ("run_id", "status", "report"):
        if not isinstance(e.get(k), str):
            raise ValueError(f"report entry has no {k}")
    e["issue"] = _int(e.get("issue"))
    return e


def _norm_followup(f):
    if not isinstance(f, dict):
        raise ValueError("followup is not an object")
    f = dict(f)
    f["pr"] = _int(f.get("pr"))
    if f.get("kind") not in ("merged", "closed"):
        raise ValueError(f"followup kind {f.get('kind')!r}")
    return f


def _norm_usage_entry(e):
    if not isinstance(e, dict) or not parse_iso(e.get("t")):
        raise ValueError("usage entry without a valid t")
    e = dict(e)
    if "cost_usd" in e:
        e["cost_usd"] = float(e["cost_usd"])
    return e


SECTIONS = {"prs": _norm_pr, "queue": _norm_queue, "running": _norm_running, "reports_pending": _norm_report,
            "followups": _norm_followup}


def normalize_state(state: dict) -> list[str]:
    """Repair `state` in place; quarantine what can't be repaired. Returns one note per change (empty = clean)."""
    notes: list[str] = []
    qz = state.setdefault("quarantine", [])

    def quarantine(where: str, value, why: str) -> None:
        qz.append({"t": iso(now()), "where": where, "why": why, "value": value})
        notes.append(f"quarantined {where} ({why}): {json.dumps(value)[:160]}")

    for key, fn in [*SECTIONS.items(), ("usage.log", _norm_usage_entry)]:
        holder, name = (state.setdefault("usage", {}), "log") if key == "usage.log" else (state, key)
        val = holder.get(name, [])
        if not isinstance(val, list):
            quarantine(key, val, "not a list")
            val = []
        good = []
        for i, x in enumerate(val):
            try:
                y = fn(x)
            except Exception as e:  # noqa: BLE001 -- any malformed entry goes to quarantine, never crashes the gate
                quarantine(f"{key}[{i}]", x, str(e)[:120])
                continue
            if y != x:
                notes.append(f"repaired {key}[{i}]: {json.dumps(x)[:120]} -> {json.dumps(y)[:120]}")
            good.append(y)
        holder[name] = good
    seen: dict[int, int] = {}  # one entry per watched PR; a dict (it carries reviewed_head) beats a bare int
    prs = []
    for p in state["prs"]:
        n = pr_num(p)
        if n in seen:
            j = seen[n]
            if isinstance(p, dict) and not isinstance(prs[j], dict):
                prs[j] = p
            notes.append(f"repaired prs: duplicate #{n} dropped")
            continue
        seen[n] = len(prs)
        prs.append(p)
    state["prs"] = prs
    for key in ("paused_until", "last_model_tick"):
        if state.get(key) and not parse_iso(state[key]):
            quarantine(key, state[key], "not an ISO time")
            state[key] = None
    try:
        mw = _int(state.get("max_workers", 2))
        if not 0 <= mw <= 4:
            raise ValueError(f"max_workers {mw} outside 0..4")
        state["max_workers"] = mw
    except ValueError as e:
        quarantine("max_workers", state.get("max_workers"), str(e))
        state["max_workers"] = 2
    for gone in ("promoted_issues", "line_partials", "refill"):  # retired 2026-10-25 (the focus replaced them)
        state.pop(gone, None)
    for key in ("agy", "features", "usage", "credit", "retro", "goal", "focus"):
        if not isinstance(state.get(key, {}), dict):
            quarantine(key, state[key], "not an object")
            state[key] = {}
    try:
        mo = _int(state.get("max_opus", 1))
        if not 0 <= mo <= 4:
            raise ValueError(f"max_opus {mo} outside 0..4")
        state["max_opus"] = mo
    except ValueError as e:
        quarantine("max_opus", state.get("max_opus"), str(e))
        state["max_opus"] = 1
    if not isinstance(state["usage"].get("rate", {}), dict):
        quarantine("usage.rate", state["usage"]["rate"], "not an object")
        state["usage"]["rate"] = {}
    state["quarantine"] = qz[-50:]
    if not state["quarantine"]:
        state.pop("quarantine")
    return notes


_LOAD_NOTES: list[str] = []


def load_state() -> dict:
    state = json.loads(STATE.read_text())
    _LOAD_NOTES[:] = normalize_state(state)  # in memory; the next save persists the repair and logs it
    return state


def save_state(state: dict) -> None:
    notes = [*_LOAD_NOTES, *normalize_state(state)]
    _LOAD_NOTES.clear()
    for note in dict.fromkeys(notes):
        log("STATE " + note)
    tmp = STATE.with_suffix(".json.tmp")
    tmp.write_text(json.dumps(state, indent=2) + "\n")
    tmp.replace(STATE)


@contextlib.contextmanager
def edit_state():
    with state_lock():
        state = load_state()
        yield state
        save_state(state)


def log(line: str, quiet: bool = False) -> None:
    with open(QUIET_LOG if quiet else LOG, "a") as fh:
        fh.write(f"- {iso(now())} [churn] {line}\n")


def pid_alive(pid: int | None) -> bool:
    if not pid:
        return False
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


