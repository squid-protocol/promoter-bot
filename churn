    return str(meta.get("status")) if meta.get("finished") else "live"


def exp_value(d: dict, cfg: dict) -> tuple[float, float] | None:
    """(six-month best-case payoff, cost incl. displaced slot-hours) in USD, or None if design.json states no value."""
    v = d.get("value") or {}
    try:
        pay, hrs = float(v["payoff_usd_per_month"]), float(v["slot_hours"])
        usd = len(d.get("arms") or {}) * len(d.get("tasks") or []) * int(d.get("replicates") or 0) * float(d["per_run_usd"])
    except (KeyError, TypeError, ValueError):
        return None
    return 6 * pay, usd + cfg["score_usd"] + cfg["log_usd"] + hrs * float(cfg["slot_hour_usd"])


def exp_design_problems(d: dict, room: float, cfg: dict | None = None) -> list[str]:
    """What makes design.json unrunnable (churn refuses it with no model)."""
    out = []
    cfg = {**EXP_DEFAULT, **(cfg or {})}
    if (val := exp_value(d, cfg)) is None:
        out.append("value missing (payoff_usd_per_month, slot_hours, basis)")
    elif val[0] < float(cfg["payoff_x"]) * val[1]:
        out.append(f"not worth running: six months of best-case payoff ${val[0]:.0f} is under {cfg['payoff_x']:g}x the "
                   f"cost ${val[1]:.0f} (USD plus slot-hours at ${cfg['slot_hour_usd']:g})")
    if d.get("mode") not in ("replay", "live"):
        out.append("mode must be replay or live")
    arms, tasks = d.get("arms") or {}, d.get("tasks") or []
    if not isinstance(arms, dict) or not 2 <= len(arms) <= 4:
        out.append("2-4 arms")
    if not tasks or not all(isinstance(t, dict) and isinstance(t.get("issue"), int) and t.get("brief") for t in tasks):
        out.append("tasks need an issue number and a brief")
    if d.get("mode") == "replay" and not all(t.get("base") and t.get("reference") for t in tasks if isinstance(t, dict)):
        out.append("replay tasks need base and reference shas")
    reps = d.get("replicates")
    if not isinstance(reps, int) or reps < 2:
        out.append("replicates must be at least 2 (one run per arm is an anecdote)")
    try:
        cost = len(arms) * len(tasks) * int(reps or 0) * float(d.get("per_run_usd") or 0)
    except (TypeError, ValueError):
        cost = 0.0
    if not cost:
        out.append("per_run_usd missing")
    elif cost > room:
        out.append(f"arms x tasks x replicates x per_run_usd = ${cost:.0f} is over the ${room:.0f} left")
    if not d.get("rubric"):
        out.append("rubric missing")
    return out


