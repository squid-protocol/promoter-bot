    qp.add_argument("--issue", type=int)
    qp.add_argument("--model", default="sonnet", choices=["haiku", "sonnet", "opus"])
    qp.add_argument("--task", help="what the worker should do (one or two sentences; the tick turns it into a brief)")
    qp.add_argument("--front", action="store_true", help="add at the front of the queue")
    qp.add_argument("--filler", action="store_true",
                    help=f"add: an off-focus item for an open filler window (at most {FILLER_QUEUE_MAX} queued)")
    qp.add_argument("--needs-owner", action="store_true", help="park it until the owner decides")
