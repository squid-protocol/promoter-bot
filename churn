def make_crucible_worktree(repo: str, issue: int, stamp: str) -> tuple[Path, str]:
    """A worktree of <org>/<repo> off origin/main, from one shared clone under WT (never under the gitgalaxy
    repo, per the crucibles' AGENTS.md)."""
    base = WT / f"_clone-{repo}"
    if not (base / ".git").exists():
        r = run(["git", "clone", "-q", f"https://github.com/{REPO.split('/')[0]}/{repo}.git", str(base)], timeout=300)
        if r.returncode != 0:
            raise SystemExit(f"clone of {repo} failed: {r.stderr.strip()[:200]}")
    run(["git", "-C", str(base), "fetch", "-q", "origin"], timeout=120)
    wt, branch = WT / f"{repo}-{issue}-{stamp}", f"churn/{issue}-{stamp}"
    r = run(["git", "-C", str(base), "worktree", "add", "-q", "-b", branch, str(wt), "origin/main"])
    if r.returncode != 0:
        raise SystemExit(f"worktree add failed: {r.stderr.strip()}")
    return wt, branch


def make_worktree(issue: int, stamp: str) -> tuple[Path, str]:
    wt = WT / f"churn-{issue}"
    busy = {r.get("worktree") for r in load_state().get("running", []) if r.get("run_id") and pid_alive(r.get("pid"))}
    busy |= {json.loads((RUNS / r / "meta.json").read_text()).get("worktree") for r in
             [x.get("run_id") for x in load_state().get("running", []) if x.get("run_id") and pid_alive(x.get("pid"))]}
    if wt.exists() and str(wt) in busy:  # a second worker on the same issue (another step) gets its own tree
        wt = WT / f"churn-{issue}-{stamp}"
    if wt.exists():
        branch = run(["git", "-C", str(wt), "branch", "--show-current"]).stdout.strip()
        try:
            done = [p for p in gh_json(f"repos/{REPO}/pulls?state=closed&head={REPO.split('/')[0]}:{branch}") if p.get("closed_at")]
        except RuntimeError:
            done = []
        if not done:
            return wt, branch
        wt = WT / f"churn-{issue}-{stamp}"  # its PR is merged/closed: start a new branch off origin/main
    return new_worktree(issue, stamp, wt)


def use_systemd() -> bool:
    return bool(shutil.which("systemd-run")) and run(["systemctl", "--user", "is-system-running"]).stdout.strip() in (
        "running", "degraded")


def spawn_detached(unit: str, cmd: list[str], cwd: Path, logfile: Path, props: list[str] | None = None) -> int:
    """Start cmd outside the caller's lifetime. Under systemd each worker is its own transient user unit: a oneshot
    tick service kills every process left in its cgroup when it ends, so a plain child would die with the tick."""
    if use_systemd():
        r = run(["systemd-run", "--user", "--collect", "--quiet", f"--unit={unit}", f"--working-directory={cwd}",
                 "-p", "Nice=5", *[x for p in props or [] for x in ("-p", p)],
                 f"--setenv=PATH={os.environ.get('PATH', '/usr/bin:/bin')}", *cmd])
        if r.returncode == 0:
            for _ in range(20):
                pid = run(["systemctl", "--user", "show", "-p", "MainPID", "--value", unit]).stdout.strip()
                if pid.isdigit() and int(pid) > 0:
                    return int(pid)
                time.sleep(0.25)
            return 0
        log(f"systemd-run failed for {unit} ({r.stderr.strip()[:120]}); falling back to a session-detached child")
    with open(logfile, "w") as wl:
        return subprocess.Popen(cmd, cwd=cwd, stdin=subprocess.DEVNULL, stdout=wl, stderr=subprocess.STDOUT,
                                start_new_session=True).pid


def nudge_tick() -> None:
    """Ask for a tick now (a worker finished). The tick service queues behind a running tick, which loops on DIRTY."""
    if use_systemd() and run(["systemctl", "--user", "cat", "churn-tick.service"]).returncode == 0:
        run(["systemctl", "--user", "start", "--no-block", "churn-tick.service"])
        return
    subprocess.Popen([sys.executable, SELF, "tick"], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True, cwd=str(TICK_CWD))


def crucible_repo_of(issue: int) -> str | None:
    """The repo of this issue's queue items when they all agree (a crucible step and a gitgalaxy item of the same
    issue disagree: then the tick must pass --repo, which the gate's launch line names)."""
    repos = {q.get("repo") for q in load_state().get("queue", []) if q.get("issue") == issue and not q.get("pr")} \
        if STATE.exists() else set()
    return next(iter(repos)) if len(repos) == 1 else None


def held_by_live(state: dict, wt: Path, task: str) -> str | None:
    """The live run already on this worktree, or on the PR this task names (`PR #n`), else None. #20: an Opus rescue
    and a Sonnet fix launched on #5552 a minute apart, and resumes started on work a live peer had just finished."""
    prs = set(re.findall(r"PR #(\d+)\b", task or ""))
    for r in state.get("running", []):
        if not r.get("run_id") or not pid_alive(r.get("pid")):
            continue
        if str(_run_meta(r["run_id"]).get("worktree") or "") == str(wt) or any(
                re.search(rf"#{n}\b", r.get("task") or "") for n in prs):
            return r["run_id"]
    return None


def checklist_note(issue: int) -> str:
