def comment_run_outcome(e: dict, note: str) -> None:
    """A run that ends without a PR leaves its outcome only in the local churn log, which the other host, the owner on
    GitHub and a later worktree cleanup never see (owner 2026-10-19): post the review note on the issue."""
    r = run(["gh", "issue", "comment", str(e["issue"]), "-R", REPO, "--body",
             f"<!-- promoter-bot run-outcome run={e['run_id']} -->\n**Churn run `{e['run_id']}` (host {HOST_ID}) ended "
             f"without a PR.** {note}"])
    if r.returncode:
        log(f"run-outcome comment on #{e['issue']} failed: {r.stderr.strip()[:160]}")


def cmd_review(a) -> int:
    with edit_state() as st:
        pending = st.get("reports_pending", [])
        hit = next((e for e in pending if e["run_id"] == a.run_id), None)
        if hit is None:
            raise SystemExit(f"{a.run_id} is not in reports_pending")
        st["reports_pending"] = [e for e in pending if e["run_id"] != a.run_id]
    log(f"review done {a.run_id}" + (f": {a.note[:160]}" if a.note else ""))
    # another repo's run never records its PR (reap skips the lookup): no outcome comment there
    if a.note and hit.get("issue") and not hit.get("pr") and not hit.get("repo") and not getattr(a, "no_comment", False):
        comment_run_outcome(hit, a.note)
    return 0


def cmd_agy_result(a) -> int:
    """Record one Sonnet-checked agy run in the ladder trial; two REJECTs at a step route that step (and the ones
    above it) back to Claude (owner 2026-10-13)."""
    with edit_state() as st:
        trial = st.setdefault("agy", {}).setdefault("trial", {})
        res = trial.setdefault("results", [])
        res.append({"issue": a.issue, "step": a.step, "verdict": a.verdict, "pr": a.pr, "denials": a.denials,
                    "notes": (a.notes or "")[:300], "t": iso(now())})
        rejects = sum(1 for r in res if r.get("step") == a.step and r.get("verdict") == "REJECT")
        rerouted = []
        if rejects >= 2:
            for q in st.get("queue", []):
                if q.get("backend") == "agy" and int(q.get("agy_step") or 0) >= a.step:
                    q.pop("backend")
                    rerouted.append(q["issue"])
    log(f"agy trial: #{a.issue} step {a.step} {a.verdict}" + (f" (PR #{a.pr})" if a.pr else "")
        + (f"; {rejects} REJECTs at step {a.step}: agy capped at step {a.step - 1}, rerouted to Claude: "
           + ", ".join(f"#{i}" for i in rerouted) if rejects >= 2 else ""))
    return 0


def restore_quarantine(state: dict) -> list[str]:
    """Move quarantined section entries back when they now pass their section's checks (e.g. after a schema change the
    quarantining process didn't know). Entries that still fail, or duplicate a live entry, stay quarantined."""
    notes, keep = [], []
    for e in state.get("quarantine", []):
        m = re.match(r"(\w+)\[\d+\]$", str(e.get("where", "")))
        fn = SECTIONS.get(m.group(1)) if m else None
        if not fn:
            keep.append(e)
            continue
        try:
            y = fn(e.get("value"))
        except Exception as ex:  # noqa: BLE001
            keep.append({**e, "restore_failed": str(ex)[:120]})
            continue
        live = state.setdefault(m.group(1), [])
        if any(json.dumps(x, sort_keys=True) == json.dumps(y, sort_keys=True) for x in live):
            notes.append(f"dropped quarantined {e['where']}: already present")
            continue
        live.append(y)
        notes.append(f"restored {e['where']} from quarantine ({e.get('t')}): {json.dumps(y)[:140]}")
    state["quarantine"] = keep
    return notes


def cmd_state(a) -> int:
    if a.action == "restore":
        with edit_state() as st:
            notes = restore_quarantine(st)
        for n in notes:
            log(n)
        print("\n".join(notes) if notes else "nothing to restore")
        return 0
    raw = json.loads(STATE.read_text())
    notes = normalize_state(raw)
    print("\n".join(notes) if notes else "state OK")
    if a.fix and notes:
        with edit_state():
            pass  # load + save: the save normalizes, persists and logs
        print("repaired and saved")
    return 1 if notes and not a.fix else 0


def _parse_pace(v: str) -> str:
    if v not in ("off", "rate", "ledger"):
        raise ValueError("pace is off, rate or ledger")
    return v


def _parse_time(v: str) -> str:
    if not (t := parse_iso(v)):
        raise ValueError("not an ISO time")
    return iso(t)


# key -> (where, parse); `where` is a path into the state. Owner 2026-10-16: knobs change through churn, never by hand.
CONFIG_KEYS = {
    "max_workers": (("max_workers",), int),
    "max_opus": (("max_opus",), int),
    "core_reserve": (("core_reserve",), int),
    "pace": (("usage", "pace"), _parse_pace),
    "block_start": (("usage", "block_start"), _parse_time),
    **{f"rate.{k}": (("usage", "rate", k), int if isinstance(d, int) else float) for k, d in RATE_DEFAULT.items()},
    **{f"ci.{k}": (("ci_admission_cfg", k), int if isinstance(d, int) else float) for k, d in CI_ADMISSION_DEFAULT.items()},
}


def cmd_credit(a) -> int:
    """`churn credit` (status), `add USD [--expires D] [--note N]`, `sync USD` (the Console's balance), `on`, `off`,
    `when paused|always`, `model haiku|sonnet|opus`."""
    if a.action in ("add", "sync") and a.value is None:
        raise SystemExit(f"credit {a.action} needs an amount in USD")
    with edit_state() as st:
        c = st.setdefault("credit", {})
        if a.action == "add":
            c.setdefault("grants", []).append({"t": iso(now()), "usd": round(float(a.value), 2),
                                               **({"expires": iso(parse_iso(a.expires) or now())} if a.expires else {}),
                                               **({"note": a.note} if a.note else {})})
            c.pop("blocked", None)
            log(f"credit: +${float(a.value):.2f} granted" + (f", expires {a.expires}" if a.expires else ""))
        elif a.action == "sync":
            delta = round(float(a.value) - credit_balance(st)["balance"], 2)
            c.setdefault("grants", []).append({"t": iso(now()), "usd": delta, "note": f"sync to Console balance ${a.value}"})
            log(f"credit: synced to ${float(a.value):.2f} (adjustment {delta:+.2f})")
        elif a.action in ("on", "off"):
            c["enabled"] = a.action == "on"
            if a.action == "on":
                c.pop("blocked", None)
        elif a.action == "when":
            if a.value not in ("paused", "always"):
                raise SystemExit("credit when: paused | always")
            c["when"] = a.value
        elif a.action == "model":
            if a.value not in WORKER_BUDGET:
                raise SystemExit(f"credit model: one of {sorted(WORKER_BUDGET)}")
            c["model"] = a.value
        state = st
    cfg, bal = credit_cfg(state), credit_balance(state)
    ok, why = credit_ready(state, bool((p := parse_iso(state.get("paused_until"))) and now() < p))
    print(f"credit lane: {'on' if cfg['enabled'] else 'off'}, when={cfg['when']}, model={cfg['model']}, "
          f"key {'present' if credit_key(cfg) else 'MISSING'} ({cfg['key_file']})")
    print(f"balance ${bal['balance']:.2f} = granted ${bal['granted']:.2f} - spent ${bal['spent']:.2f} - expired "
          f"${bal['expired']:.2f}" + (f"; next expiry {bal['next_expiry']}" if bal["next_expiry"] else ""))
    print(f"runs: {len((state.get('credit') or {}).get('log', []))}; now: {'ready' if ok else why}")
    return 0


def cmd_retro(a) -> int:
    """`churn retro` (status), `now` (due at the next tick), `on`, `off`, `set issue|every_days|model|budget_usd|deep_every V`,
    `size FILE KB` (0 removes the budget)."""
    with edit_state() as st:
        r = st.setdefault("retro", {})
        if a.action == "now":
            r.pop("last", None)
        elif a.action in ("on", "off"):
            r["enabled"] = a.action == "on"
        elif a.action == "set":
            casts = {"issue": int, "every_days": float, "model": str, "budget_usd": float, "deep_every": int}
            if a.key not in casts or a.value is None:
                raise SystemExit(f"retro set: one of {sorted(casts)} and a value")
            if a.key == "model" and a.value not in WORKER_BUDGET:
                raise SystemExit(f"retro model: one of {sorted(WORKER_BUDGET)}")
            r[a.key] = casts[a.key](a.value)
        elif a.action == "size":
            if not a.key or a.value is None:
                raise SystemExit("retro size FILE KB")
            sizes = dict(retro_cfg(st)["size_budget_kb"])
            if float(a.value) > 0:
                sizes[a.key] = float(a.value)
            else:
                sizes.pop(a.key, None)
            r["size_budget_kb"] = sizes
        state = st
    cfg, r = retro_cfg(state), state.get("retro") or {}
    print(f"weekly retro: {'on' if cfg['enabled'] else 'off'}, issue #{cfg['issue']}, every {cfg['every_days']} days, "
          f"{cfg['model']} cap ${cfg['budget_usd']}, deep audit every {cfg['deep_every']}; done {r.get('count', 0)}, last "
          f"{r.get('last')}; size budgets {cfg['size_budget_kb']}; now: {retro_due(state)[1]}")
    return 0


