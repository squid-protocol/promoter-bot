    if a.cmd == "tick":
        if a.reason and not a.force:
            a.reason = []
        return cmd_tick(a) if a.dry_run else guarded_tick(lambda: cmd_tick(a))
    if a.cmd == "worker":
        if a.issue is None:
            ap.error("worker needs --issue")
        a.resume_run = None
        return cmd_worker(a)
    if a.cmd == "send-back":
        prev = json.loads((RUNS / a.run_id / "meta.json").read_text())
        if not prev.get("session_id"):
            raise SystemExit(f"{a.run_id} has no session id (not reaped yet, or it crashed)")
        fin = parse_iso(prev.get("finished"))
        if fin and now() - fin > dt.timedelta(hours=1) and not a.force:
            raise SystemExit(f"{a.run_id} finished {iso(fin)}, over 1 h ago: its prompt cache is gone and a resume re-bills "
                             "the whole context (#4767). Start a fresh `churn worker` from its handoff note instead "
                             "(--force to resume anyway).")
        ns = argparse.Namespace(resume_run=a.run_id, message=a.message, force=False, plan=False)
        return cmd_worker(ns)
