def cmd_tick(a) -> int:
    H.mkdir(parents=True, exist_ok=True)
    TICK_LOCK.touch(exist_ok=True)
    fh = open(TICK_LOCK)
    try:
        fcntl.flock(fh, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        DIRTY.touch()  # the running tick loops once more when it sees this
        return 0
    if STOP.exists() and not a.dry_run:  # a dry run only reports, so it may preview a stopped churn
        log("stopped (churn.stop present)", quiet=True)
        return 0
    for _ in range(2):
        started = time.time()
        DIRTY.unlink(missing_ok=True)
        with edit_state() as state:
            reaped = reap(state)
        for e in reaped:
            log(f"reaped {e['run_id']} (#{e['issue']} {e['model']}): {e['status']}")
        state = load_state()
        if not a.dry_run:
            with contextlib.suppress(Exception):  # first: a runaway writer waits out neither a limit nor an outage
                for line in scratch_watch(state):
                    log(line)
            if down := unreachable():
                offline_tick(state, down)
                return 0
            if state.get("offline"):
                back_online()
                state = load_state()
            with contextlib.suppress(Exception):
                flush_outbox()
            with contextlib.suppress(Exception):  # the install follows origin/main (sync pulse, hourly)
                if note := run_sync_pulse():
                    log(note)
        paused = parse_iso(state.get("paused_until"))
        if paused and now() < paused:  # Claude's limit; agy has its own quota and API credit its own bill: both go on
            did = []
            agy_items = any(q.get("backend") == "agy" for q in state.get("queue", []))
            if agy_items or credit_ready(state, True)[0]:
                refresh_tools()
                b, snap = box(), (json.loads(SNAP.read_text()) if SNAP.exists() else {})
                did = (lanes(b, snap, True, a.dry_run) if agy_items else []) + credit_lane(b, snap, True, a.dry_run)
            log(f"paused until {iso(paused)}" + (f"; lanes: {', '.join(did)}" if did else ""), quiet=not did)
            if a.dry_run:
                print(json.dumps({"paused_until": iso(paused), "lanes": did}, indent=1))
            return 0
        refresh_tools()
        b = box()
        with contextlib.suppress(Exception):
            if (qr := quota_tick(state)) and not a.dry_run:
                with edit_state() as st:
                    st["gh_quota"] = qr
            if QUOTA_MODE == "hold" and b.get("verdict") == "GREEN":  # launches wait; reviews and live work go on
                b = {**b, "verdict": "YELLOW", "reasons": [*b.get("reasons", []),
                     f"GitHub API quota under the reserve ({(qr or {}).get('remaining')} left): new launches wait"]}
        old = json.loads(SNAP.read_text()) if SNAP.exists() else {}
        _OPEN_CACHE.clear()
        global _INFLIGHT
