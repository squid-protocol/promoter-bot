def model_tick(reasons: list[str], model: str, state: dict, b: dict) -> dict:
    td = RUNS / "ticks"
    td.mkdir(parents=True, exist_ok=True)
    stamp = now().strftime("%Y%m%dT%H%M%SZ")
    status = (
        f"Headless tick started by `churn tick` at {iso(now())}. The gate already reaped finished workers, "
        "refreshed the PR snapshot and checked the box; don't redo those. Why this tick runs:\n"
        + "\n".join(f"- {r}" for r in reasons)
        + f"\nBox: {b.get('verdict')} free_slots {b.get('free_slots')} ({'; '.join(b.get('reasons', [])[:3])}).\n"
        f"Spend: window ${window_usd(state):.0f} over {WINDOW_H}h; learned budget "
        f"{state.get('usage', {}).get('learned_budget_usd') or 'unknown'}"
        + (" -- pace is OFF (owner): ignore spend, fill free slots; a limit hit pauses churn until the reset by itself.\n"
           if state.get("usage", {}).get("pace") == "off" else
           f" -- {plan['why']}. The gate already sized the launches to this block: launch exactly what it named.\n"
           if (plan := rate_plan(state)) else ".\n")
        + f"Claude workers running: {sum(1 for r in state.get('running', []) if r.get('run_id') and r.get('backend') != 'agy' and r.get('lane') != 'credit')} "
        f"of {state.get('max_workers', 2)} (agy-lane runs: {sum(1 for r in state.get('running', []) if r.get('backend') == 'agy')}, "
        "they do NOT count toward the cap).\n"
    )
    # 2026-10-18 cost audit: the skill's ~37 KB body lands AFTER the command args, so a per-tick status in the args made
    # every tick re-write ~22k cache tokens (~79% of a tick's cost). The prompt is now byte-identical across ticks (the
    # skill body stays cached for the hour) and this tick's status is a file the tick reads first.
    (td / f"{stamp}-{model}-status.md").write_text(status)
    TICK_STATUS.write_text(status)
    prompt = (
        "/night-shift tick\n\n"
        f"Start by reading {TICK_STATUS}: when this headless tick started and why it runs, the box, spend and "
        "running workers.\n"
        "Launch workers ONLY with `churn worker` (never the Agent tool); send one back with `churn send-back`.\n"
        "An allow_workflows item's grant carries to `churn worker` by itself (even after `churn queue rm`); "
        "`--allow-workflows` only confirms it and refuses the launch when there is none.\n"
        + TICK_CLI
        + "Reply in 2-4 lines."
    )
    cmd = claude_cmd(prompt, model, TICK_BUDGET[model], allowed=TICK_ALLOWED)
    cmd += ["--disallowedTools", f"Edit({STATE})", f"Write({STATE})", f"Edit({SNAP})", f"Write({SNAP})"]
    out_path = td / f"{stamp}-{model}.json"
    try:
        with open(out_path, "w") as out, open(td / f"{stamp}-{model}.err", "w") as err:
            subprocess.run(cmd, cwd=TICK_CWD, stdin=subprocess.DEVNULL, stdout=out, stderr=err, timeout=TICK_TIMEOUT_S,
                           env=plan_env())
    except subprocess.TimeoutExpired:
        log(f"model tick ({model}) timed out after {TICK_TIMEOUT_S // 60} min; see {out_path}")
    try:
        return json.loads(out_path.read_text())
    except Exception:
        return {}


# ---------------------------------------------------------------- queue generators
# 2026-10-25: the three-stage refill (rules over all open issues, then a tick asked to file and label work, then the
# "effectively endless" call-graph filler) is gone. It existed so a slot never sat idle, and that is exactly how the
# fleet left every focus the owner set: an idle slot was filled with whatever was open. Work now comes only from the
# focus's own generators (ladder_items, settle_check's next checklist line and requeue_next_slice, both for focus
# issues), PR fixes and red main. An idle slot under a focus pages the owner (focus_alerts) instead.


def launchable(state: dict, snap: dict | None) -> int:
    """Focus items a slot could take now or soon: not the owner's, not agy, not blocked or waiting."""
    return sum(1 for x in state.get("queue", []) if not x.get("needs_owner") and x.get("backend") != "agy"
               and in_focus(state, x) and not blocked_by(x, snap, state) and not waiting(x))


def open_issues() -> list[dict]:
    r = run(["gh", "issue", "list", "--repo", REPO, "--state", "open", "--limit", "500",
             "--json", "number,title,labels,milestone,assignees,body"], timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh issue list: {r.stderr.strip()[:160]}")
    return json.loads(r.stdout)


# Owner 2026-10-18: an issue's checklist is its parts list, and the boxes were never ticked (156 merged PRs against the
# open core issues, 0 of 138 lines checked). A refill item now names ONE unchecked line by a key, the worker writes
# `Checklist: done|partial [c:<key>]` in the PR body, and on merge the gate ticks that line itself: the boxes count
# what is left (scorecard), and a core issue's next line is queued at once instead of after the 12 h cooldown.
CHECK_RE = re.compile(r"^(\s*[-*]\s+)\[([ xX])\]\s+(.*?)\s*$", re.M)
CHECK_KEY_RE = re.compile(r"\[c:([0-9a-f]{8})\]")
PR_CHECK_RE = re.compile(r"\bChecklist:?\W*(done|partial)\b[^\n]*?\[c:([0-9a-f]{8})\]([^\n]*)", re.I)


def check_key(text: str) -> str:
    return hashlib.sha1(" ".join(text.split()).lower().encode()).hexdigest()[:8]


def checklist(body: str | None) -> list[dict]:
    """[{done, text, key}] for each `- [ ]` / `- [x]` line of an issue body."""
    return [{"done": m.group(2) != " ", "text": m.group(3), "key": check_key(m.group(3))}
            for m in CHECK_RE.finditer(body or "")]


def tick_line(body: str, key: str, pr: int) -> str | None:
    """body with the unchecked line `key` ticked and its PR appended; None if no unchecked line has that key."""
    for m in CHECK_RE.finditer(body):
        if m.group(2) == " " and check_key(m.group(3)) == key:
            return body[:m.start()] + f"{m.group(1)}[x] {m.group(3)} (#{pr})" + body[m.end():]
    return None


def claimed_checks(state: dict, issue: int) -> set[str]:
    """Checklist keys of issue #issue that a queued or running item already holds."""
    return {k for s in ("queue", "running") for x in state.get(s, []) if x.get("issue") == issue
            for k in CHECK_KEY_RE.findall(str(x.get("task", "")))}


def next_check(i: dict, state: dict) -> dict | None:
    taken = claimed_checks(state, i["number"])
    return next((c for c in checklist(i.get("body")) if not c["done"] and c["key"] not in taken), None)


def check_task(i: dict, c: dict) -> str:
    k = c["key"]
    return (f"#{i['number']} {i.get('title', '')[:120]} -- checklist item [c:{k}]: \"{c['text'][:300]}\". Do this item "
            "(or its next PR-sized slice); burned estates only, list the rest as sibling gaps. Put one line in the PR "
            f"body: `Checklist: done [c:{k}]` if this PR completes the item, else `Checklist: partial [c:{k}] -- <what "
            "is left>`. Never edit the issue: the gate ticks the box when the PR merges.")


def refill_item(i: dict, task: str | None = None, check: dict | None = None) -> dict:
    meta = {"title": i.get("title", ""), "labels": i.get("labels") or []}
    item = {"issue": i["number"], "model": "sonnet", "needs_owner": False, "auto": "refill",
            "task": task or (check_task(i, check) if check else
                             f"#{i['number']} {i.get('title', '')[:120]} -- take the next unchecked item on the issue; "
                             "burned estates only, list the rest as sibling gaps")}
    if sc := issue_scope(i["number"], meta):
        item["scope"] = sc
    return item


def goal_reports() -> list[dict]:
    """The evidence reports at goal_reports.ref (fetched first): one dict per `report.json` under goal_reports.path,
    with `file` added. A report lists programs[] with `program`, `level` (L0..L5, `*` = carried while stale) and
    `translation` {hole_count, gap_classes, refused}. No goal_reports in the host config: nothing to measure."""
    ref, path = GOAL_REPORTS.get("ref"), GOAL_REPORTS.get("path")
    if not ref or not path:
        return []
    if GOAL_REPORTS.get("fetch"):
        run(["git", "-C", str(V6), "fetch", "-q", "origin", GOAL_REPORTS["fetch"]], timeout=120)
    r = run(["git", "-C", str(V6), "ls-tree", "-r", "--name-only", ref, "--", path])
    if r.returncode:
        raise RuntimeError(f"goal reports at {ref}:{path}: {r.stderr.strip()[:160]}")
    out = []
    for f in r.stdout.split():
        if f.endswith("report.json") and not (s := run(["git", "-C", str(V6), "show", f"{ref}:{f}"])).returncode:
            with contextlib.suppress(ValueError):
                out.append({**json.loads(s.stdout), "file": f})
    return out


def goal_measure(reports: list[dict], issues: list[dict]) -> dict:
    """Programs per level, and every program that does not translate whole (L0) with the open issues that name it.
    `untracked` = L0 programs no open issue mentions: nobody is working on them. `below` = {estate: [[program, level]]}
    for the programs at L1-L3, which the ladder refill slices by estate."""
    levels: collections.Counter = collections.Counter()
    texts = [(i["number"], f"{i.get('title', '')}\n{i.get('body') or ''}".lower()) for i in issues]
    untranslated, below = [], collections.defaultdict(list)
    for rep in reports:
        for p in rep.get("programs") or []:
            lv = str(p.get("level") or "?").rstrip("*")
            levels[lv] += 1
            if lv in ("L1", "L2", "L3"):
                below[Path(rep["file"]).parent.name].append([Path(str(p.get("program", ""))).stem, lv])
            if lv != "L0":
                continue
            t = p.get("translation") or {}
            stem = Path(str(p.get("program", ""))).stem.lower()
            hits = sorted(n for n, txt in texts if stem and re.search(rf"\b{re.escape(stem)}\b", txt))
            untranslated.append({"estate": Path(rep["file"]).parent.name, "program": p.get("program"),
                                 "holes": t.get("hole_count"), "refused": t.get("refused"),
                                 "classes": [str(c)[:120] for c in (t.get("gap_classes") or [])[:4]], "issues": hits})
    return {"t": iso(now()), "programs": sum(levels.values()), "levels": dict(sorted(levels.items())),
            "untranslated": untranslated, "untracked": [u["program"] for u in untranslated if not u["issues"]],
            "below": {e: sorted(ps) for e, ps in sorted(below.items())}}


def goal_summary(m: dict) -> str:
    lv = " ".join(f"{k} {v}" for k, v in (m.get("levels") or {}).items())
    holes = sum(int(u.get("holes") or 0) for u in m.get("untranslated", []))
    return (f"{m.get('programs', 0)} programs: {lv}; {len(m.get('untranslated', []))} not translated whole "
            f"({holes} holes), {len(m.get('untracked', []))} with no open issue")


def goal_tick(state: dict, force: bool = False) -> list[str]:
    """Measure when due (goal.measure_every_h), keep the result and a dated snapshot, and set goal.ask to the untracked
    programs not asked about in the last day. Returns log notes."""
    g = goal_cfg(state)
    last = parse_iso((g.get("measure") or {}).get("t"))
    due = (state.get("goal") or {}).get("measure_due")
    if not GOAL_REPORTS or (not force and not due and last and
                            now() - last < dt.timedelta(hours=float(g["measure_every_h"]))):
        return []
    m = goal_measure(goal_reports(), open_issues())
    snaps = H / "progress-snapshots"
    snaps.mkdir(exist_ok=True)
    (snaps / f"goal-{now().strftime('%Y-%m-%dT%H%MZ')}.json").write_text(json.dumps(m, indent=1))
    with edit_state() as st:
        gs = st.setdefault("goal", {})
        gs["measure"] = m
        gs.pop("measure_due", None)
        asked = {k: t for k, t in (gs.get("asked") or {}).items()
                 if (ts := parse_iso(t)) and now() - ts < dt.timedelta(days=1)}
        gs["asked"] = asked
        gs["ask"] = [p for p in m["untracked"] if p not in asked]
    return [f"goal measured: {goal_summary(m)}"]


def goal_need(state: dict) -> str:
    g = goal_cfg(state)
    rows = {u["program"]: u for u in (g.get("measure") or {}).get("untranslated", [])}
    lines = "; ".join(f"{p} ({rows.get(p, {}).get('estate', '?')}: {rows.get(p, {}).get('holes')} holes"
                      + (f", refused: {rows[p]['refused']}" if rows.get(p, {}).get("refused") else "")
                      + f", classes: {' | '.join(rows.get(p, {}).get('classes') or [])[:240]})" for p in g.get("ask", []))
    return (f"evidence measure: these programs do not translate whole and no open issue names them: {lines}. "
            "For each hole class (one issue per class, several programs may share it): check closed issues for an owner "
            "decision first; if the program cannot be done here (source the vendor compiler rejects, needs a real "
            "mainframe, a language we do not translate) file it scope:frontier and say why; otherwise file a scope:core "
            "issue with the holes and source lines, a checklist, and the labels the repo uses. Do NOT queue it: list "
            "the new issues in your summary, and the owner adds them to the focus (`churn focus add`) or not.")


# Owner 2026-10-25: the factory drifted off the L1->L4 ladder. The estate slices were queued by hand once (10-23), merged,
# and nothing queued the next round: the rule refill skips an issue with an open PR or a run in the last 12 h, so it fell
# through to infra and call-graph work (~20 of ~240 merges on 10-24 were ladder work), and the checklist's "SPLIT FIRST"
# kept re-slicing #6072's estate lines (12 partials on one line: estate-sized data PRs are partial by design). Now, with
# a focus ladder (`churn focus ladder N`), every gate pass queues one slice per estate that has programs below L4 (from
# the goal measure) and no ladder item queued, running or in an open PR; an estate is queued again only after a newer
# measure. It is the focus's own generator: the one refill left while a focus is set.
LADDER_TAG = "[ladder:{}]"


def ladder_anchor(state: dict) -> int | None:
    return (focus_cfg(state).get("ladder") or {}).get("anchor")


def ladder_items(state: dict, snap: dict | None) -> list[dict]:
    """New ladder slices for the focus ladder's anchor issue, one per estate (stamps focus.ladder_queued)."""
    g = goal_cfg(state)
    anchor = ladder_anchor(state)
    if not anchor or not in_focus(state, {"issue": anchor}) or state.get("workers_paused"):
        return []
    m = g.get("measure") or {}
    measured = parse_iso(m.get("t"))
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    tasks = [str(x.get("task") or "") for x in [*state.get("queue", []), *live]]
    branches = {v.get("branch") for v in (snap or {}).values() if v.get("state") == "open"}
    tasks += [str(mt.get("task") or "") for d in RUNS.glob(f"{anchor}-*")
              if (mt := _run_meta(d.name)) and mt.get("branch") in branches]
    ours = " ".join(t for t in tasks if "[ladder:" in t)
    others = " ".join(t for t in tasks if "[ladder:" not in t)
    skip = {str(x).lower() for x in (focus_cfg(state).get("ladder") or {}).get("skip") or []}
    last = dict(focus_cfg(state).get("ladder_queued") or {})
    out = []
    for estate, progs in sorted((m.get("below") or {}).items()):
        if estate.lower() in skip:
            continue  # a whole estate dropped from the ladder (owner 2026-10-27: cics-crucible)
        tag = LADDER_TAG.format(estate)
        if tag in ours or ((t := parse_iso(last.get(estate))) and (not measured or measured <= t)):
            continue  # in hand, or this measure was already sliced: wait for a newer one
        progs = [(p, lv) for p, lv in progs if p.lower() not in skip
                 and not re.search(rf"\b{re.escape(p)}\b", others, re.I)]  # another item already works on it
        if not progs:
            continue
        names = ", ".join(f"{p} ({lv})" for p, lv in progs)
        out.append({"issue": int(anchor), "model": "sonnet", "needs_owner": False, "auto": "ladder", "scope": "core",
                    "task": f"{tag} ladder slice of #{anchor}, estate {estate}: lift every program below L4 at the "
                            f"latest evidence report ({names}). Re-measure at origin/main first (`ladder_gaps.py`): drop "
                            f"what is already L4. ONE PR for the estate, one or both rungs, data only (case scenarios, "
                            f"reviewed infeasible outcomes with their reason; the ladder-slice skill, `ladder_refresh.py`); "
                            f"state before/after coverage per program. A program that will not close goes under "
                            f"**Remaining slices** with why; a harness or tool gap is a sibling for #6271, never code in "
                            f"this PR. Burned estates only; evidence levels, not 'proven'."})
        last[estate] = iso(now())
    if out:
        state.setdefault("focus", {})["ladder_queued"] = last
    return out


def cmd_goal(a) -> int:
    """`churn goal` (the last evidence measure), `measure` (measure now). The focus ladder reads it."""
    state = load_state()
    if a.action == "measure":
        if not GOAL_REPORTS:
            raise SystemExit("no goal_reports in the host config: nothing to measure")
        for note in goal_tick(state, force=True):
            log(note)
            print(note)
        return 0
    m = goal_cfg(state).get("measure")
    if not m:
        print("not measured" + ("" if GOAL_REPORTS else ": no goal_reports in the host config"))
        return 0
    print(f"measured {m['t']}: {goal_summary(m)}")
    for e, ps in (m.get("below") or {}).items():
        print(f"  below L4, {e}: " + ", ".join(f"{p} ({lv})" for p, lv in ps))
    for u in m.get("untranslated", []):
        print(f"  L0 {u['estate']} {u['program']}: {u.get('holes')} holes"
              + (f" ({u['refused']})" if u.get("refused") else "") + " -> "
              + (", ".join(f"#{n}" for n in u["issues"]) or "NO ISSUE"))
    return 0


# Owner 2026-10-18: more than one host (and later people) work the same repo. GitHub is the only state they share, so
# an issue's owner is recorded there: a person by assigning themselves, a host by a `claim:<host_id>` label plus one
# lease comment it edits on every refresh. Every host skips issues that are assigned or claimed by someone else; a
# claim nobody refreshed for ttl_h hours expires and may be taken over. Two hosts claiming in the same minute: the
# earliest `labeled` event of a claim still on the issue wins, the other host takes its label back off.
CLAIMS_DEFAULT = {"enabled": True, "ttl_h": 6, "refresh_h": 2, "expire_checks": 10, "per_tick": 10}
CLAIM_PREFIX = "claim:"
CLAIM_MARK = "<!-- promoter-bot claim host={} -->"


def claims_cfg(state: dict) -> dict:
    return {**CLAIMS_DEFAULT, **{k: v for k, v in (state.get("claims") or {}).items() if k in CLAIMS_DEFAULT}}


def claim_label(host: str = HOST_ID) -> str:
    return CLAIM_PREFIX + host


def claim_exempt(state: dict, issue) -> bool:
    """Standing issues every host may work at once: the weekly retro's issue."""
    return not issue or int(issue) == retro_cfg(state).get("issue")


def foreign_claim(i: dict) -> str | None:
    """Who else holds issue `i` (a gh issue dict with labels + assignees): a person or another host; None if free."""
    if who := [str(x.get("login", "")) for x in i.get("assignees") or []]:
        return "assigned to " + ", ".join(who)
    hosts = [n[len(CLAIM_PREFIX):] for n in (str(lab.get("name", "")) for lab in i.get("labels") or [])
             if n.startswith(CLAIM_PREFIX) and n != claim_label()]
    return f"claimed by {', '.join(hosts)}" if hosts else None


def gh_pages(path: str) -> list[dict]:
    """Every element of a paginated GitHub list endpoint."""
    r = run(["gh", "api", "--paginate", path, "--jq", ".[]"], timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh api {path}: {r.stderr.strip()[:200]}")
    return [json.loads(line) for line in r.stdout.splitlines() if line.strip()]


def gh_comment(n: int, body: str, cid: int | None = None) -> int:
    """Post a comment on #n (or edit comment `cid`); returns its id."""
    path = f"repos/{REPO}/issues/comments/{cid}" if cid else f"repos/{REPO}/issues/{n}/comments"
    r = run(["gh", "api", *(["-X", "PATCH"] if cid else []), path, "-f", f"body={body}"])
    if r.returncode:
        raise RuntimeError(f"gh api {path}: {r.stderr.strip()[:200]}")
    return int(json.loads(r.stdout)["id"])


def gh_uncomment(cid: int) -> None:
    run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/issues/comments/{cid}"])  # already gone: fine


def claim_body(state: dict) -> str:
    return (CLAIM_MARK.format(HOST_ID) + f"\nClaimed by promoter-bot host `{HOST_ID}`, lease renewed {iso(now())}. "
            f"It lapses after {claims_cfg(state)['ttl_h']} h without a renewal. To take it back, assign someone or "
            f"remove the `{claim_label()}` label.")


def claim_comments(n: int, host: str) -> list[dict]:
    mark = CLAIM_MARK.format(host)
    return [c for c in gh_pages(f"repos/{REPO}/issues/{n}/comments") if mark in str(c.get("body", ""))]


def claim_winner(n: int, labels: list[str]) -> str | None:
    """The host whose claim label (of those still on #n) was added first; ties go to the smaller name."""
    added: dict[str, str] = {}
    for e in gh_pages(f"repos/{REPO}/issues/{n}/events"):
        name = str((e.get("label") or {}).get("name", ""))
        if e.get("event") == "labeled" and name in labels:
            added[name] = str(e.get("created_at", ""))  # events run oldest first: keep the latest add
    if not added:
        return None
    return min(added, key=lambda k: (added[k], k))[len(CLAIM_PREFIX):]


def claim_age_h(n: int, host: str) -> float | None:
    """Hours since `host` last renewed its claim on #n (its lease comment), or since the label went on if it has none
    (a person tagged it by hand); None if neither is readable."""
    stamps = [parse_iso(c.get("updated_at")) for c in claim_comments(n, host)]
    if not any(stamps):
        stamps = [parse_iso(e.get("created_at")) for e in gh_pages(f"repos/{REPO}/issues/{n}/events")
                  if e.get("event") == "labeled" and (e.get("label") or {}).get("name") == claim_label(host)]
    stamps = [t for t in stamps if t]
    return (now() - max(stamps)).total_seconds() / 3600 if stamps else None


def host_role(name: str) -> bool:
    """Whether this host does a job that only one host should do (HOST_ROLES); every role when host.roles is unset."""
    return HOST.get("roles") is None or name in HOST["roles"]


def host_skips(i: dict) -> str | None:
    """Why issue `i` (a gh issue dict with labels + milestone) is not this host's work; None if it is.
    A `lane:<host_id>` label routes an issue to that host whatever its milestone. Otherwise an issue must be in one of
    host.milestones or carry one of host.labels (both empty: anything), must not be in host.exclude_milestones, and
    every `needs:<x>` label it carries must be in host.capabilities (unset: this host can do anything).
    host.prefer_milestones only orders refill (host_prefers), it skips nothing."""
    names = {str(lab.get("name", "")) for lab in i.get("labels") or []}
    ms = str((i.get("milestone") or {}).get("title", ""))
    lanes = {n[5:] for n in names if n.startswith("lane:")}
    if lanes and HOST_ID not in lanes:
        return "routed to " + ", ".join(sorted(lanes))
    caps = HOST.get("capabilities")
    if caps is not None and (missing := sorted(n[6:] for n in names if n.startswith("needs:") and n[6:] not in caps)):
        return "needs " + ", ".join(missing)
    if lanes:
        return None
    if ms and ms in (HOST.get("exclude_milestones") or []):
        return f"milestone {ms} is another host's"
    want_ms, want_labels = HOST.get("milestones") or [], HOST.get("labels") or []
    if (want_ms or want_labels) and ms not in want_ms and not names & set(want_labels):
        return "outside this host's lanes"
    return None


def claim(state: dict, n: int, dry_run: bool = False) -> tuple[bool, str, dict | None]:
    """Take issue #n for this host: (True, note, new lease or None) when it is ours, (False, why, None) when it is closed
    or a person or another host has it. Reads GitHub, so call it OUTSIDE the state lock; store the lease after."""
    if not claims_cfg(state)["enabled"] or claim_exempt(state, n) or str(n) in (state.get("claims") or {}).get("held", {}):
        return True, "", None
    i = gh_json(f"repos/{REPO}/issues/{n}")
    if i.get("state") == "closed":
        return False, "closed", None
    if who := foreign_claim(i):
        return False, who, None
    if dry_run:
        return True, "would claim", None
    gh_label(n, add=claim_label())
    labels = [str(lab.get("name", "")) for lab in gh_json(f"repos/{REPO}/issues/{n}").get("labels") or []]
    rivals = [x for x in labels if x.startswith(CLAIM_PREFIX)]
    if len(rivals) > 1 and (win := claim_winner(n, rivals)) and win != HOST_ID:
        gh_label(n, remove=claim_label())
        return False, f"lost the claim race to {win}", None
    mine = claim_comments(n, HOST_ID)
    return True, "claimed", {"comment": gh_comment(n, claim_body(state), mine[0]["id"] if mine else None), "t": iso(now())}


def release(n: int, lease: dict | None = None) -> None:
    """Give issue #n back on GitHub: label and lease comment off (the caller drops state["claims"]["held"][n])."""
    gh_label(n, remove=claim_label())
    for cid in {(lease or {}).get("comment")} | {c["id"] for c in claim_comments(n, HOST_ID)}:
        if cid:
            gh_uncomment(int(cid))


def wanted_claims(state: dict) -> set[int]:
    """Issues this host is working: queued, running, waiting for review, with a watched PR or a followup."""
    out = {x.get("issue") for k in ("queue", "running", "reports_pending", "followups") for x in state.get(k, [])
           if isinstance(x, dict)}
    out |= {p.get("issue") for p in state.get("prs", []) if isinstance(p, dict)}
    return {int(n) for n in out if n and not claim_exempt(state, n)}


def claimed_here() -> set[int]:
    """Open issues that carry this host's claim label on GitHub."""
    r = run(["gh", "issue", "list", "--repo", REPO, "--state", "open", "--label", claim_label(), "--limit", "500",
             "--json", "number"], timeout=120)
    if r.returncode:
        raise RuntimeError(f"gh issue list: {r.stderr.strip()[:160]}")
    return {int(i["number"]) for i in json.loads(r.stdout)}


def sync_claims(dry_run: bool = False) -> list[str]:
    """Level-triggered, once per tick: claim what this host works on (per_tick at most), renew leases older than
    refresh_h, release what it dropped. A queued item someone else holds leaves the queue; a running one only gets a
    CLAIM line for the owner. GitHub is read and written outside the state lock; the results are merged in after.
    An issue that could not be claimed (closed, someone else's) is asked about again only after refresh_h."""
    st = load_state()
    cfg = claims_cfg(st)
    if not cfg["enabled"]:
        return []
    cl = st.get("claims") or {}
    held, skip = dict(cl.get("held") or {}), dict(cl.get("skip") or {})
    fresh = lambda t: (ts := parse_iso(t)) and now() - ts < dt.timedelta(hours=float(cfg["refresh_h"]))
    want, have = wanted_claims(st), claimed_here()
    gone = [k for k in held if int(k) not in have]  # a person took the label off: claim it again if still ours
    for k in gone:
        held.pop(k)
    running = {r.get("issue") for r in st.get("running", [])}
    notes, got, lost, renewed = [], {}, {}, {}
    todo = [n for n in sorted(want - set(map(int, held))) if not fresh(skip.get(str(n)))][:int(cfg["per_tick"])]
    for n in todo:
        ok, why, lease = claim({**st, "claims": {**cl, "held": held}}, n, dry_run)
        if ok:
            if lease:
                got[str(n)] = lease
            if why:
                notes.append(f"#{n} {why}")
        else:
            lost[n] = why
            if why != "closed" and n in running:
                notes.append(f"CLAIM #{n}: {why}, but a worker of ours is on it -- owner: settle who keeps it")
    for k, lease in held.items():
        if int(k) in want and not fresh(lease.get("t")) and not dry_run:
            renewed[k] = {"comment": gh_comment(int(k), claim_body(st), lease.get("comment")), "t": iso(now())}
    released = sorted(have - want)
    for n in released:
        if not dry_run:
            release(n, held.get(str(n)))
        notes.append(f"released #{n}")
    if dry_run:
        return notes
    with edit_state() as cur:
        c = cur.setdefault("claims", {})
        h = c.setdefault("held", {})
        for k in gone + [str(n) for n in released]:
            h.pop(k, None)
        h.update(got)
        h.update(renewed)
        c["skip"] = {k: t for k, t in (c.get("skip") or {}).items() if fresh(t)} | {str(n): iso(now()) for n in lost}
        for n, why in lost.items():
            before = len(cur.get("queue", []))
            cur["queue"] = [x for x in cur.get("queue", []) if x.get("issue") != n]
            if len(cur["queue"]) < before:
                notes.append(f"dropped #{n} from the queue: {why}")
            if n in set(focus_issues(cur)):
                notify(f"focus-claimed-{n}", "focus issue held elsewhere",
                       f"#{n} is in this host's focus but {why}: this host cannot work it. Release the claim there or "
                       f"change one host's focus.", priority="high", cooldown_h=12)
    return notes


def expire_claims(state: dict, issues: list[dict]) -> list[str]:
    """Take the label off claims another host stopped renewing (ttl_h), so refill sees those issues as free. At most
    expire_checks issues per call (each costs a GitHub read). `issues` (from open_issues) is updated in place."""
    cfg, notes = claims_cfg(state), []
    claimed = [(i, n[len(CLAIM_PREFIX):]) for i in issues if not i.get("assignees")
               for n in (str(lab.get("name", "")) for lab in i.get("labels") or [])
               if n.startswith(CLAIM_PREFIX) and n != claim_label()]
    for i, host in claimed[:int(cfg["expire_checks"])]:
        age = claim_age_h(i["number"], host)
        if age is not None and age >= float(cfg["ttl_h"]):
            gh_label(i["number"], remove=claim_label(host))
            i["labels"] = [lab for lab in i.get("labels") or [] if lab.get("name") != claim_label(host)]
            notes.append(f"expired {claim_label(host)} on #{i['number']} (not renewed for {age:.0f} h)")
    for line in notes:
        log(line)
    return notes


def cmd_claims(a) -> int:
    """status (default): this host's id and leases; sync [--dry-run]; on / off; release N."""
    if a.action in ("on", "off"):
        with edit_state() as st:
            st.setdefault("claims", {})["enabled"] = a.action == "on"
        log(f"claims {a.action} (owner)")
        return 0
    if a.action == "release":
        if not a.issue:
            raise SystemExit("claims release needs an issue number")
        release(a.issue, (load_state().get("claims") or {}).get("held", {}).get(str(a.issue)))
        with edit_state() as st:
            st.setdefault("claims", {}).setdefault("held", {}).pop(str(a.issue), None)
        log(f"released #{a.issue} (owner)")
        return 0
