STALE_QUEUED_H = 3
CI_QUEUE_PAGES = 3  # #35: the median came from the newest 100 only (biased low in a long queue); read up to 300


def ci_queue(gh=None, ignore=()) -> dict:
    """GitHub Actions runs waiting for a runner: count and median wait (minutes), leaving out runs of the `ignore`
    workflow files. One API call, up to CI_QUEUE_PAGES when more than 100 runs are queued."""
    gh = gh or gh_json
    runs: list = []
    total = 0
    try:
        for page in range(1, CI_QUEUE_PAGES + 1):
            d = gh(f"repos/{REPO}/actions/runs?status=queued&per_page=100" + (f"&page={page}" if page > 1 else ""))
            got = d.get("workflow_runs", [])
            total, runs = max(total, int(d.get("total_count", 0))), runs + got
            if len(got) < 100 or len(runs) >= total:
                break
    except RuntimeError as e:
        if not runs:
            return {"error": str(e)[:120]}  # a later page failing keeps what the earlier pages saw
    total = max(total, len(runs))
    is_light = [os.path.basename(str(r.get("path", ""))) in set(ignore) for r in runs]
    counted = [r for r, lt in zip(runs, is_light) if not lt]
    light = len(runs) - len(counted)
    every = sorted((now() - t).total_seconds() / 60 for r in counted if (t := parse_iso(r.get("created_at"))))
    # 2026-10-16 audit: one run queued for hours (no runner will ever take it) kept the median >= busy_wait_min, so busy
    # mode -- and the hold on normal work -- could never end. Runs queued longer than STALE_QUEUED_H don't count.
    waits = [w for w in every if w < STALE_QUEUED_H * 60]
    stale = len(every) - len(waits)
    # Runs beyond the pages read are unseen: count them at the share of counted runs among those seen.
    unseen = total - len(runs)
    queued = len(counted) - stale + (round(unseen * len(counted) / len(runs)) if runs else unseen)
    by_wf = collections.Counter(os.path.basename(str(r.get("path", ""))) for r in counted
                                if (t := parse_iso(r.get("created_at"))) and now() - t < dt.timedelta(hours=STALE_QUEUED_H))
    return {"queued": max(0, queued), "median_wait_min": round(waits[len(waits) // 2], 1) if waits else 0.0,
            **({"stale": stale} if stale else {}), **({"ignored": light} if light else {}),
            **({"unseen": unseen} if unseen > 0 else {}), "by_workflow": dict(by_wf)}


def ci_mode(state: dict, q: dict, adm: dict | None = None) -> tuple[str, str]:
    """busy when CI admission has no room for one normal launch (`adm`, else state's ci_admission), calm otherwise.
    An unreadable queue, or no admission reading yet, keeps the previous mode."""
    prev = state.get("ci_mode", "calm")
    if "error" in q:
        return prev, f"CI queue unknown ({q['error']}); stays {prev}"
    adm = adm if adm is not None else state.get("ci_admission")
    if not adm or "admit" not in adm:
        return prev, f"no CI admission reading yet; stays {prev}"
    mode = "busy" if int(adm["admit"]) < 1 else "calm"
    extra = ", ".join(f"{q[k]} {label}" for k, label in (("ignored", "lightweight ignored"), ("unseen", "past the pages read"))
                      if q.get(k))
    return mode, (f"CI {mode}: " + (f"held ({adm['held']}), " if adm.get("held") else "")
                  + f"admission room {adm.get('room_rm')} runner-min, {adm['admit']} launch(es) at "
                  f"{adm.get('per_launch_rm')} each, target_util {adm.get('target_util')}; {q.get('queued')} runs queued"
                  + (f" ({extra})" if extra else ""))


def retire_ci_pressure(state: dict) -> list[str]:
    """#38 step 3: drop busy/calm threshold overrides from state.ci_pressure (they decide nothing now), loudly."""
    cp = state.get("ci_pressure") or {}
    gone = {k: cp.pop(k) for k in CI_PRESSURE_RETIRED if k in cp}
    return ["ci_pressure: retired busy/calm override(s) removed, admission decides now (#38): "
            + ", ".join(f"{k}={v}" for k, v in gone.items())] if gone else []


# #38 step 1 (shadow): measure CI load in runner-minutes against the pool instead of counting runs. The busy/calm counts
# were set 2026-10-14; by 10-20 jobs ran 4.9 -> 3.1 min on the same 20-job pool, so "20 queued" meant half the wait, and
# busy hours tripled while runner-hours stayed flat (#34). A learned per-workflow cost tracks such changes by itself.
# Logged next to busy/calm, deciding nothing yet; the admission controller (#38 step 2) reads these numbers.
CI_PROFILE_DEFAULT = {"every_h": 1, "sample_runs": 12, "alpha": 0.3, "pool": 20, "wait_window_h": 2,
                      "default_runner_min": 5.0}


def ci_profile_cfg(state: dict) -> dict:
    return {**CI_PROFILE_DEFAULT, **(state.get("ci_profile_cfg") or {})}


def ci_run_cost(jobs: list[dict]) -> dict | None:
    """Runner-minutes, wall minutes, job count and per-job queue waits of one completed run; None if no job ran."""
    ran = [(c, s, e) for j in jobs if j.get("conclusion") != "skipped"
           and (c := parse_iso(j.get("created_at"))) and (s := parse_iso(j.get("started_at")))
           and (e := parse_iso(j.get("completed_at")))]
    if not ran:
        return None
    return {"runner_min": sum((e - s).total_seconds() for _, s, e in ran) / 60,
            "wall_min": (max(e for *_, e in ran) - min(c for c, *_ in ran)).total_seconds() / 60,
            "jobs": len(ran), "waits": [max(0.0, (s - c).total_seconds() / 60) for c, s, _ in ran]}


def ci_profile_sample(state: dict, gh=None, ignore=(), want=()) -> list[str]:
    """Every every_h: read the jobs of up to sample_runs completed runs (about 1 + 1.5 x sample_runs API calls) and
    fold each workflow file's runner-minutes, wall minutes and job count into an EWMA; keep pull_request job queue
    waits (the outcome the admission controller holds to a target). `want`: workflow files queued now -- the
    least-profiled of them get their latest completed run first. Returns log notes; mutates state."""
    cfg = ci_profile_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    last = parse_iso(prof.get("sampled_at"))
    if last and now() - last < dt.timedelta(hours=float(cfg["every_h"])):
        return []
    gh = gh or gh_json
    prof["sampled_at"] = iso(now())
    seen = set(prof.get("seen_runs", []))
    try:
        runs = gh(f"repos/{REPO}/actions/runs?status=completed&per_page=100").get("workflow_runs", [])
    except RuntimeError as e:
        return [f"ci profile: runs unreadable ({str(e)[:80]})"]
    fresh = [r for r in runs if r.get("id") not in seen and r.get("conclusion") not in ("cancelled", "skipped")
             and os.path.basename(str(r.get("path", ""))) not in set(ignore)]
    # Short runs finish most often (and shepherd runs fill the newest 100), so the newest runs are mostly docs, audits
    # and post-merge. The least-profiled workflows queued now come first, then one run per workflow, least-sampled first,
    # so the heavy PR workflows (smoke, det sweep) don't go unmeasured.
    def n_of(wf):
        return int((prof["workflows"].get(wf) or {}).get("n", 0))
    picked: list[dict] = []
    wanted = collections.Counter(w for w in want if w.endswith((".yml", ".yaml")) and w not in set(ignore))
    for wf in sorted(wanted, key=lambda w: (n_of(w), -wanted[w], w)):  # least profiled, then most queued
        if len(picked) >= int(cfg["sample_runs"]) // 2 or n_of(wf) >= 3:
            break
        try:  # 20: superseded PR runs are cancelled (cancel-in-progress), so the last few can all be cancelled
            got = gh(f"repos/{REPO}/actions/workflows/{wf}/runs?status=completed&per_page=20").get("workflow_runs", [])
        except RuntimeError:
            continue
        picked += [r for r in got if r.get("id") not in seen
                   and r.get("conclusion") not in ("cancelled", "skipped")][:1]
    first: dict[str, dict] = {}
    for r in fresh:
        first.setdefault(os.path.basename(str(r.get("path", ""))), r)
    have = {r.get("id") for r in picked}
    picked += sorted((r for r in first.values() if r.get("id") not in have),
                     key=lambda r: n_of(os.path.basename(str(r.get("path", "")))))
    picked = picked[:int(cfg["sample_runs"])]
    a, n = float(cfg["alpha"]), 0
    for r in picked:
        try:
            jobs = gh(f"repos/{REPO}/actions/runs/{r['id']}/jobs?per_page=100").get("jobs", [])
        except RuntimeError:
            continue
        seen.add(r["id"])
        if not (c := ci_run_cost(jobs)):
            continue
        n += 1
        w = prof["workflows"].setdefault(os.path.basename(str(r.get("path", ""))), {"n": 0})
        for k in ("runner_min", "wall_min", "jobs"):
            w[k] = round(c[k] if not w["n"] else (1 - a) * float(w.get(k, c[k])) + a * c[k], 2)
        w["n"], w["t"] = w["n"] + 1, iso(now())
        if r.get("event") == "pull_request":
            prof["waits"] += [[iso(t), round(x, 2)] for x in c["waits"] if (t := parse_iso(r.get("updated_at")))]
    keep = now() - dt.timedelta(hours=max(6.0, float(cfg["wait_window_h"])))
    prof["waits"] = [x for x in prof["waits"] if (t := parse_iso(x[0])) and t >= keep][-500:]
    prof["seen_runs"] = sorted(seen)[-300:]
    notes = [f"ci profile: sampled {n} of {len(picked)} runs, {len(prof['workflows'])} workflows known"] if picked else []
    # Per-push cost from pushes whose runs have all finished: the newest completed runs hold a recent push's quick
    # workflows but not its heavy ones (still running), which read 9 runner-min a push against ~65 measured (#34).
    lo, hi = now() - dt.timedelta(minutes=90), now() - dt.timedelta(minutes=60)
    try:
        window = gh(f"repos/{REPO}/actions/runs?event=pull_request&per_page=100&created="
                    f"{lo.strftime('%Y-%m-%dT%H:%M:%SZ')}..{hi.strftime('%Y-%m-%dT%H:%M:%SZ')}").get("workflow_runs", [])
    except RuntimeError:
        window = []
    if (pp := per_push_cost(window, prof, cfg)) is not None:
        prof["per_push_rm"] = round(pp if prof.get("per_push_rm") is None else (1 - a) * float(prof["per_push_rm"]) + a * pp, 1)
    if note := adjust_target_util(state):
        notes.append(note)
    return notes


def per_push_cost(runs: list[dict], prof: dict, cfg: dict) -> float | None:
    """Runner-minutes one PR push costs: for the pull_request runs in `runs` (all runs created in a closed window),
    each workflow's runs per pushed head SHA times its learned cost. Cancelled (superseded) and skipped (draft) runs
    don't count, nor runs still going. None with fewer than 3 pushes in view."""
    pr = [r for r in runs if r.get("event") == "pull_request" and r.get("status") in (None, "completed")
          and r.get("conclusion") not in ("cancelled", "skipped")]
    shas = {r.get("head_sha") for r in pr if r.get("head_sha")}
    if len(shas) < 3:
        return None
    per_wf = collections.Counter(os.path.basename(str(r.get("path", ""))) for r in pr)
    return sum(k / len(shas) * float(workflow_cost(prof, wf, cfg)["runner_min"]) for wf, k in per_wf.items())


# #38 step 2 (shadow): admission instead of a busy/calm switch. Each launch is priced at its expected CI cost and
# admitted while the pool has room under target_util; target_util follows the outcome (PR job queue wait) by AIMD, so
# nothing here is a hand-set congestion threshold. pushes_per_pr is a setting until PR history is measured (step 3).
# #38 step 3: the hourly AIMD alone let a 22:20Z-23:20Z overrun (p50 5.28 min) stand for an hour while admission still
# admitted 2-5. Every tick now reads the job waits of the newest live PR runs (live_runs API calls); their p50 over
# fast_factor x target cuts target_util at once, at most every fast_every_min.
# 2026-10-23 storm: both wait gauges read jobs that had STARTED (completed runs; the newest 2 live runs), so 01:30Z-02:34Z
# the queue grew 28 -> 121 runs, the oldest jobs waited 35 min, and the gauges read 1.3 / 5.4 min while admission
# admitted 4-8 a tick. The queued runs' own median wait (ci_queue) now feeds the fast cut too, and over
# hold_queue_wait_min it holds admission outright.
CI_ADMISSION_DEFAULT = {"target_wait_min": 5.0, "util_init": 0.8, "util_min": 0.3, "util_max": 1.0, "util_step": 0.05,
                        "util_cut": 0.8, "pushes_per_pr": 2.0, "horizon_min": 60, "min_waits": 5,
                        "live_runs": 2, "fast_factor": 1.5, "fast_window_min": 30, "fast_every_min": 20,
                        "hold_queue_wait_min": 10.0, "climb_every_min": 20, "occupancy_runs": 25}


def ci_admission_cfg(state: dict) -> dict:
    return {**CI_ADMISSION_DEFAULT, **(state.get("ci_admission_cfg") or {})}


def recent_job_waits(state: dict) -> list[float]:
    cfg = ci_profile_cfg(state)
    cut = now() - dt.timedelta(hours=float(cfg["wait_window_h"]))
    return sorted(x[1] for x in (state.get("ci_profile") or {}).get("waits", []) if (t := parse_iso(x[0])) and t >= cut)


def adjust_target_util(state: dict) -> str | None:
    """AIMD on the pool share admission may fill, once per profile sample: PR job wait p50 over target_wait_min cuts it
    (x util_cut), under 60% of the target raises it (+ util_step); in between, or with too few waits, it holds."""
    cfg = ci_admission_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    u = float(prof.get("target_util", cfg["util_init"]))
    waits = recent_job_waits(state)
    if len(waits) < int(cfg["min_waits"]):
        prof["target_util"] = u
        return None
    p50, target = waits[len(waits) // 2], float(cfg["target_wait_min"])
    occ = state.get("ci_occupancy") or {}
    if (age := occ.get("queued_job_age_p50")) is not None and (t := parse_iso(occ.get("t"))) \
            and now() - t < dt.timedelta(minutes=30):
        p50 = max(p50, float(age))  # started jobs only show the waits that ended; the ones still queued are longer
    if p50 > target:
        new = max(float(cfg["util_min"]), u * float(cfg["util_cut"]))
    elif p50 < 0.6 * target:
        new = min(float(cfg["util_max"]), u + float(cfg["util_step"]))
    else:
        new = u
    prof["target_util"] = round(new, 3)
    return f"ci admission: PR job wait p50 {p50} min vs target {target}: target_util {u:.2f} -> {new:.2f}" \
        if round(new, 3) != round(u, 3) else None


def ci_occupancy(state: dict, in_progress: list[dict] | None, gh=None) -> dict:
    """Runner occupancy from the jobs of every run in progress (newest occupancy_runs, one API call each), counting the
    ignored light workflows too: they hold runners. 2026-10-24: the snapshot's `in_progress` counts RUNS (~10), which
    read as half the 20-runner pool idle; a job-level sample found 18-22 jobs running and 41-68 queued, queued jobs
    waiting a median 1.5-8 min and up to 37 min, while the started-job wait churn tuned on said ~3.6 min. Returns
    jobs_running, jobs_queued, queued_job_age_p50 / _max (minutes so far), runs_read, and `jobs` {run id: jobs} for
    live_pr_job_waits to reuse."""
    n = int(ci_admission_cfg(state)["occupancy_runs"])
    runs = sorted((r for r in in_progress or [] if r.get("id")), key=lambda r: str(r.get("created_at") or ""),
                  reverse=True)
    jobs_by_run, running, ages = {}, 0, []
    for r in runs[:n]:
        try:
            jobs = (gh or gh_json)(f"repos/{REPO}/actions/runs/{r['id']}/jobs?per_page=100&filter=latest").get("jobs", [])
        except RuntimeError:
            continue
        jobs_by_run[r["id"]] = jobs
        for j in jobs:
            if j.get("status") == "in_progress":
                running += 1
            elif j.get("status") in ("queued", "waiting", "pending") and (c := parse_iso(j.get("created_at"))):
                ages.append(round(max(0.0, (now() - c).total_seconds() / 60), 1))
    ages.sort()
    return {"jobs_running": running, "jobs_queued": len(ages), "runs_read": len(jobs_by_run),
            **({"runs_unread": len(runs) - n} if len(runs) > n else {}),
            "queued_job_age_p50": ages[len(ages) // 2] if ages else None, "queued_job_age_max": ages[-1] if ages else None,
            "jobs": jobs_by_run}


def live_pr_job_waits(state: dict, in_progress: list[dict] | None, gh=None, jobs: dict | None = None) -> list[list]:
    """[job id, wait min] for the jobs of the newest live_runs pull_request runs in progress: a started job's queue
    wait, or a queued job's wait so far (a lower bound). One API call per run read, none for a run in `jobs`
    (ci_occupancy already read it)."""
    n = int(ci_admission_cfg(state)["live_runs"])
    runs = sorted((r for r in in_progress or [] if r.get("event") == "pull_request" and r.get("id")),
                  key=lambda r: str(r.get("created_at") or ""), reverse=True)[:n]
    out = []
    for r in runs:
        try:
            got = (jobs or {}).get(r["id"])
            jobs_r = got if got is not None else (gh or gh_json)(
                f"repos/{REPO}/actions/runs/{r['id']}/jobs?per_page=100").get("jobs", [])
        except RuntimeError:
            continue
        for j in jobs_r:
            if j.get("conclusion") == "skipped" or not (c := parse_iso(j.get("created_at"))):
                continue
            s = None if j.get("status") == "queued" else parse_iso(j.get("started_at"))
            out.append([j.get("id"), round(max(0.0, ((s or now()) - c).total_seconds() / 60), 2)])
    return out


def fast_cut(state: dict, live: list[list], queued_wait: float | None = None,
             queued_job_age: float | None = None) -> str | None:
    """Fold this tick's live job waits into ci_profile.live_waits (by job id, fast_window_min kept) and cut target_util
    (x util_cut) when their p50, or `queued_wait` (the queued runs' median wait, which no started job shows), is over
    fast_factor x target_wait_min; at most every fast_every_min."""
    cfg = ci_admission_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    keep = now() - dt.timedelta(minutes=float(cfg["fast_window_min"]))
    seen = {str(x[0]): x for x in prof.get("live_waits", []) if (t := parse_iso(x[1])) and t >= keep}
    for jid, w in live:
        seen[str(jid)] = [jid, iso(now()), w]
    prof["live_waits"] = list(seen.values())[-300:]
    waits = sorted(x[2] for x in prof["live_waits"])
    limit = float(cfg["fast_factor"]) * float(cfg["target_wait_min"])
    over = [(v, what) for v, what in ((waits[len(waits) // 2] if len(waits) >= int(cfg["min_waits"]) else None,
                                       "live PR job wait p50"), (queued_wait, "queued runs' median wait"),
                                      (queued_job_age, "queued jobs' median wait so far"))
            if v is not None and float(v) > limit]
    last = parse_iso(prof.get("fast_cut_at"))
    if not over or (last and now() - last < dt.timedelta(minutes=float(cfg["fast_every_min"]))):
        return None
    v, what = max(over)
    u = float(prof.get("target_util", cfg["util_init"]))
    new = max(float(cfg["util_min"]), u * float(cfg["util_cut"]))
    prof["target_util"], prof["fast_cut_at"] = round(new, 3), iso(now())
    return f"ci admission: {what} {v} min over {limit:g}: target_util {u:.2f} -> {new:.2f} (fast cut)"


def fast_climb(state: dict, queued_wait: float | None, queued_job_age: float | None = None) -> str | None:
    """The fast cut's other half (2026-10-23): cuts came every tick but the climb only hourly, on completed-run waits,
    so the 2026-10-23 storm left target_util at the 0.3 floor for half a day while live waits were 2 min. Raise it by
    util_step at most every climb_every_min while the live PR job wait p50 (as folded by fast_cut) and the queued runs'
    median wait are both under 60% of target_wait_min; never within climb_every_min of a cut."""
    cfg = ci_admission_cfg(state)
    prof = state.setdefault("ci_profile", {"workflows": {}, "waits": []})
    u = float(prof.get("target_util", cfg["util_init"]))
    waits = sorted(x[2] for x in prof.get("live_waits", []))
    calm = 0.6 * float(cfg["target_wait_min"])
    if (u >= float(cfg["util_max"]) or queued_wait is None or float(queued_wait) >= calm
            or (queued_job_age is not None and float(queued_job_age) >= calm)
            or len(waits) < int(cfg["min_waits"]) or waits[len(waits) // 2] >= calm):
        return None
    every = dt.timedelta(minutes=float(cfg["climb_every_min"]))
    if any((t := parse_iso(prof.get(k))) and now() - t < every for k in ("fast_cut_at", "fast_climb_at")):
        return None
    new = min(float(cfg["util_max"]), u + float(cfg["util_step"]))
    prof["target_util"], prof["fast_climb_at"] = round(new, 3), iso(now())
    return (f"ci admission: live PR job wait p50 {waits[len(waits) // 2]} min, queued {queued_wait} min, both under "
            f"{calm:g}: target_util {u:.2f} -> {new:.2f} (fast climb)")


def ci_admission(state: dict, backlog: dict, q: dict | None = None) -> dict:
    """What admission would allow now: room = target_util x pool x horizon minus the work in hand (backlog) minus what
    live Claude workers will push (one PR's cost each), in runner-minutes; admit = launches that fit at one PR each.
    Held (admit 0) while the queued runs' median wait (`q`, from ci_queue) is over hold_queue_wait_min, whatever the
    room. Crucible-repo work runs on its own repo's CI and is not priced here."""
    cfg, pcfg = ci_admission_cfg(state), ci_profile_cfg(state)
    prof = state.get("ci_profile") or {}
    u = float(prof.get("target_util", cfg["util_init"]))
    per_push = float(prof.get("per_push_rm") or 2 * float(pcfg["default_runner_min"]))
    per_launch = per_push * float(cfg["pushes_per_pr"])
    live = [r for r in claude_slot_holders(state) if not r.get("repo")]
    committed = len(live) * per_launch
    in_hand = float(backlog.get("queued_rm") or 0) + float(backlog.get("active_rm") or 0)
    room = u * int(backlog.get("pool") or pcfg["pool"]) * float(cfg["horizon_min"]) - in_hand - committed
    out = {"target_util": round(u, 3), "per_launch_rm": round(per_launch), "committed_rm": round(committed),
           "room_rm": round(room), "admit": max(0, int(room // per_launch)) if per_launch > 0 else 0}
    qw, hold = (q or {}).get("median_wait_min"), float(cfg["hold_queue_wait_min"])
    if qw is not None and "error" not in (q or {}) and float(qw) > hold:
        out.update(admit=0, held=f"queued runs' median wait {qw} min over {hold:g}")
    return out


def workflow_cost(prof: dict, wf: str, cfg: dict) -> dict:
    """The learned cost of workflow file `wf`, else the median of known workflows, else default_runner_min."""
    known = prof.get("workflows") or {}
    if wf in known:
        return known[wf]
    rms = sorted(float(w.get("runner_min", 0)) for w in known.values()) or [float(cfg["default_runner_min"])]
    return {"runner_min": rms[len(rms) // 2], "wall_min": None, "jobs": None}


def ci_backlog(state: dict, q: dict, in_progress: list[dict] | None) -> dict:
    """Minutes the pool needs to drain the work in hand: queued runs at their learned runner-minutes plus what is left
    of runs in progress (shards queue AFTER a run's plan job starts, so queued runs alone miss most of the backlog),
    over `pool` runners. Plus the outcome: median pull_request job queue wait over wait_window_h."""
    cfg = ci_profile_cfg(state)
    prof = state.get("ci_profile") or {}
    pool = max(1, int(cfg["pool"]))
    by_wf = q.get("by_workflow") or {}
    queued_rm = sum(n * float(workflow_cost(prof, wf, cfg)["runner_min"]) for wf, n in by_wf.items())
    if q.get("unseen") and by_wf:
        queued_rm *= (sum(by_wf.values()) + q["unseen"]) / sum(by_wf.values())
    active_rm = 0.0
    for r in in_progress or []:
        c = workflow_cost(prof, os.path.basename(str(r.get("path", ""))), cfg)
        if (t := parse_iso(r.get("run_started_at") or r.get("created_at"))) and c.get("wall_min"):
            done = min(1.0, (now() - t).total_seconds() / 60 / max(1.0, float(c["wall_min"])))
            active_rm += float(c["runner_min"]) * (1 - done)
        else:
            active_rm += float(c["runner_min"]) / 2  # no wall time learned yet: assume half done
    waits = recent_job_waits(state)
    return {"backlog_min": round((queued_rm + active_rm) / pool, 1), "queued_rm": round(queued_rm),
            "active_rm": round(active_rm), "in_progress": None if in_progress is None else len(in_progress),
            "pool": pool, "job_wait_p50": waits[len(waits) // 2] if waits else None, "job_wait_n": len(waits)}


def ci_in_progress(gh=None, ignore=()) -> list[dict] | None:
    """Runs in progress (one API call, newest 100), minus the `ignore` workflows; None when unreadable."""
    try:
        runs = (gh or gh_json)(f"repos/{REPO}/actions/runs?status=in_progress&per_page=100").get("workflow_runs", [])
    except RuntimeError:
        return None
    return [r for r in runs if os.path.basename(str(r.get("path", ""))) not in set(ignore)]


def _json_or_empty(line: str) -> dict:
    try:
        r = json.loads(line)
    except ValueError:
        return {}
    return r if isinstance(r, dict) else {}


CI_SNAPSHOTS_KEEP_D = 30
CI_SNAPSHOTS_MAX_BYTES = 4_000_000  # ~300 B a tick, 144 ticks a day: trimming runs about once a month


def log_ci_snapshot(state: dict, q: dict, path: Path | None = None) -> None:
    """#36: append this tick's CI reading and the decision it fed. Only mode switches were logged before, so busy time
    and the queued/wait distribution had to be rebuilt from switch lines (the #34 analysis)."""
    path = path or CI_SNAPSHOTS
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    row = {"t": iso(now()), "host": HOST_ID, **{k: v for k, v in q.items() if k not in ("t", "by_workflow")},
           **{k: v for k, v in (state.get("ci_backlog") or {}).items() if k != "t"},
           **{k: v for k, v in (state.get("ci_admission") or {}).items() if k != "t"},
           **{k: v for k, v in (state.get("ci_occupancy") or {}).items() if k != "t"},
           "mode": state.get("ci_mode", "calm"), "mode_since": state.get("ci_mode_since"),
           "running": len(live), "running_backfill": sum(r.get("lane") == "backfill" for r in live),
           "queue_len": len(state.get("queue", []))}
    try:
        with open(path, "a") as fh:
            fh.write(json.dumps(row, sort_keys=True) + "\n")
        if path.stat().st_size > CI_SNAPSHOTS_MAX_BYTES:
            cut = now() - dt.timedelta(days=CI_SNAPSHOTS_KEEP_D)
            path.write_text("".join(ln + "\n" for ln in path.read_text().splitlines()
                                    if (t := parse_iso(_json_or_empty(ln).get("t"))) and t >= cut))
    except OSError as e:
        log(f"ci snapshot not written: {e}", quiet=True)


def ci_snapshot_summary(hours: float = 24, path: Path | None = None) -> str:
    """Busy share and the queued / median-wait spread over the last `hours` of snapshots, for `churn status`."""
    path = path or CI_SNAPSHOTS
    if not path.exists():
        return "no CI snapshots yet"
    cut = now() - dt.timedelta(hours=hours)
    rows = [r for ln in path.read_text().splitlines()
            if (t := parse_iso((r := _json_or_empty(ln)).get("t"))) and t >= cut and "error" not in r]
    if not rows:
        return f"no CI snapshots in the last {hours:g} h"
    def mid(k):
        vs = sorted(r.get(k, 0) for r in rows)
        return vs[len(vs) // 2]
    busy = sum(r.get("mode") == "busy" for r in rows)
    idle_busy = sum(r.get("mode") == "busy" and not r.get("running") for r in rows)
    out = (f"CI last {hours:g} h: busy {100 * busy // len(rows)}% of {len(rows)} ticks ({idle_busy} with 0 running); "
           f"median queued {mid('queued')}, median wait {mid('median_wait_min')} min")
    # #38 step 3: admission decides; a hold is earned when PR jobs really waited over the target at the time
    if held := [r for r in rows if "admit" in r and r["admit"] < 1]:
        tw = float(CI_ADMISSION_DEFAULT["target_wait_min"])
        over = sum((r.get("job_wait_p50") or 0) > tw for r in held)
        out += f"; admission held {len(held)} ticks, {over} of them with PR job wait p50 over {tw:g} min"
    return out


HELD_PLAN_MAX_H = 48
OVERLAP_IGNORE = re.compile(r"(^docs/|\.md$|baseline|ledger|_report\b|CHANGELOG)")  # shared ledgers: the tick calls these harmless
_INFLIGHT: dict[str, set[str]] | None = None  # inflight_files() once per tick (git + one gh call per watched PR)


def held_plan(state: dict, x: dict) -> tuple[str, dict] | tuple[None, None]:
    """The newest held plan for a normal gitgalaxy item's issue (2026-10-16: 42 plan-held runs since 10-13, $22.50;
    10 issues planned 2-3 times because a requeued item planned again from scratch)."""
    if x.get("pr") or x.get("repo") or x.get("lane") in ("backfill", "ci") or x.get("backend") == "agy":
        return None, None
    cut = now() - dt.timedelta(hours=HELD_PLAN_MAX_H)
    task = str(x.get("task") or "")  # same issue is not enough: a later slice must not re-run an old slice's plan
    hits = [(rid, h) for rid, h in (state.get("held_plans") or {}).items()
            if h.get("issue") == x.get("issue") and (t := parse_iso(h.get("t"))) and t > cut
            and (rid in task or (h.get("task") and h["task"] == task))]
    return max(hits, key=lambda rh: rh[1]["t"], default=(None, None))


def plan_overlap(state: dict, x: dict) -> list[str]:
    """`who: file` overlaps that still hold item x's saved plan; checked by the gate, no plan run spent."""
    rid, h = held_plan(state, x)
    if not rid:
        return []
    global _INFLIGHT
    if _INFLIGHT is None:
        _INFLIGHT = inflight_files(rid)
    files = {f for f in h.get("files", []) if not OVERLAP_IGNORE.search(f)}
    return [f"{who}: {f}" for who, fs in _INFLIGHT.items() if who != f"worker {rid}" for f in sorted(files & fs)]


def backfill_rank(x: dict) -> int:
    """Backfill order (owner 2026-10-14): crucible-repo steps first (no CI cost, small Sonnet steps), then other
    backfill, L5 mutation last (long Opus runs with a real start-up cost)."""
    if x.get("repo") in CRUCIBLE_REPOS:
        return 0
    return 2 if "mutation" in str(x.get("task", "")).lower() else 1


def issue_meta(n: int) -> dict | None:
    """Issue #n's title + labels (one gh call), or None if unreadable."""
    r = run(["gh", "issue", "view", str(n), "--repo", REPO, "--json", "title,labels"])
    if r.returncode:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def issue_scope(n: int, meta: dict | None = None) -> str | None:
    """Scope from issue #n's `scope:<name>` label; None if unlabelled or unreadable."""
    d = meta if meta is not None else issue_meta(n)
    names = [str(lab.get("name", "")) for lab in (d or {}).get("labels") or []]
    return next((x[6:] for x in names if x.startswith("scope:") and x[6:] in SCOPES), None)


# Owner 2026-10-18: 20 of 70 merged PRs were core (33 infra). With 2 workers, ci-lane, infra and backfill items could
# hold both slots while a core item waited (in busy mode normal items never launched at all). `core_reserve` (default
# 1) Claude workers stay on scope:core whenever a core item can launch; PR fixes still go first (finishing beats starting).
CORE_RESERVE = 1


# ---------------------------------------------------------------- focus (owner 2026-10-25)
# "We keep on not being able to focus: the system just switches." Goal stages, tiers, scope ranks, the core slot and
# host lanes all only RANKED work; every way of adding work (rule refill, call-graph filler, follow-up next slices,
# the tick's own queue adds and goal edits) kept feeding other issues, and a focus item that vanished (dropped for a
# claim) went unnoticed while the slots filled with whatever was left. The focus is one owner-set allowlist per host,
# enforced where work is picked and where every worker launches (cmd_worker), so no path around it exists:
# - launchable: the focus issues (their PR fixes too), red main, and the owner-budgeted retro/experiment lanes;
# - only the owner changes it: `churn focus ...` refuses inside any run churn started (CHURN_RUN).
# Same day, owner: "that sounds like the factory will scream to a halt ... it's okay if we have some work that gets in
# from not the current goal to keep the rate of production up, but we don't want those to launch more follow-up work
# that reshuffles the queue; when the system legitimately runs out of goal work, a model should check for a trivial
# blocker and whether it's okay to switch to general work." So, FILLER:
# - a free slot with no launchable focus work for STARVE_PASSES gate passes is a "focus starved" need for the tick:
#   it first looks for a trivial blocker of focus work and fixes it; only if the focus is really out of work does it
#   open a filler window (`churn focus filler --hours H --reason R`, allowed to the tick only while starving);
# - inside the window, off-focus queue items launch, but only when no focus item can (focus always picks first, so
#   filler never reorders the focus), at most FILLER_MAX launches, Sonnet, capped at FILLER_BUDGET_USD;
# - filler is terminal: its merged PR queues no next slice or checklist line (those stay focus-only), the worker is
#   told so, and the tick may add filler items only with `--filler` while the window is open (FILLER_QUEUE_MAX);
# - starvation still unresolved after STARVE_PAGE passes pages the owner; every 6 h the launch mix is checked: any
#   off-focus launch that was not filler pages "drift" (a leak), and filler over FILLER_SHARE_PAGE of launches pages
#   "the focus keeps starving".
FOCUS_EXEMPT_LANES = ("retro", "experiment")
DRIFT_EVERY_H = 6
STARVE_PASSES = 2
STARVE_PAGE = 6
FILLER_MAX = 4
FILLER_QUEUE_MAX = 4
FILLER_HOURS_MAX = 12
FILLER_BUDGET_USD = 8.0
FILLER_SHARE_PAGE = 0.5
# Owner 2026-10-29, after the ladder starved on ZECS002/ZECSNC waiting for an assembler coverage slice: "if I approved
# work for a goal and one of those issues requires already logged issues it is okay to begin working on that issue as
# part of the goal." So a PREREQUISITE (`churn focus prereq FOCUS NEED --reason R`, the tick may do it) makes an open,
# already-logged issue that a focus issue needs count as focus work. One level only (a prerequisite's own needs are not
# linked), at most PREREQ_MAX at once, the owner is paged for each and can drop it (`churn focus prereq rm NEED`), and a
# link ends when its issue closes (checked with the drift check) or its focus issue leaves the focus.
PREREQ_MAX = 3
FILLER_NOTE = ("\n\nFILLER WORK (the host's focus is out of launchable work, so this slice keeps production going): "
               "do this one PR-sized slice only. Do not plan follow-ups: list what is left under **Remaining slices** / "
               "**Sibling gaps** and stop; churn will not queue a next slice for filler work.\n")


def focus_cfg(state: dict) -> dict:
    return state.get("focus") or {}


def focus_on(state: dict) -> bool:
    return bool(focus_cfg(state).get("issues"))


def focus_issues(state: dict) -> list[int]:
    return [int(n) for n in focus_cfg(state).get("issues") or []]


def focus_prereqs(state: dict) -> list[dict]:
    """Live prerequisite links: [{issue, for, reason, by, t}], only those whose focus issue is still in the focus."""
    own = set(focus_issues(state))
    return [p for p in focus_cfg(state).get("prereqs") or [] if int(p.get("for", 0)) in own]


def issue_open(n: int) -> bool | None:
    """Is issue #n open? None if unreadable (or not an issue)."""
    r = run(["gh", "issue", "view", str(n), "--repo", REPO, "--json", "state"])
    if r.returncode:
        return None
    try:
        return json.loads(r.stdout).get("state") == "OPEN"
    except ValueError:
        return None


def prune_prereqs(state: dict) -> list[str]:
    """Drop prerequisite links whose issue closed or whose focus issue left the focus (one gh read per link)."""
    out, keep, live = [], [], {id(p) for p in focus_prereqs(state)}
    for p in focus_cfg(state).get("prereqs") or []:
        if id(p) not in live:
            out.append(f"#{p['issue']} (focus #{p.get('for')} left the focus)")
        elif issue_open(int(p["issue"])) is False:
            out.append(f"#{p['issue']} (closed)")
        else:
            keep.append(p)
    if out:
        with edit_state() as st:
            st.setdefault("focus", {})["prereqs"] = [p for p in st["focus"].get("prereqs") or []
                                                     if any(p.get("issue") == k.get("issue") for k in keep)]
    return out


def in_focus(state: dict, x: dict) -> bool:
    """May item / launch x run under the focus? With no focus set only red main and the exempt lanes run: churn never
    roams free (the free-roaming refill was where the drift came from). Filler is decided separately (filler_open)."""
    if x.get("auto") == "main-red" or str(x.get("task", "")).startswith("Main is red:"):
        return True  # a red main blocks every merge, the focus's too
    if x.get("lane") in FOCUS_EXEMPT_LANES:
        return True
    if x.get("filler_pr"):
        return True  # fixing a filler PR finishes work in hand; a PR left to rot is the stale-PR problem again
    if x.get("main_red_pr"):
        return True  # 2026-10-27: #6785's fix item sat "off focus" while main stayed red
    if x.get("issue") is None:
        return False
    return int(x["issue"]) in set(focus_issues(state)) | {int(p["issue"]) for p in focus_prereqs(state)}


def filler_branch(branch: str | None) -> bool:
    """A filler run opened this branch (its PR's fixes may run after the window closed)."""
    if not branch or not (m := re.match(r"churn/(\d+)-", branch)):
        return False
    return any(mt.get("filler") and mt.get("branch") == branch for d in RUNS.glob(f"{m.group(1)}-*")
               if (mt := _run_meta(d.name)))


def main_red_branch(branch: str | None) -> bool:
    """A red-main run opened this branch, so its PR's fixes are red-main work too (the fix item's task is "Fix PR")."""
    if not branch or not (m := re.match(r"churn/(\d+)-", branch)):
        return False
    return any(str(mt.get("task", "")).startswith("Main is red:") and mt.get("branch") == branch
               for d in RUNS.glob(f"{m.group(1)}-*") if (mt := _run_meta(d.name)))


def filler_window(state: dict) -> dict:
    return focus_cfg(state).get("filler") or {}


def filler_open(state: dict) -> bool:
    """A filler window is open and has launches left."""
    w = filler_window(state)
    return bool((t := parse_iso(w.get("until"))) and t > now() and int(w.get("launched", 0)) < int(w.get("max", FILLER_MAX)))


def starving(state: dict) -> bool:
    return int(focus_cfg(state).get("idle_passes", 0)) >= STARVE_PASSES


def owner_only(what: str) -> None:
    if os.environ.get("CHURN_RUN"):
        raise SystemExit(f"{what}: owner only. This runs inside a churn tick or worker (CHURN_RUN), and the focus is the "
                         "owner's decision; say what should change in your report instead.")


def park_off_focus(state: dict, issue: int, task: str, source: str) -> str:
    """Record work that was not queued because it is off the focus (the owner sees it in `churn focus`)."""
    f = state.setdefault("focus", {})
    parked = [p for p in f.get("parked") or [] if p.get("issue") != issue][-49:]
    parked.append({"issue": int(issue), "task": str(task)[:200], "source": source, "t": iso(now())})
    f["parked"] = parked
    return f"off focus ({f.get('name') or 'focus'}): #{issue} not queued, parked"


def focus_share(state: dict, hours: float = 24) -> dict:
    """Launch mix over the last `hours` since the focus was set: {focus, filler, leak, total}. New worker runs only (not
    checks, prechecks or resumes). `leak` = off-focus and not filler: something launched around the focus."""
    f = focus_cfg(state)
    cut = max(now() - dt.timedelta(hours=hours), parse_iso(f.get("set")) or now() - dt.timedelta(hours=hours))
    out = {"focus": 0, "filler": 0, "leak": 0, "total": 0}
    for d in RUNS.glob("*-*"):
        m = _run_meta(d.name)
        t = parse_iso(m.get("started"))
        if not t or t < cut or m.get("check_of") or m.get("precheck_of") or m.get("resume_of"):
            continue
        out["total"] += 1
        # experiment runs record no lane, only an exp/ branch (2026-10-27: 13 E1 runs paged as "drift")
        lane = m.get("lane") or ("experiment" if str(m.get("branch") or "").startswith("exp/") else None)
        kind = ("focus" if in_focus(state, {"issue": m.get("issue"), "task": m.get("task"), "lane": lane})
                else "filler" if m.get("filler") else "leak")
        out[kind] += 1
    return out


def filler_live(state: dict, snap: dict | None) -> bool:
    """An open filler window that has an off-focus item it can launch. 2026-10-28 04:13-08:13 a window opened over a
    queue of owner-parked items only: nothing launched, and an open window muted starvation, so the box sat empty 4 h."""
    return filler_open(state) and focus_pick(state, snap, "calm", False)[1] is not None


def focus_need(state: dict, snap: dict | None) -> str | None:
    """The tick's "focus starved" need: find a trivial blocker first, open filler only if the focus is really out."""
    if not focus_on(state) or not starving(state) or filler_live(state, snap):
        return None
    f = focus_cfg(state)
    why = idle_causes(state, snap, state.get("ci_mode", "calm"))
    queued = sorted({f"#{x['issue']}" for x in state.get("queue", []) if in_focus(state, x)})
    lad = (f.get("ladder") or {}).get("anchor")
    return (f"focus starved: a worker slot has been free for {f.get('idle_passes')} gate passes and no work of the focus "
            f"'{f.get('name')}' ({', '.join(f'#{n}' for n in focus_issues(state))}) can launch ({why}; focus items "
            f"queued: {', '.join(queued) or 'none'}). 1) Look for a TRIVIAL blocker of focus work and fix it: a focus "
            f"item waiting on something already done (`churn queue wait` expired, a merged --after-pr), a focus issue "
            f"with no queued next step (queue it: `churn queue add --issue <focus issue> ...`)"
            + (f", a stale evidence measure the ladder #{lad} slices from (`churn goal measure`)" if lad else "")
            + ", a report waiting for review, or a focus issue that waits on another already-logged open issue (owner "
            f"2026-10-29: that is goal work; link it with `churn focus prereq <focus issue> <needed issue> --reason "
            f"\"<where the focus issue needs it>\"`, then queue it; at most {PREREQ_MAX}, never one you just filed). "
            f"2) Only if the focus is truly out of launchable work for now (blocked on "
            f"CI, an owner ruling, another host's claim, or done), open filler: `churn focus filler --hours <1-"
            f"{FILLER_HOURS_MAX}> --reason \"<one plain sentence: why the focus cannot use the slot>\"`. Filler launches "
            f"the off-focus queue items already queued; if there are none, add at most {FILLER_QUEUE_MAX} small, "
            f"self-contained ones with `churn queue add --filler --issue <n> --task ...` (burned estates, open scope:core "
            f"or scope:sweep issues, one PR each, never an epic). Say in your summary which of the two you did.")


# 2026-10-30 (owner, after an overnight of idle slots): when the focus starves, the gate itself queues the next unchecked
# checklist line of each focus issue that has nothing queued, running or waiting for review, before the tick is asked.
# At most FOCUS_REFILL_READS issue reads a pass, each issue at most once per FOCUS_REFILL_EVERY_H; the ladder anchor
# is skipped (the ladder refill slices it by estate), and so is an issue another host claims or this host skips.
FOCUS_REFILL_READS = 6
FOCUS_REFILL_EVERY_H = 2


def focus_refill(state: dict) -> list[str]:
    """Queue the next checklist line of starved focus issues (see FOCUS_REFILL_READS). Returns log lines."""
    if not focus_on(state) or state.get("workers_paused") or QUOTA_MODE != "ok":
        return []
    busy = {x.get("issue") for k in ("queue", "running", "reports_pending") for x in state.get(k, [])}
    checked = focus_cfg(state).get("refill_checked") or {}
    due = [n for n in focus_issues(state) if n not in busy and n != ladder_anchor(state)
           and not ((t := parse_iso(checked.get(str(n)))) and now() - t < dt.timedelta(hours=FOCUS_REFILL_EVERY_H))]
    out, items, seen = [], [], {}
    for n in due[:FOCUS_REFILL_READS]:
        seen[str(n)] = iso(now())
        try:
            i = gh_json(f"repos/{REPO}/issues/{n}")
        except (RuntimeError, ValueError):
            continue
        if i.get("state") != "open" or foreign_claim(i) or host_skips(i):
            continue
        if c := next_check(i, state):
            items.append(refill_item(i, check=c))
            out.append(f"focus refill: queued #{n} [c:{c['key']}] {c['text'][:80]}")
    with edit_state() as st:
        f = st.setdefault("focus", {})
        f["refill_checked"] = {**(f.get("refill_checked") or {}), **seen}
        have = {x.get("issue") for x in st.get("queue", [])}
        st.setdefault("queue", []).extend(x for x in items if x["issue"] not in have)
    return out


def focus_alerts(state: dict, snap: dict | None, launched: list[str]) -> list[str]:
    """Starvation bookkeeping, the unresolved-starvation page and the launch-mix pages. Returns log lines."""
    if not focus_on(state):
        notify("focus-none", "no focus set", "This host has no focus, so churn launches nothing but red-main fixes. "
               "Set one: `churn focus set NAME N..` (and `churn focus ladder N` for a ladder).", priority="high",
               cooldown_h=12)
        return []
    out = []
    f = focus_cfg(state)
    name = f.get("name") or "the focus"
    live = claude_slot_holders(state)
    free = len(live) < int(state.get("max_workers", 1))
    held = (t := parse_iso(state.get("paused_until"))) and t > now()  # a limit / offline pause: not starvation
    # focus work that exists but waits on CI admission, the box or the pace is not starvation: filler would wait too.
    # 2026-10-28: a free slot beside live focus workers starves too. Requiring no live focus work kept nyx at 2 of 3
    # workers for hours with focus issue #6278 unqueued: the tick was never asked to queue its next step.
    # It also covers 2026-10-27, when a live E1 experiment arm kept the ladder from ever starving.
    ready = focus_pick(state, snap, "calm", True)[1] is not None
    starved = free and not launched and not ready and not state.get("workers_paused") and not held
    with edit_state() as st:
        fs = st.setdefault("focus", {})
        fs["idle_passes"] = int(fs.get("idle_passes", 0)) + 1 if starved and not filler_live(st, snap) else 0
        idle = fs["idle_passes"]
        last = parse_iso(fs.get("drift_checked"))
        drift_due = not last or now() - last >= dt.timedelta(hours=DRIFT_EVERY_H)
        if drift_due:
            fs["drift_checked"] = iso(now())
    if idle == STARVE_PAGE:
        why = idle_causes(state, snap, state.get("ci_mode", "calm"))
        msg = (f"{name}: a worker slot has been free for {idle} gate passes, no focus work can launch ({why}), and the "
               f"tick neither cleared a blocker nor opened filler. Look at `churn focus`.")
        notify("focus-starved", "focus starved", msg, priority="high", cooldown_h=6)
        out.append(f"FOCUS starved: {msg}")
    if drift_due:
        if gone := prune_prereqs(state):
            out.append("focus prereq ended: " + ", ".join(gone))
        mix = focus_share(state)
        if mix["leak"]:
            msg = (f"{name}: {mix['leak']} of {mix['total']} launches in the last 24 h were neither focus work nor "
                   f"filler. Something launches around the focus: check `churn focus`.")
            notify("focus-drift", "focus drift", msg, priority="high", cooldown_h=DRIFT_EVERY_H)
            out.append(f"FOCUS drift: {msg}")
        if mix["total"] >= 4 and mix["filler"] / mix["total"] > FILLER_SHARE_PAGE:
            msg = (f"{name}: {mix['filler']} of {mix['total']} launches in the last 24 h were filler: the focus keeps "
                   f"running out of launchable work. Widen it or unblock it (`churn focus`).")
            notify("focus-filler-share", "focus keeps starving", msg, cooldown_h=24)
            out.append(f"FOCUS filler share: {msg}")
    return out


def focus_prereq(args: list[str], reason: str | None) -> int:
    """`focus prereq FOCUS NEED --reason R` links an open, already-logged issue a focus issue needs (tick or owner);
    `focus prereq rm NEED` drops a link. See PREREQ_MAX."""
    tick = bool(os.environ.get("CHURN_RUN"))
    with edit_state() as st:
        f = st.setdefault("focus", {})
        links = f.get("prereqs") or []
        if args[:1] == ["rm"] and len(args) == 2:
            need = _int(args[1])
            f["prereqs"] = [p for p in links if int(p["issue"]) != need]
            msg = f"focus prereq rm #{need}"
        elif len(args) == 2 and "rm" not in args:
            forn, need = _int(args[0]), _int(args[1])
            if forn not in focus_issues(st):
                raise SystemExit(f"focus prereq: #{forn} is not a focus issue; only the focus's own issues may link a "
                                 "prerequisite (one level: a prerequisite's needs are not linked)")
            if need in focus_issues(st):
                raise SystemExit(f"focus prereq: #{need} is already a focus issue")
            if not reason:
                raise SystemExit("focus prereq FOCUS NEED --reason \"where the focus issue needs it\"")
            live = [p for p in focus_prereqs(st) if int(p["issue"]) != need]
            if len(live) >= PREREQ_MAX:
                raise SystemExit(f"focus prereq: {PREREQ_MAX} prerequisites are live ("
                                 + ", ".join(f"#{p['issue']}" for p in live) + "); finish one, or ask the owner")
            if issue_open(need) is not True:
                raise SystemExit(f"focus prereq: #{need} is not an open issue; only already-logged open issues count "
                                 "(new or closed work is the owner's call)")
            f["prereqs"] = live + [{"issue": need, "for": forn, "reason": reason[:300], "by": "tick" if tick else "owner",
                                    "t": iso(now())}]
            msg = f"focus prereq: #{need} counts as focus work for #{forn}: {reason[:200]}"
        else:
            raise SystemExit("focus prereq FOCUS NEED --reason R | focus prereq rm NEED")
    log(msg)
    print(msg)
    if tick and "rm" not in args:
        notify(f"focus-prereq-{args[1]}", "focus prerequisite",
               f"{msg}. Drop it with `churn focus prereq rm {args[1]}`.", cooldown_h=1)
    return 0


def cmd_focus(a) -> int:
    """`churn focus` (status), `set NAME N..`, `add N..`, `rm N..`, `ladder ANCHOR [--skip P..]`, `off`,
    `filler --hours H --reason R [--max N]` / `filler off` (the tick may open filler only while starving),
    `prereq FOCUS NEED --reason R` / `prereq rm NEED` (the tick may link an already-logged prerequisite)."""
    args = list(a.args or [])
    if a.action == "status":
        state = load_state()
        f = focus_cfg(state)
        if not focus_on(state):
            print("no focus set: nothing launches but red-main fixes (`churn focus set NAME N..`)")
            return 0
        lad = f.get("ladder") or {}
        print(f"focus: {f.get('name')} (set {f.get('set')}): " + ", ".join(f"#{n}" for n in focus_issues(state)))
        if lad.get("anchor"):
            below = (goal_cfg(state).get("measure") or {}).get("below") or {}
            print(f"  ladder #{lad['anchor']}, skip {', '.join(lad.get('skip') or []) or 'none'}: "
                  + "; ".join(f"{e} {len(ps)}" for e, ps in below.items()))
        mix = focus_share(state)
        print(f"  last 24 h: {mix['total']} launches: {mix['focus']} focus, {mix['filler']} filler, {mix['leak']} leaked")
        w = filler_window(state)
        if filler_open(state):
            print(f"  filler OPEN until {w['until']} ({w.get('launched', 0)}/{w.get('max', FILLER_MAX)} launched, by "
                  f"{w.get('by')}): {w.get('reason')}")
        elif f.get("idle_passes"):
            print(f"  starving: {f['idle_passes']} idle gate passes" + (" (the tick is asked)" if starving(state) else ""))
        q = state.get("queue", [])
        print(f"  queued: {sum(in_focus(state, x) for x in q)} focus, {sum(not in_focus(state, x) for x in q)} off-focus "
              f"(launch only as filler)")
        for p in focus_prereqs(state):
            print(f"  prerequisite #{p['issue']} for #{p['for']} ({p.get('by')}, {p.get('t')}): {p.get('reason', '')[:100]}")
        for p in (f.get("parked") or [])[-10:]:
            print(f"  not queued (off focus, {p.get('source')}, {p.get('t')}): #{p['issue']} {p['task'][:100]}")
        return 0
    if a.action == "prereq":
        return focus_prereq(args, a.reason)
    if a.action == "filler":
        with edit_state() as st:
            f = st.setdefault("focus", {})
            if args[:1] == ["off"]:
                f.pop("filler", None)
                msg = "filler closed"
            else:
                tick = bool(os.environ.get("CHURN_RUN"))
                if tick and not starving(st):
                    raise SystemExit("focus filler: the tick may open filler only while the gate reports the focus "
                                     "starved; focus work can launch now")
                if not focus_on(st):
                    raise SystemExit("focus filler: no focus set")
                if not a.reason:
                    raise SystemExit("focus filler --hours H --reason \"why the focus cannot use the slot\"")
                hours = min(float(a.hours or 6), FILLER_HOURS_MAX)
                f["filler"] = {"until": iso(now() + dt.timedelta(hours=hours)), "reason": a.reason[:300],
                               "by": "tick" if tick else "owner", "launched": 0, "max": int(a.max or FILLER_MAX),
                               "t": iso(now())}
                f["idle_passes"] = 0
                msg = f"filler open for {hours:g} h (max {f['filler']['max']} launches, {f['filler']['by']}): {a.reason[:200]}"
        log(msg)
        print(msg)
        if "open" in msg and os.environ.get("CHURN_RUN"):
            notify("focus-filler", "filler on", f"{focus_cfg(load_state()).get('name')}: {msg}", cooldown_h=1)
        return 0
    owner_only("churn focus " + a.action)
    with edit_state() as st:
        f = st.setdefault("focus", {})
        if a.action == "set":
            if len(args) < 2:
                raise SystemExit("focus set NAME N..")
            f.update(name=args[0], issues=sorted({_int(x) for x in args[1:]}), set=iso(now()), idle_passes=0)
            msg = f"focus set: {args[0]} = " + ", ".join(f"#{n}" for n in f["issues"])
        elif a.action in ("add", "rm"):
            nums = {_int(x) for x in args}
            cur = set(f.get("issues") or [])
            f["issues"] = sorted(cur | nums if a.action == "add" else cur - nums)
            msg = f"focus {a.action}: " + ", ".join(f"#{n}" for n in sorted(nums)) + f" -> {len(f['issues'])} issues"
        elif a.action == "ladder":
            if len(args) < 1:
                raise SystemExit("focus ladder ANCHOR|off [--skip PROGRAM..]")
            if args[0] == "off":
                f.pop("ladder", None)
                msg = "focus ladder off"
            else:
                anchor = _int(args[0])
                f["ladder"] = {"anchor": anchor, "skip": sorted(set(a.skip or []))}
                f["issues"] = sorted(set(f.get("issues") or []) | {anchor})
                msg = f"focus ladder #{anchor}, skip {', '.join(f['ladder']['skip']) or 'none'}"
        elif a.action == "off":
            st["focus"] = {"parked": f.get("parked") or []}
            msg = "focus off: nothing launches but red-main fixes until a new focus is set"
        else:
            raise SystemExit(f"focus {a.action}?")
    log(f"{msg} (owner)")
    print(msg)
    return 0


# The evidence measure (2026-10-21; its goal stages became the focus on 2026-10-25): with `goal_reports` in the host
# config the gate reads the repo's evidence reports every measure_every_h, counts programs per level, lists the programs
# below L4 per estate (the focus ladder slices them) and names L0 programs no open issue mentions (the tick files issues
# for those but never queues them).
GOAL_DEFAULT = {"measure_every_h": 6}
GOAL_REPORTS = _CFG.get("goal_reports") or {}  # {"fetch": "branch", "ref": "origin/branch", "path": "dir/of/reports"}


def goal_cfg(state: dict) -> dict:
    return {**GOAL_DEFAULT, **(state.get("goal") or {})}


def stamp_scopes(state: dict, limit: int = 6) -> list[str]:
    """Give queue items without a scope their issue's scope (and tier) label, at most `limit` gh reads a tick; an
    item is read once (`scope_checked`). Before this, PR-fix and hand-queued items ranked level with sweep."""
    out, metas = [], {}
    for x in state.get("queue", []):
        if x.get("scope") or x.get("scope_checked") or not x.get("issue") or x.get("backend") == "agy":
            continue
        if x["issue"] not in metas:
            if len(metas) >= limit:
                break
            metas[x["issue"]] = issue_meta(x["issue"])
        if (meta := metas[x["issue"]]) is None:
            continue  # unreadable: try again next tick
        x["scope_checked"] = True
        if sc := issue_scope(x["issue"], meta):
            x["scope"] = sc
            out.append(f"#{x['issue']} {sc}")
    return out


def pick_item(state: dict, snap: dict | None, mode: str) -> tuple[int, dict] | tuple[None, None]:
    """The next Claude queue item for this CI mode: focus work first (focus_pick); only when none can launch and a
    filler window is open, an off-focus item as filler (the same order among the off-focus items)."""
    hit = focus_pick(state, snap, mode, True)
    if hit[1] is None and filler_open(state):
        hit = focus_pick(state, snap, mode, False)
    return hit


def focus_pick(state: dict, snap: dict | None, mode: str, focus: bool) -> tuple[int, dict] | tuple[None, None]:
    """Among the launchable focus (or, focus=False, off-focus) items: PR fixes, then red main, then the `ci` lane, then
    `normal` items by queue position when CI is calm, or `backfill` items when it is busy (at most backfill_max
    running). Calm mode offers backfill too once the slots have sat idle for backfill_idle_ticks ticks.
    2026-10-25: the focus replaced the ranking layers (scope, tier, goal stage, core slot), so queue position orders."""
    q = [(i, x) for i, x in enumerate(state.get("queue", [])) if not x.get("needs_owner") and x.get("backend") != "agy"
         and in_focus(state, x) == focus and not blocked_by(x, snap, state) and not waiting(x)
         and not plan_overlap(state, x)]
    for want in (lambda x: x.get("pr"), lambda x: x.get("auto") == "main-red", lambda x: x.get("lane") == "ci"):
        if hit := next(((i, x) for i, x in q if want(x)), None):
            return hit  # a PR fix finishes work in hand; a red main blocks every PR
    cfg = ci_cfg(state)
    live = [r for r in state.get("running", []) if r.get("lane") == "backfill" and pid_alive(r.get("pid"))]
    backfill = min(((i, x) for i, x in q if x.get("lane") == "backfill"), key=lambda ix: (backfill_rank(ix[1]), ix[0]),
                   default=(None, None))
    if mode == "busy":
        since = parse_iso(state.get("ci_mode_since"))
        if since and (now() - since).total_seconds() / 60 < float(cfg["backfill_min_busy_min"]):
            return None, None  # a short busy spell: a backfill launched now would be preempted again within minutes
        return backfill if len(live) < int(cfg["backfill_max"]) else (None, None)
    normal = next(((i, x) for i, x in q if x.get("lane") in (None, "normal")), (None, None))
    if normal[1] is not None or len(live) >= int(cfg["backfill_max"]) \
            or int(state.get("idle_streak", 0)) < int(cfg["backfill_idle_ticks"]):
        return normal
    return backfill


def idle_causes(state: dict, snap: dict | None, mode: str) -> str:
    """Why no Claude queue item could launch, for the quiet line (owner 2026-10-16: 39 idle ticks a day said only
    "nothing launchable"). Counts items per cause; blocked items also name their blockers, which `factory` totals."""
    c: collections.Counter = collections.Counter()
    blockers: collections.Counter = collections.Counter()
    for x in state.get("queue", []):
        if x.get("backend") == "agy":
            c["agy"] += 1
        elif x.get("needs_owner"):
            c["owner"] += 1
        elif not in_focus(state, x):
            c["off-focus"] += 1
        elif bl := blocked_by(x, snap, state):
            c["blocked"] += 1
            blockers.update(bl)
        elif waiting(x):
            c["wait"] += 1
        elif plan_overlap(state, x):
            c["plan-overlap"] += 1
        elif x.get("lane") == "backfill" and mode != "busy":
            c["backfill-calm"] += 1
        elif x.get("lane") in (None, "normal") and not x.get("pr") and mode == "busy":
            c["ci-admission"] += 1
        else:
            c["other"] += 1  # launchable by its own rule (a pace or plan hold, or a backfill already running)
    if not c:
        return "idle: empty"
    room = (state.get("ci_admission") or {}).get("room_rm")
    return "idle: " + ", ".join(f"{k} {v}" + (" (" + " ".join(f"#{n}x{m}" for n, m in blockers.most_common(3)) + ")"
                                               if k == "blocked" else f" (room {room} runner-min)"
                                               if k == "ci-admission" and room is not None else "")
                                for k, v in c.most_common())


def unapplied_owner_answers() -> list[dict]:
    """Owner replies in owner-answers.jsonl the tick has not applied yet. One the tick looked at and could not map stays
    `applied: false` with an `applied_note` saying why; that one waits for the owner, so it does not wake the model."""
    try:
        lines = (H / "owner-answers.jsonl").read_text().splitlines()
    except OSError:
        return []
    out = []
    for line in lines:
        try:
            e = json.loads(line)
        except ValueError:
            continue
        if isinstance(e, dict) and not e.get("applied") and not e.get("applied_note"):
            out.append(e)
    return out


def gate(state: dict, b: dict, force: list[str], needs: dict[str, str] | None = None,
         snap: dict | None = None) -> tuple[list[str], str]:
    """needs: {key: reason} from reconcile (review #n@head, followup #n), already filtered by the stall rule."""
    reasons = list(force)
    if needs:
        reasons += list(needs.values())
    # 2026-10-22: the gate never looked at owner answers, so seven 10-21 rulings sat unapplied for a day while the
    # ticks it did wake (refill, launch) stayed on their own reason. Step 0b applies them.
    if answers := unapplied_owner_answers():
        reasons.append("owner answers to apply (step 0b, owner-answers.jsonl): " + ", ".join(
            f"{e.get('id', '?')} ({str(e.get('question') or e.get('item') or '')[:60]})" for e in answers))
    pending = [e for e in state.get("reports_pending", []) if not auto_checkable(e)  # agy `done`: the lane launches a checker
               and not precheck_holds(e)]
    if pending:
        reasons.append("review: " + ", ".join(
            f"{e['run_id']} ({e['status']}" + (f"; {e['review_why']}" if e.get("review_why") else "")
            + (f"; PRECHECK FAILED again after its automatic send-back: {e['precheck_problems']}" if e.get("precheck") == "fail"
               else "") + ")" for e in pending))
    live = claude_slot_holders(state)
    agy = [r for r in state.get("running", []) if not r.get("run_id")]  # hand-tracked / legacy entries
    if not state.get("workers_paused"):
        plan = rate_plan(state)
        free = worker_slots(b, len(live), slot_ceiling(state, plan))
        if state.get("ci_mode") == "busy" and not free and b.get("verdict") == "GREEN" and b.get("free_slots", 0) >= 1:
            free = 1  # backfill takes no Claude slot; pick_item only offers backfill if no PR fix / ci item is waiting

        mode = state.get("ci_mode", "calm")
        cand = budget_picks(state, snap, mode, max(free, 1), plan)
        idx, item = cand[0] if cand else (None, None)
        if free and not item and (x := pick_item(state, snap, mode)[1]):
            m = x.get("model", "sonnet")
            log(f"launch held by pace: next #{x['issue']} ({m}"
                + (f", ~${plan['cost'][m]:.0f} in this block" if plan else "") + "): "
                + (plan["why"] if plan else f"opus {live_opus_count(state)}/{state.get('max_opus', 1)}"), quiet=True)
        if item and item.get("lane") != "backfill" and not worker_slots(b, len(live), slot_ceiling(state, plan)):
            item = None  # the extra slot above is for backfill only
        open_prs = [n for n in prs_needing_work(snap or {}, live, state) if not (item and item.get("pr") == int(n))]
        if free and item and not item.get("pr") and item.get("lane") != "backfill" and len(open_prs) >= 3:
            log(f"launch held: {len(open_prs)} churn PRs need work ({', '.join('#' + n for n in open_prs)}); "
                "finish those first", quiet=True)
            item = None
        if free and item:
            ok, why = (True, plan["why"]) if plan else pace_allows(state, item.get("model", "sonnet"))
            if ok:
                n = min(free, int(b.get("free_slots", free) or free))
                picks = [(idx, item)] + [(k, x) for k, x in cand[1:]
                                         if (x.get("lane") == "backfill") == (item.get("lane") == "backfill")][:n - 1]

                def desc(k, x):
                    what = (f"PR fix for #{x['pr']}: work on that PR's own branch (send-back or `churn worker --worktree "
                            f"--branch`), the PR exists already" if x.get("pr") else x.get("model", "sonnet"))
                    return (f"queue[{k}] #{x['issue']} ({what}, lane {x.get('lane', 'normal')}"
                            + (f", repo {x['repo']}: `churn worker --repo {x['repo']}`" if x.get("repo") else "") + ")")
                reasons.append(f"launch slot{'s' if len(picks) > 1 else ''}: box {b.get('verdict')} free_slots "
                               f"{b.get('free_slots')}, launch {len(picks)}: next " + "; ".join(desc(k, x) for k, x in picks)
                               + f" (rm the highest index first); {why}; {state.get('ci_mode', 'calm')} CI")
    if agy:
        stale = [r for r in agy if (t := parse_iso(r.get("started"))) and now() - t > dt.timedelta(hours=3)]
        last = parse_iso(state.get("last_model_tick"))
        if stale and (not last or now() - last > dt.timedelta(hours=3)):
            reasons.append("non-churn entries in running for 3h+: " + ", ".join(r.get("agent", "?") for r in stale))
    # Owner 2026-10-16: ticks run on Sonnet; Opus only to review an Opus worker's PR (the big changes). 61% of ticks
    # were Opus, mostly for launches, followups and small re-reviews.
    model = "opus" if any(e.get("review_model") == "opus" or (not e.get("review_model") and e.get("model") == "opus"
                                                             and e.get("pr")) for e in pending) else "sonnet"
    return reasons, model


def pr_in_hand(n: str, v: dict, live: list[dict]) -> bool:
    """A live worker is already on PR n: its task names it (#n), or the PR's churn/<issue>- branch is its issue."""
    tasks = " ".join(r.get("task") or "" for r in live)
    m = re.match(r"churn/(\d+)-", v.get("branch", ""))
    return bool(re.search(rf"#{n}\b", tasks) or (m and m.group(1) in {str(r.get("issue")) for r in live}))


FLAKE_HOURS = 2


def flaked(state: dict, n: str, v: dict) -> bool:
    """The tick declared PR n's red at this head a CI flake and reran it (`churn pr flake`): no fix item for it until
    the head changes or FLAKE_HOURS pass (2026-10-14: #5105's Db2 pull flake was re-queued and dropped every tick)."""
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None) or {}
    fh, at = str(p.get("flake_head") or ""), parse_iso(p.get("flake_at"))
    return bool(fh and "head" in v and (fh.startswith(v["head"]) or v["head"].startswith(fh[:12]))
                and at and now() - at < dt.timedelta(hours=FLAKE_HOURS))


# 2026-10-25: #6593 (Evidence Refresh red on main) got 21 Sonnet runs in 96 min. #6583 had fixed main at 04:59Z, but
# the issue stays open until the workflow next passes, and that run took ~1.5 h: each worker found nothing to do, ended,
# and the next gate pass queued another. A red-main issue whose last fix run finished under MAIN_RED_RETRY_H ago is now
# queued again only when the workflow has failed on main since that run started (new evidence), read at most every
# MAIN_RED_CHECK_MIN.
MAIN_RED_RETRY_H = 6
MAIN_RED_CHECK_MIN = 10


def last_main_red_run(issue: int) -> dict | None:
    """The newest finished (status done) churn run on red-main issue `issue`, or None."""
    done = [m for d in RUNS.glob(f"{issue}-*") if (m := _run_meta(d.name)) and m.get("status") == "done"]
    return max(done, key=lambda m: m.get("started", "")) if done else None


def failed_on_main_since(title: str, since: dt.datetime, runs=None) -> bool | None:
    """Did the issue's workflow ("main is red: <workflow>") fail on main, a run last updated after `since`? None =
    unreadable."""
    wf = re.sub(r"(?i)^\s*main is red:\s*", "", title).strip()
    try:
        data = (runs or gh_json)(f"repos/{REPO}/actions/runs?branch=main&status=failure&per_page=30") or {}
    except (RuntimeError, ValueError):
        return None
    return any(r.get("name") == wf and (t := parse_iso(r.get("updated_at"))) and t > since
               for r in data.get("workflow_runs") or [])


def queue_main_red(state: dict, issues: list[dict], snap: dict | None = None, runs=None) -> list[str]:
    """Owner 2026-10-14: main sat red for hours (#5091 Full Suite since 05:36Z, #5094 Evidence Refresh) while churn only
    watched PRs. Each open `ci-red-main` issue with no live worker and no queue item becomes a `ci`-lane item."""
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    have = {q["issue"] for q in state.get("queue", [])} | {r.get("issue") for r in live}
    # 2026-10-14: the issue stays open until its fix merges AND the workflow passes on main; a watched PR or a report
    # waiting for review for it means the work is done or in flight -- don't queue it again.
    have |= {p.get("issue") for p in state.get("prs", []) if isinstance(p, dict) and p.get("issue")}
    have |= {e.get("issue") for e in state.get("reports_pending", [])}
    have |= {int(m.group(1)) for v in (snap or {}).values() if v.get("state") == "open"
             if (m := re.match(r"churn/(\d+)-", v.get("branch", "")))}
    added = []
    checked = state.setdefault("main_red_checked", {})
    for i in issues:
        n = int(i["number"])
        if n in have:
            continue
        last = last_main_red_run(n)
        if last and (t := parse_iso(last.get("started"))) and now() - t < dt.timedelta(hours=MAIN_RED_RETRY_H):
            seen = parse_iso(checked.get(str(n)))
            if seen and now() - seen < dt.timedelta(minutes=MAIN_RED_CHECK_MIN):
                continue  # read GitHub at most every MAIN_RED_CHECK_MIN while it waits
            checked[str(n)] = iso(now())
            if not failed_on_main_since(i.get("title", ""), t, runs):
                continue  # no failure since its last run started: that run's verdict stands
        checked.pop(str(n), None)
        state.setdefault("queue", []).insert(0, {
            "issue": n, "model": "sonnet", "needs_owner": False, "lane": "ci", "allow_workflows": True, "auto": "main-red",
            "task": (f"Main is red: {i.get('title', '')} (#{n}). Read the failing runs named in the issue (latest first, "
                     "tests/tools/ci_digest.py), separate infrastructure flakes (rerun them) from real failures, and fix "
                     "the real ones in one PR with tests (class sweep: siblings of each failure). The issue closes itself "
                     "when the workflow next succeeds on main.")})
        added.append(f"#{n}")
    return added


def red_main_issues() -> list[dict]:
    try:
        return [i for i in gh_json(f"repos/{REPO}/issues?labels=ci-red-main&state=open&per_page=50") if "pull_request" not in i]
    except RuntimeError:
