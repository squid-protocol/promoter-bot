def exp_cfg(state: dict) -> dict:
    return {**EXP_DEFAULT, **{k: v for k, v in (state.get("experiment_cfg") or {}).items() if k in EXP_DEFAULT}}


def exp_dir(e: dict) -> Path:
    return H / "experiments" / e["id"]


def active_experiment(state: dict) -> dict | None:
    return next((e for e in state.get("experiments", []) if e.get("stage") in EXP_ACTIVE), None)


def exp_room(state: dict) -> tuple[bool, str]:
    """Whether a new experiment may be proposed: lane on, none active, under the 30-day quota."""
    cfg = exp_cfg(state)
    if not cfg["enabled"]:
        return False, "off (`churn experiment set enabled true`)"
    if e := active_experiment(state):
        return False, f"{e['id']} is active ({e['stage']})"
    recent = [e for e in state.get("experiments", []) if e.get("stage") != "dropped"
              and (t := parse_iso(e.get("created"))) and now() - t < dt.timedelta(days=30)]
    if len(recent) >= int(cfg["per_30d"]):
        return False, f"{len(recent)} in the last 30 days (per_30d {cfg['per_30d']})"
    return True, "room"


def exp_add(state: dict, question: str, change: str, issue: int | None = None, source: str = "owner") -> dict:
    n = 1 + max((int(e["id"][1:]) for e in state.get("experiments", []) if re.fullmatch(r"E\d+", str(e.get("id")))),
                default=0)
    e = {"id": f"E{n}", "question": question.strip(), "change": change.strip(), "issue": issue, "stage": "proposed",
         "created": iso(now()), "source": source, "runs": [], "attempts": 0, "arms": []}
    state.setdefault("experiments", []).append(e)
    return e


def exp_slug(e: dict) -> str:
    return f"{e['id'].lower()}-" + "-".join(re.findall(r"[a-z0-9]+", e["question"].lower())[:6])


def exp_spent(e: dict) -> float:
    total = 0.0
    for rid in e.get("runs", []):
        with contextlib.suppress(OSError, ValueError):
            total += float(json.loads((RUNS / rid / "meta.json").read_text()).get("cost_usd") or 0)
    return round(total, 2)


def exp_run_state(rid: str | None) -> str:
    """'none' (never launched), 'live', or the finished run's status."""
    if not rid:
        return "none"
    try:
        meta = json.loads((RUNS / rid / "meta.json").read_text())
    except (OSError, ValueError):
