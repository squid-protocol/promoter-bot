def cmd_queue(a) -> int:
    """List or edit the work queue (the tick launches the first item with needs_owner false)."""
    with edit_state() as state:
        q = state.setdefault("queue", [])
        if a.action == "add":
            if a.issue is None or not a.task:
                raise SystemExit("queue add needs --issue and --task")
            item = {"issue": a.issue, "model": a.model, "task": a.task, "needs_owner": a.needs_owner}
            if a.backend == "agy":
                item["backend"] = "agy"
            if a.pr:
                item["pr"] = a.pr
            if a.after_pr:
                item["after_prs"] = a.after_pr
            if getattr(a, "after_merge", False):
                item["after_merge"] = True
            if a.allow_workflows:
                item["allow_workflows"] = True
            if a.agy_step:
                item["agy_step"] = a.agy_step
            if a.lane and a.lane != "normal":
                item["lane"] = a.lane
            if getattr(a, "repo", None):
                item["repo"] = a.repo
            meta = issue_meta(a.issue) if not a.pr else None
            tier = getattr(a, "tier", None) or (issue_tier(a.issue, meta) if not a.pr and a.lane in (None, "normal") else None)
            if tier:
                item["tier"] = tier
            if meta is not None and (sc := issue_scope(a.issue, meta)):
                item["scope"] = sc
            if getattr(a, "promote", False):
                item["promoted"] = True
            at = next((k for k, x in enumerate(q) if x.get("issue") == a.before_issue), None) if a.before_issue else None
            if a.front:
                q.insert(0, item)
            elif at is not None:
                q.insert(at, item)
            else:
                q.append(item)
            log(f"queued #{a.issue} ({'agy' if a.backend == 'agy' else a.model}{', front' if a.front else ''}"
                f"{', ' + item['tier'] if item.get('tier') else ''}): {a.task[:120]}")
        elif a.action == "rm":
            if a.index is None or not 0 <= a.index < len(q):
                raise SystemExit("queue rm needs --index N from `churn queue`")
            gone = q.pop(a.index)
            log(f"unqueued #{gone['issue']}: {gone['task'][:80]}")
        elif a.action == "route":
            if a.index is None or not 0 <= a.index < len(q) or not a.backend:
                raise SystemExit("queue route needs --index N and --backend claude|agy")
            if a.backend == "agy":
                q[a.index]["backend"] = "agy"
            else:
                q[a.index].pop("backend", None)
            log(f"routed #{q[a.index]['issue']} to {a.backend}")
        elif a.action == "lane":
            if a.index is None or not 0 <= a.index < len(q) or not a.lane:
                raise SystemExit("queue lane needs --index N and --lane normal|ci|backfill")
            q[a.index]["lane"] = a.lane
            if a.lane == "normal":
                q[a.index].pop("lane")
            log(f"lane of #{q[a.index]['issue']} -> {a.lane}")
        elif a.action == "park":
            if a.index is None or not 0 <= a.index < len(q) or not a.note:
                raise SystemExit("queue park needs --index N and --note")
            q[a.index].update(needs_owner=True, note=a.note[:300])
            log(f"parked #{q[a.index]['issue']} for the owner: {a.note[:120]}")
        elif a.action == "wait":
            if a.index is None or not 0 <= a.index < len(q) or not (a.run or a.minutes) or not a.note:
                raise SystemExit("queue wait needs --index N, --run RUN_ID and/or --minutes M, and --note")
            x = q[a.index]
            x.update(wait_set=iso(now()), note=a.note[:300])
            x.pop("wait_run", None)
            x.pop("wait_until", None)
            if a.run:
                x["wait_run"] = a.run
            if a.minutes:
                x["wait_until"] = iso(now() + dt.timedelta(minutes=a.minutes))
            log(f"#{x['issue']} waits" + (f" for run {a.run}" if a.run else "") + (f" {a.minutes} min" if a.minutes else "")
                + f" (the gate offers it again when that is over, at most {WAIT_MAX_H} h): {a.note[:120]}")
        elif a.action == "tier":
            if a.index is None or not 0 <= a.index < len(q) or not a.tier:
                raise SystemExit("queue tier needs --index N and --tier " + "|".join(TIERS))
            q[a.index]["tier"] = a.tier
            log(f"tier of #{q[a.index]['issue']} -> {a.tier}")
        elif a.action == "retier":  # tier (normal items) and scope (every non-PR item) from the issues' labels
            metas: dict[int, dict | None] = {}
            for x in q:
                if x.get("pr"):
                    continue
                if x["issue"] not in metas:
                    metas[x["issue"]] = issue_meta(x["issue"])
                meta = metas[x["issue"]]
                if meta is None:
                    continue
                if x.get("lane") in (None, "normal") and (t := issue_tier(x["issue"], meta)):
                    x["tier"] = t
                if sc := issue_scope(x["issue"], meta):
                    x["scope"] = sc
                else:
                    x.pop("scope", None)
            log("retiered the queue from issue labels: " + ", ".join(
                f"#{x['issue']} {x.get('tier') or '-'}/{x.get('scope') or '-'}" for x in q if not x.get("pr")))
        elif a.action == "promote":  # owner: launch this (frontier) item, with core priority
            if a.index is None or not 0 <= a.index < len(q):
                raise SystemExit("queue promote needs --index N from `churn queue`")
            q[a.index]["promoted"] = True
            log(f"promoted #{q[a.index]['issue']} (owner): launches with core priority"
                + (f": {a.note[:120]}" if a.note else ""))
        elif a.action == "top":
            if a.index is None or not 0 <= a.index < len(q):
                raise SystemExit("queue top needs --index N from `churn queue`")
            q.insert(0, q.pop(a.index))
    for i, item in enumerate(q):
        flag = " [needs owner]" if item.get("needs_owner") else ""
        who = "agy" if item.get("backend") == "agy" else item.get("model", "sonnet")
        extra = "".join([f" [PR #{item['pr']}]" if item.get("pr") else "", f" [{item['lane']}]" if item.get("lane") else "",
                         f" [{item_tier(item)}]" if not item.get("pr") and item.get("lane") in (None, "normal") and item_tier(item) else "",
                         f" [{item['repo']}]" if item.get("repo") else "",
                         (" [promoted]" if item.get("promoted") else f" [{item['scope']}]" if item.get("scope") else ""),
                         " [frontier: held]" if scope_held(item) else "",
                         f" [after {','.join('#' + str(n) for n in item['after_prs'])}]" if item.get("after_prs") else "",
                         f" [waits {w}]" if (w := waiting(item)) else ""])
        print(f"{i:2}  #{item['issue']:<5} {who:<6}{flag}{extra} {item['task'][:100]}")
    return 0


def gh_label(n: int, add: str | None = None, remove: str | None = None) -> None:
    if add == "shepherd:merge":
        # The shepherd approves the head it sees when this label is ADDED (a `labeled` event; it records the sha). Adding
        # it while it is already on the PR fires nothing, so a re-review of a new head never took (#5080, 2026-10-14):
        # remove it first so the add is a fresh event for the reviewed head.
        run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/issues/{n}/labels/shepherd:merge"])
    if add:
        r = run(["gh", "api", f"repos/{REPO}/issues/{n}/labels", "-f", f"labels[]={add}"])
        if r.returncode:
            raise SystemExit(f"adding {add} to #{n} failed: {r.stderr.strip()[:200]}")
    if remove:
        run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/issues/{n}/labels/{remove}"])  # absent label: fine


def cmd_pr(a) -> int:
    with edit_state() as st:
        prs = st.setdefault("prs", [])
        idx = next((i for i, p in enumerate(prs) if pr_num(p) == a.number), None)
        if a.action == "unwatch":
            if idx is None:
                raise SystemExit(f"#{a.number} is not watched")
            prs.pop(idx)
            log(f"unwatched PR #{a.number}")
            return 0
        entry = prs[idx] if idx is not None else {"number": a.number}
        if not isinstance(entry, dict):
            entry = {"number": entry}
        if a.issue is not None:
            entry["issue"] = a.issue
        if a.action == "allow-workflows":  # the owner's OK for this PR's workflow edits; survives new heads
            entry["allow_workflows"] = True
            log(f"PR #{a.number}: owner allows its workflow edits")
        elif a.action == "flake":
            if not a.head:
                raise SystemExit("pr flake needs --head")
            entry.update(flake_head=a.head, flake_at=iso(now()))
        elif a.action == "reviewed":
            if not a.head or not a.verdict:
                raise SystemExit("pr reviewed needs --head and --verdict")
            entry.update(reviewed_head=a.head, verdict=a.verdict, reviewed_at=iso(now()))
            if a.note:
                entry["note"] = a.note[:300]
            if a.verdict == "send-back":  # #19: the gate loops once more after this tick and launches the fix now
                DIRTY.touch()
        elif a.head:
            entry["reviewed_head"] = a.head
        if idx is None:
            prs.append(entry)
        else:
            prs[idx] = entry
    if a.action == "reviewed" and a.verdict == "merge":
        gh_label(a.number, add="shepherd:merge", remove="shepherd:reapprove")
    log(f"PR #{a.number} {a.action}" + (f" {a.verdict} at {a.head}" if a.action == "reviewed" else "")
        + (f": {a.note[:120]}" if getattr(a, "note", None) else ""))
    return 0


def requeue_next_slice(state: dict, f: dict, nxt: str | None) -> str | None:
    """#37 (2026-10-21): followups for #5878/#5893 (#5648) and #5850 (#5649) left their issues open and nothing queued
    the next slice, so nyx's core work stopped until the owner requeued it. A merged "Part of" followup whose issue is
    still open queues the next slice at the front: `--next` text when the tick gives it, else (core issues only, like
    settle_check's checklist lines) a generic continue-after-#pr task. None = nothing queued."""
    issue = f.get("issue")
    if not issue or f.get("kind") != "merged" or (not nxt and (state.get("workers_paused")
                                                               or not refill_cfg(state)["enabled"])):
        return None
    if any(x.get("issue") == issue for s in ("queue", "running") for x in state.get(s, [])):
        return None
    try:
        i = gh_json(f"repos/{REPO}/issues/{issue}")
    except (RuntimeError, ValueError):
        return None
    if i.get("state") != "open" or foreign_claim(i) or host_skips(i):
        return None
    if not nxt and issue_scope(issue, i) != "core":
        return None
    item = refill_item(i, task=(f"Next slice of #{issue} after PR #{f['pr']}: {nxt}" if nxt else
                                f"#{issue} {i.get('title', '')[:120]} -- continue after PR #{f['pr']} (a merged slice): "
                                "take the next PR-sized part of what the issue still asks; one draft PR"))
    item["auto"] = "followup-next"
    state.setdefault("queue", []).insert(0, item)
    return f"queued the next slice of #{issue}" + ("" if nxt else " (generic: no --next)")


def cmd_followup(a) -> int:
    with edit_state() as st:
        f = next((f for f in st.get("followups", []) if f["pr"] == a.number), None)
        if f is None:
            raise SystemExit(f"no followup for #{a.number}")
        st["followups"] = [g for g in st["followups"] if g is not f]
        queued = None if getattr(a, "closed", False) else requeue_next_slice(st, f, getattr(a, "next", None))
    log(f"followup #{a.number} done" + (f": {a.note[:160]}" if a.note else "") + (f"; {queued}" if queued else ""))
    return 0


def comment_run_outcome(e: dict, note: str) -> None:
    """A run that ends without a PR leaves its outcome only in the local churn log, which the other host, the owner on
    GitHub and a later worktree cleanup never see (owner 2026-10-19): post the review note on the issue."""
    r = run(["gh", "issue", "comment", str(e["issue"]), "-R", REPO, "--body",
             f"<!-- promoter-bot run-outcome run={e['run_id']} -->\n**Churn run `{e['run_id']}` (host {HOST_ID}) ended "
             f"without a PR.** {note}"])
    if r.returncode:
        log(f"run-outcome comment on #{e['issue']} failed: {r.stderr.strip()[:160]}")


def cmd_review(a) -> int:
    with edit_state() as st:
        pending = st.get("reports_pending", [])
        hit = next((e for e in pending if e["run_id"] == a.run_id), None)
        if hit is None:
            raise SystemExit(f"{a.run_id} is not in reports_pending")
        st["reports_pending"] = [e for e in pending if e["run_id"] != a.run_id]
    log(f"review done {a.run_id}" + (f": {a.note[:160]}" if a.note else ""))
    # another repo's run never records its PR (reap skips the lookup): no outcome comment there
    if a.note and hit.get("issue") and not hit.get("pr") and not hit.get("repo") and not getattr(a, "no_comment", False):
        comment_run_outcome(hit, a.note)
    return 0


def cmd_agy_result(a) -> int:
    """Record one Sonnet-checked agy run in the ladder trial; two REJECTs at a step route that step (and the ones
    above it) back to Claude (owner 2026-10-13)."""
    with edit_state() as st:
        trial = st.setdefault("agy", {}).setdefault("trial", {})
        res = trial.setdefault("results", [])
        res.append({"issue": a.issue, "step": a.step, "verdict": a.verdict, "pr": a.pr, "denials": a.denials,
                    "notes": (a.notes or "")[:300], "t": iso(now())})
        rejects = sum(1 for r in res if r.get("step") == a.step and r.get("verdict") == "REJECT")
        rerouted = []
        if rejects >= 2:
            for q in st.get("queue", []):
                if q.get("backend") == "agy" and int(q.get("agy_step") or 0) >= a.step:
                    q.pop("backend")
                    rerouted.append(q["issue"])
    log(f"agy trial: #{a.issue} step {a.step} {a.verdict}" + (f" (PR #{a.pr})" if a.pr else "")
        + (f"; {rejects} REJECTs at step {a.step}: agy capped at step {a.step - 1}, rerouted to Claude: "
           + ", ".join(f"#{i}" for i in rerouted) if rejects >= 2 else ""))
    return 0


def restore_quarantine(state: dict) -> list[str]:
    """Move quarantined section entries back when they now pass their section's checks (e.g. after a schema change the
    quarantining process didn't know). Entries that still fail, or duplicate a live entry, stay quarantined."""
    notes, keep = [], []
    for e in state.get("quarantine", []):
        m = re.match(r"(\w+)\[\d+\]$", str(e.get("where", "")))
        fn = SECTIONS.get(m.group(1)) if m else None
        if not fn:
            keep.append(e)
            continue
        try:
            y = fn(e.get("value"))
        except Exception as ex:  # noqa: BLE001
            keep.append({**e, "restore_failed": str(ex)[:120]})
            continue
        live = state.setdefault(m.group(1), [])
        if any(json.dumps(x, sort_keys=True) == json.dumps(y, sort_keys=True) for x in live):
            notes.append(f"dropped quarantined {e['where']}: already present")
            continue
        live.append(y)
        notes.append(f"restored {e['where']} from quarantine ({e.get('t')}): {json.dumps(y)[:140]}")
    state["quarantine"] = keep
    return notes


def cmd_state(a) -> int:
    if a.action == "restore":
        with edit_state() as st:
            notes = restore_quarantine(st)
        for n in notes:
            log(n)
        print("\n".join(notes) if notes else "nothing to restore")
        return 0
    raw = json.loads(STATE.read_text())
    notes = normalize_state(raw)
    print("\n".join(notes) if notes else "state OK")
    if a.fix and notes:
        with edit_state():
            pass  # load + save: the save normalizes, persists and logs
        print("repaired and saved")
    return 1 if notes and not a.fix else 0


def _parse_pace(v: str) -> str:
    if v not in ("off", "rate", "ledger"):
        raise ValueError("pace is off, rate or ledger")
    return v


def _parse_time(v: str) -> str:
    if not (t := parse_iso(v)):
        raise ValueError("not an ISO time")
    return iso(t)


# key -> (where, parse); `where` is a path into the state. Owner 2026-10-16: knobs change through churn, never by hand.
CONFIG_KEYS = {
    "max_workers": (("max_workers",), int),
    "max_opus": (("max_opus",), int),
    "core_reserve": (("core_reserve",), int),
    "pace": (("usage", "pace"), _parse_pace),
    "block_start": (("usage", "block_start"), _parse_time),
    **{f"rate.{k}": (("usage", "rate", k), int if isinstance(d, int) else float) for k, d in RATE_DEFAULT.items()},
}


def cmd_credit(a) -> int:
    """`churn credit` (status), `add USD [--expires D] [--note N]`, `sync USD` (the Console's balance), `on`, `off`,
    `when paused|always`, `model haiku|sonnet|opus`."""
    if a.action in ("add", "sync") and a.value is None:
        raise SystemExit(f"credit {a.action} needs an amount in USD")
    with edit_state() as st:
        c = st.setdefault("credit", {})
        if a.action == "add":
            c.setdefault("grants", []).append({"t": iso(now()), "usd": round(float(a.value), 2),
                                               **({"expires": iso(parse_iso(a.expires) or now())} if a.expires else {}),
                                               **({"note": a.note} if a.note else {})})
            c.pop("blocked", None)
            log(f"credit: +${float(a.value):.2f} granted" + (f", expires {a.expires}" if a.expires else ""))
        elif a.action == "sync":
            delta = round(float(a.value) - credit_balance(st)["balance"], 2)
            c.setdefault("grants", []).append({"t": iso(now()), "usd": delta, "note": f"sync to Console balance ${a.value}"})
            log(f"credit: synced to ${float(a.value):.2f} (adjustment {delta:+.2f})")
        elif a.action in ("on", "off"):
            c["enabled"] = a.action == "on"
            if a.action == "on":
                c.pop("blocked", None)
        elif a.action == "when":
            if a.value not in ("paused", "always"):
                raise SystemExit("credit when: paused | always")
            c["when"] = a.value
        elif a.action == "model":
            if a.value not in WORKER_BUDGET:
                raise SystemExit(f"credit model: one of {sorted(WORKER_BUDGET)}")
            c["model"] = a.value
        state = st
    cfg, bal = credit_cfg(state), credit_balance(state)
    ok, why = credit_ready(state, bool((p := parse_iso(state.get("paused_until"))) and now() < p))
    print(f"credit lane: {'on' if cfg['enabled'] else 'off'}, when={cfg['when']}, model={cfg['model']}, "
          f"key {'present' if credit_key(cfg) else 'MISSING'} ({cfg['key_file']})")
    print(f"balance ${bal['balance']:.2f} = granted ${bal['granted']:.2f} - spent ${bal['spent']:.2f} - expired "
          f"${bal['expired']:.2f}" + (f"; next expiry {bal['next_expiry']}" if bal["next_expiry"] else ""))
    print(f"runs: {len((state.get('credit') or {}).get('log', []))}; now: {'ready' if ok else why}")
    return 0


def cmd_retro(a) -> int:
    """`churn retro` (status), `now` (due at the next tick), `on`, `off`, `set issue|every_days|model|budget_usd|deep_every V`,
    `size FILE KB` (0 removes the budget)."""
    with edit_state() as st:
        r = st.setdefault("retro", {})
        if a.action == "now":
            r.pop("last", None)
        elif a.action in ("on", "off"):
            r["enabled"] = a.action == "on"
        elif a.action == "set":
            casts = {"issue": int, "every_days": float, "model": str, "budget_usd": float, "deep_every": int}
            if a.key not in casts or a.value is None:
                raise SystemExit(f"retro set: one of {sorted(casts)} and a value")
            if a.key == "model" and a.value not in WORKER_BUDGET:
                raise SystemExit(f"retro model: one of {sorted(WORKER_BUDGET)}")
            r[a.key] = casts[a.key](a.value)
        elif a.action == "size":
            if not a.key or a.value is None:
                raise SystemExit("retro size FILE KB")
            sizes = dict(retro_cfg(st)["size_budget_kb"])
            if float(a.value) > 0:
                sizes[a.key] = float(a.value)
            else:
                sizes.pop(a.key, None)
            r["size_budget_kb"] = sizes
        state = st
    cfg, r = retro_cfg(state), state.get("retro") or {}
    print(f"weekly retro: {'on' if cfg['enabled'] else 'off'}, issue #{cfg['issue']}, every {cfg['every_days']} days, "
          f"{cfg['model']} cap ${cfg['budget_usd']}, deep audit every {cfg['deep_every']}; done {r.get('count', 0)}, last "
          f"{r.get('last')}; size budgets {cfg['size_budget_kb']}; now: {retro_due(state)[1]}")
    return 0


def cmd_worktrees(a) -> int:
    """`churn worktrees` removes finished worktrees now (what the gate does every worktree_gc.every_h); --dry-run lists."""
    notes = gc_worktrees(load_state(), dry_run=a.dry_run, limit=a.limit, grace_h=a.grace_h)
    if not a.dry_run:
        for note in notes:
            log(f"[owner] {note}")
    print("\n".join(notes) or "no finished worktrees to remove")
    return 0


def cmd_config(a) -> int:
    """`churn config` lists the knobs; `churn config KEY VALUE` sets one (validated, logged)."""
    if not a.key:
        state = load_state()
        for k, (path, _) in CONFIG_KEYS.items():
            v = state
            for p in path:
                v = v.get(p) if isinstance(v, dict) else None
            dflt = RATE_DEFAULT.get(k[5:]) if k.startswith("rate.") else {"max_workers": 2, "max_opus": 1, "pace": "ledger",
                                                                                          "core_reserve": CORE_RESERVE}.get(k)
            print(f"{k} = {v if v is not None else dflt}" + (" (default)" if v is None else ""))
        return 0
    if a.key not in CONFIG_KEYS or a.value is None:
        raise SystemExit(f"usage: churn config KEY VALUE; keys: {', '.join(CONFIG_KEYS)}")
    path, parse = CONFIG_KEYS[a.key]
    try:
        val = parse(a.value)
    except (ValueError, TypeError) as e:
        raise SystemExit(f"{a.key}: bad value {a.value!r} ({e})") from None
    if a.key in ("max_workers", "max_opus", "core_reserve", "rate.max_opus_burst", "rate.max_workers_burst") and not 0 <= val <= 4:
        raise SystemExit(f"{a.key} must be 0..4")
    if a.key in ("rate.headroom", "rate.surplus_share") and not 0 < val <= 1:
        raise SystemExit(f"{a.key} must be in (0, 1]")
    with edit_state() as state:
        holder = state
        for p in path[:-1]:
            holder = holder.setdefault(p, {})
        old = holder.get(path[-1])
        holder[path[-1]] = val
    log(f"[owner] config {a.key} {old} -> {val}" + (f" ({a.note})" if a.note else ""))
    print(f"{a.key}: {old} -> {val}")
    return 0


