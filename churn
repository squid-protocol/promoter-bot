    v = d.get("value") or {}
    return (f"best case ${pay:.0f} over six months vs ${cost:.0f} cost ({v.get('slot_hours')} slot-hours of focus work "
            f"displaced at ${cfg['slot_hour_usd']:g}); basis: {v.get('basis', '?')}")


def exp_owner_question(e: dict, d: dict) -> Path:
    q = H / "owner-questions" / f"experiment-{e['id']}.md"
    q.parent.mkdir(parents=True, exist_ok=True)
    runs = len(d["arms"]) * len(d["tasks"]) * int(d["replicates"])
    q.write_text(f"## Owner question\nItem: experiment {e['id']}\nQuestion: Run experiment {e['id']} as designed?\n"
                 f"Context: {e['question']} (would change: {e['change']}). Design: {exp_dir(e) / 'design.md'}. "
                 f"{d['mode']} mode, {len(d['arms'])} arms ({', '.join(d['arms'])}), {len(d['tasks'])} tasks x "
                 f"{d['replicates']} replicates = {runs} runs, est ${runs * float(d['per_run_usd']):.0f} plus scoring.\n"
                 f"Cost vs reward: {exp_value_line(d)}\n"
                 f"Facts checked: design.json passed churn's checks (arms, replicates, budget, rubric).\n"
                 f"yes: Run it -- I register it in temporal-crucible, then run the arms on spare capacity.\n"
                 f"no: Drop it -- I close the experiment and its issue.\n"
                 f"hold: Wait -- it stays designed.\n")
    return q


def exp_launch(e: dict, step: str, model: str, budget: float, brief: str, issue: int, **kw) -> str | None:
    """Launch one experiment worker; its run id, or None (refused: logged)."""
    task = f"experiment {e['id']} {step}"
    try:
        with contextlib.redirect_stdout(open(os.devnull, "w")):
            cmd_worker(argparse.Namespace(**{"resume_run": None, "issue": issue, "model": model, "task": task,
                                             "brief": brief, "brief_file": None, "force": False, "plan": False,
                                             "worktree": None, "branch": None, "check_of": None, "repo": None,
                                             "lane": "experiment", "budget_usd": float(budget), **kw}))
    except (SystemExit, OSError, RuntimeError) as e2:
        log(f"experiment {e['id']} {step}: launch refused: {str(e2)[:200]}")
        return None
    metas = [m for m in RUNS.glob("*/meta.json") if m.stat().st_mtime > time.time() - 600]
    for m in sorted(metas, key=lambda p: p.stat().st_mtime, reverse=True):
        with contextlib.suppress(OSError, ValueError):
            if json.loads(m.read_text()).get("task") == task:
                return m.parent.name
    return None


def tc_clone() -> Path:
    """churn's shared temporal-crucible clone (the one make_crucible_worktree uses), fetched and at origin/main."""
    base = WT / f"_clone-{TC_REPO}"
    if not (base / ".git").exists():
        run(["git", "clone", "-q", f"https://github.com/{ORG}/{TC_REPO}.git", str(base)], timeout=300)
    run(["git", "-C", str(base), "fetch", "-q", "origin"], timeout=120)
    run(["git", "-C", str(base), "checkout", "-q", "--detach", "origin/main"])
    return base


def exp_tracking_issue(e: dict) -> int | None:
    r = run(["gh", "api", f"repos/{REPO}/issues", "-f", f"title=Experiment {e['id']}: {e['question'][:90]}",
             "-f", f"body=Experiment {e['id']}, run by churn's experiment lane ({e['source']}).\n\nQuestion: "
             f"{e['question']}\n\nWhat the answer would change: {e['change']}\n\nThe design, registration and result are "
             f"logged in {ORG}/{TC_REPO}; churn closes this issue when the experiment is cleaned up.",
             "-f", f"labels[]={EXP_LABEL}", "--jq", ".number"])
    return int(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip().isdigit() else None


def exp_tc_pr(rid: str | None) -> int | None:
    """The temporal-crucible PR a run's branch opened."""
    try:
        branch = json.loads((RUNS / str(rid) / "meta.json").read_text()).get("branch")
    except (OSError, ValueError):
        return None
    r = run(["gh", "api", f"repos/{ORG}/{TC_REPO}/pulls?state=all&head={ORG}:{branch}", "--jq", ".[0].number"])
    return int(r.stdout.strip()) if r.returncode == 0 and r.stdout.strip().isdigit() else None


def exp_arm_worktree(e: dict, arm: dict, base: str) -> tuple[Path, str]:
    wt, branch = WT / f"exp-{e['id']}-{arm['blind']}", f"exp/{e['id']}-{arm['blind']}"
    run(["git", "-C", str(V6), "fetch", "-q", "origin"], timeout=300)
    r = run(["git", "-C", str(V6), "worktree", "add", "-q", "-b", branch, str(wt), base])
    if r.returncode != 0:
        raise SystemExit(f"worktree add failed: {r.stderr.strip()[:200]}")
    return wt, branch


def exp_cleanup(e: dict, winner: str | None) -> list[str]:
    """Close every arm PR but the winner's, ready the winner, remove arm worktrees and branches, close the issue."""
    notes = []
    for arm in e.get("arms", []):
        if pr := arm.get("pr"):
            if arm["blind"] == winner:
                title = re.sub(r"^\[exp [^\]]*\]\s*", "", str(arm.get("title") or ""))
                run(["gh", "api", "-X", "PATCH", f"repos/{REPO}/pulls/{pr}", "-f", f"title={title or 'experiment winner'}"])
                run(["gh", "pr", "ready", str(pr), "-R", REPO])
                with edit_state() as st:
                    prs = st.setdefault("prs", [])
                    if not any(pr_num(p) == pr for p in prs):
                        prs.append({"number": pr, "issue": arm["task"]})
                notes.append(f"#{pr} kept (ready, watched)")
            else:
                run(["gh", "api", "-X", "POST", f"repos/{REPO}/issues/{pr}/comments", "-f",
                     f"body=Closing: an arm of experiment {e['id']}; the result is logged in {ORG}/{TC_REPO}."])
                run(["gh", "api", "-X", "PATCH", f"repos/{REPO}/pulls/{pr}", "-f", "state=closed"])
                notes.append(f"#{pr} closed")
        if wt := arm.get("worktree"):
            run(["git", "-C", str(V6), "worktree", "remove", "--force", wt])
        if (b := arm.get("branch")) and arm["blind"] != winner:
            run(["git", "-C", str(V6), "branch", "-D", b])
            if arm.get("pr"):
                run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/git/refs/heads/{b}"])
    if e.get("issue"):
        run(["gh", "api", "-X", "POST", f"repos/{REPO}/issues/{e['issue']}/comments", "-f",
             f"body=Experiment {e['id']} is done: result in {ORG}/{TC_REPO}#{e.get('result_pr')}. Arms cleaned up."])
        run(["gh", "api", "-X", "PATCH", f"repos/{REPO}/issues/{e['issue']}", "-f", "state=closed"])
    return notes


def exp_winner(e: dict, results: dict) -> str | None:
    """Live mode: the arm run with the highest rubric total, ties to the cheaper run. Replay keeps nothing."""
    if e.get("mode") != "live":
        return None
    def total(r: dict) -> float:
        return sum(float(v) for k, v in (r.get("scores") or {}).items() if k.startswith("R") and isinstance(v, (int, float)))
    ranked = sorted(results.values(), key=lambda r: (-total(r), float(r.get("cost_usd") or 0)))
    return ranked[0]["blind"] if ranked else None


def exp_capacity(state: dict, b: dict, need: int) -> bool:
    """Spare capacity only: GREEN, CI calm, workers on, and a slot left for the bug lane when the queue has work."""
    if state.get("workers_paused") or b.get("verdict") != "GREEN" or state.get("ci_mode") == "busy":
        return False
    free = worker_slots(b, len(claude_slot_holders(state)), slot_ceiling(state, rate_plan(state)))
    reserve = 1 if any(not q.get("needs_owner") for q in state.get("queue", [])) else 0
    return free >= need + reserve


def experiment_lane(b: dict, snap: dict, dry_run: bool = False) -> list[str]:
    """Advance the active experiment by at most one step a tick (see the stage list above)."""
    state = load_state()
    if not exp_cfg(state)["enabled"]:
        return []
    cfg = exp_cfg(state)
    e = active_experiment(state)
    if e is None:  # take one proposal from the retro's file when there is room
        ok, _ = exp_room(state)
        lines = EXP_PROPOSALS.read_text().splitlines() if EXP_PROPOSALS.exists() else []
        hit = next(((i, m) for i, x in enumerate(lines) if (m := EXP_PROPOSAL_RE.match(x))), None)
        if not ok or not hit:
            return []
        if dry_run:
            return [f"experiment proposal: {hit[1]['q'][:80]}"]
        with edit_state() as st:
            e = exp_add(st, hit[1]["q"], hit[1]["c"], source="retro")
        lines[hit[0]] = lines[hit[0]].replace("- [ ]", "- [x]", 1) + f" -> {e['id']}"
        EXP_PROPOSALS.write_text("\n".join(lines) + "\n")
        return [f"experiment {e['id']} proposed (retro)"]
    d = exp_dir(e)
    stage, did = e["stage"], []

    def save(**kw) -> None:
        with edit_state() as st:
            x = next(y for y in st["experiments"] if y["id"] == e["id"])
            for k, v in kw.items():
                if k == "add_run":
                    x.setdefault("runs", []).append(v)
                else:
                    x[k] = v

    def retry_or_drop(back: str, why: str) -> list[str]:
        n = int(e.get("attempts", 0)) + 1
        if n >= int(cfg["max_attempts"]):
            save(stage="dropped", attempts=n, note=why)
            notify(f"exp-{e['id']}", f"churn: experiment {e['id']} dropped", why, priority="high", cooldown_h=24 * 365)
            return [f"experiment {e['id']} dropped: {why}"]
        save(stage=back, attempts=n, note=why)
        return [f"experiment {e['id']} back to {back}: {why}"]

    if dry_run:
        return [f"experiment {e['id']}: {stage}"]
    if stage == "proposed":
        if not exp_capacity(state, b, 1):
            return []
        issue = e.get("issue") or exp_tracking_issue(e)
        if not issue:
            return [f"experiment {e['id']}: could not open its tracking issue"]
        d.mkdir(parents=True, exist_ok=True)
        tpl = tc_clone() / "docs" / "_agent_experiment_template.md"
        brief = EXP_DESIGN_BRIEF.format(id=e["id"], issue=issue, question=e["question"], change=e["change"], dir=d,
                                        template=tpl, room=cfg["budget_usd"] - cfg["design_usd"] - cfg["score_usd"]
                                        - 2 * cfg["log_usd"] - exp_spent(e),
                                        slot_hour_usd=cfg["slot_hour_usd"], payoff_x=cfg["payoff_x"])
        if rid := exp_launch(e, "design", cfg["design_model"], cfg["design_usd"], brief, issue):
            save(stage="designing", issue=issue, design_run=rid, add_run=rid)
            did.append(f"experiment {e['id']} design ({cfg['design_model']})")
    elif stage == "designing":
        rs = exp_run_state(e.get("design_run"))
        if rs == "live":
            return []
        try:
            design = json.loads((d / "design.json").read_text())
        except (OSError, ValueError):
            return retry_or_drop("proposed", f"design run {rs}: no readable design.json")
        room = cfg["budget_usd"] - exp_spent(e) - cfg["score_usd"] - 2 * cfg["log_usd"]
        if probs := exp_design_problems(design, room, cfg):
            return retry_or_drop("proposed", "design refused: " + "; ".join(probs))
        q = exp_owner_question(e, design)
        save(stage="designed", mode=design["mode"], question_file=str(q))
        did.append(f"experiment {e['id']} designed: owner question {q.name}")
    elif stage == "approved":
        if not exp_capacity(state, b, 1):
            return []
        brief = EXP_REGISTER_BRIEF.format(id=e["id"], issue=e["issue"], dir=d, org=ORG, tc=TC_REPO, slug=exp_slug(e))
        if rid := exp_launch(e, "register", cfg["log_model"], cfg["log_usd"], brief, e["issue"], repo=TC_REPO):
            save(stage="registering", register_run=rid, add_run=rid)
            did.append(f"experiment {e['id']} registration")
    elif stage == "registering":
        rs = exp_run_state(e.get("register_run"))
        if rs == "live":
            return []
        if not (pr := exp_tc_pr(e.get("register_run"))):
            return retry_or_drop("approved", f"registration run {rs}: no temporal-crucible PR")
        design = json.loads((d / "design.json").read_text())
        arms = [{"blind": os.urandom(3).hex(), "label": label, "task": t["issue"], "task_index": i, "rep": r}
                for i, t in enumerate(design["tasks"]) for r in range(int(design["replicates"])) for label in design["arms"]]
        (d / ".labels.json").write_text(json.dumps({a["blind"]: a["label"] for a in arms}, indent=1))
        save(stage="running", register_pr=pr, registered=iso(now()),
             arms=[{k: v for k, v in a.items() if k != "label"} for a in arms])
        did.append(f"experiment {e['id']} registered (tc PR #{pr}): {len(arms)} arm runs")
    elif stage == "running":
        design = json.loads((d / "design.json").read_text())
        labels = json.loads((d / ".labels.json").read_text())
        arms = e.get("arms", [])
        if (spent := exp_spent(e)) + float(design["per_run_usd"]) + cfg["score_usd"] + cfg["log_usd"] > cfg["budget_usd"]:
            todo = [a for a in arms if not a.get("run")]
            if todo:  # out of budget: score what ran
                for a in todo:
                    a["status"] = "skipped-budget"
                save(arms=arms)
                did.append(f"experiment {e['id']}: budget reached at ${spent}, {len(todo)} runs skipped")
        pending = [a for a in arms if not a.get("run") and not a.get("status")]
        live = [a for a in arms if a.get("run") and exp_run_state(a["run"]) == "live"]
        if pending and not live or (pending and design["mode"] == "replay" and len(live) < int(cfg["max_live"])):
            # live mode launches one task-replicate's arms together on the same main; replay runs them one at a time,
            # at most max_live at once (owner 2026-10-27: E1 arms held 2 of 3 slots while ladder work queued)
            group = ([a for a in pending if (a["task_index"], a["rep"]) == (pending[0]["task_index"], pending[0]["rep"])]
                     if design["mode"] == "live" else pending[:1])
            if exp_capacity(state, b, len(group)):
                for a in group:
                    t = design["tasks"][a["task_index"]]
                    out = d / "arms" / a["blind"]
                    out.mkdir(parents=True, exist_ok=True)
                    brief = EXP_ARM_BRIEF.format(
                        id=e["id"], blind=a["blind"], issue=a["task"], condition=design["arms"][labels[a["blind"]]],
                        brief=t["brief"], out=out,
                        mode_rules=EXP_REPLAY_RULES if design["mode"] == "replay" else
                        EXP_LIVE_RULES.format(id=e["id"], blind=a["blind"]))
                    kw = {}
                    if design["mode"] == "replay":
                        try:
                            wt, branch = exp_arm_worktree(e, a, t["base"])
                        except SystemExit as err:
                            a["status"] = "worktree-failed"
                            log(f"experiment {e['id']} run {a['blind']}: {err}")
                            continue
                        a.update(worktree=str(wt), branch=branch)
                        kw = {"worktree": str(wt), "branch": branch}
                    if rid := exp_launch(e, f"run {a['blind']}", design.get("arm_model") or cfg["arm_model"],
                                         float(design["per_run_usd"]), brief, a["task"], **kw):
                        a["run"] = rid
                        save(add_run=rid)
                        did.append(f"experiment {e['id']} run {a['blind']}")
                save(arms=arms)
        elif not pending and not live:
            for a in arms:
                if a.get("run"):
                    a["status"] = exp_run_state(a["run"])
                    with contextlib.suppress(OSError, ValueError):
                        meta = json.loads((RUNS / a["run"] / "meta.json").read_text())
                        a.setdefault("worktree", meta.get("worktree"))
                        a.setdefault("branch", meta.get("branch"))
                        if meta.get("pr"):
                            a["pr"] = meta["pr"]
                            a["title"] = str(gh_json(f"repos/{REPO}/pulls/{meta['pr']}").get("title") or "")
            save(stage="scoring", arms=arms)
            did.append(f"experiment {e['id']}: all runs finished, scoring next")
    elif stage == "scoring":
        if not e.get("score_run"):
            if not exp_capacity(state, b, 1):
                return []
            design = json.loads((d / "design.json").read_text())
            runs = "\n".join(f"- {a['blind']}: {a.get('worktree')} ({a.get('status')})" for a in e["arms"] if a.get("run"))
            ref = ("Reference fixes (the ground truth, by task issue): " + ", ".join(
                f"#{t['issue']} {t['reference']} (base {t['base']})" for t in design["tasks"])) if design["mode"] == "replay" else ""
            brief = EXP_SCORE_BRIEF.format(id=e["id"], issue=e["issue"], dir=d, runs=runs, reference=ref)
            if rid := exp_launch(e, "score", cfg["score_model"], cfg["score_usd"], brief, e["issue"]):
                save(score_run=rid, add_run=rid)
                did.append(f"experiment {e['id']} blind scoring")
            return did
        rs = exp_run_state(e["score_run"])
        if rs == "live":
            return []
        try:
            scores = json.loads((d / "scores.json").read_text())
        except (OSError, ValueError):
            scores = {}
        ran = [a for a in e["arms"] if a.get("run")]
        if missing := [a["blind"] for a in ran if a["blind"] not in scores]:
            save(score_run=None)
            return retry_or_drop("scoring", f"scoring run {rs}: no score for {', '.join(missing[:5])}")
        labels = json.loads((d / ".labels.json").read_text())
        results = {}
        for a in ran:
            meta = json.loads((RUNS / a["run"] / "meta.json").read_text())
            mins = None
            if (t0 := parse_iso(meta.get("started"))) and (t1 := parse_iso(meta.get("finished"))):
                mins = round((t1 - t0).total_seconds() / 60, 1)
            results[a["blind"]] = {"blind": a["blind"], "condition": labels[a["blind"]], "task": a["task"], "rep": a["rep"],
                                   "status": a.get("status"), "cost_usd": meta.get("cost_usd"), "minutes": mins,
                                   "pr": a.get("pr"), "scores": scores[a["blind"]]}
        (d / "results.json").write_text(json.dumps(results, indent=1))
        save(stage="logging", winner=exp_winner(e, results), scored=iso(now()))
        did.append(f"experiment {e['id']} scored and unblinded")
    elif stage == "logging":
        if not e.get("log_run"):
            if not exp_capacity(state, b, 1):
                return []
            brief = EXP_LOG_BRIEF.format(id=e["id"], issue=e["issue"], reg_pr=e.get("register_pr"), dir=d, slug=exp_slug(e))
            if rid := exp_launch(e, "log", cfg["log_model"], cfg["log_usd"], brief, e["issue"], repo=TC_REPO):
                save(log_run=rid, add_run=rid)
                did.append(f"experiment {e['id']} result write-up")
            return did
        rs = exp_run_state(e["log_run"])
        if rs == "live":
            return []
        if not (pr := exp_tc_pr(e["log_run"])):
            save(log_run=None)
            return retry_or_drop("logging", f"result run {rs}: no temporal-crucible PR")
        e["result_pr"] = pr
        notes = exp_cleanup(e, e.get("winner"))
        save(stage="closed", result_pr=pr, closed=iso(now()), cleanup=notes)
        notify(f"exp-{e['id']}-done", f"churn: experiment {e['id']} logged",
               f"{e['question']}\nResult: {ORG}/{TC_REPO}#{pr} (draft, needs your review). Cleanup: "
               + ("; ".join(notes) or "worktrees removed"), cooldown_h=24 * 365, tags="test_tube")
        did.append(f"experiment {e['id']} logged (tc PR #{pr}) and cleaned up")
    return did


def experiment_orphans(state: dict) -> list[str]:
    """An open `experiment` PR whose experiment is over (closed, dropped or unknown) for a day: closed (the #4479
    arms sat open after the verdict). Run from the gate with no model."""
    r = run(["gh", "api", f"repos/{REPO}/issues?labels={EXP_LABEL}&state=open&per_page=100", "--jq",
             '.[] | select(.pull_request) | [.number, .title, .updated_at] | @tsv'])
    if r.returncode:
        return []
    live = {e["id"] for e in state.get("experiments", []) if e.get("stage") in EXP_ACTIVE}
    keep = {a.get("pr") for e in state.get("experiments", []) for a in e.get("arms", []) if a["blind"] == e.get("winner")}
    out = []
    for line in r.stdout.splitlines():
        n, title, updated = (line.split("\t") + ["", "", ""])[:3]
        m = re.match(r"\[exp (E\d+)", title)
        if not n.isdigit() or int(n) in keep or (m and m.group(1) in live):
            continue
        if (t := parse_iso(updated)) and now() - t < dt.timedelta(hours=24):
            continue
        run(["gh", "api", "-X", "POST", f"repos/{REPO}/issues/{n}/comments", "-f",
             "body=Closing: an experiment arm whose experiment is over (churn's orphan sweep)."])
        run(["gh", "api", "-X", "PATCH", f"repos/{REPO}/pulls/{n}", "-f", "state=closed"])
        out.append(f"closed orphan experiment PR #{n}")
    return out


