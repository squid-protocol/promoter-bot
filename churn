def owner_allows_workflows(state: dict, issue) -> bool:
    """The owner allowed .github/workflows edits for this issue: a queue item says so, or one did in the last day.
    The grant outlives the item: on 2026-10-23 the tick's `churn queue rm` ran after a failed launch, the relaunch
    saw no grant, and the #4726 / #5501 PRs bounced off the precheck all night."""
    if any(q.get("allow_workflows") for q in state.get("queue", []) if q.get("issue") == issue):
        return True
    t = parse_iso((state.get("workflow_grants") or {}).get(str(issue)))
    return bool(t) and now() - t < dt.timedelta(hours=WORKFLOW_GRANT_HOURS)


def workflow_grant_problem(state: dict, pr, issue, files: list[str]) -> str | None:
    """The workflow edits in `files` that no grant on this host covers, by the precheck's rules: the PR's OK, the
    issue's item grant, or the standing policy (never the shepherd's own workflows). 2026-10-28: nyx had no standing
    grant, so its precheck sent back 13 workflow edits since 10-24, while its review tick approved #6549 and #6873
    "under the standing grant" it read in the skill text: the two disagreed and each send-back cost a worker run."""
    wf = [f for f in files if f.startswith(".github/workflows/")]
    if not wf or pr_allows_workflows(state, pr):
        return None
    if standing_workflows(state):
        wf = [f for f in wf if SHEPHERD_WORKFLOWS.match(f)]
    elif issue is not None and owner_allows_workflows(state, int(issue)):
        return None
    if not wf:
        return None
    return (f"edits {', '.join(wf)} with no workflow grant on this host (`churn policy` shows "
            f"{json.dumps(state.get('owner_policy') or {})}): record `hold` for the owner, or the owner runs "
            f"`churn pr allow-workflows {pr}`" + (" or `churn policy workflows on`" if not standing_workflows(state) else ""))


