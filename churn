NOISE = {"infra", "flake", "main"}  # ci_digest triage the shepherd handles by rerunning (or main's own fix)
CI_RED: dict[int, str] = {}  # PR -> its failing checks at the last triage, for the fix brief (#19: no tick to read CI)


def ci_triage(n: int) -> list[str] | None:
    """ci_digest's triage of PR n's failed checks at its current head (origin/main's ci_digest in TOOLS), or None when
    it cannot be read. [] = nothing failing right now (CI still running, or the label is stale)."""
    try:  # ci_digest exits 1 whenever something failed; its JSON is the answer either way
        r = run([sys.executable, str(TOOLS / "tests" / "tools" / "ci_digest.py"), str(n), "--json"], timeout=300)
        failed = json.loads(r.stdout)["failed"]
        CI_RED[n] = "; ".join(f"{f.get('check')} ({f.get('triage')})"
                              + (f": {' '.join((f.get('tests') or [])[:3])}" if f.get("tests") else "")
                              + (f", repro `{f['repro']}`" if f.get("repro") else "") for f in failed)[:600]
        return [f.get("triage") for f in failed]
    except (ValueError, KeyError, TypeError, AttributeError, subprocess.TimeoutExpired):
        return None


def mark_flake(state: dict, n: str, head: str, note: str) -> None:
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
    if p is None:
        p = {"number": int(n)}
        state.setdefault("prs", []).append(p)
    p.update(flake_head=head, flake_at=iso(now()), flake_note=note[:200])


def prune_pr_fixes(state: dict, snap: dict) -> list[str]:
    """Drop auto PR-fix items whose PR moved on: closed, or its head changed since the item was queued (a worker or
    send-back already pushed; the next pass judges the new head). 2026-10-16: ticks spent ~48 turns in 4 days dropping
    such items by hand."""
    out, keep = [], []
    for q in state.get("queue", []):
        v = snap.get(str(q.get("pr"))) if q.get("auto") == "pr-fix" or q.get("owner_hold") else None
        if v is not None and q.get("owner_hold") and v.get("state") == "open":
            keep.append(q)  # the owner's hold: a new head does not lift it, only the PR closing or merging
            continue
        if v is not None and (v.get("state") != "open" or (q.get("head") and v.get("head") and q["head"] != v["head"])):
            out.append(f"#{q['pr']}")
            continue
        keep.append(q)
    state["queue"] = keep
    return out


FIX_LOOP_CAP, FIX_LOOP_WINDOW_H = 3, 24


def recent_fix_runs(pr: int, issue: int) -> int:
    """Fix-loop runs (PR fixes naming #pr, send-backs and precheck retries of runs on this PR) started in the window.
    A run known to have committed nothing of its own (merge-only or no-op, #20) is not a fix round. 2026-10-28: a
    send-back or precheck retry counts only for the PR its run worked on; #5859's precheck retries of #6832/#6843 made
    every regraft PR of the issue start at 2 fix runs, so each went straight to an Opus rescue and a regraft."""
    cut = now() - dt.timedelta(hours=FIX_LOOP_WINDOW_H)
    n = 0
    for d in RUNS.glob(f"{issue}-*"):
        m = _run_meta(d.name)
        t = parse_iso(m.get("started"))
        if not t or t < cut or m.get("check_of") or m.get("code_changed") is False:
            continue
        kind = run_kind(m)
        if (kind == "pr_fix" and re.search(rf"#{pr}\b", m.get("task") or "")) or (
                kind in ("send_back", "precheck_retry") and str(m.get("pr") or "") == str(pr)):
            n += 1
    return n


RESCUE_AT = 2  # Sonnet fix runs in the window before the one Opus rescue run (owner 2026-10-17)
RESCUE_TAG = "RESCUE"


def was_rescued(pr: int, issue: int) -> bool:
    """An Opus rescue run for this PR has started (ever: one rescue per PR)."""
    return any(re.match(rf"{RESCUE_TAG} \(Fix PR #{pr}\b", _run_meta(d.name).get("task") or "") for d in RUNS.glob(f"{issue}-*"))


RESCUE_VERDICT_RE = re.compile(r"Rescue verdict:\**\s*\**\s*(SAVE|SLICE|RESTART|OWNER)\b\**:?\s*(.*)", re.IGNORECASE)


def rescue_verdict(pr: int, issue: int) -> tuple[str, str, str] | None:
    """(run id, verdict, why) of the newest finished rescue of PR pr, or None (none ran, or it gave no verdict)."""
    hits = sorted((m for d in RUNS.glob(f"{issue}-*") if (m := _run_meta(d.name)).get("status") == "done"
                   and re.match(rf"{RESCUE_TAG} \(Fix PR #{pr}\b", m.get("task") or "")),
                  key=lambda m: m.get("started", ""), reverse=True)
    for m in hits[:1]:
        with contextlib.suppress(OSError, ValueError):
            result = str(json.loads((RUNS / m["run_id"] / "out.json").read_text()).get("result") or "")
            if found := RESCUE_VERDICT_RE.findall(result):
                return m["run_id"], found[-1][0].upper(), found[-1][1].strip()[:200]
    return None


def rescue_task(n, branch: str | None, issue: int, loops: int, why: list[str]) -> str:
    """The Opus rescue brief: judge the PR before touching it, then one verdict (owner 2026-10-17)."""
    return (f"{RESCUE_TAG} (Fix PR #{n}, Opus) ({branch}): {loops} fix runs in {FIX_LOOP_WINDOW_H} h and it is back"
            f"{' (' + ' + '.join(why) + ')' if why else ''}. Owner OK (2026-10-17): a rescue run may close this PR and "
            f"edit issue #{issue}. FIRST judge, before changing anything: read issue #{issue}, the PR's diff and size, "
            f"every review note and send-back reason, its CI failures and the earlier runs' reports "
            f"({RUNS}/{issue}-*/report.md). Then end your report with `## Rescue verdict: SAVE|SLICE|RESTART|OWNER` and "
            f"why. SAVE: the fix is tractable; do it now on the PR's branch (merge origin/main, never rebase; gates; "
            f"push). SLICE: sound but too big (5-file rule); cut this PR to a first self-contained slice of <= 5 "
            f"hand-written files, push, and list the rest under **Remaining slices**. RESTART: the approach is wrong; "
            f"close the PR with a comment saying why, then edit issue #{issue}: append `## Plan (Opus rescue of PR "
            f"#{n})` with ordered steps, each one Sonnet-sized PR of <= 5 hand-written files with its own acceptance "
            f"check, the pitfalls the failed attempts hit, and what to reuse from the closed branch; list the same "
            f"steps under **Remaining slices**. OWNER: only for a ruling only the owner can make; ask one plain question. "
            f"There is no second rescue: if this fails again the PR goes to the owner.")


# Owner 2026-10-24: a PR far behind the train never recovers by merging main. #5898/#5900 (10-21) used their two
# fix runs and their rescue, parked as "owner decides", the tick auto-held them, and they sat 3 days while main moved
# ~560 commits on (18 of 19 conflicts were generated det-sweep ledgers). A stale PR (conflicting and STALE_BEHIND
# commits behind, or past its rescue) is REGRAFTED once instead: a fresh branch off current main carries only the PR's
# net hand-written change, generated files are regenerated, a new PR supersedes the old one. Stale PRs of one issue go
# in one regraft. If the PR is still open after its regraft, the gate closes it and queues the slice afresh on the
# issue; the owner is asked only when the regraft run says only the owner can rule.
STALE_BEHIND = 150
BEHIND_TTL_H = 6
REGRAFT_TAG = "REGRAFT"
GENERATED_RE = re.compile(r"(^docs/|det_sweep_coverage/|baseline[^/]*\.json$|ledger|_report\b|\.test_durations$|"
                          r"^tests/fixtures/evidence_report/|CHANGELOG)")
REGRAFT_VERDICT_RE = re.compile(r"REGRAFT VERDICT:\s*(REGRAFTED|DONE|RESTART|OWNER)\b:?\s*(.*)", re.I)


def behind_main(entry: dict | None, n: int, head: str, compare=None) -> int:
    """Commits on main that PR n's head lacks, cached on its state.prs entry per head for BEHIND_TTL_H (0 = unknown)."""
    if entry is None or not head:
        return 0
    c = entry.get("behind") or {}
    if c.get("head") == head and (t := parse_iso(c.get("t"))) and now() - t < dt.timedelta(hours=BEHIND_TTL_H):
        return int(c.get("n") or 0)
    try:
        k = int(((compare or gh_json)(f"repos/{REPO}/compare/{head}...main") or {}).get("ahead_by") or 0)
    except (RuntimeError, ValueError, AttributeError, TypeError):
        return int(c.get("n") or 0) if c.get("head") == head else 0
    entry["behind"] = {"head": head, "n": k, "t": iso(now())}
    return k


def conflict_files(n: int) -> list[str] | None:
    """Files PR n's head conflicts on against origin/main (git merge-tree in V6), or None when unknown."""
    if run(["git", "-C", str(V6), "fetch", "-q", "origin", "main", f"pull/{n}/head:refs/churn/regraft/{n}"],
           timeout=180).returncode:
        return None
    r = run(["git", "-C", str(V6), "merge-tree", "--write-tree", "--name-only", "origin/main", f"refs/churn/regraft/{n}"])
    if r.returncode not in (0, 1):
        return None
    if not r.returncode:
        return []
    files = []
    for x in r.stdout.splitlines()[1:]:  # first line is the tree; names until the blank line, then messages
        if not x.strip():
            break
        files.append(x.strip())
    return files


def was_regrafted(pr: int, issue: int) -> str | None:
    """The newest finished regraft run that carried PR pr (one regraft per PR; a crashed or limit-killed one does not
    count), or None."""
    hits = [m for d in RUNS.glob(f"{issue}-*") if (m := _run_meta(d.name))
            and m.get("status") == "done" and re.match(rf"{REGRAFT_TAG} \(PR [^)]*#{pr}\b", m.get("task") or "")]
    return max(hits, key=lambda m: m.get("started", "")).get("run_id") if hits else None


def regraft_verdict(rid: str) -> tuple[str, str] | None:
    """The run's closing `REGRAFT VERDICT: X ...` line as (X, rest), or None (no verdict: it failed or is unread)."""
    with contextlib.suppress(OSError, ValueError):
        result = str(json.loads((RUNS / rid / "out.json").read_text()).get("result") or "")
        if hits := REGRAFT_VERDICT_RE.findall(result):
            return hits[-1][0].upper(), hits[-1][1].strip()[:300]
    return None


def regraft_task(prs: list[int], issue: int, behind: int, files: list[str] | None, why: list[str]) -> str:
    """The regraft brief: re-apply the PRs' net hand-written change on a fresh branch off current main."""
    names = ", ".join(f"#{p}" for p in prs)
    hand = [f for f in files or [] if not GENERATED_RE.search(f)]
    seen = (f" Conflicts against main: {len(files)} files, hand-written: {', '.join(hand[:8]) or 'none'}."
            if files is not None else "")
    many = (f" The PRs are stacked slices of #{issue}: carry them as ONE new PR if together they stay within the "
            f"5-hand-written-file rule, else one new PR per old PR." if len(prs) > 1 else "")
    src = " ".join(f"`git fetch origin pull/{p}/head:regraft-src-{p}`" for p in prs)
    return (f"{REGRAFT_TAG} (PR {names}): {behind} commits behind main ({' + '.join(why)}); merging main into it has "
            f"stopped working.{seen}{many} Do NOT merge main into the old branch and do NOT rebase or force-push it. "
            f"Your worktree is a FRESH branch off current origin/main. 1. {src}; the PR's own change is "
            f"`git diff $(git merge-base origin/main regraft-src-N) regraft-src-N`. 2. Check it is still needed: if main "
            f"already does it, close the old PR(s) with a comment naming the main commit, verdict DONE. 3. Re-apply only "
            f"the hand-written files (`git apply -3`, or by hand against main's CURRENT version: the code under it may have "
            f"moved). Never carry generated files (coverage ledgers, baselines, generated docs/reports): regenerate them "
            f"with the repo's tools after the change. 4. Gates, push, open the new PR: the old title, `Part of #{issue}`, "
            f"`Supersedes {names}`, and the old body's class table, owner decisions and `Checklist:` line. Then close each "
            f"old PR with a comment linking the new one. Verdict REGRAFTED. 5. If the change no longer fits main (the code "
            f"it touched was rewritten), close the old PR(s) saying why and append `## Plan (regraft of PR {names})` to "
            f"issue #{issue} with Sonnet-sized steps, verdict RESTART. OWNER only for a ruling only the owner can make: "
            f"one plain question. End your report with exactly one line `REGRAFT VERDICT: REGRAFTED #<new> | DONE | "
            f"RESTART | OWNER: <question>`.")


def owner_held(n: int) -> bool:
    """The owner (not the tick's auto-hold) answered "hold" on PR n's item in owner-answers.jsonl."""
    with contextlib.suppress(OSError):
        for line in (H / "owner-answers.jsonl").read_text().splitlines():
            with contextlib.suppress(ValueError):
                e = json.loads(line)
                if (isinstance(e, dict) and str(e.get("answer", "")).lower() == "hold"
                        and re.search(rf"PR #{n}\b", str(e.get("item", "")))
                        and not str(e.get("note", "")).startswith("auto-hold")):
                    return True
    return False


def expire_owner_parks(state: dict) -> list[str]:
    """Drop the fix-loop cap's "owner decides" items the owner never answered (only the tick's auto-hold): they parked
    forever while main ran away from the PR. The next pass judges the PR again, and it is regrafted. Kept: an item with
    a note (the owner or a regraft parked it) or a real owner hold."""
    out, keep = [], []
    for q in state.get("queue", []):
        if (q.get("auto") == "pr-fix" and q.get("needs_owner") and q.get("pr") and not q.get("note")
                and not owner_held(int(q["pr"]))):
            out.append(f"#{q['pr']}")
            continue
        keep.append(q)
    state["queue"] = keep
    return out


def close_and_restart(state: dict, n: int, issue: int, rid: str) -> None:
    """A PR still open after its regraft: close it (pointing at the run) and queue its slice afresh on the issue."""
    run(["gh", "pr", "close", str(n), "-R", REPO, "--comment",
         f"Closed by churn: this PR fell too far behind main and its regraft (run {rid}) could not carry it. The slice "
         f"is queued again on #{issue}, from current main."])
    state.setdefault("queue", []).append({
        "issue": issue, "model": "sonnet", "needs_owner": False, "auto": "restart", "tier": "followup",
        "task": f"RESTART the slice of closed PR #{n} from current main: its regraft (run {rid}) could not carry it. "
                f"Read `gh pr view {n}` and its diff for what to reuse and the issue's latest `## Plan` section; re-do "
                f"the change on a fresh branch, regenerate generated files, one PR."})


def new_worktree(issue: int, stamp: str, wt: Path | None = None) -> tuple[Path, str]:
    """A new churn/<issue>-<stamp> branch off freshly fetched origin/main in its own worktree."""
    wt = wt or WT / f"churn-{issue}-{stamp}"
    branch = f"churn/{issue}-{stamp}"
    run(["git", "-C", str(V6), "fetch", "-q", "origin"], timeout=120)
    r = run(["git", "-C", str(V6), "worktree", "add", "-q", "-b", branch, str(wt), "origin/main"])
    if r.returncode != 0:
        raise SystemExit(f"worktree add failed: {r.stderr.strip()}")
    return wt, branch


FIX_SETTLE_MIN = 15  # a run on the PR finished this recently: CI on its push has not reported yet (#20)


def update_branch(n: int) -> bool:
    """Merge origin/main into PR n's branch on GitHub (the update-branch API): True when GitHub took it, False on a real
    conflict (422) or any other failure. #20: ~8 Claude fix runs a night only merged main and pushed."""
    return not run(["gh", "api", "-X", "PUT", f"repos/{REPO}/pulls/{n}/update-branch"]).returncode


def recently_settling(state: dict, n: str, v: dict, issue: int) -> bool:
    """A run on PR n is not judged yet (its report waits for review) or finished under FIX_SETTLE_MIN ago (#20: four
    resume/fix runs found their work already done, one fix overlapped an Opus rescue)."""
    if any(e.get("issue") == issue for e in state.get("reports_pending", [])):
        return True
    cut = now() - dt.timedelta(minutes=FIX_SETTLE_MIN)
    return any(m.get("branch") == v.get("branch") and (t := parse_iso(m.get("finished"))) and t > cut
               for d in RUNS.glob(f"{issue}-*") if (m := _run_meta(d.name)))


def carry_reviews(state: dict, snap: dict, compare=None) -> list[str]:
    """A PR the gate updated with main (update_branch) keeps its review: when its head moved from `updated_from` by
    exactly GitHub's one merge commit, the verdict given at the old head is re-stamped at the new one, so the update
    costs no re-review model tick."""
    out = []
    for p in state.get("prs", []):
        if not isinstance(p, dict) or not (old := str(p.get("updated_from") or "")):
            continue
        v = snap.get(str(pr_num(p)), {})
        if v.get("state") != "open" or not v.get("head") or old.startswith(v["head"]) or v["head"].startswith(old[:12]):
            continue
        p.pop("updated_from")
        rh = str(p.get("reviewed_head") or "")
        if not (rh and p.get("verdict") and (rh.startswith(old) or old.startswith(rh[:12]))):
            continue
        try:
            c = (compare or gh_json)(f"repos/{REPO}/compare/{old}...{v['head']}")
            commits = c.get("commits") or []
        except (RuntimeError, ValueError, AttributeError):
            continue
        if len(commits) == 1 and len(commits[0].get("parents") or []) == 2:
            p["reviewed_head"] = v["head"]
            out.append(f"#{pr_num(p)} {p['verdict']} -> {v['head']}")
    return out


def queue_pr_fixes(state: dict, snap: dict, triage=None, update=None, compare=None, conflicts=None) -> list[str]:
    """Owner 2026-10-13: #5038/#5041 sat conflicting for hours because a tick with no free slot only logged them and
    stuck_seen then hid them. Any watched open PR that is conflicting (dirty) or shepherd:needs-fix, with no live worker
    on it and no queue item for it, gets a fix item at the FRONT of the queue (key "pr").
    2026-10-16: so does a PR reviewed send-back at its current head. #5204's send-back waited for #5201; when #5201
    merged a tick dropped the fix item ("clean, nothing to fix"), the head never moved, and 5 items blocked on it idled
    the slots ~20 h. A send-back stays a need until the head changes."""
    live = [r for r in state.get("running", []) if pid_alive(r.get("pid"))]
    added = [f"expired:{x}" for x in expire_owner_parks(state)]
    queued = {int(p) for q in state.get("queue", []) for p in [q.get("pr"), *q.get("also_prs", [])] if p}
    issue_of = {pr_num(p): p.get("issue") for p in state.get("prs", []) if isinstance(p, dict)}
    for n, v in snap.items():
        if v.get("state") != "open" or int(n) in queued or pr_in_hand(n, v, live) or flaked(state, n, v):
            continue
        sent_back = verdict_at_head(state, n, v) == "send-back"
        why = [w for w, hit in (("conflicts with main", v.get("mergeable_state") == "dirty"),
                                ("shepherd:needs-fix", "shepherd:needs-fix" in v.get("labels", [])),
                                ("review sent it back", sent_back)) if hit]
        if not why:
            continue
        m = re.match(r"churn/(\d+)-", v.get("branch", ""))
        issue = issue_of.get(int(n)) or (int(m.group(1)) if m else int(n))
        if recently_settling(state, n, v, issue):
            continue
        entry = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
        if why == ["conflicts with main"] and entry is not None and entry.get("update_tried") != v.get("head"):
            # #20: a branch that only needs main merged is GitHub's job, not a model's; a real conflict fails (422)
            entry["update_tried"] = v.get("head")
            if (update or update_branch)(int(n)):
                entry["updated_from"] = v.get("head")
                added.append(f"updated:#{n}")
                continue
        if why == ["shepherd:needs-fix"]:  # a red, not a conflict: only a REAL failure is a worker's job
            kinds = (triage or ci_triage)(int(n))
            if kinds is not None and not [k for k in kinds if k not in NOISE]:
                if "main" in kinds and entry is not None and entry.get("update_tried") != v.get("head"):
                    entry["update_tried"] = v.get("head")  # main's own red: take main's fix, no worker
                    if (update or update_branch)(int(n)):
                        entry["updated_from"] = v.get("head")
                        added.append(f"updated:#{n}")
                        continue
                if kinds:  # infra / flake / main only: the shepherd reruns it; look again in FLAKE_HOURS or on a new head
                    mark_flake(state, n, v.get("head", ""), "gate: CI noise only (" + ", ".join(sorted(set(kinds))) + ")")
                    added.append(f"noise:#{n} ({', '.join(sorted(set(kinds)))})")
                if not kinds:  # nothing failing at this head yet: not churn work until triage finds a failure
                    for p in state.get("prs", []):
                        if isinstance(p, dict) and pr_num(p) == int(n):
                            p["clean_head"] = v.get("head")
                continue
        loops = recent_fix_runs(int(n), issue)
        # Owner 2026-10-17: two Sonnet fix runs, then ONE Opus rescue that judges the PR (save / slice / restart /
        # owner). 2026-10-24: a PR that fails again after its rescue, or falls STALE_BEHIND behind main while
        # conflicting, is regrafted (see STALE_BEHIND); the owner hears of it only if the regraft asks.
        # 2026-10-28: only a CONFLICTING PR is regrafted. #6896 -> #6901 -> #6902 -> #6905 were each regrafted at 0
        # commits behind for a red that was main's (DOOM-rosetta), each after an Opus rescue said SAVE: the same diff on
        # a fresh branch takes the same red, and the old PR was closed with its checks still running. A red PR past
        # its rescue that merges cleanly goes to the owner instead (as the rescue brief says), with the rescue's verdict.
        rescued = loops >= RESCUE_AT and was_rescued(int(n), issue)
        rescue = loops >= RESCUE_AT and not rescued
        dirty = "conflicts with main" in why
        behind = behind_main(entry, int(n), v.get("head", ""), compare) if dirty else 0
        if rescued and not dirty:
            rv = rescue_verdict(int(n), issue)
            said = f"its rescue ({rv[0]}) said {rv[1]}: {rv[2]}" if rv else "its rescue gave no verdict"
            state.setdefault("queue", []).insert(0, {
                "issue": issue, "pr": int(n), "model": "opus", "needs_owner": True, "auto": "pr-fix",
                "note": f"red after its Opus rescue, no conflict (a regraft would carry the same red); {said}"[:300],
                "task": f"Owner ruling for PR #{n}: {' + '.join(why)} after its Opus rescue; {said}"[:600],
                **({"head": v["head"]} if v.get("head") else {})})
            queued.add(int(n))
            added.append(f"#{n} (owner: red after its rescue)")
            continue
        if rescued or (dirty and behind >= STALE_BEHIND):
            if rescued:
                why.append(f"{loops} fix runs in {FIX_LOOP_WINDOW_H} h and an Opus rescue already ran")
            if rid := was_regrafted(int(n), issue):  # its one regraft ran and the PR is still open
                verdict = regraft_verdict(rid)
                if verdict and verdict[0] == "OWNER":
                    state.setdefault("queue", []).insert(0, {
                        "issue": issue, "pr": int(n), "model": "opus", "needs_owner": True, "auto": "pr-fix",
                        "note": f"regraft {rid} asks: {verdict[1]}"[:300],
                        "task": f"Owner ruling for PR #{n}: its regraft (run {rid}) asks: {verdict[1]}",
                        **({"head": v["head"]} if v.get("head") else {})})
                    added.append(f"#{n} (owner: the regraft asks)")
                elif verdict and verdict[0] in ("REGRAFTED", "DONE"):  # the run left the old PR open: close it
                    run(["gh", "pr", "close", str(n), "-R", REPO, "--comment",
                         f"Closed by churn: superseded by its regraft (run {rid}: {verdict[0]} {verdict[1]})."[:900]])
                    added.append(f"closed:#{n} (regraft {verdict[0].lower()})")
                else:
                    close_and_restart(state, int(n), issue, rid)
                    added.append(f"restart:#{n}")
                continue
            group = [int(n)] + sorted(
                int(k) for k, o in snap.items() if k != n and o.get("state") == "open" and int(k) not in queued
                and o.get("mergeable_state") == "dirty" and str(o.get("branch", "")).startswith(f"churn/{issue}-")
                and not pr_in_hand(k, o, live) and not was_regrafted(int(k), issue))
            files = (conflicts or conflict_files)(int(n)) if dirty else None
            hand = files is None or any(not GENERATED_RE.search(f) for f in files)
            state.setdefault("queue", []).insert(0, {
                "issue": issue, "pr": int(n), "model": "opus" if hand else "sonnet", "needs_owner": False,
                "task": regraft_task(group, issue, behind, files, why), "auto": "pr-fix", "regraft": True,
                **({"also_prs": group[1:]} if group[1:] else {}), **({"head": v["head"]} if v.get("head") else {})})
            queued.update(group)
            added.append(f"#{n} (regraft{', with ' + ', '.join(f'#{g}' for g in group[1:]) if group[1:] else ''})")
            continue
        note = next((str(p.get("note") or "") for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), "")
        review = (f" The review at this head asked for: {note[:400]} (This item comes back every tick until the head "
                  f"changes: to defer it use `churn queue wait`, never `churn queue rm`.)" if sent_back and note else "")
        if "shepherd:needs-fix" in why and CI_RED.get(int(n)):
            review += f" Red at this head (ci_digest): {CI_RED[int(n)]}."
        task = (rescue_task(n, v.get("branch"), issue, loops, why) + review if rescue else
                f"Fix PR #{n} ({v.get('branch')}): {' + '.join(why)}. Work on the PR's own branch: merge origin/main "
                f"(never rebase), resolve (regenerate generated docs, never hand-merge them), read any red check and fix "
                f"what is real, gates, push; report the PR's CI." + review)
        state.setdefault("queue", []).insert(0, {"issue": issue, "pr": int(n), "model": "opus" if rescue else "sonnet",
                                                 "task": task, "needs_owner": False, "auto": "pr-fix",
                                                 **({"filler_pr": True} if filler_branch(v.get("branch")) else {}),
                                                 **({"main_red_pr": True} if main_red_branch(v.get("branch")) else {}),
                                                 **({"rescue": True} if rescue else {}),
                                                 **({"head": v["head"]} if v.get("head") else {})})
        added.append(f"#{n}")
    return added


def verdict_at_head(state: dict, n: str, v: dict) -> str | None:
    """The tick's recorded verdict for PR n if it was given at the PR's CURRENT head (else None)."""
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
    rh = str((p or {}).get("reviewed_head") or "")
    if rh and "head" in v and (rh.startswith(v["head"]) or v["head"].startswith(rh[:12])):
        return p.get("verdict")
    return None


HOLD_WORKFLOW_RE = re.compile(r"workflow|\.github/|allow_workflows", re.I)


def release_workflow_holds(state: dict, snap: dict) -> list[str]:
    """2026-10-24: the owner's standing workflow grant re-queued the held ITEMS but left four PRs (#6155 #6333 #6404
    #6426) on a `hold` verdict at their head, and a hold makes no need, so nothing ever re-reviewed them. Under the
    standing grant, a hold whose note is about a workflow edit (not the shepherd's own) is cleared: the head is
    unreviewed again and the next tick reviews it like any other. Returns log lines."""
    if not standing_workflows(state):
        return []
    out = []
    for n, v in snap.items():
        if v.get("state") != "open" or verdict_at_head(state, n, v) != "hold":
            continue
        p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None)
        note = str((p or {}).get("note") or "")
        if p is not None and HOLD_WORKFLOW_RE.search(note) and not re.search(r"shepherd", note, re.I):
            p.pop("verdict", None)
            p.pop("reviewed_head", None)
            p["allow_workflows"] = True
            out.append(f"PR #{n}: workflow hold released under the standing grant; review it again ({note[:80]})")
    return out


def owner_holds(state: dict, snap: dict) -> list[str]:
    """Open PRs the tick put on hold at their current head: they wait on the owner, not on churn."""
    return [n for n, v in snap.items() if v.get("state") == "open" and verdict_at_head(state, n, v) == "hold"]


def fix_merge_labels(state: dict, snap: dict, dry_run: bool = False) -> list[str]:
    """Owner 2026-10-14: #5080 was reviewed `merge` at its head but lost shepherd:merge (shepherd:reapprove instead), so
    nothing would ever merge it. A PR reviewed `merge` at its CURRENT head gets its labels put back (the skill's rule:
    re-add shepherd:merge only if that head was reviewed)."""
    out = []
    for n, v in snap.items():
        labels = set(v.get("labels", []))
        if (v.get("state") == "open" and verdict_at_head(state, n, v) == "merge"
                and ("shepherd:merge" not in labels or "shepherd:reapprove" in labels)
                and not labels & {"shepherd:needs-fix"} and v.get("mergeable_state") != "dirty"):
            if not dry_run:
                gh_label(int(n), add="shepherd:merge", remove="shepherd:reapprove")
            out.append(f"#{n}")
    return out


def owner_parked(state: dict, n: str) -> bool:
    """PR n waits on the owner: its fix item is needs_owner (fix-loop cap), or one of its needs stalled."""
    return any(q.get("pr") == int(n) and q.get("needs_owner") for q in state.get("queue", [])) or \
        any(re.match(rf"(review|followup|orphan PR) #{n}\b", k) for k in state.get("stalled", []))


def clean_at_head(state: dict, n: str, v: dict) -> bool:
    """The gate's triage found nothing failing at this head (a stale shepherd:needs-fix label); re-triaged every tick."""
    p = next((p for p in state.get("prs", []) if isinstance(p, dict) and pr_num(p) == int(n)), None) or {}
    return bool(v.get("head")) and p.get("clean_head") == v["head"]


def prs_needing_work(snap: dict, live: list[dict] | None = None, state: dict | None = None) -> list[str]:
    """Open watched PRs that need churn work (fix rule 3). A PR with shepherd:merge that is only waiting for CI or the
    shepherd doesn't count: holding launches for those would stall churn behind CI. With `live` (running Claude
    workers), a PR a live worker is already fixing doesn't count either (owner 2026-10-13, for the agy lane): its task
    names the PR (#n), or the PR's churn/<issue>- branch is that worker's issue."""
    out = []
    for n, v in snap.items():
        if v.get("state") != "open":
            continue
        if live and pr_in_hand(n, v, live):
            continue
        if state is not None and verdict_at_head(state, n, v) in ("hold", "merge"):
            continue  # hold: waits on the owner; merge at this head: fix_merge_labels puts the labels back
        if state is not None and (owner_parked(state, n) or flaked(state, n, v) or clean_at_head(state, n, v)):
            continue  # 2026-10-16 audit: three such PRs held all normal churn with nothing scheduled to clear them
        labels = set(v.get("labels", []))
        if ("shepherd:merge" not in labels or labels & {"shepherd:reapprove", "shepherd:needs-fix"}
                or v.get("mergeable_state") == "dirty"):
            out.append(n)
    return out


def auto_checkable(e: dict) -> bool:
    return e.get("backend") == "agy" and e.get("status") == "done"


def lanes(b: dict, snap: dict, claude_paused: bool, dry_run: bool = False) -> list[str]:
    """Deterministic launches that need no model tick: a Sonnet checker for each finished agy run (Claude slot
    needed), and agy workers from `backend: agy` queue items (agy's own quota: runs during a Claude pause too)."""
    did = []
    state = load_state()
    if state.get("workers_paused"):
        return did
    live_claude = claude_slot_holders(state)
    cfg = agy_cfg(state)
    if not claude_paused:
        for e in [e for e in state.get("reports_pending", []) if auto_checkable(e)]:
            if worker_slots(b, len(live_claude), int(state.get("max_workers", 2))) <= 0:
                break
            meta = json.loads((RUNS / e["run_id"] / "meta.json").read_text())
            did.append(f"checker for {e['run_id']}")
            if dry_run:
                live_claude.append(e)
                continue
            brief = CHECK_BRIEF.format(issue=e["issue"], wt=meta["worktree"], branch=meta["branch"], agy_dir=RUNS / e["run_id"],
                                       repo_dir=V6, python=SELFSCAN_PY)
            with contextlib.redirect_stdout(open(os.devnull, "w")):
                cmd_worker(argparse.Namespace(resume_run=None, issue=e["issue"], model=cfg["checker_model"],
                                              task=f"check agy run {e['run_id']}", brief=brief, brief_file=None, force=False,
                                              plan=False, worktree=meta["worktree"], branch=meta["branch"], check_of=e["run_id"]))
            with edit_state() as st:
                st["reports_pending"] = [x for x in st.get("reports_pending", []) if x["run_id"] != e["run_id"]]
            live_claude.append(e)
    paused = parse_iso(cfg.get("paused_until"))
    live_agy = [r for r in state.get("running", []) if r.get("backend") == "agy" and pid_alive(r.get("pid"))]
    item = next((q for q in state.get("queue", []) if q.get("backend") == "agy" and not q.get("needs_owner")
                 and in_focus(state, q)
                 and not blocked_by(q, snap) and not waiting(q)), None)
    if (item and cfg["enabled"] and not (paused and now() < paused) and len(live_agy) < cfg["max_running"]
            and b.get("verdict") == "GREEN" and b.get("free_slots", 0) >= 1 and len(prs_needing_work(snap, live_claude, state)) < 3):
        did.append(f"agy worker for #{item['issue']}")
        if not dry_run:
            with contextlib.redirect_stdout(open(os.devnull, "w")):
                cmd_agy(argparse.Namespace(issue=item["issue"], task=item.get("task"), model=item.get("agy_model"),
                                           brief_file=None, force=False))
            with edit_state() as st:
                q = st.get("queue", [])
                with contextlib.suppress(ValueError):
                    q.remove(item)
    return did


def _run_meta(rid: str) -> dict:
    with contextlib.suppress(OSError, ValueError):
        return json.loads((RUNS / rid / "meta.json").read_text())
    return {}


WARM_RESUME_MIN = 55  # a run finished this recently resumes inside the 1 h prompt cache (send-back's limit is 60)


def direct_spec(state: dict, snap: dict, x: dict) -> dict | None:
    """How the gate can launch item x itself, or None if a model tick must write its brief (owner 2026-10-16: ~330 of
    ~440 model ticks since 10-14 carried a launch; for these items the brief already exists):
    - a PR fix, when a churn worktree of its issue is on the PR's branch;
    - a backfill RESUME item (the preempted run's worktree);
    - an item whose plan was held, once the overlap cleared: it implements the saved plan, no new plan run."""
    def tree(meta):
        return meta if meta.get("worktree") and Path(meta["worktree"]).is_dir() else None
    if x.get("regraft"):  # a fresh branch off current main, made at launch (direct_launches)
        return {"worktree": None, "branch": None, "plan": False, "fresh": True, "brief": x["task"]}
    if x.get("pr"):
        branch = (snap.get(str(x["pr"])) or {}).get("branch")
        metas = sorted((m for d in RUNS.glob(f"{x['issue']}-*") if (m := _run_meta(d.name))), key=lambda m: m.get("started", ""))
        m = next((m for m in reversed(metas) if branch and m.get("branch") == branch and tree(m)), None)
        if m and m.get("session_id") and m.get("status") == "done" and not m.get("repo") and not x.get("rescue") and (
                m.get("model") == x.get("model", "sonnet")) and (
                t := parse_iso(m.get("finished"))) and now() - t < dt.timedelta(minutes=WARM_RESUME_MIN):
            # #19: the run that wrote this PR is still in the 1 h prompt cache: the fix goes back into its session
            return {"worktree": m["worktree"], "branch": branch, "brief": x["task"], "plan": False, "resume_run": m["run_id"]}
        return m and {"worktree": m["worktree"], "branch": branch, "brief": x["task"], "plan": False, "repo": m.get("repo")}
    if x.get("lane") == "backfill" and (r := re.match(r"RESUME backfill run (\S+)", str(x.get("task", "")))):
        m = tree(_run_meta(r.group(1)))
        return m and {"worktree": m["worktree"], "branch": m.get("branch"), "brief": x["task"], "plan": False,
                      "repo": m.get("repo"), "lane": "backfill"}
    rid, _ = held_plan(state, x)
    if not rid and (spec := fresh_spec(state, snap, x)):
        return spec
    if rid and (m := tree(_run_meta(rid))):
        prompt = (RUNS / rid / "prompt.md").read_text() if (RUNS / rid / "prompt.md").exists() else x.get("task", "")
        return {"worktree": m["worktree"], "branch": m.get("branch"), "plan": False, "held_plan": rid,
                "brief": (f"PHASE 2 (the gate checked your saved plan's files against the in-flight work: the overlap "
                          f"that held it has cleared). Implement the plan in {RUNS / rid / 'plan.md'}; first `git merge "
                          f"origin/main` (never rebase), since this worktree may be behind. Queue task: {x.get('task', '')}"
                          f"\n\n{prompt}")}
    return None


SKILL_MD = Path.home() / ".claude/skills/night-shift/SKILL.md"


def worker_brief_template() -> str | None:
    """The skill's "## Worker brief" section, read live so the gate's brief and a tick's brief stay one text."""
    with contextlib.suppress(OSError):
        m = re.search(r"^## Worker brief[^\n]*\n(.*?)(?=^## )", SKILL_MD.read_text(), re.S | re.M)
        return m.group(1).strip() if m else None
    return None


def fresh_spec(state: dict, snap: dict, x: dict) -> dict | None:
    """A new normal/ci-lane item the gate launches itself (owner 2026-10-16: a launch-only model tick just filled the
    skill's brief template). Only with plan_first on, since the plan's impact check is what catches file overlap with
    in-flight work; never a crucible step, an owner item, or an issue with a live run or an open churn PR."""
    if (x.get("pr") or x.get("repo") or x.get("needs_owner") or x.get("backend") == "agy"
            or x.get("lane", "normal") not in ("normal", "ci") or not state.get("features", {}).get("plan_first")):
        return None
    issue = x.get("issue")
    if crucible_repo_of(issue) or any(r.get("issue") == issue for r in state.get("running", []) if pid_alive(r.get("pid"))):
        return None
    if any(str(v.get("branch") or "").startswith(f"churn/{issue}-") and v.get("state") == "open" for v in snap.values()
           if isinstance(v, dict)):
        return None
    if not (tpl := worker_brief_template()):
        return None
    task = str(x.get("task") or "")
    owner = re.search(r"Owner OK \([^)]*\):[^\n]*", task)
    brief = (f"# Issue #{issue}\n\nTask: {task}\n\nRead the issue (`gh issue view {issue} -R {REPO}`) for the acceptance "
             f"criteria first.\n"
             + (f"\nCopy this line into the PR body under `## Owner decisions`: {owner.group(0)}\n" if owner else "")
             + ("\nThe owner queued this workflow change (allow_workflows): editing .github/workflows is in scope.\n"
                if x.get("allow_workflows") else
                "\nThe owner's standing grant allows .github/workflows edits the issue needs (not shepherd-*.yml); "
                "review the workflow diff extra carefully.\n" if standing_workflows(state) else "")
             + f"\n{tpl}\n")
    return {"worktree": None, "branch": None, "plan": None, "brief": brief}


def direct_launches(b: dict, snap: dict, dry_run: bool = False) -> list[str]:
    """Launch, with no model tick, the gate's launch picks that need no brief written (direct_spec), in pick order;
    stop at the first pick that needs the model so priority is kept. Same slot, pace and PR-hold rules as gate()."""
    state = load_state()
    if state.get("workers_paused"):
        return []
    if not dry_run:
        with edit_state() as st:  # held plans age out; the first run seeds them from the runs dir
            cut = now() - dt.timedelta(hours=HELD_PLAN_MAX_H)
            if "held_plans" not in st:
                st["held_plans"] = {}
                for d in RUNS.glob("*/plan_held"):
                    m = _run_meta(d.parent.name)
                    if m.get("status") == "plan-held" and not m.get("repo") and (d.parent / "plan.md").exists():
                        st["held_plans"][d.parent.name] = {"issue": m.get("issue"), "t": m.get("finished") or iso(now()),
                                                           "task": m.get("task"),
                                                           "files": plan_files((d.parent / "plan.md").read_text())}
            st["held_plans"] = {k: v for k, v in st["held_plans"].items() if (t := parse_iso(v.get("t"))) and t > cut}
        state = load_state()
    plan = rate_plan(state)
    live = claude_slot_holders(state)
    free = worker_slots(b, len(live), slot_ceiling(state, plan))
    mode = state.get("ci_mode", "calm")
    if mode == "busy" and not free and b.get("verdict") == "GREEN" and b.get("free_slots", 0) >= 1:
        free = 1  # backfill takes no Claude slot
    did: list[str] = []
    for _, x in budget_picks(state, snap, mode, max(free, 0), plan):
        spec = direct_spec(state, snap, x)
        if spec is None:
            break
        if spec.get("worktree") and held_by_live(state, Path(spec["worktree"]), x.get("task") or ""):
            continue  # a live run already has this PR (#20): the next pick may still go
        if x.get("lane") != "backfill" and not worker_slots(b, len(live) + len(did), slot_ceiling(state, plan)):
            break
        if not x.get("pr") and x.get("lane") != "backfill" and len(prs_needing_work(snap, live, state)) >= 3:
            break  # gate's "finish those first" hold
        ok, _ = (True, "") if plan else pace_allows(state, x.get("model", "sonnet"))
        if not ok:
            break
        what = (f"PR fix #{x['pr']}" + (" (warm resume)" if spec.get("resume_run") else " (regraft)" if spec.get("fresh")
                                        else "") if x.get("pr") else "backfill resume" if spec.get("lane") else
                f"held plan {spec['held_plan']}" if spec.get("held_plan") else "new issue, gate brief")
        did.append(f"#{x['issue']} ({what})")
        if dry_run:
            continue
        try:
            with contextlib.redirect_stdout(open(os.devnull, "w")):
                if spec.get("resume_run"):
                    cmd_worker(argparse.Namespace(resume_run=spec["resume_run"], message=spec["brief"], force=False,
                                                  plan=False))
                else:
                    if spec.get("fresh"):
                        wt, branch = new_worktree(x["issue"], now().strftime("%Y%m%dT%H%MZ") + "-regraft")
                        spec.update(worktree=str(wt), branch=branch,
                                    brief=f"Your working directory {wt} is a fresh git worktree, on branch {branch} off "
                                          f"current origin/main. Handoff notes go in {H}.\n\n{spec['brief']}")
                    cmd_worker(argparse.Namespace(resume_run=None, issue=x["issue"], model=x.get("model", "sonnet"),
                                                  task=x.get("task"), brief=spec["brief"], brief_file=None, force=False,
                                                  plan=spec["plan"], worktree=spec["worktree"], branch=spec.get("branch"),
                                                  check_of=None, repo=spec.get("repo"), lane=spec.get("lane")))
        except (SystemExit, OSError, RuntimeError) as e:  # a cap / missing tree: leave the item to the model tick
            did.pop()
            log(f"direct launch of #{x['issue']} refused, left queued for the tick: {str(e)[:200]}")
            break
        with edit_state() as st:
            q = st.get("queue", [])
            with contextlib.suppress(ValueError):
                q.remove(x)
            if spec.get("held_plan"):
                st.get("held_plans", {}).pop(spec["held_plan"], None)
        state = load_state()
    return did


BOX_HELD_ALERT_H = 2  # #31: a box non-GREEN this long with work queued and no worker running pages the owner once


def note_box(state: dict, b: dict) -> None:
    """A box that stays non-GREEN blocks every launch: say why in churn-log (not just the quiet log) after two ticks in a
    row, and at once when box_status names a probable stray (#4930: a stray `find /` held it YELLOW for 40 min)."""
    verdict = b.get("verdict")
    with edit_state() as st:
        streak = st.get("box_streak", {})
        same = streak.get("verdict") == verdict
        streak = {"verdict": verdict, "ticks": streak.get("ticks", 0) + 1 if same else 1,
                  "logged": streak.get("logged") if same else False,
                  "since": (streak.get("since") if same else None) or iso(now())}
        strays = b.get("strays") or []
        if verdict != "GREEN" and not streak["logged"] and (streak["ticks"] >= 2 or strays):
            why = "; ".join(b.get("reasons", []))[:300]
            log(f"box {verdict} for {streak['ticks']} tick(s), launches held: {why}"
                + (f" | culprit: {b['culprit']}" if b.get("culprit") else "")
                + ("" if not strays else " | probable strays: " + ", ".join(f"pid {x['pid']} ({x['age_min']} min) {x['cmd'][:60]}" for x in strays)))
            streak["logged"] = True
        held = now() - (parse_iso(streak["since"]) or now())
        page = (verdict != "GREEN" and held >= dt.timedelta(hours=BOX_HELD_ALERT_H) and not claude_slot_holders(st)
                and launchable(st, None))
        if verdict == "GREEN" and st.get("box_streak", {}).get("logged"):
            log(f"box GREEN again after {st['box_streak'].get('ticks')} {st['box_streak'].get('verdict')} tick(s)")
        st["box_streak"] = streak
        state["box_streak"] = streak
    if page:  # outside the state lock: a slow ntfy must not hold it
        notify(f"box-held-{verdict}-{streak['since']}", f"churn: box {verdict} {held.total_seconds() / 3600:.0f} h, nothing running",
               f"{page} queued item(s) wait. Why: " + "; ".join(b.get("reasons", []))[:600], priority="high",
               cooldown_h=24, tags="hourglass")


