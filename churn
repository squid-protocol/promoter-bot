    w.add_argument("--branch", help="the branch of --worktree")
    w.add_argument("--repo", choices=sorted(CRUCIBLE_REPOS), help="work in a worktree of this crucible repo (backfill steps)")
    w.add_argument("--allow-workflows", action="store_true",
                   help="confirm the owner's workflow-edit grant for --issue (refused when there is none)")
    w.add_argument("--plan", action=argparse.BooleanOptionalAction, default=None,
                   help="plan-mode phase + impact check before implementing (default: state features.plan_first)")
    ag = sub.add_parser("agy", help="start one detached agy worker (own quota; a Sonnet checker follows)")
    ag.add_argument("--issue", type=int, required=True)
    ag.add_argument("--task")
    ag.add_argument("--model", help="agy model (default state agy.model)")
