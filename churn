def capped_backfills(state: dict | None) -> list[dict]:
    return [r for r in (state or {}).get("running", []) if r.get("lane") == "backfill" and r.get("cpu_quota")
            and r.get("run_id") and pid_alive(r.get("pid"))]


def psi_avg60(path: Path) -> float | None:
    with contextlib.suppress(OSError, ValueError, IndexError, StopIteration):
        line = next(x for x in path.read_text().splitlines() if x.startswith("some"))
        return float(line.split("avg60=")[1].split()[0])
    return None


def capped_pressure(state: dict | None) -> float:
    """CPU pressure (PSI some avg60) that a CPU-capped backfill worker explains: its tasks wait on its own quota, which
    the system PSI counts as 'waiting for a core' although the other cores are free (2026-10-14: system 73% = the capped
    unit's 78%, system 'full' 0). Discount it only when the system figure is within 10 points of the unit's."""
    sys_psi = psi_avg60(Path("/proc/pressure/cpu"))
    units = [psi_avg60(CGROUP_APP / f"churn-{r['run_id']}.service" / "cpu.pressure") for r in capped_backfills(state)]
    units = [u for u in units if u is not None]
    if sys_psi is None or not units or sys_psi - max(units) > 10:
        return 0.0
    return min(sys_psi, max(units))


def runnable_tasks(cg: Path) -> int:
    """Threads in state R anywhere under a cgroup (a throttled task stays R and counts in load1)."""
    n = 0
    for d, _, files in os.walk(cg):
        if "cgroup.threads" not in files:
            continue
        with contextlib.suppress(OSError):
            for tid in (Path(d) / "cgroup.threads").read_text().split():
                with contextlib.suppress(OSError, IndexError):
                    n += (Path("/proc") / tid / "stat").read_text().rsplit(")", 1)[1].split()[0] == "R"
    return n


def capped_load(state: dict | None) -> float:
    """load1 a capped backfill adds beyond the cores its quota lets it use: those tasks queue on the quota, not on the
    other cores (2026-10-14: load1 24-36 with 1-2 normal workers running)."""
    extra = 0.0
    for r in capped_backfills(state):
        cores = int(r["cpu_quota"].rstrip("%")) / 100 if r["cpu_quota"].rstrip("%").isdigit() else 0
        extra += max(0.0, runnable_tasks(CGROUP_APP / f"churn-{r['run_id']}.service") - cores)
    return extra


def capped_worktrees(state: dict | None) -> list[str]:
    """box_status's holder tags (wt:<worktree dir>) of the CPU-capped backfill workers."""
    out = []
    for r in capped_backfills(state):
        with contextlib.suppress(OSError, ValueError, KeyError):
            out.append("wt:" + Path(json.loads((RUNS / r["run_id"] / "meta.json").read_text())["worktree"]).name)
    return out


def box(state: dict | None = None) -> dict:
    state = state if state is not None else (load_state() if STATE.exists() else None)
    adj, capped, ladj = capped_pressure(state), capped_worktrees(state), capped_load(state)
    if adj > 0 or capped or ladj > 0:
        r = run([sys.executable, "-c", _BOX_ADJ, str(TOOLS / "tests/tools/box"), str(adj), ",".join(capped), str(ladj)],
                timeout=60)
    else:
        r = run([sys.executable, str(TOOLS / "tests/tools/box/box_status.py"), "--json"], timeout=60)
    try:
        out = json.loads(r.stdout)
    except json.JSONDecodeError:
        return {"verdict": "RED", "free_slots": 0, "reasons": [f"box_status failed: {r.stderr.strip()[:120]}"]}
    if adj > 0:
        out.setdefault("reasons", []).append(f"CPU pressure {out.get('cpu_psi_raw')}% minus {adj:.0f} from the capped "
                                             "backfill worker (its own quota)")
    if ladj > 0:
        out.setdefault("reasons", []).append(f"load1 {out.get('load1_raw', 0):.1f} minus {ladj:.0f} queued on the capped "
                                             "backfill worker's quota")
    if out.get("slots_lent_by_backfill"):
        out.setdefault("reasons", []).append(f"{out['slots_lent_by_backfill']} heavy slot(s) held by the capped backfill "
                                             "worker counted free")
    return out


def worker_slots(b: dict, running: int, max_workers: int = 2) -> int:
    """How many MORE Claude workers may start: GREEN only, never more than the box's free heavy slots (box_status
    already counts the load of the running ones), never past state.max_workers (owner 2026-10-14: 2). YELLOW only
    allows a light item when nothing runs, which needs judgment, so it counts as 0 here."""
    if b.get("verdict") != "GREEN":
        return 0
    return max(0, min(max_workers - running, int(b.get("free_slots", 0))))


