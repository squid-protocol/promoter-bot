First: `git -C {repo_dir} fetch -q origin && git show origin/main:.claude/agents/gitgalaxy-pr-worker.md`
and follow it. Then check agy's work like a strict reviewer:
1. Read the issue and `git diff origin/main...HEAD` plus any uncommitted changes. Does it do what the issue asks,
   for the WHOLE input class (owner rule)? Any loosened proof, hand-edited golden/generated file, deleted test,
   unrelated churn, or invented IBM behaviour without a source? agy often over-claims in its report: verify each
   claim by running it. Golden-master changes are valid ONLY if regenerated with
   `tests/tools/crucible_check.py --update --yes` (+ `scope_check.py --expect`): re-run that yourself and require an
   identical result.
2. Fix what is small and clear yourself (commit on top, say so). If the approach is wrong, don't rescue it: report
   REJECT with why, push the branch as is for the record, and open no PR.
3. Run `pr_gates --fast` and `--ratchets` (python {python}; heavy runs via
   heavy-run.sh, golden via golden-lock.sh per the box-capacity skill). Merge origin/main if behind (never rebase).
4. PASS -> push, open a DRAFT PR (title + body say "agy-authored, Sonnet-checked"), no labels. Don't wait on CI: drafts run
   only the cheap audits (#5104); the full CI runs after the tick's review.
5. FINAL message = report: verdict PASS / FIXED (what you fixed) / REJECT (why); PR number; class + Sibling gaps;
   gates and results. Attribution lines as your system reminder gives them, verbatim.
"""


def cmd_agy(a) -> int:
    stamp = now().strftime("%Y%m%dT%H%MZ")
    with state_lock():
        state = load_state()
        cfg = agy_cfg(state)
        if not agy_installed():
            raise SystemExit(f"agy lane unavailable: {cfg['off_why']}")
        live = [r for r in state.get("running", []) if r.get("backend") == "agy" and pid_alive(r.get("pid"))]
        if not a.force and len(live) >= cfg["max_running"]:
            raise SystemExit(f"{len(live)} agy worker(s) already running (cap {cfg['max_running']}); --force to override")
    wt, branch = make_worktree(a.issue, stamp)
    prompt = Path(a.brief_file).read_text() if a.brief_file else AGY_BRIEF.format(
        issue=a.issue, wt=wt, branch=branch, task=a.task or "see the issue", repo=REPO, repo_dir=V6, python=SELFSCAN_PY)
    run_id = f"{a.issue}-{stamp}-agy"
    rd = RUNS / run_id
    rd.mkdir(parents=True, exist_ok=False)
    (rd / "prompt.md").write_text(prompt)
    meta = {"run_id": run_id, "backend": "agy", "issue": a.issue, "model": a.model or cfg["model"], "task": a.task or "",
            "worktree": str(wt), "branch": branch, "started": iso(now())}
    (rd / "meta.json").write_text(json.dumps(meta, indent=2))
    meta["pid"] = spawn_detached(f"churn-{run_id}", [sys.executable, SELF, "_agyrun", run_id], wt, rd / "wrapper.log")
    (rd / "meta.json").write_text(json.dumps(meta, indent=2))
    with edit_state() as state:
        state.setdefault("running", []).append(
            {"agent": f"agy {run_id}", "run_id": run_id, "backend": "agy", "pid": meta["pid"], "issue": a.issue,
             "model": meta["model"], "started": meta["started"], "task": (a.task or "")[:200]})
    log(f"launched agy worker {run_id} (#{a.issue}, {meta['model']}) pid {meta['pid']} in {wt}")
    print(json.dumps({"run_id": run_id, "pid": meta["pid"], "worktree": str(wt), "branch": branch}))
    return 0


def cmd_agyrun(a) -> int:
    rd = RUNS / a.run_id
    meta = json.loads((rd / "meta.json").read_text())
    cfg = agy_cfg(load_state())
    env = {**plan_env(), "PYTHONPATH": meta["worktree"], "AGY_MODEL": meta["model"],
           "AGY_MODE": "accept-edits", "AGY_ADD_DIR": meta["worktree"], "AGY_TIMEOUT": str(cfg["timeout_s"]),
           "AGY_RUN_DIR": str(rd)}
    rc = 1
    try:
        with open(rd / "wrapper.out", "w") as fh:
            rc = subprocess.call([AGY_WORKER, "agy", f"@{rd / 'prompt.md'}"], cwd=meta["worktree"], env=env,
                                 stdin=subprocess.DEVNULL, stdout=fh, stderr=subprocess.STDOUT)
    finally:
        (rd / "exit").write_text(f"{rc}\n{iso(now())}\n")
        DIRTY.touch()
        nudge_tick()
    return 0


AGY_CONV = Path.home() / ".gemini/antigravity-cli/conversations"


def agy_denied_call(rd: Path) -> str:
    """The tool + last command agy tried before a headless soft-denial (its log names only the tool; the command is
    in the conversation DB). Best effort: '' when it can't be found."""
    import sqlite3
    log_text = (rd / "agy.log").read_text(errors="ignore") if (rd / "agy.log").exists() else ""
    tool = (re.findall(r'soft-denying tool confirmation "(\w+)"', log_text) or [""])[-1]
    conv = (re.findall(r"conversation ([0-9a-f-]{36}) step", log_text) or [""])[-1]
    db = AGY_CONV / f"{conv}.db"
    if not tool or not conv or not db.exists():
        return tool
    try:
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        blob = []
        for (t,) in con.execute("SELECT name FROM sqlite_master WHERE type='table'"):
            for row in con.execute(f'SELECT * FROM "{t}"'):
                blob += [v.decode("utf-8", "ignore") if isinstance(v, bytes) else v for v in row if isinstance(v, (bytes, str))]
        con.close()
    except sqlite3.Error:
        return tool
    text = "\n".join(blob)
    pat = (r'"Url"\s*:\s*"(https?://[^"]{4,300})"' if tool == "ReadUrlContent" else
           r'(?:CommandLine|commandLine|command_line)"?\s*[:=]\s*"((?:[^"\\]|\\.){1,300})"')
    hits = re.findall(pat, text)
    return f"{tool}: {hits[-1][:300]}" if hits else tool


def reap_agy(state: dict, r: dict) -> dict:
    rid = r["run_id"]
    rd = RUNS / rid
    meta = json.loads((rd / "meta.json").read_text())
    rc = int(((rd / "exit").read_text().split() or ["1"])[0]) if (rd / "exit").exists() else -1
    out = (rd / "agy.out").read_text() if (rd / "agy.out").exists() else ""
    err = (rd / "agy.err").read_text() if (rd / "agy.err").exists() else ""
    commits = run(["git", "-C", meta["worktree"], "log", "--oneline", "origin/main..HEAD"]).stdout.strip()
    dirty = run(["git", "-C", meta["worktree"], "status", "--porcelain"]).stdout.strip()
    agy = state.setdefault("agy", {})
    if rc != 0 and AGY_LIMIT_RE.search(err + "\n" + out[-2000:]):
        status = "limit"
        agy["paused_until"] = iso(now() + dt.timedelta(hours=1))
        agy.setdefault("limit_hits", []).append({"t": iso(now()), "run_id": rid})
    elif rc == 3:
        status = "denied"
    elif rc == 124:
        status = "timeout"
    elif rc == -1:
        status = "crashed"
    elif rc != 0:
        status = "error"
    elif not commits and not dirty:
        status = "no-change"
    else:
        status = "done"
    meta.update(status=status, finished=iso(now()), exit=rc)
    (rd / "meta.json").write_text(json.dumps(meta, indent=2))
    (rd / "report.md").write_text(
        f"# agy run {rid} (#{r['issue']}, {meta['model']}): {status}\n\nexit {rc}, branch {meta['branch']}, worktree "
        f"{meta['worktree']}\n\n## Commits\n```\n{commits or '(none)'}\n```\n## Uncommitted\n```\n{dirty or '(none)'}\n```\n"
        + (f"\n## stderr (tail)\n```\n{err[-2000:]}\n```\n" if err.strip() and status != "done" else "")
        + f"\n## agy's final report\n\n{out[-6000:] or '(none)'}\n")
    if status == "denied" and (what := agy_denied_call(rd)):
        with open(rd / "report.md", "a") as fh:
            fh.write(f"\n## Refused call (from agy's conversation)\n```\n{what}\n```\n")
    state.setdefault("usage", {}).setdefault("log", []).append(
        {"t": iso(now()), "model": f"agy-{meta['model']}", "tokens": 0, "issue": r["issue"], "run_id": rid})
    return {"run_id": rid, "issue": r["issue"], "model": meta["model"], "backend": "agy", "status": status,
            "report": str(rd / "report.md"), "review_model": "sonnet"}


def reap(state: dict) -> list[dict]:
    """Move finished churn workers from `running` to `reports_pending`; ledger + limit detection."""
    done, keep = [], []
    for r in state.get("running", []):
        rid = r.get("run_id")
        if not rid:  # hand-tracked or legacy entries: the model handles those
            keep.append(r)
            continue
        rd = RUNS / rid
        if not (rd / "exit").exists() and pid_alive(r.get("pid")):
            keep.append(r)
            continue
        if r.get("backend") == "agy":
            entry = reap_agy(state, r)
            state.setdefault("reports_pending", []).append(entry)
            done.append(entry)
            continue
        out = {}
        with contextlib.suppress(Exception):
            out = json.loads((rd / "out.json").read_text())
        err = (rd / "err.txt").read_text() if (rd / "err.txt").exists() else ""
        result = str(out.get("result") or "")
        cost, tokens = run_cost(out)
        meta = json.loads((rd / "meta.json").read_text())
        held = (rd / "plan_held").exists()
        credit = r.get("lane") == "credit"
        # out.json is the session's total: it includes the plan phase (phase 2 resumes it; a held or failed plan's
        # out.json IS the plan's) and, on a resume, the runs before. Keep the total, log only this run's part.
        session_cost = max(cost, float(meta.get("plan_cost_usd") or 0))
        cost = max(0.0, session_cost - float(meta.get("resume_base_usd") or 0))
        denials = out.get("permission_denials") or []
        if (rd / "preempted").exists():
            status = "preempted"
        elif not out:
            status = "crashed"
        elif held:
            status = "plan-held"
        elif credit and (cf := credit_failure(out, result + "\n" + err)):
            status = cf
            credit_hold(state, status, rid, result + "\n" + err)
        elif out.get("is_error") and AUTH_RE.search(result + "\n" + err):
            status = "crashed"
            auth_alert(result + "\n" + err, f"worker {rid}")
        elif out.get("is_error") and OFFLINE_RE.search(result + "\n" + err):
            status = "offline"
        elif (reset := (limit_reset(result + "\n" + err) if (out.get("is_error") or out.get("api_error_status") == 429) else None)):
            status = "limit"
            record_limit(state, reset, f"worker {rid}", result + "\n" + err)
        elif out.get("subtype") == "error_max_budget_usd" or "budget" in str(out.get("terminal_reason", "")):
            status = "budget"
        elif out.get("is_error"):
            status = "error"
        elif denials:
            status = "denied"
        else:
            status = "done"
        track_failures(state, status, rid, result + "\n" + err)
        pr = None
        if status != "plan-held" and not meta.get("repo") and Path(meta["worktree"]).is_dir():
            # the branch the worker really used (it may rename it) and its open PR: a requeue or relaunch must name them
            branch, pr = worktree_pr(meta["worktree"], r["issue"])
            meta["branch"] = branch or meta["branch"]
            if (changed := own_commits(meta["worktree"], meta.get("head_start"))) is not None:
                meta["code_changed"] = changed
        meta.update(session_id=out.get("session_id"), status=status, cost_usd=round(cost, 2), finished=iso(now()), pr=pr,
                    session_cost_usd=round(session_cost, 4))
        if pr and not meta.get("repo") and all(pr_num(p) != pr for p in state.get("prs", [])):
            # 2026-10-16 audit: only the model's `pr watch` made a PR visible; a review that skipped it left the PR with no
            # fix items, review needs or followups
            state.setdefault("prs", []).append({"number": pr, "issue": r["issue"]})
            log(f"PR #{pr} watch (auto, from run {rid})")
        (rd / "meta.json").write_text(json.dumps(meta, indent=2))
        (rd / "report.md").write_text(
            f"# churn run {rid} (#{r['issue']}, {r['model']}): {status}\n\n"
            f"cost ${cost:.2f}, {out.get('num_turns', '?')} turns, session {out.get('session_id')}, "
            f"branch {meta['branch']}, worktree {meta['worktree']}"
            + (f", open PR #{pr} (a requeue is a PR item: `churn queue --pr {pr}`; never a second PR)" if pr else "")
            + "\n"
            + (f"\n## Plan held: file overlap with a live worker\n```\n{(rd / 'plan_held').read_text()}\n```\n"
               f"Plan: {rd / 'plan.md'}; impact: {rd / 'plan.json'}. Approve with `churn send-back {rid} \"Plan approved: "
               "implement it\"` (session is warm for ~1 h), or requeue.\n" if held else "")
            + (f"\nPlanned first: plan {rd / 'plan.md'}, impact {rd / 'plan.json'}\n" if meta.get("plan") and not held else "")
            + (f"\n## Permission denials\n```\n{json.dumps(denials, indent=1)[:4000]}\n```\n" if denials else "")
            + (f"\n## stderr (tail)\n```\n{err[-2000:]}\n```\n" if err.strip() and status != 'done' else "")
            + f"\n## Worker's final report\n\n{result or '(none)'}\n")
        # a credit run's cost is API credit, not plan usage: its own ledger, so pacing never learns from it
        (state.setdefault("credit", {}) if credit else state.setdefault("usage", {})).setdefault("log", []).append(
            {"t": iso(now()), "model": r["model"], "tokens": tokens, "cost_usd": round(cost, 2), "issue": r["issue"], "run_id": rid,
             **({"started": r["started"]} if r.get("started") else {})})
        entry = {"run_id": rid, "issue": r["issue"], "model": r["model"], "status": status, "report": str(rd / "report.md"),
                 **({"pr": pr} if pr else {}), **({"repo": meta["repo"]} if meta.get("repo") else {})}
        rh = next((str(p.get("reviewed_head") or "") for p in state.get("prs", [])
                   if isinstance(p, dict) and pr and pr_num(p) == pr), "")
        if status == "done" and pr and rh and (why := small_delta(meta["worktree"], rh)):
            entry.update(review_model="sonnet", review_why=why)  # a re-review of a small change: Sonnet, not Opus
        if status == "done" and pr and not meta.get("repo") and not meta.get("check_of"):
            entry.update(precheck="pending", precheck_at=iso(now()))
            start_precheck(rid)
        if meta.get("check_of"):  # agy work checked by Sonnet: a Sonnet tick does the merge review (owner 2026-10-12)
            entry.update(check_of=meta["check_of"], review_model="sonnet")
        if status.startswith("credit-"):  # billing, not the work: the item goes back for the plan (or credit) to run
            orig = dict(meta.get("queue_item") or {"issue": r["issue"], "model": "sonnet", "needs_owner": False,
                                                     "task": str(r.get("task") or "")})
            if Path(meta["worktree"]).is_dir() and branch_files(meta["worktree"]):
                orig["task"] = (f"RESUME credit run {rid} ({status} {iso(now())}): same worktree {meta['worktree']} / "
                                f"branch {meta['branch']}; read its handoff note, keep uncommitted edits, continue. "
                                f"{str(orig.get('task') or '')[:300]}")
            if pr:
                orig["pr"] = pr
            state.setdefault("queue", []).insert(0, orig)
        elif status == "offline" and r.get("lane") != "experiment":  # nothing to review: requeue the same work
            item = {"issue": r["issue"], "model": r.get("model", "sonnet"), "needs_owner": False,
                    "task": (f"RESUME run {rid} (lost the network {iso(now())}): same worktree {meta['worktree']} / "
                             f"branch {meta['branch']}; read its handoff note, keep uncommitted edits, continue. "
                             f"{str(r.get('task') or '')[:300]}"),
                    **({"lane": r["lane"]} if r.get("lane") else {}), **({"pr": pr} if pr else {}),
                    **({"repo": meta["repo"]} if meta.get("repo") else {})}
            state.setdefault("queue", []).insert(0, item)
            state.setdefault("offline", {})["requeued"] = int(state.get("offline", {}).get("requeued", 0)) + 1
        elif status != "preempted" and r.get("lane") != "experiment":  # preempted: resumes from its queue item;
            state.setdefault("reports_pending", []).append(entry)  # an experiment run is read by experiment_lane
        if held and not meta.get("repo"):  # its plan's files gate the requeued item with no new plan run
            with contextlib.suppress(OSError):
                state.setdefault("held_plans", {})[rid] = {"issue": r["issue"], "t": iso(now()), "task": meta.get("task"),
                                                          "files": plan_files((rd / "plan.md").read_text())}
        done.append(entry)
    state["running"] = keep
    return done


# ---------------------------------------------------------------- PR snapshot
PR_FIELDS_GQL = ("number state merged headRefOid headRefName mergeStateStatus body "
                 "labels(first: 40) { nodes { name } }")


def prs_graphql(nums: list[int], batch: int = 40) -> dict[int, dict]:
    """#64: the watched PRs in one GraphQL query per `batch` (the separate GraphQL quota), shaped like the REST pull
    object pr_snapshot reads. 2026-10-24: one REST call per watched PR per gate run was ~33 of a gate's ~60 calls, at
    16-24 gate runs an hour. Missing PRs are left out (the caller falls back to REST for them)."""
    owner, name = REPO.split("/")
    out: dict[int, dict] = {}
    for i in range(0, len(nums), batch):
        part = nums[i: i + batch]
        q = "query { repository(owner: %s, name: %s) { %s } }" % (
            json.dumps(owner), json.dumps(name), " ".join(f"p{n}: pullRequest(number: {n}) {{ {PR_FIELDS_GQL} }}" for n in part))
        r = run(["gh", "api", "graphql", "-f", f"query={q}"], timeout=60)
        if r.returncode:
            continue
        repo = (json.loads(r.stdout).get("data") or {}).get("repository") or {}
        for n in part:
            g = repo.get(f"p{n}")
            if g:
                out[n] = {"state": "open" if g["state"] == "OPEN" else "closed", "merged": g["state"] == "MERGED",
                          "head": {"sha": g["headRefOid"], "ref": g["headRefName"]},
                          "mergeable_state": str(g.get("mergeStateStatus") or "unknown").lower(), "body": g.get("body"),
                          "labels": [{"name": x["name"]} for x in (g.get("labels") or {}).get("nodes") or []]}
    return out


def pr_snapshot(prs: list[int], old: dict) -> dict:
    snap = {}
    nums = [pr_num(p) for p in prs]
    try:
        bulk = prs_graphql(nums)
    except (OSError, ValueError, subprocess.TimeoutExpired):
        bulk = {}
    for n in nums:
        try:
            p = bulk.get(n) or gh_json(f"repos/{REPO}/pulls/{n}")
        except RuntimeError as e:
            snap[str(n)] = old.get(str(n), {"error": str(e)[:80]})
            continue
        ms = p.get("mergeable_state")
        if ms in (None, "unknown"):
            ms = old.get(str(n), {}).get("mergeable_state", "unknown")
        snap[str(n)] = {"state": p["state"], "merged": p.get("merged", False), "head": p["head"]["sha"][:12],
                        "mergeable_state": ms, "labels": sorted(lbl["name"] for lbl in p.get("labels", [])),
                        "branch": p["head"].get("ref", ""), "closes": bool(CLOSES_RE.search(p.get("body") or "")),
                        **pr_checks(p.get("body") or "")}
    return snap


def pr_checks(body: str) -> dict:
    """{"checks": [[status, key, what is left], ...], "check": the first [status, key]} for the PR body's `Checklist:`
    lines, or {} (#20: one PR may report several lines, and #5587's marker sat mid-line after "Part of #n.")."""
    found = [[m.group(1).lower(), m.group(2), m.group(3).strip(" -:—")[:300]] for m in PR_CHECK_RE.finditer(body)]
    return {"checks": found, "check": found[0][:2]} if found else {}


CLOSES_RE = re.compile(r"\b(?:close[sd]?|fix(?:e[sd])?|resolve[sd]?)\s+#\d+", re.I)
_OPEN_CACHE: dict[int, bool] = {}


def pr_is_open(n: int, snap: dict | None) -> bool:
    """after_prs gating: from the snapshot if watched, else one gh call per tick (unknown -> treated as open)."""
    v = (snap or {}).get(str(n))
    if v and "state" in v:
        return v["state"] == "open"
    if n not in _OPEN_CACHE:
        try:
            _OPEN_CACHE[n] = gh_json(f"repos/{REPO}/pulls/{n}").get("state") == "open"
        except RuntimeError:
            return True
    return _OPEN_CACHE[n]


WAIT_MAX_H = 6  # a wait never strands an item: after this the gate offers it again
_RUN_DONE: dict[int, bool] = {}


FOCUS_WAIT_MAX_MIN = 30


def waiting(q: dict) -> str | None:
    """Why item q is still waiting (`churn queue wait`), or None. 2026-10-16: the gate named #5133's fix every tick
    while it waited on a main ground-truth run; each Sonnet tick declined it again (~$0.13 a time). A tick now records
    the wait once; the gate checks it with no model -- a time, or a GitHub Actions run that must complete."""
    set_at = parse_iso(q.get("wait_set"))
    if set_at and now() - set_at > dt.timedelta(hours=WAIT_MAX_H):
        return None
    until = parse_iso(q.get("wait_until"))
    if until and now() < until:
        return f"until {iso(until)}"
    if (wk := q.get("wait_worker")) and not _run_meta(str(wk)).get("finished") and (RUNS / str(wk)).is_dir():
        return f"worker {wk}"
    rid = q.get("wait_run")
    if rid:
        if rid not in _RUN_DONE:
            try:
                _RUN_DONE[rid] = gh_json(f"repos/{REPO}/actions/runs/{rid}").get("status") == "completed"
            except RuntimeError:
                _RUN_DONE[rid] = False  # unreadable: keep waiting; WAIT_MAX_H still releases it
        if not _RUN_DONE[rid]:
            return f"run {rid}"
    return None


def blocked_by(q: dict, snap: dict | None, state: dict | None = None) -> list[int]:
    """after_prs still blocking: open, and (when the state is known) not approved at its current head. An approved PR
    only waits for CI / the shepherd, so its code is final: later work may start and merge main before it pushes
    (owner 2026-10-14: five items waited behind one approved PR that was merely BEHIND)."""
    out = []
    for n in q.get("after_prs", []):
        if not pr_is_open(n, snap):
            continue
        v = (snap or {}).get(str(n), {})
        if state is not None and v and not q.get("after_merge") and verdict_at_head(state, str(n), v) == "merge" \
                and "shepherd:needs-fix" not in v.get("labels", []) and v.get("mergeable_state") != "dirty":
            continue  # after_merge (owner 2026-10-14): the item branches off main AFTER the PR lands, so approval isn't enough
        out.append(n)
    return out


# ---------------------------------------------------------------- reconcile (level-triggered)
# Owner 2026-10-13: the gate used to react to snapshot DIFFS and remember "seen" heads, so a PR noticed once and not
# acted on (no free slot) vanished. Now every tick derives what each watched PR needs from the whole current state;
# a need stays until the state shows it met (reviewed_head == head, followup done, PR fixed) -- or it stalls after
# STALL_AFTER model ticks and waits for the owner.
STALL_AFTER = 3


def settle_closed(state: dict, snap: dict) -> list[str]:
    """Drop merged/closed PRs from the watch list. A merge that says "Fixes #n" needs nothing more (GitHub closes the
    issue); a "Part of" merge or an unmerged close becomes a followup the tick must clear (`churn followup done`)."""
    notes, keep = [], []
    have = {f["pr"] for f in state.get("followups", [])}
    for p in state.get("prs", []):
        n = pr_num(p)
        v = snap.get(str(n), {})
        if v.get("state") in (None, "open"):
            keep.append(p)
            continue
        issue = p.get("issue") if isinstance(p, dict) else None
        m = re.match(r"churn/(\d+)-", v.get("branch", ""))
        owner = issue or (int(m.group(1)) if m else None)  # #20: an entry without its issue (mark_flake, ints) settles
        checks = v.get("checks") or ([[*v["check"], ""]] if v.get("check") else [])
        if v.get("merged") and owner and checks and not v.get("closes") and (
                note := "; ".join(x for c in checks if (x := settle_check(state, int(owner), n, *c)))):
            notes.append(note)  # the box records it: no followup for the tick
        elif v.get("merged") and v.get("closes"):
            notes.append(f"merged #{n} (closes its issue itself)")
        elif n not in have:
            kind = "merged" if v.get("merged") else "closed"
            state.setdefault("followups", []).append({"pr": n, "kind": kind, "issue": issue, "since": iso(now())})
            if kind == "merged" and issue and int(issue) == int((focus_cfg(state).get("ladder") or {}).get("anchor") or 0):
                state.setdefault("goal", {})["measure_due"] = True  # a ladder PR moved the levels: slice from fresh numbers
            notes.append(f"{kind} #{n} -> followup" + (f" (issue #{issue})" if issue else ""))
    state["prs"] = keep
    return notes


def settle_check(state: dict, issue: int, pr: int, status: str, key: str, left_text: str = "") -> str | None:
    """A merged PR that reported `Checklist: done|partial [c:key]`: tick the line (done) or say on the issue what the
    slice delivered (partial; #20: epics showed 0 of 8 while their slices merged), and for a core issue queue its
    next unclaimed line (or the same one, partial) right away. None = not settled here: the old followup, e.g. every line
    is now ticked (the tick closes the issue), the line was edited away, or the issue cannot be read."""
    try:
        i = gh_json(f"repos/{REPO}/issues/{issue}")
    except (RuntimeError, ValueError):
        return None
    body = i.get("body") or ""
    if i.get("state") != "open" or not any(c["key"] == key for c in checklist(body)):
        return None
    note = f"merged #{pr}: checklist [c:{key}] of #{issue} {status}"
    if status == "done" and (new := tick_line(body, key, pr)) is not None:
        r = run(["gh", "api", "-X", "PATCH", f"repos/{REPO}/issues/{issue}", "--input", "-"],
                input=json.dumps({"body": new}))
        if r.returncode:
            return None
        body = new
        note += ", ticked"
    elif status == "partial":
        line = next(c["text"] for c in checklist(body) if c["key"] == key)
        msg = (f"#{pr} merged: a partial slice of [c:{key}] \"{line[:200]}\""
               + (f"; left: {left_text}" if left_text else "") + " (promoter-bot)")
        if not run(["gh", "api", "-X", "POST", f"repos/{REPO}/issues/{issue}/comments", "-f", f"body={msg}"]).returncode:
            note += ", commented"
    left = [c for c in checklist(body) if not c["done"]]
    if not left:
        return None
    note += f", {len(left)} left"
    i["body"] = body
    if (not state.get("workers_paused") and in_focus(state, {"issue": issue})
            and issue != ladder_anchor(state)  # the ladder refill slices it by estate
            and not foreign_claim(i) and not host_skips(i)
            and not any(x.get("issue") == issue for s in ("queue", "running") for x in state.get(s, []))
            and (c := next_check(i, state))):
        state.setdefault("queue", []).append(refill_item(i, check=c))
        note += f"; queued next line [c:{c['key']}]"
    return note


def reviews_needed(state: dict, snap: dict, live: list[dict]) -> dict[str, str]:
    """{pr: why} for watched open PRs that need a review at their CURRENT head: shepherd:reapprove, or no
    shepherd:merge, and not yet reviewed at this head (`churn pr reviewed`). Conflicts/needs-fix go to the queue."""
    entries = {pr_num(p): p for p in state.get("prs", [])}
    out = {}
    for n, v in snap.items():
        if v.get("state") != "open" or "head" not in v or pr_in_hand(n, v, live):
            continue
        labels = set(v.get("labels", []))
        if v.get("mergeable_state") == "dirty" or "shepherd:needs-fix" in labels:
            continue
        p = entries.get(int(n))
        rh = str(p.get("reviewed_head") or "") if isinstance(p, dict) else ""
        if rh and (rh.startswith(v["head"]) or v["head"].startswith(rh[:12])):
            continue
        if "shepherd:reapprove" in labels:
            out[n] = f"{v['head']} (reapprove)"
        elif "shepherd:merge" not in labels:
            out[n] = f"{v['head']} (no shepherd:merge yet)"
    return out


REPORT_STALE_H, FOLLOWUP_STALE_H = 6, 24
_CI_IN_FLIGHT: dict[str, bool] = {}


def ci_in_flight(head: str) -> bool:
    """A check run at this head is still queued or running (one gh call per head per tick). 2026-10-21: 13 of 15 PRs
    the liveness rule flagged carried a stale shepherd:needs-fix from an older head while CI ran on the new one; each
    Sonnet tick said "waiting on CI, no action" and the PR merged on its own (~50 ticks in a day)."""
    if head not in _CI_IN_FLIGHT:
        try:
            runs = gh_json(f"repos/{REPO}/commits/{head}/check-runs?per_page=100").get("check_runs", [])
            _CI_IN_FLIGHT[head] = any(r.get("status") != "completed" for r in runs)
        except RuntimeError:
            _CI_IN_FLIGHT[head] = False  # unreadable: flag it as before
    return _CI_IN_FLIGHT[head]


def orphans(state: dict, snap: dict, live: list[dict]) -> dict[str, str]:
    """Liveness invariant (2026-10-16 audit): every open thing churn tracks has a next step scheduled or a recorded wake
    condition. {key: why} for the ones that have neither: a watched open PR nobody will move, a queue item blocked
    behind a PR churn doesn't watch, a report or followup waiting far too long. The tick turns each into a standing
    need (so it reaches the owner via the stall rule) instead of letting it sit silently, as #5204 did for ~20 h."""
    out: dict[str, str] = {}
    needs_review = reviews_needed(state, snap, live)
    queued_prs = {int(q["pr"]) for q in state.get("queue", []) if q.get("pr")}
    for n, v in snap.items():
        if v.get("state") != "open" or "head" not in v or int(n) in queued_prs or n in needs_review:
            continue
        verdict = verdict_at_head(state, n, v)
        labels = set(v.get("labels", []))
        mergeable = "shepherd:needs-fix" not in labels and v.get("mergeable_state") != "dirty"
        if (pr_in_hand(n, v, live) or verdict == "hold" or (verdict == "merge" and mergeable)
                or flaked(state, n, v) or clean_at_head(state, n, v) or ci_in_flight(v["head"])):
            continue  # a worker has it / the owner / CI + the shepherd / a rerun / nothing failing / CI still running
        out[f"orphan PR #{n}"] = (f"PR #{n} at {v['head']} has no next step (verdict {verdict or 'none'} at this head, "
                                  f"labels {sorted(labels) or 'none'}, {v.get('mergeable_state')})")
    watched = {pr_num(p) for p in state.get("prs", [])}
    for q in state.get("queue", []):
        for n in blocked_by(q, snap, state):
            if n not in watched and not any(re.search(rf"#{n}\b", r.get("task") or "") for r in live):
                out[f"orphan blocker #{n}"] = f"queue item #{q['issue']} waits on PR #{n}, which churn doesn't watch"
    for e in state.get("reports_pending", []):
        fin = parse_iso(_run_meta(e["run_id"]).get("finished")) if e.get("run_id") else None
        if fin and now() - fin > dt.timedelta(hours=REPORT_STALE_H):
            out[f"orphan report {e['run_id']}"] = f"report {e['run_id']} has waited {(now() - fin).total_seconds() / 3600:.0f} h for review"
    for f in state.get("followups", []):
        since = parse_iso(f.get("since"))
        if since and now() - since > dt.timedelta(hours=FOLLOWUP_STALE_H):
            out[f"orphan followup #{f['pr']}"] = f"followup for PR #{f['pr']} open {(now() - since).total_seconds() / 3600:.0f} h"
    return out


def owner_items(state: dict, snap: dict) -> list[str]:
    """Everything waiting on the owner, from the four places churn records it (one list for `churn status`)."""
    out = [f"PR #{n} on hold: " + str(next((p.get("note") for p in state.get("prs", []) if isinstance(p, dict)
                                            and pr_num(p) == int(n)), "") or "")[:140] for n in owner_holds(state, snap)]
    out += [f"queue #{q['issue']}" + (f" (PR #{q['pr']})" if q.get("pr") else "") + f": {str(q.get('task', ''))[:140]}"
            for q in state.get("queue", []) if q.get("needs_owner")]
    out += [f"stalled: {k}" for k in state.get("stalled", [])]
    out += [f"experiment {e['id']} designed: owner OK needed ({e.get('question_file')})"
            for e in state.get("experiments", []) if e.get("stage") == "designed"]
    return out


def count_attempts(state: dict, keys: list[str]) -> tuple[list[str], list[str]]:
    """Bump the model-tick attempt count of each need; keys past STALL_AFTER stop triggering (owner decides).
    Returns (keys still active, keys newly stalled). Counts of needs that went away are dropped."""
    att = {k: v for k, v in state.get("attempts", {}).items() if k in keys}
    active, stalled = [], []
    for k in keys:
        if att.get(k, 0) >= STALL_AFTER:
            if k not in state.get("stalled", []):
                stalled.append(k)
            continue
        active.append(k)
    state["attempts"] = att
    state["stalled"] = [k for k in state.get("stalled", []) if k in keys] + stalled
    return active, stalled


def bump_attempts(state: dict, keys: list[str]) -> None:
    att = state.setdefault("attempts", {})
    for k in keys:
        att[k] = att.get(k, 0) + 1


# ---------------------------------------------------------------- tick
# ---------------------------------------------------------------- CI pressure (load balancer)
# Owner 2026-10-14: three workers outran the free runner pool (31 runs queued, median wait 24 min). When GitHub's queue
# is busy, new PR-producing work only lengthens it; CI-light "backfill" work (L5 mutation, research) uses the idle
# Claude compute instead, and normal churn resumes when the queue clears. Hysteresis keeps it from flapping.
# Owner 2026-10-14 17:50Z: uncapped, the L5 backfill drove load1 to 24-36 on 12 cores (box RED 13:33-17:31Z, PR fixes and
# ci items held) and was preempted/resumed 5 times in 5 h (an Opus context reload each). Now it always runs under a hard
# CPUQuota of backfill_cores; when CI calms a backfill run DRAINS (finishes its ~20-30 min step) and is stopped only once it
# has run backfill_drain_max_min; a (re)launch waits until CI has been busy for backfill_min_busy_min.
# #35 (2026-10-21): 35 of 53 queued runs were one-job, ~1-min shepherd label-event runs (35% of all runs, 1.6-2.2k/day,
# mostly our own PRs' labels) while 6 ran: they held both hosts busy. ignore_workflows (workflow file names) don't count.
# #38 step 3 (2026-10-22): busy/calm comes from CI admission now (busy = no room for one normal launch). The queued-run
# and median-wait thresholds below were retired: overnight 10-21/22 they held work on 95 ticks across both hosts while
# PR jobs waited ~1 min for a runner, and admission never wanted to hold.
CI_PRESSURE_DEFAULT = {"backfill_max": 1, "backfill_calm_cores": 3, "backfill_cores": 4, "backfill_drain_max_min": 45,
                       "backfill_min_busy_min": 20, "backfill_idle_ticks": 2,
                       "ignore_workflows": ["shepherd-event.yml", "shepherd-reconcile.yml", "main-watch.yml"]}
CI_PRESSURE_RETIRED = ("busy_queued", "busy_wait_min", "calm_queued", "calm_wait_min", "busy_count_min_wait")


def ci_cfg(state: dict) -> dict:
    return {**CI_PRESSURE_DEFAULT, **state.get("ci_pressure", {})}


def yield_backfill(state: dict, snap: dict | None, b: dict, stop=None, mode: str = "busy") -> list[str]:
    """Owner 2026-10-14 15:15Z: in busy mode the L5 backfill held all 3 heavy slots (~9 cores) while the PR fixes for
    #5111/#5108 couldn't launch. A waiting PR fix or ci item outranks backfill: if the box has no slot for it, preempt.
    2026-10-16: this is now the ONLY reason backfill stops. In calm mode a launchable normal item also counts (it waits
    the drain window; PR fixes / ci items don't). CI calming by itself no longer stops backfill: that used to stop runs
    with nothing waiting and left the slots idle (9 preempted RESUME items, ~6 h of idle ticks on 2026-10-16)."""
    if not any(r.get("lane") == "backfill" and r.get("run_id") and pid_alive(r.get("pid")) for r in state.get("running", [])):
        return []
    rest = {**state, "queue": [q for q in state.get("queue", []) if q.get("lane") != "backfill"]}
    _, x = pick_item(rest, snap, mode)  # busy: only PR fixes and the ci lane; calm: normal items too
    if x is None or worker_slots(b, len(claude_slot_holders(state)), int(state.get("max_workers", 2))):
        return []
    priority = bool(x.get("pr")) or x.get("lane") == "ci"
    if not priority and len(prs_needing_work(snap or {}, claude_slot_holders(state), state)) >= 3:
        return []  # the gate would hold that normal item anyway ("finish those first")
    return preempt_backfill(state, "calm", stop, why=f"{'priority' if priority else 'normal'} work waits: #{x['issue']}"
                            + (f" (PR fix for #{x['pr']})" if x.get("pr") else " (ci lane)" if priority else ""),
                            drain_max_min=0 if priority else None)


def claude_slot_holders(state: dict) -> list[dict]:
    """Live Claude workers that count toward max_workers: not agy, not backfill (owner 2026-10-14: backfill uses only
    capacity normal churn can't use -- it never takes one of the slots), not credit (billed to API credit, not the plan)."""
    return [r for r in state.get("running", []) if r.get("run_id") and r.get("backend") != "agy"
            and r.get("lane") not in ("backfill", "credit") and pid_alive(r.get("pid"))]


def preempt_backfill(state: dict, mode: str, stop=None, why: str = "CI calm: normal churn gets the box",
                     drain_max_min: float | None = None) -> list[str]:
    """Owner 2026-10-14: backfill runs ONLY while the pipeline is clogged. When CI calms, stop each backfill worker (its
    unit, so its heavy-run slots and CPU free at once) and requeue a resume item at the front of the backfill lane; its
    branch, worktree, handoff note and scratch results carry the work to the next busy spell."""
    if mode != "calm":
        return []
    stop = stop or (lambda unit: run(["systemctl", "--user", "stop", unit]))
    drain_max = float(ci_cfg(state)["backfill_drain_max_min"] if drain_max_min is None else drain_max_min)
    notes = []
    for r in state.get("running", []):
        if r.get("lane") != "backfill" or not r.get("run_id") or not pid_alive(r.get("pid")):
            continue
        started = parse_iso(r.get("started"))
        ran = (now() - started).total_seconds() / 60 if started else None
        if ran is not None and ran < drain_max:  # drain: a capped step finishes; a stop + resume costs more than it frees
            notes.append(f"backfill {r['run_id']} draining: {ran:.0f} of {drain_max:.0f} min, no new backfill launches")
            continue
        rd = RUNS / r["run_id"]
        with contextlib.suppress(OSError):
            (rd / "preempted").write_text(iso(now()) + "\n")
        stop(f"churn-{r['run_id']}.service")
        meta = {}
        with contextlib.suppress(OSError, ValueError):
            meta = json.loads((rd / "meta.json").read_text())
        resume = {"issue": r["issue"], "model": r.get("model", "sonnet"), "needs_owner": False, "lane": "backfill",
                  "task": (f"RESUME backfill run {r['run_id']} (preempted {iso(now())} when CI calmed): same worktree "
                           f"{meta.get('worktree', '?')} / branch {meta.get('branch', '?')}; read its handoff note and "
                           f"scratch results, keep uncommitted edits, continue. Backfill rule: at most ONE heavy-run.sh "
                           f"job at a time; checkpoint every ~15 min. {str(r.get('task') or '')[:200]}")}
        q = state.setdefault("queue", [])
        first = next((k for k, x in enumerate(q) if x.get("lane") == "backfill"), len(q))
        q.insert(first, resume)
        notes.append(f"preempted backfill {r['run_id']} ({why}); resume queued")
    return notes


CONTAINER_MAX_AGE_H = 4  # state["container_max_age_h"] overrides; the longest legit test container is ~1.5 h (evidence db2)


def reap_containers(max_age_h: float, docker=None) -> list[str]:
    """Owner 2026-10-14: a `gitgalaxy-gnucobol:3` container (`cobc ... && ./ndb`) spun one core for 52 h after its worker
    was gone. Remove containers of gitgalaxy-* images running longer than max_age_h. Services from other images (the
    gitgalaxy-db2 container runs icr.io/db2_community/db2) are never touched. A host without Docker has nothing to reap."""
    if docker is None and not shutil.which("docker"):
        return []
    docker = docker or (lambda *args: run(["docker", *args], timeout=60))
    r = docker("ps", "--format", "{{.ID}}\t{{.Image}}\t{{.Names}}")
    if getattr(r, "returncode", 1) != 0:
        return []
    notes = []
    for line in r.stdout.splitlines():
        cid, image, name = (line.split("\t") + ["", ""])[:3]
        if not image.split("/")[-1].startswith("gitgalaxy"):
            continue
        t = parse_iso(docker("inspect", "-f", "{{.State.StartedAt}}", cid).stdout.strip()[:19] + "Z")
        if t is None or (now() - t).total_seconds() / 3600 < max_age_h:
            continue
        if getattr(docker("rm", "-f", cid), "returncode", 1) == 0:
            notes.append(f"removed stale container {name} ({image}, up {(now() - t).total_seconds() / 3600:.0f} h)")
    return notes


# Owner 2026-10-17: nothing ever removed a worker's worktree -- 607 had piled up, 499 of them on merged/closed PRs, clean.
# The gate removes those (gitgalaxy worktrees directly under WT) once the PR has been closed grace_h, a few per run.
# #31 (nyx 2026-10-19/20: disk YELLOW held every launch 21 h): under disk pressure the gc runs hourly with a 1 h grace and
# a higher limit, even on a RED box, and it also takes idle worktrees whose branch never had a PR.
WT_GC_DEFAULT = {"enabled": True, "every_h": 6, "grace_h": 48, "limit": 25, "disk_every_h": 1, "disk_grace_h": 1,
                 "disk_limit": 100}
DISK_REASONS = ("disk almost full", "disk filling", "inodes almost gone", "inodes low")
NO_PR_BRANCH_RE = re.compile(r"^(?:churn|agy|claude)/\d+-")


def disk_pressure(b: dict) -> list[str]:
    """box_status's disk/inode reasons (YELLOW or RED)."""
    return [r for r in b.get("reasons", []) if r.startswith(DISK_REASONS)]


def wt_gc_cfg(state: dict) -> dict:
    return {**WT_GC_DEFAULT, **{k: v for k, v in (state.get("worktree_gc") or {}).items() if k in WT_GC_DEFAULT}}


def git_worktrees(base: Path = V6) -> list[tuple[str, str]]:
    """(path, branch) per worktree of `base`; branch "" when detached."""
    out, path = [], None
    for line in run(["git", "-C", str(base), "worktree", "list", "--porcelain"]).stdout.splitlines():
        if line.startswith("worktree "):
            path = line[9:]
            out.append((path, ""))
        elif line.startswith("branch ") and path:
            out[-1] = (path, line[7:].removeprefix("refs/heads/"))
    return out


def worktrees_in_use(state: dict) -> set[str]:
    """Worktrees a run, a pending report, a held plan or a queue item still points at."""
    rids = [r.get("run_id") for r in state.get("running", []) + state.get("reports_pending", [])]
    rids += list((state.get("held_plans") or {}).keys())
    used = {r.get("worktree") for r in state.get("running", [])} | {x.get("worktree") for x in state.get("queue", [])}
    for rid in filter(None, rids):
        with contextlib.suppress(OSError, ValueError):
            used.add(json.loads((RUNS / rid / "meta.json").read_text()).get("worktree"))
    return {str(Path(u)) for u in used if u}


def closed_branches() -> dict[str, dt.datetime]:
    """branch -> when its last PR closed, for branches whose PRs are all merged or closed (none open)."""
    return pr_branch_states()[0]


def pr_branch_states() -> tuple[dict[str, dt.datetime], set[str]]:
    """(closed_branches, every branch that ever had a PR), from one gh call."""
    r = run(["gh", "pr", "list", "--repo", REPO, "--state", "all", "--limit", "20000", "--json", "headRefName,state,closedAt"],
            timeout=300)
    if r.returncode:
        raise RuntimeError(f"gh pr list: {r.stderr.strip()[:160]}")
    out, still_open = {}, set()
    for p in json.loads(r.stdout):
        b, t = p.get("headRefName") or "", parse_iso((p.get("closedAt") or "")[:19] + "Z")
        if p.get("state") == "OPEN":
            still_open.add(b)
        elif t and (b not in out or t > out[b]):
            out[b] = t
    return {b: t for b, t in out.items() if b not in still_open}, still_open | set(out)


def wt_activity(path: str) -> dt.datetime:
    """When a worktree was last touched: its HEAD commit or the directory itself, whichever is later."""
    t = Path(path).stat().st_mtime
    with contextlib.suppress(ValueError):
        t = max(t, float(run(["git", "-C", path, "log", "-1", "--format=%ct"]).stdout.strip() or 0))
    return dt.datetime.fromtimestamp(t, dt.timezone.utc)


def gc_worktrees(state: dict, dry_run: bool = False, limit: int | None = None, grace_h: float | None = None,
                 worktrees=None, closed=None, remove=None, pr_heads=None, activity=None) -> list[str]:
    """Remove finished worktrees: directly under WT (not churn-tools, not `_`-prefixed), not in use, on a branch whose
    PRs all closed more than grace_h ago, or on a worker branch that never had a PR and was idle grace_h (#31: such a
    tree was never collected, however old). `git worktree remove` without --force refuses a tree with modified or
    untracked files, so uncommitted work stays; the branch itself is kept."""
    cfg = wt_gc_cfg(state)
    limit = cfg["limit"] if limit is None else limit
    grace_h = cfg["grace_h"] if grace_h is None else grace_h
    cut = now() - dt.timedelta(hours=grace_h)
    worktrees = git_worktrees() if worktrees is None else worktrees
    if closed is None:
        closed, pr_heads = pr_branch_states()
    activity = activity or wt_activity
    remove = remove or (lambda path: run(["git", "-C", str(V6), "worktree", "remove", path], timeout=300))
    used = worktrees_in_use(state)
    ours = [(path, b) for path, b in worktrees if Path(path).parent == WT and Path(path) != TOOLS
            and not Path(path).name.startswith("_") and str(Path(path)) not in used]
    picks = [(closed[b], path, b) for path, b in ours if b in closed and closed[b] < cut]
    if pr_heads is not None:  # None: the caller passed no PR list, so no-PR trees can't be told apart
        for path, b in ours:
            if b and b not in pr_heads and NO_PR_BRANCH_RE.match(b):
                with contextlib.suppress(OSError):
                    if (t := activity(path)) < cut:
                        picks.append((t, path, b))
    picks.sort()
    more = [f"{len(picks) - limit} more finished worktree(s) left for the next run"] if len(picks) > limit else []
    if dry_run:
        return [f"would remove {Path(p).name} ({b}, " + (f"PR closed {iso(t)})" if b in closed else f"no PR, idle since {iso(t)})")
                for t, p, b in picks[:limit]] + more
    gone, kept = [], []
    for _, path, _b in picks[:limit]:
        r = remove(path)
        (gone if getattr(r, "returncode", 1) == 0 else kept).append(Path(path).name)
    if gone or kept:
        run(["git", "-C", str(V6), "worktree", "prune"])
    notes = [f"removed {len(gone)} finished worktree(s) (PR closed or no PR, idle > {grace_h:g} h): "
             + ", ".join(gone[:8]) + (" ..." if len(gone) > 8 else "")] if gone else []
    if kept:
        notes.append(f"kept {len(kept)} finished worktree(s) with local changes: " + ", ".join(kept[:8]))
    return notes + more


def gc_worktrees_if_due(b: dict) -> list[str]:
    """Every cfg.every_h, not on a RED box (removal is disk I/O); under disk pressure every disk_every_h with the short
    disk_grace_h, RED included: freeing the disk is the way out of that RED."""
    state = load_state()
    cfg = wt_gc_cfg(state)
    last = parse_iso(state.get("worktree_gc_at"))
    disk = disk_pressure(b)
    every = cfg["disk_every_h"] if disk else cfg["every_h"]
    if not cfg["enabled"] or (b.get("verdict") == "RED" and not disk) or (last and now() - last < dt.timedelta(hours=every)):
        return []
    with edit_state() as st:
        st["worktree_gc_at"] = iso(now())
    try:
        if disk:
            return gc_worktrees(state, limit=cfg["disk_limit"], grace_h=cfg["disk_grace_h"])
        return gc_worktrees(state)
    except (RuntimeError, OSError, subprocess.TimeoutExpired) as e:
        return [f"worktree gc skipped: {str(e)[:160]}"]


# Owner 2026-10-17: phone alerts (ntfy) when churn needs a human. Topic and send history live in their own file, not
# churn-state.json, so a broken state still gets reported. No topic -> nothing is sent (tests, a fresh box).
NOTIFY = H / "churn-notify.json"
HEARTBEAT = H / "churn-gate-ok"  # touched by every tick that finishes; the watchdog reads its age
GATE_FAILS = H / "churn-gate-fails"  # consecutive ticks that raised
NOTIFY_COOLDOWN_H = 3
WATCHDOG_STALE_MIN = 60
OWNER_WAIT_H = 12
AUTH_RE = re.compile(r"invalid api key|please run /login|oauth token (?:has )?expired|authentication_error|"
                     r"invalid bearer token|credentials? (?:are |is )?(?:invalid|expired)", re.I)


def notify_cfg() -> dict:
    with contextlib.suppress(OSError, ValueError):
        return json.loads(NOTIFY.read_text())
    return {}


def notify(key: str, title: str, msg: str, priority: str = "default", cooldown_h: float = NOTIFY_COOLDOWN_H,
           tags: str = "", post=None, queue: bool = True) -> bool:
    """Push one alert to the owner's phone; the same key at most once per cooldown_h. Never raises, never blocks
    longer than 10 s: an alert must not take the gate down with it."""
    cfg = notify_cfg()
    if not cfg.get("topic") or not cfg.get("enabled", True):
        return False
    last = parse_iso((cfg.get("sent") or {}).get(key))
    if last and now() - last < dt.timedelta(hours=cooldown_h):
        return False
    url = f"{cfg.get('server', 'https://ntfy.sh').rstrip('/')}/{cfg['topic']}"
    # several hosts share one topic (#11): name the box. Only a configured host_id; the hashed default means one box.
    shown = f"{_CFG['host_id']}: {title}" if _CFG.get("host_id") else title
    headers = {"Title": shown.encode("ascii", "replace").decode(), "Priority": priority}
    if tags:
        headers["Tags"] = tags
    req = urllib.request.Request(url, data=msg[:3500].encode(), headers=headers, method="POST")
    try:
        (post or (lambda r: urllib.request.urlopen(r, timeout=10).close()))(req)  # noqa: S310 (fixed https server)
    except (OSError, urllib.error.URLError, ValueError) as e:
        log(f"notify {key} failed: {str(e)[:120]}", quiet=True)
        if queue and priority in ("urgent", "high") and all(m.get("key") != key for m in cfg.get("outbox") or []):
            cfg.setdefault("outbox", []).append({"key": key, "title": title, "msg": msg[:3500], "priority": priority,
                                                 "tags": tags, "t": iso(now())})
            with contextlib.suppress(OSError):
                NOTIFY.write_text(json.dumps(cfg, indent=1))
        return False
    cfg.setdefault("sent", {})[key] = iso(now())
    with contextlib.suppress(OSError):
        NOTIFY.write_text(json.dumps(cfg, indent=1))
    return True


# Owner 2026-10-17: an internet outage must not burn the queue. Offline, `claude -p` retries ~3 min and exits with
# "API Error: Can't reach the API server ... (ENOTFOUND)"; the gate used to launch the next item into every free slot
# and the review ticks stalled into owner items. Now the tick checks both APIs first and holds like a limit pause.
NET_HOSTS = ("api.anthropic.com", "api.github.com")
OFFLINE_RE = re.compile(r"can.t reach the api server|ENOTFOUND|EAI_AGAIN|ECONNREFUSED|ECONNRESET|ETIMEDOUT|"
                        r"connection error|network is unreachable|getaddrinfo", re.I)
OFFLINE_NOTIFY_MIN = 20  # shorter blips are only logged


def unreachable(hosts=NET_HOSTS) -> list[str]:
    """Hosts a 5 s TCP connect to :443 cannot reach (DNS failure included)."""
    out = []
    for h in hosts:
        try:
            socket.create_connection((h, 443), timeout=5).close()
        except OSError:
            out.append(h)
    return out


def flush_outbox() -> int:
    """Deliver urgent/high alerts that failed while the box was offline, marked with when they were raised."""
    box_ = notify_cfg().get("outbox") or []
    if not box_:
        return 0
    sent = 0
    for m in box_:
        if notify(m["key"], f"{m['title']} (delayed, raised {m['t'][11:16]}Z)", m["msg"], priority=m["priority"],
                  cooldown_h=0, tags=m.get("tags", ""), queue=False):
            sent += 1
    cfg = notify_cfg()
    cfg["outbox"] = [] if sent == len(box_) else box_[sent:]
    with contextlib.suppress(OSError):
        NOTIFY.write_text(json.dumps(cfg, indent=1))
    return sent


def offline_tick(state: dict, down: list[str]) -> None:
    """Hold this tick: no launches, no model ticks (so no attempt counts or stalls), no GitHub reads."""
    with edit_state() as st:
        off = st.setdefault("offline", {})
        first = not off.get("since")
        off.setdefault("since", iso(now()))
        off["ticks"] = int(off.get("ticks", 0)) + 1
    log(f"offline: cannot reach {', '.join(down)}; holding launches and model ticks", quiet=not first)


def back_online() -> None:
    state = load_state()
    off = state.get("offline") or {}
    since = parse_iso(off.get("since"))
    with edit_state() as st:
        st.pop("offline", None)
    mins = (now() - since).total_seconds() / 60 if since else 0
    log(f"back online after {mins:.0f} min ({off.get('ticks', 0)} ticks held, {off.get('requeued', 0)} run(s) requeued)")
    if mins >= OFFLINE_NOTIFY_MIN:
        notify(f"online-{off.get('since')}", "churn: back online",
               f"The box was offline {mins / 60:.1f} h (since {off.get('since')}). {off.get('requeued', 0)} worker(s) "
               "requeued; churn resumed.", tags="globe_with_meridians", queue=False)


# Owner 2026-10-17: Claude Code updates itself daily (2.1.300 -> .301 -> .302 in three days). A release that changes
# `-p` output or flags would end every worker `crashed`/`error` while the gate stays healthy -- no alert covered that.
FAIL_STREAK_PAGE = 4
FAIL_STREAK_HOLD_H = 1  # then one more round of launches probes whether it still fails


def claude_version_note() -> str:
    path = Path(CLAUDE).resolve()
    name = path.name if re.fullmatch(r"\d+\.\d+\.\d+", path.name) else (
        run([CLAUDE, "--version"], timeout=20).stdout.split(" ")[0].strip() or "?")
    with contextlib.suppress(OSError):
        at = dt.datetime.fromtimestamp(path.stat().st_mtime).astimezone()
        recent = dt.datetime.now().astimezone() - at < dt.timedelta(hours=48)
        return f"Claude Code {name}, installed {at.strftime('%b %d %H:%M')}" + (" (recent update: a likely cause)." if recent else ".")
    return f"Claude Code {name}."


def track_failures(state: dict, status: str, rid: str, text: str) -> None:
    """Consecutive workers that crashed or errored (not a limit, an outage or a preemption). FAIL_STREAK_PAGE in a row
    pages the owner and holds launches FAIL_STREAK_HOLD_H; a run that works clears the streak."""
    if status in ("done", "denied", "budget"):
        state.pop("fail_streak", None)
        return
    if status not in ("crashed", "error"):
        return
    fs = state.setdefault("fail_streak", {"n": 0, "runs": []})
    fs["n"] = int(fs.get("n", 0)) + 1
    fs["runs"] = (list(fs.get("runs", [])) + [rid])[-8:]
    fs["last"] = " ".join((text or "").split())[-300:]
    if fs["n"] >= FAIL_STREAK_PAGE:
        hold = now() + dt.timedelta(hours=FAIL_STREAK_HOLD_H)
        if not (p := parse_iso(state.get("paused_until"))) or p < hold:
            state["paused_until"] = iso(hold)
        notify("fail-streak", f"churn: {fs['n']} workers failed in a row",
               f"Runs {', '.join(fs['runs'])}. {claude_version_note()} Launches hold {FAIL_STREAK_HOLD_H} h, then retry. "
               f"Last error: {fs['last'] or '(no output)'}", priority="urgent", cooldown_h=6, tags="rotating_light")
        log(f"{fs['n']} workers failed in a row ({', '.join(fs['runs'][-4:])}); holding launches {FAIL_STREAK_HOLD_H} h")


def auth_alert(text: str, source: str) -> None:
    """A run that failed on Claude's login: every later run fails the same way until the owner logs in again."""
    if AUTH_RE.search(text or ""):
        notify("claude-auth", "churn: Claude login failed",
               f"{source} failed to authenticate; every run will fail until you log in again (`claude` -> /login).\n"
               + " ".join(text.split())[:300], priority="urgent", tags="rotating_light")


OWNER_REF_RE = re.compile(r"^\s*(PR|queue) #(\d+)|^\s*(stalled): (\S+)")


def owner_ref(text: str) -> tuple[str, str] | None:
    """("PR", "123") / ("queue", "45") / ("stalled", key) from the head of an owner item or an answer's `item`."""
    m = OWNER_REF_RE.match(str(text or ""))
    return None if not m else (m[1], m[2]) if m[1] else (m[3], m[4])


def answered_refs() -> set[tuple[str, str]]:
    """Owner items the owner has answered but the tick has not applied yet (#28): no alert, `ANSWERED` in status."""
    return {r for e in unapplied_owner_answers() if (r := owner_ref(e.get("item")))}


def owner_question(ref: tuple[str, str] | None) -> str | None:
    """The phone text of $H/owner-questions/*.md for this item: its question and the yes/no/hold labels."""
    if not ref:
        return None
    for f in sorted((H / "owner-questions").glob("*.md")):
        with contextlib.suppress(OSError):
            lines = f.read_text().splitlines()
            fields = {k.strip().lower(): v.strip() for k, _, v in (x.partition(":") for x in lines) if v}
            if owner_ref(fields.get("item")) == ref:
                opts = [f"{k}: {fields[k].split(' -- ')[0]}" for k in ("yes", "no", "hold") if fields.get(k)]
                return "\n".join([fields.get("question", ""), *opts]).strip() or None
    return None


def gate_alerts(state: dict, b: dict, snap: dict) -> None:
    """Disk RED from box_status, and the owner's items: one ping when an item first appears on a host with
    host.owner_pings (#29: a hold sat 12 h unseen on nyx 2026-10-20; melek's comms-bot already pushes each owner call
    with answer buttons, so it leaves this off), one high-priority reminder after OWNER_WAIT_H, nothing for an answered
    one (#28)."""
    disk = [r for r in b.get("reasons", []) if r.startswith("disk almost full") or r.startswith("inodes almost gone")]
    if disk:
        notify("disk-red", "churn: disk almost full", "; ".join(disk) + "\nThe gate launches nothing while RED.",
               priority="urgent", tags="floppy_disk")
    cfg = notify_cfg()
    if not cfg.get("topic"):
        return
    seen, keep = cfg.get("owner_seen") or {}, {}
    answered = answered_refs()
    for item in owner_items(state, snap):
        k = item.split(":")[0]
        keep[k] = seen.get(k) or iso(now())
        if owner_ref(item) in answered:
            continue
        if k not in seen and HOST.get("owner_pings"):  # off where comms-bot already pushes owner calls (melek)
            notify(f"owner-new:{k}", f"churn: {k} needs you", owner_question(owner_ref(item)) or item,
                   cooldown_h=24 * 365, tags="raising_hand")
        elif now() - parse_iso(keep[k]) >= dt.timedelta(hours=OWNER_WAIT_H):
            notify(f"owner:{k}", f"churn: {k} waits on you", item, priority="high", cooldown_h=24 * 365, tags="raising_hand")
    cfg = notify_cfg()
    cfg["owner_seen"] = keep
    with contextlib.suppress(OSError):
        NOTIFY.write_text(json.dumps(cfg, indent=1))


# Owner 2026-10-23: a #6072 fault probe looped forever under -ftraceall and its trace.txt filled the root disk from
# /tmp/gitgalaxy-scratch at ~75 MB/s (~100 GB); every Claude session then failed with ENOSPC and ticks did nothing for
# 2.5 h. disk-red pages only when the disk is almost full, far too late for a 75 MB/s writer, so this watches the scratch
# tree itself: over max_gb the owner is paged and GnuCOBOL containers older than any honest step are removed (`docker rm
# -f` needs only the docker group, though the looping process inside runs as root; the worker's pkill was refused).
SCRATCH_DEFAULT = {"path": "/tmp/gitgalaxy-scratch", "max_gb": 50, "reap": True, "reap_after_min": 30,
                   "image": "gitgalaxy-gnucobol", "idle_h": 24, "sweep_every_h": 1, "sweep_dirs": ["claude"],
                   "keep": ["locks", "ci-digest", "bg"]}


def scratch_cfg(state: dict) -> dict:
    return {**SCRATCH_DEFAULT, **{k: v for k, v in (state.get("scratch_watch") or {}).items() if k in SCRATCH_DEFAULT}}


def scratch_usage(path: str) -> tuple[float, list[tuple[float, str]]] | None:
    """(total GB, the biggest dirs three levels down as (GB, path)); None when it can't be measured."""
    try:
        r = run(["ionice", "-c3", "nice", "du", "-xk", "-d3", path], timeout=120)
    except (OSError, subprocess.TimeoutExpired):
        return None
    sizes = []
    for line in r.stdout.splitlines():
        kb, _, p = line.partition("\t")
        if kb.isdigit():
            sizes.append((int(kb) / 1024**2, p))
    total = next((gb for gb, p in sizes if p.rstrip("/") == path.rstrip("/")), None)
    if total is None:
        return None
    depth = path.rstrip("/").count("/") + 3
    return total, sorted((s for s in sizes if s[1].count("/") == depth), reverse=True)[:3]


def proof_containers(image: str) -> list[tuple[str, str, float]]:
    """(id, name, minutes running) of each running container from `image`."""
    r = run(["docker", "ps", "--format", "{{.ID}}\t{{.Image}}\t{{.Names}}\t{{.CreatedAt}}"], timeout=30)
    out = []
    for line in r.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 4 or not parts[1].startswith(image):
            continue
        with contextlib.suppress(ValueError):  # CreatedAt: "2026-10-23 21:25:00 -0400 EDT"
            born = dt.datetime.strptime(parts[3][:25], "%Y-%m-%d %H:%M:%S %z")
            out.append((parts[0], parts[2], (now() - born).total_seconds() / 60))
    return out


# Owner 2026-10-24 (#31 ask 3): workers leave one scratch dir per run under /tmp/gitgalaxy-scratch/claude and nothing
# removed them: nyx reached 67 GB in ~200 dirs (#6166 15 GB, #5863 mutation 10 GB) while the watch above only paged.
# Hourly, a dir under sweep_dirs (or a loose file at the top) untouched for idle_h and not in use by any process goes.
def newer_than(path: str, cutoff: float) -> bool:
    """True when path or anything under it was modified after cutoff (stops at the first such entry)."""
    stack = [path]
    while stack:
        p = stack.pop()
        try:
            if os.lstat(p).st_mtime > cutoff:
                return True
            with os.scandir(p) as it:
                for e in it:
                    if e.is_dir(follow_symlinks=False):
                        stack.append(e.path)
                    elif e.stat(follow_symlinks=False).st_mtime > cutoff:
                        return True
        except (NotADirectoryError, FileNotFoundError, PermissionError):
            continue
    return False


def paths_in_use(root: str) -> set[str]:
    """Paths under root that some process has as its cwd or an open file (read from /proc)."""
    root = root.rstrip("/") + "/"
    used = set()
    for pid in os.listdir("/proc"):
        if not pid.isdigit():
            continue
        links = [f"/proc/{pid}/cwd"]
        with contextlib.suppress(OSError):
            links += [f"/proc/{pid}/fd/{fd}" for fd in os.listdir(f"/proc/{pid}/fd")]
        for link in links:
            with contextlib.suppress(OSError):
                if (t := os.readlink(link)).startswith(root):
                    used.add(t)
    return used


def scratch_sweep(cfg: dict) -> list[str]:
    """Remove idle worker scratch; one log line when anything went."""
    base = cfg["path"].rstrip("/")
    if not os.path.isdir(base):
        return []
    cutoff = time.time() - cfg["idle_h"] * 3600
    used = paths_in_use(base)
    cands = [e.path for e in os.scandir(base) if e.is_file(follow_symlinks=False) and e.name not in cfg["keep"]]
    for d in cfg["sweep_dirs"]:
        with contextlib.suppress(OSError):
            cands += [e.path for e in os.scandir(f"{base}/{d}")]
    gone, stuck = [], []
    for p in sorted(cands):
        if any(u == p or u.startswith(p + "/") for u in used) or newer_than(p, cutoff):
            continue
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p, ignore_errors=True)  # files a root container wrote can refuse; reported, not fatal
        else:
            with contextlib.suppress(OSError):
                os.unlink(p)
        (stuck if os.path.lexists(p) else gone).append(p.removeprefix(base + "/"))
    if not gone and not stuck:
        return []
    return [f"scratch sweep: removed {len(gone)} idle (> {cfg['idle_h']} h) entr{'y' if len(gone) == 1 else 'ies'} "
            f"under {base}" + (f": {', '.join(gone[:8])}" + (" ..." if len(gone) > 8 else "") if gone else "")
            + (f"; could not fully remove {', '.join(stuck[:5])}" if stuck else "")]


def scratch_sweep_if_due(state: dict, cfg: dict) -> list[str]:
    last = parse_iso(state.get("scratch_sweep_at"))
    if not cfg["idle_h"] or (last and now() - last < dt.timedelta(hours=cfg["sweep_every_h"])):
        return []
    with edit_state() as st:
        st["scratch_sweep_at"] = iso(now())
    return scratch_sweep(cfg)


def scratch_watch(state: dict) -> list[str]:
    """Log lines when the scratch tree is over its limit (after reaping stale proof containers and paging), plus the
    hourly idle sweep's line; else []."""
    cfg = scratch_cfg(state)
    swept = scratch_sweep_if_due(state, cfg)
    usage = scratch_usage(cfg["path"])
    if usage is None or usage[0] < cfg["max_gb"]:
        return swept
    total, top = usage
    reaped = []
    if cfg["reap"]:
        for cid, name, mins in proof_containers(cfg["image"]):
            if mins >= cfg["reap_after_min"] and run(["docker", "rm", "-f", cid], timeout=60).returncode == 0:
                reaped.append(f"{name} ({mins:.0f} min)")
    line = (f"scratch watch: {cfg['path']} is {total:.0f} GB (limit {cfg['max_gb']}); biggest: "
            + ", ".join(f"{p} {gb:.0f} GB" for gb, p in top)
            + (f"; removed proof containers: {', '.join(reaped)}" if reaped else "; no stale proof container to remove"))
    notify("scratch-big", f"churn: scratch at {total:.0f} GB", line.removeprefix("scratch watch: ")
           + "\nA runaway writer fills the disk and stops every Claude session; check it now.",
           priority="urgent", cooldown_h=1, tags="floppy_disk")
    return swept + [line]


def guarded_tick(fn) -> int:
    """Heartbeat for the watchdog; two failed ticks in a row page the owner (one failure can be a blip)."""
    try:
        rc = fn()
    except Exception as e:
        fails = 1
        with contextlib.suppress(OSError, ValueError):
            fails += int(GATE_FAILS.read_text().strip() or 0)
        with contextlib.suppress(OSError):
            GATE_FAILS.write_text(str(fails))
        if fails >= 2:
            notify("gate-crash", f"churn: gate failed {fails} ticks in a row",
                   f"{type(e).__name__}: {str(e)[:400]}\nSee `journalctl --user -u churn-tick -n 50`.",
                   priority="urgent", tags="rotating_light")
        raise
    GATE_FAILS.unlink(missing_ok=True)
    HEARTBEAT.touch()
    return rc


STUCK_LOOP_MIN = 20  # a pgrep wait loop this old whose target is gone waits forever
WORKER_SILENT_MIN = 45  # no transcript write for this long: the worker sits inside one tool call
WAIT_LOOP_RE = re.compile(r"""\b(?:while|until)\b.*?\bpgrep\s+(?:-\S+\s+)*?-[A-Za-z]*f[A-Za-z]*\s+(?:-\S+\s+)*"""
                          r"""(?:"([^"]+)"|'([^']+)'|([^\s;|&)]+))""")
DEAD_LOOP_MIN = 10  # the gate's threshold; it acts on the second sighting, so a dead loop lives ~20-30 min at most
DEAD_LOOP_RECHECK_MIN = 8
DEAD_LOOPS = H / "churn-dead-loops.json"  # dead loops seen once: {pid: {first seen, loop start}}


def proc_table() -> dict[int, tuple[int, str, float]]:
    """{pid: (ppid, cmdline, age in minutes)} for every process we can read."""
    tck, up = os.sysconf("SC_CLK_TCK"), float(Path("/proc/uptime").read_text().split()[0])
    out = {}
    for p in Path("/proc").iterdir():
        if not p.name.isdigit():
            continue
        with contextlib.suppress(OSError, ValueError, IndexError):
            f = (p / "stat").read_text().rsplit(")", 1)[1].split()
            cmd = (p / "cmdline").read_bytes().replace(b"\0", b" ").decode(errors="replace").strip()
            out[int(p.name)] = (int(f[1]), cmd, (up - int(f[19]) / tck) / 60)
    return out


def session_transcript(claude_pid: int) -> Path | None:
    """The live transcript of a claude process, from its ~/.claude/sessions registry entry."""
    with contextlib.suppress(OSError, ValueError, KeyError):
        s = json.loads((Path.home() / ".claude/sessions" / f"{claude_pid}.json").read_text())
        return Path.home() / ".claude/projects" / re.sub(r"[^A-Za-z0-9]", "-", s["cwd"]) / f"{s['sessionId']}.jsonl"
    return None


def worker_trees(state: dict, procs: dict) -> dict[str, list[int]]:
    """{run_id: descendant pids} for each live churn worker."""
    kids = collections.defaultdict(list)
    for pid, (ppid, _, _) in procs.items():
        kids[ppid].append(pid)
    out = {}
    for r in state.get("running", []):
        if not (r.get("run_id") and pid_alive(r.get("pid"))):
            continue
        tree, todo = [], list(kids[r["pid"]])
        while todo:
            tree.append(todo.pop())
            todo += kids[tree[-1]]
        out[r["run_id"]] = tree
    return out


def dead_wait_loops(state: dict, procs: dict, min_age: float = STUCK_LOOP_MIN) -> list[tuple[str, int, str, float]]:
    """(run_id, pid, pattern, age min) for each worker shell looping on `pgrep -f PATTERN` at least min_age old while
    no process but the loops themselves matches PATTERN (2026-10-17: #5053 and #4628 each spun ~1 h in
    `until ! pgrep -f "evidence.py prove"`, a loop that matches its own command line)."""
    out = []
    for rid, tree in worker_trees(state, procs).items():
        for pid in tree:
            _, cmd, age = procs[pid]
            m = WAIT_LOOP_RE.search(cmd)
            if not m or age < min_age:
                continue
            pat = next(g for g in m.groups() if g)
            try:
                hit = re.compile(pat).search
            except re.error:
                hit = lambda c, pat=pat: pat in c
            if not any("pgrep" not in c and hit(c) for _, c, _ in procs.values()):
                out.append((rid, pid, pat, age))
    return out


def stuck_workers(state: dict, procs: dict | None = None, transcript=session_transcript) -> list[tuple[str, str, str]]:
    """Live churn workers that wait on nothing (dead_wait_loops), or whose transcript has gone silent. Alert only:
    the gate ends dead loops itself (end_dead_wait_loops)."""
    if not any(r.get("run_id") and pid_alive(r.get("pid")) for r in state.get("running", [])):
        return []
    procs = procs if procs is not None else proc_table()
    dead = collections.defaultdict(list)
    for rid, pid, pat, age in dead_wait_loops(state, procs):
        dead[rid].append(f"pid {pid} has waited {age:.0f} min on `pgrep -f \"{pat}\"`, but no such process runs "
                         f"(the loop matches itself). `kill {pid}` lets the worker go on.")
    out = []
    for rid, tree in worker_trees(state, procs).items():
        silent = None
        for pid in tree:
            t = transcript(pid) if "claude" in procs[pid][1].split(" ", 1)[0] else None
            if t and t.exists():
                silent = (time.time() - t.stat().st_mtime) / 60
                break
        if dead[rid] or (silent is not None and silent >= WORKER_SILENT_MIN):
            shells = [procs[p][1].split("&& eval ", 1)[-1][:160] for p in tree if "eval " in procs[p][1]]
            msg = " ".join(dead[rid]) or (f"No transcript write for {silent:.0f} min; it sits inside one tool call: "
                                          + ("; ".join(shells) or "no shell running"))
            out.append((f"stuck-{rid}", f"churn: worker {rid} looks stuck", msg))
    return out


BOT_PRS = H / "churn-bot-prs.json"  # what tend_bot_prs did per bot PR: {n: {head, rerun, dispatched, paged}}
BOT_PR_MAX_AGE_H = 24


def tend_bot_prs(gh=None, sh=None) -> list[str]:
    """Bot PRs (a workflow's PR from a branch prefix in config `bot_prs`) have no worker and no shepherd label, so
    nothing looked after them: #5317 (evidence refresh) sat 13 h on 2026-10-17 after a 15.2 s timing flake failed
    ground-truth and blocked its auto-merge, then main moved and it conflicted. Per PR head, once each (owner
    2026-10-17): conflicting or older than BOT_PR_MAX_AGE_H -> dispatch its workflow on main (it rebuilds the PR from
    current main; skipped while a run is queued or running); a failed check -> rerun the failed jobs; still red after
    that -> page the owner. Returns log lines."""
    prefixes = _CFG.get("bot_prs") or {}
    if not prefixes:
        return []
    gh, sh = gh or gh_json, sh or run
    seen = {}
    with contextlib.suppress(OSError, ValueError):
        seen = json.loads(BOT_PRS.read_text())
    keep, lines, t = {}, [], now()
    for pr in gh(f"repos/{REPO}/pulls?state=open&per_page=100"):
        ref = pr["head"]["ref"]
        wf = next((w for pre, w in prefixes.items() if ref.startswith(pre)), None)
        if not wf:
            continue
        n, head = pr["number"], pr["head"]["sha"]
        mem = seen.get(str(n)) or {}
        mem = mem if mem.get("head") == head else {"head": head, "seen_at": iso(t)}
        keep[str(n)] = mem
        if mem.get("dispatched"):
            continue  # its rebuild is on the way: a new head starts over
        full = gh(f"repos/{REPO}/pulls/{n}")
        if full.get("mergeable_state") in (None, "unknown"):
            continue  # GitHub computes it lazily; the first pass on #5317 read it unknown and reran a conflicting PR
        age_h = (t - parse_iso(mem.get("seen_at") or pr["created_at"])).total_seconds() / 3600
        if full.get("mergeable_state") == "dirty" or age_h > BOT_PR_MAX_AGE_H:
            if any(gh(f"repos/{REPO}/actions/workflows/{wf}/runs?status={st}&per_page=5").get("workflow_runs")
                   for st in ("queued", "in_progress")):
                continue
            why = "conflicts with main" if full.get("mergeable_state") == "dirty" else f"open {age_h:.0f} h"
            if sh(["gh", "workflow", "run", wf, "-R", REPO, "--ref", "main"]).returncode == 0:
                mem["dispatched"] = iso(t)
                lines.append(f"bot PR #{n} {why}: dispatched {wf} on main to rebuild it")
            continue
        labels = {lb.get("name") for lb in (pr.get("labels") or ())}
        if "shepherd:merge" in labels:
            continue  # shepherd owns flake reruns and status digests; only the rebuild-on-conflict/stale check stays here
        failed = [r for r in gh(f"repos/{REPO}/actions/runs?head_sha={head}&per_page=50").get("workflow_runs", [])
                  if r.get("conclusion") in ("failure", "timed_out")]
        names = ", ".join(r.get("name", "?") for r in failed)[:300]
        if not failed:
            continue
        if not mem.get("rerun"):
            for r in failed:
                sh(["gh", "run", "rerun", str(r["id"]), "--failed", "-R", REPO])
            mem["rerun"] = iso(t)
            lines.append(f"bot PR #{n}: reran the failed jobs once ({names})")
        elif not mem.get("paged") and all(r.get("run_attempt", 1) > 1 for r in failed):
            mem["paged"] = iso(t)
            notify(f"bot-pr-{n}-{head[:8]}", f"churn: bot PR #{n} still red",
                   f"Bot PR #{n} ({ref}) is still red after one rerun: {names}. Its auto-merge stays blocked until "
                   "that is fixed.", priority="high", tags="warning")
            lines.append(f"bot PR #{n}: still red after a rerun; paged the owner")
    with contextlib.suppress(OSError):
        BOT_PRS.write_text(json.dumps(keep))
    return lines


def end_dead_wait_loops(state: dict, procs: dict | None = None, kill=os.kill) -> list[str]:
    """The gate's half (owner 2026-10-17): a dead wait loop seen on two ticks at least DEAD_LOOP_RECHECK_MIN apart is
    ended with SIGTERM. Only the loop's shell: the worker gets its tool call back and goes on. Returns log lines."""
    procs = procs if procs is not None else proc_table()
    seen = {}
    with contextlib.suppress(OSError, ValueError):
        seen = json.loads(DEAD_LOOPS.read_text())
    t, keep, lines = time.time(), {}, []
    for rid, pid, pat, age in dead_wait_loops(state, procs, min_age=DEAD_LOOP_MIN):
        start, prev = t - age * 60, seen.get(str(pid)) or {}
        first = prev["first"] if abs(prev.get("start", 0) - start) < 120 else t  # a reused pid is a new loop
        if t - first < DEAD_LOOP_RECHECK_MIN * 60:
            keep[str(pid)] = {"first": first, "start": start}
            continue
        with contextlib.suppress(ProcessLookupError, PermissionError):
            kill(pid, 15)
            lines.append(f"ended a dead wait loop in {rid}: pid {pid} waited {age:.0f} min on `pgrep -f \"{pat}\"` "
                         "with no such process (it matched itself); the worker goes on")
    with contextlib.suppress(OSError):
        DEAD_LOOPS.write_text(json.dumps(keep))
    return lines


def watchdog_checks(gh_ok=None, timer_active=None, state=None) -> list[tuple[str, str, str]]:
    """(key, title, message) for each problem the gate cannot report itself."""
    if STOP.exists():
        return []  # stopped on purpose
    out = []
    if state is None:
        with contextlib.suppress(Exception):
            state = load_state()
    with contextlib.suppress(OSError, ValueError):
        out += stuck_workers(state or {})
    age = (time.time() - HEARTBEAT.stat().st_mtime) / 60 if HEARTBEAT.exists() else None
    if age is not None and age > WATCHDOG_STALE_MIN:
        out.append(("stale", f"churn: no gate tick for {age / 60:.1f} h",
                    "The tick timer runs every 10 min. Check `systemctl --user status churn-tick.timer churn-tick.service`."))
    timer_active = timer_active if timer_active is not None else (
        run(["systemctl", "--user", "is-active", "churn-tick.timer"]).stdout.strip() == "active")
    if not timer_active:
        out.append(("timer", "churn: tick timer is not running", "`systemctl --user enable --now churn-tick.timer`"))
    if gh_ok is None and unreachable(("api.github.com",)):
        return out  # offline: `gh auth status` would fail too, and the alert could not leave the box anyway
    gh_ok = gh_ok if gh_ok is not None else run(["gh", "auth", "status"], timeout=30).returncode == 0
    if not gh_ok:
        out.append(("gh-auth", "churn: GitHub login failed", "`gh auth status` fails; run `gh auth login`."))
    return out


# Owner 2026-10-19: nyx's disk hit 10% free, box_status said YELLOW, and the gate launched nothing for hours with no
# alert (disk-red pages only at RED). Every cause of a stop has its own rule; this one watches the outcome instead: no
# Claude worker live for WORK_STOP_ALERT_MIN pages once per idle spell with every reason it can see.
WORK_STOP_ALERT_MIN = 60


def last_worker_activity(state: dict) -> dt.datetime | None:
    """When a Claude worker last finished (the usage ledger; orchestrator ticks are not workers)."""
    ts = [parse_iso(e.get("t")) for e in (state.get("usage") or {}).get("log", [])
          if e.get("issue") and not str(e.get("model", "")).startswith("orchestrator")]
    return max((t for t in ts if t), default=None)


def work_stop_reasons(state: dict, b: dict | None, snap: dict | None) -> list[str]:
    out = []
    if state.get("offline"):
        out.append(f"offline since {state['offline'].get('since')}")
    if (p := parse_iso(state.get("paused_until"))) and now() < p:
        out.append(f"usage-limit pause until {iso(p)}")
    if state.get("workers_paused"):
        out.append(f"workers_paused: {state['workers_paused']}")
    if (fs := state.get("fail_streak")) and fs.get("n"):
        out.append(f"{fs['n']} workers failed in a row")
    if int(state.get("max_workers", 2)) < 1:
        out.append("max_workers is 0")
    if b and b.get("verdict") != "GREEN":
        out.append(f"box {b.get('verdict')}: " + "; ".join(b.get("reasons", []))[:300])
    elif b and int(b.get("free_slots", 0)) < 1:
        out.append("box GREEN but no free heavy slot")
    out.append(idle_causes(state, snap, state.get("ci_mode", "calm")))
    return out


def work_stop_check(state: dict, b: dict | None, snap: dict | None) -> str | None:
    """Page once when no Claude worker has run for WORK_STOP_ALERT_MIN (unless churn was stopped on purpose); say so
    when one runs again. Returns what it sent, for the log."""
    if STOP.exists():
        return None
    cfg = notify_cfg()
    if claude_slot_holders(state):
        if not (stopped := cfg.pop("work_stopped", None)):
            return None
        with contextlib.suppress(OSError):
            NOTIFY.write_text(json.dumps(cfg, indent=1))
        notify(f"work-resumed-{stopped}", "churn: working again", f"A worker is running again (idle since {stopped}).",
               cooldown_h=0, tags="white_check_mark", queue=False)
        return "work resumed"
    since = last_worker_activity(state) or parse_iso(cfg.get("idle_seen"))
    if since is None:  # no worker on record: start the clock now
        cfg["idle_seen"] = iso(now())
        with contextlib.suppress(OSError):
            NOTIFY.write_text(json.dumps(cfg, indent=1))
        return None
    idle_min = (now() - since).total_seconds() / 60
    if idle_min < WORK_STOP_ALERT_MIN or cfg.get("work_stopped") == iso(since):
        return None
    why = work_stop_reasons(state, b, snap)
    if not notify(f"work-stopped-{iso(since)}", f"churn: no workers for {idle_min / 60:.1f} h",
                  "Nothing has run since " + iso(since) + ".\n- " + "\n- ".join(why)
                  + "\n`churn status` for detail.", priority="high", cooldown_h=24 * 365, tags="warning"):
        return None
    cfg = notify_cfg()
    cfg["work_stopped"] = iso(since)
    with contextlib.suppress(OSError):
        NOTIFY.write_text(json.dumps(cfg, indent=1))
    return f"no workers for {idle_min / 60:.1f} h: " + " | ".join(why)


def cmd_watchdog(a) -> int:
    for key, title, msg in watchdog_checks():
        notify(key, title, msg, priority="urgent" if key == "gh-auth" else "high", tags="warning")
        log(f"watchdog: {title}" + (f": {msg}" if key.startswith("stuck-") else ""), quiet=not key.startswith("stuck-"))
    with contextlib.suppress(Exception):  # an alert bug must never fail the watchdog
        state = load_state()
        b = None
        with contextlib.suppress(Exception):
            b = box(state)
        snap = json.loads(SNAP.read_text()) if SNAP.exists() else {}
        if sent := work_stop_check(state, b, snap):
            log(f"watchdog: {sent[:400]}")
    return 0


POLL_SEEN = H / "churn-poll.json"


def poll_changes(watched: list[int], open_prs: list[dict], snap: dict) -> dict[str, list]:
    """{pr: [head, labels]} of the watched PRs as GitHub shows them now ([None, []] once closed or merged), and only
    when that differs from the gate's last snapshot of them. Empty = nothing for the gate."""
    now_ = {str(p["number"]): [p["head"]["sha"][:12], sorted(lbl["name"] for lbl in p.get("labels", []))]
            for p in open_prs if p.get("number") in watched}
    seen = {str(n): [v.get("head"), sorted(v.get("labels", []))] if v.get("state") == "open" else [None, []]
            for n, v in snap.items() if int(n) in watched}
    return {n: now_.get(n, [None, []]) for n in map(str, watched)
            if n in seen and now_.get(n, [None, []]) != seen[n]}


def cmd_poll(a) -> int:
    """#19: between the 10-min gate ticks, look at the watched PRs with ONE gh call (every 2 min, churn-poll.timer) and
    start the gate at once when one changed: a red check the shepherd labelled needs-fix, a push, a merge. The gate
    then queues and launches the fix with no model tick, so a red check waits ~2 min, not up to 10, for its fix."""
    state = load_state()
    if STOP.exists() or state.get("workers_paused") or (
            (p := parse_iso(state.get("paused_until"))) and now() < p) or state.get("offline"):
        return 0
    watched = [pr_num(p) for p in state.get("prs", [])]
    if not watched or not SNAP.exists():
        return 0
    try:
        changed = poll_changes(watched, gh_json_etag(f"repos/{REPO}/pulls?state=open&per_page=100"),
                               json.loads(SNAP.read_text()))
    except (RuntimeError, ValueError):
        return 0
    try:
        last = json.loads(POLL_SEEN.read_text())
    except (OSError, ValueError):
        last = {}
    if not changed or changed == last:  # nothing new, or the gate already knows (it skipped: no slot, a pause)
        return 0
    POLL_SEEN.write_text(json.dumps(changed))
    log("poll: watched PRs changed (" + ", ".join(f"#{n}" for n in changed) + "): gate now", quiet=True)
    DIRTY.touch()  # a running tick loops once more
    nudge_tick()
    return 0


