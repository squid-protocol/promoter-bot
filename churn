def cmd_queue(a) -> int:
    """List or edit the work queue (the tick launches the first item with needs_owner false)."""
    with edit_state() as state:
        q = state.setdefault("queue", [])
        if a.action == "add":
            if a.issue is None or not a.task:
                raise SystemExit("queue add needs --issue and --task")
            item = {"issue": a.issue, "model": a.model, "task": a.task, "needs_owner": a.needs_owner}
            if a.backend == "agy":
                item["backend"] = "agy"
            if a.pr:
                item["pr"] = a.pr
            if getattr(a, "note", None):
                item["note"] = a.note[:300]
            if a.needs_owner and a.pr and not os.environ.get("CHURN_RUN"):
                # 2026-10-28: the owner's hold on a PR. A tick removed one at 16:12Z ("main's red cleared") before the
                # PR's own red check finished, and the gate sent the PR to an Opus rescue. Only the owner lifts it.
                item["owner_hold"] = True
            if a.after_pr:
                item["after_prs"] = a.after_pr
            if getattr(a, "after_merge", False):
                item["after_merge"] = True
            if a.allow_workflows:
                item["allow_workflows"] = True
            if a.agy_step:
                item["agy_step"] = a.agy_step
            if a.lane and a.lane != "normal":
                item["lane"] = a.lane
            if getattr(a, "repo", None):
                item["repo"] = a.repo
            if not in_focus(state, item):
                queued_filler = sum(1 for x in q if x.get("filler"))
                if getattr(a, "filler", False) and filler_open(state) and queued_filler < FILLER_QUEUE_MAX:
                    item["filler"] = True  # launches only as filler, below every focus item
                else:
                    why = ("" if not getattr(a, "filler", False) else " (no filler window open)" if not filler_open(state)
                           else f" (already {queued_filler} filler items queued)")
                    msg = park_off_focus(state, a.issue, a.task, "queue add") + why
                    log(msg)
                    print(msg + " (`churn focus` lists it; only the owner widens the focus)")
                    return 0
            meta = issue_meta(a.issue) if not a.pr else None
            if meta is not None and (sc := issue_scope(a.issue, meta)):
                item["scope"] = sc
            at = next((k for k, x in enumerate(q) if x.get("issue") == a.before_issue), None) if a.before_issue else None
            if a.front:
                q.insert(0, item)
            elif at is not None:
                q.insert(at, item)
            else:
                q.append(item)
            log(f"queued #{a.issue} ({'agy' if a.backend == 'agy' else a.model}{', front' if a.front else ''}): "
                f"{a.task[:120]}")
        elif a.action == "rm":
            if a.index is None or not 0 <= a.index < len(q):
                raise SystemExit("queue rm needs --index N from `churn queue`")
            if q[a.index].get("owner_hold"):
                owner_only(f"queue rm of the owner's hold on PR #{q[a.index].get('pr')}")
            gone = q.pop(a.index)
            if gone.get("allow_workflows"):  # the launch reads it after the rm (#4726, #5501 on 2026-10-23)
                state.setdefault("workflow_grants", {})[str(gone["issue"])] = iso(now())
            log(f"unqueued #{gone['issue']}: {gone['task'][:80]}")
        elif a.action == "route":
            if a.index is None or not 0 <= a.index < len(q) or not a.backend:
                raise SystemExit("queue route needs --index N and --backend claude|agy")
            if a.backend == "agy":
                q[a.index]["backend"] = "agy"
            else:
                q[a.index].pop("backend", None)
            log(f"routed #{q[a.index]['issue']} to {a.backend}")
        elif a.action == "lane":
            if a.index is None or not 0 <= a.index < len(q) or not a.lane:
                raise SystemExit("queue lane needs --index N and --lane normal|ci|backfill")
            q[a.index]["lane"] = a.lane
            if a.lane == "normal":
                q[a.index].pop("lane")
            log(f"lane of #{q[a.index]['issue']} -> {a.lane}")
        elif a.action == "park":
            if a.index is None or not 0 <= a.index < len(q) or not a.note:
                raise SystemExit("queue park needs --index N and --note")
            q[a.index].update(needs_owner=True, note=a.note[:300])
            log(f"parked #{q[a.index]['issue']} for the owner: {a.note[:120]}")
        elif a.action == "wait":
            a.worker = getattr(a, "worker", None)
            if a.index is None or not 0 <= a.index < len(q) or not (a.run or a.minutes or a.worker) or not a.note:
                raise SystemExit("queue wait needs --index N, --worker CHURN_RUN, --run RUN_ID and/or --minutes M, "
                                 "and --note")
            x = q[a.index]
            # 2026-10-27 (owner: "all we do is stop work"): ticks wrote "wait for worker X" as a 180-min timer; X ended in
            # 20 min and the ladder slot sat empty for hours. A named churn run is now waited on until it ends, and a
            # focus item's bare timer is capped: a hold on focus work must name what it waits for.
            if not a.worker and (m := re.search(r"\b(\d+-\d{8}T\d{4}Z)\b", a.note)) and (RUNS / m.group(1)).is_dir():
                a.worker = m.group(1)
            minutes = a.minutes
            if minutes and in_focus(state, x) and not (a.worker or a.run) and minutes > FOCUS_WAIT_MAX_MIN:
                minutes = FOCUS_WAIT_MAX_MIN
            x.update(wait_set=iso(now()), note=a.note[:300])
            for k in ("wait_run", "wait_until", "wait_worker"):
                x.pop(k, None)
            if a.worker:
                x["wait_worker"] = a.worker
                minutes = None  # the run's end releases it, not a guess
            if a.run:
                x["wait_run"] = a.run
            if minutes:
                x["wait_until"] = iso(now() + dt.timedelta(minutes=minutes))
            log(f"#{x['issue']} waits" + (f" for worker {a.worker}" if a.worker else "")
                + (f" for run {a.run}" if a.run else "") + (f" {minutes} min" if minutes else "")
                + f" (the gate offers it again when that is over, at most {WAIT_MAX_H} h): {a.note[:120]}")
        elif a.action == "top":
            if a.index is None or not 0 <= a.index < len(q):
                raise SystemExit("queue top needs --index N from `churn queue`")
            q.insert(0, q.pop(a.index))
    for i, item in enumerate(q):
        flag = " [needs owner]" if item.get("needs_owner") else ""
        who = "agy" if item.get("backend") == "agy" else item.get("model", "sonnet")
        extra = "".join([f" [PR #{item['pr']}]" if item.get("pr") else "", f" [{item['lane']}]" if item.get("lane") else "",
                         f" [{item['repo']}]" if item.get("repo") else "",
                         f" [{item['scope']}]" if item.get("scope") else "",
                         "" if in_focus(state, item) else " [filler]" if item.get("filler") else " [off focus: filler only]",
                         f" [after {','.join('#' + str(n) for n in item['after_prs'])}]" if item.get("after_prs") else "",
                         f" [waits {w}]" if (w := waiting(item)) else ""])
        print(f"{i:2}  #{item['issue']:<5} {who:<6}{flag}{extra} {item['task'][:100]}")
    return 0


def gh_label(n: int, add: str | None = None, remove: str | None = None) -> None:
    if add == "shepherd:merge":
        # The shepherd approves the head it sees when this label is ADDED (a `labeled` event; it records the sha). Adding
        # it while it is already on the PR fires nothing, so a re-review of a new head never took (#5080, 2026-10-14):
        # remove it first so the add is a fresh event for the reviewed head.
        run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/issues/{n}/labels/shepherd:merge"])
    if add:
        r = run(["gh", "api", f"repos/{REPO}/issues/{n}/labels", "-f", f"labels[]={add}"])
        if r.returncode:
            raise SystemExit(f"adding {add} to #{n} failed: {r.stderr.strip()[:200]}")
    if remove:
        run(["gh", "api", "-X", "DELETE", f"repos/{REPO}/issues/{n}/labels/{remove}"])  # absent label: fine


def cmd_pr(a) -> int:
    if a.action == "reviewed" and a.verdict == "merge":  # a merge verdict honours the same grants as the precheck
        st0 = load_state()
        p0 = next((p for p in st0.get("prs", []) if isinstance(p, dict) and pr_num(p) == a.number), {})
        head = gh_json(f"repos/{REPO}/pulls/{a.number}").get("head") or {}
        m = re.match(r"churn/(\d+)-", str(head.get("ref") or ""))
        issue = a.issue if a.issue is not None else p0.get("issue") or (int(m.group(1)) if m else None)
        files = [f["filename"] for f in gh_json(f"repos/{REPO}/pulls/{a.number}/files?per_page=100")]
        if why := workflow_grant_problem(st0, a.number, issue, files):
            raise SystemExit(f"pr reviewed #{a.number} --verdict merge refused: {why}")
    with edit_state() as st:
        prs = st.setdefault("prs", [])
        idx = next((i for i, p in enumerate(prs) if pr_num(p) == a.number), None)
        if a.action == "unwatch":
            if idx is None:
                raise SystemExit(f"#{a.number} is not watched")
            prs.pop(idx)
            log(f"unwatched PR #{a.number}")
            return 0
        entry = prs[idx] if idx is not None else {"number": a.number}
        if not isinstance(entry, dict):
            entry = {"number": entry}
        if a.issue is not None:
            entry["issue"] = a.issue
        if a.action == "allow-workflows":  # the owner's OK for this PR's workflow edits; survives new heads
            entry["allow_workflows"] = True
            log(f"PR #{a.number}: owner allows its workflow edits")
        elif a.action == "flake":
            if not a.head:
                raise SystemExit("pr flake needs --head")
            entry.update(flake_head=a.head, flake_at=iso(now()))
        elif a.action == "reviewed":
            if not a.head or not a.verdict:
                raise SystemExit("pr reviewed needs --head and --verdict")
            entry.update(reviewed_head=a.head, verdict=a.verdict, reviewed_at=iso(now()))
            if a.note:
                entry["note"] = a.note[:300]
            if a.verdict == "send-back":  # #19: the gate loops once more after this tick and launches the fix now
                DIRTY.touch()
        elif a.head:
            entry["reviewed_head"] = a.head
        if idx is None:
            prs.append(entry)
        else:
            prs[idx] = entry
    if a.action == "reviewed" and a.verdict == "merge":
        gh_label(a.number, add="shepherd:merge", remove="shepherd:reapprove")
    log(f"PR #{a.number} {a.action}" + (f" {a.verdict} at {a.head}" if a.action == "reviewed" else "")
        + (f": {a.note[:120]}" if getattr(a, "note", None) else ""))
    return 0


def requeue_next_slice(state: dict, f: dict, nxt: str | None) -> str | None:
    """#37 (2026-10-21): followups for #5878/#5893 (#5648) and #5850 (#5649) left their issues open and nothing queued
    the next slice, so nyx's core work stopped until the owner requeued it. A merged "Part of" followup whose issue is
    still open queues the next slice at the front: `--next` text when the tick gives it, else a generic
    continue-after-#pr task. 2026-10-30: that generic slice was core-only (from before the focus lock), so the owner's
    sweep/infra focus issues (#5126, #7064, #4269 ...) got no next slice overnight and the box idled; the focus
    allowlist above now does that job. None = nothing queued."""
    issue = f.get("issue")
    if not issue or f.get("kind") != "merged" or (not nxt and (state.get("workers_paused")
                                                               or not focus_on(state))):
        return None
    if any(x.get("issue") == issue for s in ("queue", "running") for x in state.get(s, [])):
        return None
    if not in_focus(state, {"issue": issue}):
        return park_off_focus(state, issue, nxt or f"next slice after #{f.get('pr')}", f"followup #{f.get('pr')}")
    try:
        i = gh_json(f"repos/{REPO}/issues/{issue}")
    except (RuntimeError, ValueError):
        return None
    if i.get("state") != "open" or foreign_claim(i) or host_skips(i):
        return None
    item = refill_item(i, task=(f"Next slice of #{issue} after PR #{f['pr']}: {nxt}" if nxt else
                                f"#{issue} {i.get('title', '')[:120]} -- continue after PR #{f['pr']} (a merged slice): "
                                "take the next PR-sized part of what the issue still asks; one draft PR"))
    item["auto"] = "followup-next"
    state.setdefault("queue", []).insert(0, item)
    return f"queued the next slice of #{issue}" + ("" if nxt else " (generic: no --next)")


def cmd_experiment(a) -> int:
    """Tick- and owner-facing: the gate's experiment_lane does every step; this records decisions."""
    if a.action == "propose":
        if not a.question or not a.change:
            raise SystemExit("propose needs --question and --change (what the answer would change)")
        with edit_state() as st:
            ok, why = exp_room(st)
            if not ok:
                raise SystemExit(f"no room for an experiment: {why}")
            e = exp_add(st, a.question, a.change, a.issue, source=a.note or "cli")
        log(f"experiment {e['id']} proposed: {a.question[:120]}")
        print(e["id"])
        return 0
    if a.action in ("approve", "drop"):
        if not a.args:
            raise SystemExit(f"{a.action} needs the experiment id")
        with edit_state() as st:
            e = next((x for x in st.get("experiments", []) if x["id"] == a.args[0]), None)
            if e is None:
                raise SystemExit(f"no experiment {a.args[0]}")
            if a.action == "approve":
                if e["stage"] != "designed":
                    raise SystemExit(f"{e['id']} is {e['stage']}, not designed")
                e.update(stage="approved", approved=iso(now()), **({"approve_note": a.note} if a.note else {}))
            else:
                if e["stage"] in ("closed", "dropped"):
                    raise SystemExit(f"{e['id']} is already {e['stage']}")
                e.update(stage="dropped", note=a.note or "dropped by the owner")
        if a.action == "drop":
            notes = exp_cleanup(e, None)
            log(f"experiment {a.args[0]} dropped; cleanup: {'; '.join(notes) or 'nothing open'}")
        else:
            log(f"experiment {a.args[0]} approved")
        return 0
    if a.action == "set":
        if len(a.args) != 2 or a.args[0] not in EXP_DEFAULT:
            raise SystemExit(f"set KEY VALUE, KEY one of {sorted(EXP_DEFAULT)}")
        k, v = a.args
        val = (v.lower() in ("1", "true", "on", "yes")) if isinstance(EXP_DEFAULT[k], bool) else type(EXP_DEFAULT[k])(v)
        with edit_state() as st:
            st.setdefault("experiment_cfg", {})[k] = val
        log(f"experiment config: {k} = {val}")
    state = load_state()
    print(json.dumps({"config": exp_cfg(state), "room": exp_room(state)[1],
                      "experiments": [{k: v for k, v in e.items() if k != "arms"} | {"arms": len(e.get("arms", []))}
                                      for e in state.get("experiments", [])[-5:]]}, indent=1))
    return 0


def cmd_gh_budget(a) -> int:
    """#64: a script about to make N API calls asks first. Exit 0 when N fit above the reserve (plus the optional
    reserve, so the fleet keeps its headroom), else print when they will and exit 1, or with --wait sleep until then."""
    cfg = quota_cfg(load_state())
    while True:
        q = gh_quota()
        if q is None:
            print("quota unreadable: go ahead carefully")
            return 0
        room = q["remaining"] - cfg["optional_reserve"]
        if a.calls <= room:
            print(f"ok: {a.calls} calls fit ({q['remaining']} left, {cfg['optional_reserve']} kept for the fleet)")
            return 0
        wait = max(0, q["reset"] - time.time()) + 20
        msg = (f"not now: {q['remaining']} left, {cfg['optional_reserve']} kept for the fleet; the quota resets at "
               f"{iso(dt.datetime.fromtimestamp(q['reset'], dt.timezone.utc))}")
        if not a.wait:
            print(msg)
            return 1
        print(msg + f"; waiting {wait / 60:.0f} min", flush=True)
        time.sleep(wait)


